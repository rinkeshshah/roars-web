---
/**
 * Third-party tags, on every page, from BaseLayout.
 *
 * ONE COMPONENT, NOT TWO. A separate Analytics.astro was suggested for GA4.
 * It is not added, because this component is already mounted in BaseLayout on
 * all 197 pages: two components both injecting gtag means two `config` calls
 * and every pageview counted twice. The measurement id goes in ANALYTICS_ID
 * below and the existing mount does the rest. This project's shell is
 * BaseLayout.astro rather than Layout.astro, and it is already wired.
 *
 * ON IN PRODUCTION by default, with PUBLIC_ENABLE_TRACKING=false as an
 * explicit opt-out. See the `enabled` line for what that means for the
 * staging host.
 *
 * The verification meta is NOT behind the switch. It is inert markup with no
 * request and no cookie, and Search Console needs it present to stay verified.
 *
 * ─────────────────────────────────────────────────────────────────────────
 * WHAT IS DELIBERATELY NOT HERE. Three of the five tags on the WordPress site
 * do not work, so none of them is carried. New ones are being generated.
 *
 *   Google Analytics    UA-50783352-1 is a Universal Analytics property, and
 *                       UA stopped processing data in July 2023. The tag still
 *                       loads analytics.js and still sends a request; nothing
 *                       lands anywhere anyone can read. Carrying it would cost
 *                       every visitor a DNS lookup and a download for no data
 *                       at all. Replace with GA4: see ANALYTICS_ID.
 *
 *   Meta Pixel          the live snippet defines fbq, loads fbevents.js, and
 *                       stops. No fbq('init', '<id>'), no PageView, and no
 *                       pixel id anywhere in it. A pixel with no init reports
 *                       nothing. See PIXEL_ID.
 *
 *   facebookSignalConfig   a WordPress plugin's inline config. ajaxUrl points
 *                       at /wp-admin/admin-ajax.php, which stops existing when
 *                       WordPress does, and signalsNonce is a one-off nonce
 *                       that expired when that page was generated. There is no
 *                       version of it worth carrying to a static site.
 *
 * TO ADD EITHER ONE: put the id in the constant below and it ships. GA4 is
 * gtag.js rather than analytics.js, so that block is written for gtag. A
 * constant left empty emits nothing at all, rather than a block behind a
 * runtime `if` that can never be true, so an unused tag costs zero bytes.
 * ─────────────────────────────────────────────────────────────────────────
 *
 * LOADING. Everything waits for the load event and then an idle callback, so
 * no third-party script competes with first paint or with the LCP the homepage
 * test measures.
 */

/** Google Search Console. Inert, no request, always present. */
const SITE_VERIFICATION = 'aXxaXukTotkO1Dc0RqLpEQJLO6q8GEO4QkF64xC8OFU'

/** Gleap feedback widget. A public client key, safe in markup. */
const GLEAP_KEY = 'R8SQnj4KeBiXVrsZczEAQhdYij1U8eQr'

/** GA4 measurement id. Replaces the dead UA property. */
const ANALYTICS_ID = 'G-QX2LK1FZEG'

/** Meta Pixel id, digits only. Empty until one exists. */
const PIXEL_ID = ''

/* ON IN PRODUCTION, off everywhere else, with an explicit escape hatch.
   `import.meta.env.PROD` is true for any `astro build`, so this fires on the
   deployed site without anybody remembering an environment variable, and
   never during `astro dev`.
   NOTE THAT DEV.ROARSINC.COM IS ALSO A PRODUCTION BUILD, so it reports into
   the same GA4 property as the live site until cutover. If that matters,
   either add a hostname filter in GA4 or build the staging deploy with
   PUBLIC_ENABLE_TRACKING=false. */
const enabled =
  import.meta.env.PROD && import.meta.env.PUBLIC_ENABLE_TRACKING !== 'false'

/* Values are interpolated HERE rather than passed through `define:vars`: that
   directive wraps the script body to declare its variables and `set:html`
   then replaces what it wrote, which silently produces an empty tag. */
const q = (v: string) => JSON.stringify(v)

const ga = ANALYTICS_ID
  ? `
    /* GA4, via gtag.js. */
    var s = document.createElement('script');
    s.async = true;
    s.src = 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(${q(ANALYTICS_ID)});
    document.head.appendChild(s);
    window.dataLayer = window.dataLayer || [];
    window.gtag = function () { window.dataLayer.push(arguments); };
    window.gtag('js', new Date());
    window.gtag('config', ${q(ANALYTICS_ID)});`
  : ''

const gleap = GLEAP_KEY
  ? `
    /* Gleap. Its own loader appends the SDK async. */
    !function (Gleap, t, i) {
      if (!(Gleap = window.Gleap = window.Gleap || []).invoked) {
        for (window.GleapActions = [], Gleap.invoked = !0, Gleap.methods = ["identify", "clearIdentity", "attachCustomData", "setCustomData", "removeCustomData", "clearCustomData", "registerCustomAction", "logEvent", "sendSilentCrashReport", "startFeedbackFlow", "setAppBuildNumber", "setAppVersionCode", "preFillForm", "setApiUrl", "setFrameUrl", "isOpened", "open", "close", "on", "setLanguage", "setOfflineMode", "initialize"], Gleap.f = function (e) { return function () { var t = Array.prototype.slice.call(arguments); window.GleapActions.push({ e: e, a: t }) } }, t = 0; t < Gleap.methods.length; t++) Gleap[i = Gleap.methods[t]] = Gleap.f(i);
        Gleap.load = function () { var t = document.getElementsByTagName("head")[0], i = document.createElement("script"); i.type = "text/javascript", i.async = !0, i.src = "https://sdk.gleap.io/latest/index.js", t.appendChild(i) };
        Gleap.load();
        Gleap.initialize(${q(GLEAP_KEY)});
      }
    }();`
  : ''

const pixel = PIXEL_ID
  ? `
    /* Meta Pixel. init and PageView are the two calls the live snippet was
       missing; without them the loader reports nothing. */
    !function (f, b, e, v, n, t, s) {
      if (f.fbq) return; n = f.fbq = function () { n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments) };
      if (!f._fbq) f._fbq = n; n.push = n; n.loaded = !0; n.version = '2.0'; n.queue = [];
      t = b.createElement(e); t.async = !0; t.src = v; s = b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t, s);
    }(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');
    window.fbq('init', ${q(PIXEL_ID)});
    window.fbq('track', 'PageView');`
  : ''

const tags = [ga, gleap, pixel].filter(Boolean).join(String.fromCharCode(10))

/* Deferred to idle: none of this is needed to render the page, and all of it
   is on somebody else's server. */
const script = `
(function () {
  var started = false;
  function start() {
    if (started) return;
    started = true;
${tags}
  }
  /* NOT (requestIdleCallback || setTimeout)(start, 1): the second argument to
     requestIdleCallback is an options OBJECT, so passing a number throws a
     TypeError and nothing loads at all. They need different calls. */
  function queue() {
    if (window.requestIdleCallback) window.requestIdleCallback(start, { timeout: 2000 });
    else window.setTimeout(start, 1);
  }
  if (document.readyState === 'complete') queue();
  else window.addEventListener('load', queue, { once: true });
})();
`
---

<meta name="google-site-verification" content={SITE_VERIFICATION} />

{enabled && tags && <script is:inline set:html={script} />}
