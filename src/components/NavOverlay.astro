<script>
  /* The canvas scale. Same rule the export uses: the whole menu always fits,
     so the contact bar cannot fall off the bottom of a short viewport. */
  const fit = () => {
    const el = document.querySelector('[data-nav-canvas]') as HTMLElement | null
    if (!el) return
    const s = Math.min(window.innerWidth / 1440, window.innerHeight / 900)
    el.style.setProperty('--nav-scale', String(s))
  }
  fit()
  addEventListener('resize', fit)
</script>
