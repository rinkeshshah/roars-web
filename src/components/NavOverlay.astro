---
/**
 * The full-screen menu. Approved island 1 of 4, and the single most-used
 * component on the site: it appears on all 68 routes, so it is one component
 * with no per-page variants.
 *
 * WHY THIS ONE IS AN ABSOLUTELY-POSITIONED CANVAS, when nothing else is.
 *
 * Every page on this site is flow layout, because a page has to work at every
 * width and its content length is not known in advance. The menu is neither.
 * It is a fixed overlay with a fixed amount of content, and the export draws
 * it as a 1440x900 canvas that it scales to fit — `scale(min(vw/1440,
 * vh/900))`, centred. Translating that into flow layout is what produced the
 * arrow collisions, the panel that pushed the nav column off the left edge,
 * and the contact bar that fell off the bottom of a short viewport. So this
 * component does what the export does: one canvas, one scale, and the
 * geometry below is transcribed from the export rather than re-derived.
 *
 * Below 760px the canvas is swapped for the export's own flowing accordion,
 * which is also what the export does.
 *
 * The Phase 1 accessibility is untouched and lives in src/scripts/nav.ts:
 * focus trap, Escape to close, focus returned to the trigger, aria-expanded
 * kept in sync, keyboard-reachable throughout, prefers-reduced-motion
 * respected. Hover and focus both switch the panel, so a keyboard sees the
 * same thing a mouse does.
 *
 * TWO DELIBERATE DIVERGENCES FROM THE EXPORT, both standing decisions:
 *   - counts. The export ships 10 PROJECTS / 8 SECTORS / 5 SERVICES / 3 KITS,
 *     which are the mock's numbers. Ours are the site's: 23 / 9 / 12 / 15. A
 *     count is a factual claim about the site, and the inventory is the truth.
 *   - the founder's name. The export ships "Riinkesh A Sshah" scrambled in
 *     every panel that mentions it.
 * Both are recorded in scripts/visual-diff.mjs's ACCEPTED register.
 */
import { MENU, MENU_REST, MENU_BAND } from '../lib/nav'
import mark from '../assets/roars-mark.png'

/* Row metas are right-aligned to 348px. The export hard-codes a different
   left for each (264 / 274 / 266 / 286) because it knows its own strings;
   ours are longer, so a shared right edge is the only reading that keeps all
   four clear of the arrow at 372 and still lines them up. */
const ROW_H = 60
const ROW_TOP = 50

/**
 * A steps panel with more than six entries runs in TWO COLUMNS.
 *
 * The services panel lists all twelve services. One column of twelve at 64px
 * starts 150px down an area 614px tall and finishes 300px past the bottom of
 * it, so the last four rows ran underneath the overlay's own footer — the
 * email address and the discovery-call button printed straight through them.
 *
 * Six is the threshold because six rows is what the area holds with the panel
 * heading above it. Approach, the only other steps panel, has four and stays
 * in one column; nothing about it changes.
 */
const TWO_COL_FROM = 6
const isTwoCol = (n: number) => n > TWO_COL_FROM
/** Rows per column. One column means every item is its own row. */
const rowsIn = (n: number) => (isTwoCol(n) ? Math.ceil(n / 2) : n)
---

<div class="nav" id="nav-overlay" data-nav-overlay hidden>
  <div class="nav__sky" aria-hidden="true"></div>
  <div class="nav__veil" aria-hidden="true"></div>

  <!-- ── desktop: the export's 1440x900 canvas, scaled to fit ── -->
  <div class="nav__canvas" data-nav-canvas>
    <a class="nav__mark" href="/" aria-label="Roars, home">
      <img src={mark.src} alt="" data-decorative width="26" height="26" />
    </a>
    <span class="nav__close-label" aria-hidden="true">CLOSE</span>
    <button class="nav__close" type="button" data-nav-close>
      <span class="visually-hidden">Close menu</span>
      <span class="nav__x" aria-hidden="true"><i></i><i></i></span>
    </button>

    <!-- left: navigation -->
    <nav class="nav__col" aria-label="Main">
      <span class="nav__kicker">NAVIGATION</span>
      <span class="nav__accent"></span>
      {MENU.map((item, i) => {
        const Tag = item.href ? 'a' : 'button'
        return (
          <Tag
            class="nav__row"
            data-menu-row
            style={`top:${ROW_TOP + i * ROW_H}px`}
            {...(item.href ? { href: item.href } : { type: 'button', 'aria-controls': `nav-panel-${i}` })}
          >
            <span class="nav__rule"></span>
            {i === MENU.length - 1 && <span class="nav__rule nav__rule--last"></span>}
            <span class="nav__n">{item.n}</span>
            <span class="nav__dot"></span>
            <span class="nav__label">{item.label}</span>
            {item.meta && <span class="nav__meta">{item.meta}</span>}
            <span class="nav__arrow" aria-hidden="true">→</span>
          </Tag>
        )
      })}
    </nav>

    <span class="nav__split" aria-hidden="true"></span>

    <!-- right: the panel answers whatever the cursor is on -->
    <div class="nav__panels">
      <div class="pane" data-menu-pane="rest">
        <span class="pane__eyebrow">{MENU_REST.eyebrow}</span>
        <span class="pane__accent"></span>
        <span class="pane__title pane__title--rest">{MENU_REST.title}</span>
        <span class="pane__statlabel">{MENU_REST.statLabel}</span>
        <div class="pane__stats">
          {MENU_REST.stats.map((s, i) => (
            <div class="stat" style={`left:${i * 290}px`}>
              <span class="stat__rule"></span>
              <span class="stat__value">{s.value}</span>
              <span class="stat__label">{s.label}</span>
            </div>
          ))}
        </div>
        <span class="pane__hint">{MENU_REST.hint}</span>
      </div>

      {MENU.map((item, i) => (
        <div class="pane" id={`nav-panel-${i}`} data-menu-pane={String(i)} hidden>
          <span class="pane__eyebrow">{item.eyebrow}</span>
          <span class="pane__accent"></span>
          <span class={`pane__title${item.kind === 'kits' ? ' pane__title--1line' : ''}`}>{item.title}</span>
          {item.body && <span class={`pane__body${item.kind === 'kits' ? ' pane__body--high' : ''}`}>{item.body}</span>}

          {item.kind === 'links' && (
            <div class="links">
              {item.items!.map((l, n) => {
                const L = l.href ? 'a' : 'span'
                return (
                  <L class="links__row" style={`top:${n * 58}px`} {...(l.href ? { href: l.href } : {})}>
                    <span class="links__rule"></span>
                    {n === item.items!.length - 1 && <span class="links__rule links__rule--last"></span>}
                    <span class="links__label">{l.label}</span>
                    <span class="links__arrow" aria-hidden="true">→</span>
                  </L>
                )
              })}
              {item.ventures && (
                <div class="ventures">
                  <span class="ventures__rule"></span>
                  <span class="ventures__label">OUR OWN VENTURES</span>
                  <span class="ventures__list">{item.ventures.map((v, n) => <>{n > 0 && <br />}{v}</>)}</span>
                </div>
              )}
            </div>
          )}

          {item.kind === 'services' && (
            <div
              class:list={[
                'steps',
                item.n === '03' && 'steps--approach',
                isTwoCol(item.items!.length) && 'steps--two',
              ]}
            >
              {item.items!.map((l, n) => {
                const rows = rowsIn(item.items!.length)
                const two = isTwoCol(item.items!.length)
                const rowH = item.n === '03' ? 62 : two ? 68 : 64
                /* In two columns the numbering still reads down each column in
                   turn — 01-06 then 07-12 — because that is the order the list
                   is written in and the order a reader takes it in. */
                return (
                  <a
                    class="steps__row"
                    href={l.href!}
                    style={
                      two
                        ? `left:${Math.floor(n / rows) * 450}px;top:${(n % rows) * rowH}px`
                        : `top:${n * rowH}px`
                    }
                  >
                    <span class="steps__rule"></span>
                    {/* The closing rule belongs to the bottom of each COLUMN,
                        not to the last item overall, or the left column ends
                        open while the right one is ruled off. */}
                    {(two ? n % rows === rows - 1 : n === item.items!.length - 1) && (
                      <span class="steps__rule steps__rule--last"></span>
                    )}
                    <span class="steps__n">{String(n + 1).padStart(2, '0')}</span>
                    <span class="steps__label">{l.label}</span>
                    <span class="steps__note">{l.note}</span>
                  </a>
                )
              })}
            </div>
          )}

          {item.kind === 'cards' && (
            <div class="work">
              {item.items!.map((l, n) => (
                <a class="work__card" href={l.href!} style={`left:${(n % 3) * 290}px;top:${Math.floor(n / 3) * 130}px`}>
                  <span class="work__rule"></span>
                  <span class="work__name">{l.label}</span>
                  <span class="work__meta">{l.meta}</span>
                </a>
              ))}
              {item.all && (
                <a class="pill pill--ghost work__all" href={item.all.href!}>
                  <span class="pill__label">{item.all.label}</span>
                  <span class="pill__dot pill__dot--mute"></span>
                  <span class="pill__dot pill__dot--accent"></span>
                </a>
              )}
            </div>
          )}

          {item.kind === 'sectors' && (
            <>
              <div class="sectors">
                {item.items!.map((l, n) => (
                  <a class="sectors__cell" href={l.href!} style={`left:${(n % 4) * 216}px;top:${Math.floor(n / 4) * 150}px`}>
                    <span class="sectors__rule"></span>
                    <span class="sectors__n">{String(n + 1).padStart(2, '0')}</span>
                    <span class="sectors__name">{l.label}</span>
                    <span class="sectors__meta">{l.meta}</span>
                  </a>
                ))}
              </div>
              {item.footnote && <span class="pane__foot">{item.footnote}</span>}
            </>
          )}

          {item.kind === 'kits' && (
            <div class="kits">
              {item.items!.map((l, n) => {
                const K = l.href ? 'a' : 'span'
                return (
                  <K class="kits__card" style={`left:${n * 294}px`} {...(l.href ? { href: l.href } : {})}>
                    <span class="kits__meta">{l.meta}</span>
                    <span class="kits__name">{l.label}</span>
                    <span class="kits__note">{l.note}</span>
                    <span class="kits__arrow" aria-hidden="true">→</span>
                  </K>
                )
              })}
            </div>
          )}

          {item.kind === 'posts' && (
            <div class="posts">
              {item.items!.map((l, n) => (
                <a class="posts__row" href={l.href!} style={`top:${n * 96}px`}>
                  <span class="posts__rule"></span>
                  {n === item.items!.length - 1 && <span class="posts__rule posts__rule--last"></span>}
                  <span class="posts__date">{l.meta}</span>
                  <span class="posts__title">{l.label}</span>
                </a>
              ))}
            </div>
          )}

          {item.kind === 'contact' && (
            <div class="reach">
              <span class="reach__rule"></span>
              <span class="reach__label reach__label--a">USA</span>
              <a class="reach__value reach__value--a" href="tel:+13025051200">+1 (302) 505-1200</a>
              <span class="reach__label reach__label--b">UK</span>
              <a class="reach__value reach__value--b" href="tel:+447537183399">+44 (7537) 183399</a>
              <span class="reach__label reach__label--c">EMAIL</span>
              <a class="reach__value reach__value--c" href="mailto:sales@roarsinc.com">sales@roarsinc.com</a>
              <a class="pill pill--solid reach__cta" href="/contact-us/">
                <span class="pill__label">Book a call</span>
                <span class="pill__dot pill__dot--ink-mute"></span>
                <span class="pill__dot pill__dot--ink"></span>
              </a>
            </div>
          )}
        </div>
      ))}
    </div>

    <!-- bottom band -->
    <div class="band">
      <span class="band__rule"></span>
      {MENU_BAND.offices.map((o, i) => (
        <>
          <span class="band__label" style={`left:${i * 250}px`}>{o.label}</span>
          <a class="band__value" style={`left:${i * 250}px`} href={o.href}>{o.value}</a>
        </>
      ))}
      <span class="band__label" style="left:500px">{MENU_BAND.email.label}</span>
      <a class="band__value" style="left:500px" href={MENU_BAND.email.href}>{MENU_BAND.email.value}</a>
      <a class="pill pill--ghost band__cta" href={MENU_BAND.cta.href}>
        <span class="pill__label">{MENU_BAND.cta.label}</span>
        <span class="pill__dot pill__dot--mute"></span>
        <span class="pill__dot pill__dot--accent"></span>
      </a>
    </div>
  </div>

  <!-- ── mobile: the export's flowing accordion ── -->
  <div class="navm">
    <div class="navm__top">
      <a class="navm__mark" href="/" aria-label="Roars, home"><img src={mark.src} alt="" data-decorative width="24" height="24" /></a>
      <button class="navm__close" type="button" data-nav-close>
        <span class="visually-hidden">Close menu</span>
        <span class="navm__close-label" aria-hidden="true">CLOSE</span>
        <span class="nav__x" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
    <span class="nav__kicker navm__kicker">NAVIGATION</span>
    <span class="nav__accent navm__accent"></span>
    <ul class="navm__list">
      {MENU.map((item) => (
        <li class="navm__item">
          <div class="navm__head">
            <span class="navm__n">{item.n}</span>
            {item.href
              ? <a class="navm__label" href={item.href}>{item.label}</a>
              : <span class="navm__label">{item.label}</span>}
            {item.meta && <span class="navm__meta">{item.meta}</span>}
          </div>
          {item.items && (
            <ul class="navm__sub">
              {item.items.map((l) => (
                <li>{l.href ? <a href={l.href}>{l.label}<span aria-hidden="true">→</span></a> : <span>{l.label}</span>}</li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ul>
    <div class="navm__band">
      {MENU_BAND.offices.map((o) => (
        <div><span class="band__label">{o.label}</span><a class="band__value" href={o.href}>{o.value}</a></div>
      ))}
      <div><span class="band__label">{MENU_BAND.email.label}</span><a class="band__value" href={MENU_BAND.email.href}>{MENU_BAND.email.value}</a></div>
      <a class="pill pill--ghost" href={MENU_BAND.cta.href}>
        <span class="pill__label">{MENU_BAND.cta.label}</span>
        <span class="pill__dot pill__dot--mute"></span>
        <span class="pill__dot pill__dot--accent"></span>
      </a>
    </div>
  </div>
</div>

<style>
  /* ──────────────────────────────────────────────────────────────
     Geometry below is transcribed from
     design/prototypes/Roars v2 - Menu.dc.html. Every px is the
     export's own, not a re-derivation. Do not "tidy" these numbers.
     ────────────────────────────────────────────────────────────── */

  .nav {
    position: fixed;
    inset: 0;
    z-index: 70;
    background: #050505;
    overflow: hidden;
    opacity: 0;
    transition: opacity var(--dur-mid, 0.4s) ease;
  }
  .nav.is-open { opacity: 1; }
  .nav[hidden] { display: none; }

  /* Starfield. The export uses assets/space.jpg at opacity .3 with a
     gradient veil over it. space.jpg is gone from the prototypes by
     decision, so the field is drawn: two radial dustings plus the same
     veil, which reads the same at .3 and costs no bytes. */
  .nav__sky {
    position: absolute;
    inset: -2%;
    background:
      radial-gradient(1px 1px at 12% 22%, rgba(255, 255, 255, 0.55) 50%, transparent 50%),
      radial-gradient(1px 1px at 34% 68%, rgba(255, 255, 255, 0.4) 50%, transparent 50%),
      radial-gradient(1px 1px at 58% 14%, rgba(255, 255, 255, 0.5) 50%, transparent 50%),
      radial-gradient(1px 1px at 76% 44%, rgba(255, 255, 255, 0.35) 50%, transparent 50%),
      radial-gradient(1px 1px at 88% 78%, rgba(255, 255, 255, 0.45) 50%, transparent 50%),
      radial-gradient(1.5px 1.5px at 22% 84%, rgba(255, 255, 255, 0.3) 50%, transparent 50%),
      radial-gradient(1.5px 1.5px at 66% 90%, rgba(255, 255, 255, 0.28) 50%, transparent 50%),
      radial-gradient(60% 50% at 74% 28%, rgba(120, 96, 72, 0.35) 0%, transparent 70%),
      radial-gradient(50% 60% at 18% 62%, rgba(70, 78, 104, 0.28) 0%, transparent 70%),
      #050505;
    background-size: 220px 190px, 310px 260px, 170px 240px, 260px 200px, 340px 300px,
      420px 380px, 500px 440px, 100% 100%, 100% 100%, 100% 100%;
    opacity: 0.85;
  }
  .nav__veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(5, 5, 5, 0.62) 0%,
      rgba(5, 5, 5, 0.86) 58%,
      rgba(5, 5, 5, 0.97) 100%
    );
  }

  /* The canvas. 1440x900, scaled so the whole menu always fits, which is
     what the export does and the reason the contact bar can no longer fall
     off the bottom of a short viewport. */
  .nav__canvas {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 1440px;
    height: 900px;
    transform: translate(-50%, -50%) scale(var(--nav-scale, 1));
    transform-origin: 50% 50%;
  }

  /* ── close bar ── */
  .nav__mark {
    position: absolute;
    left: 30px;
    top: 32px;
    width: 52px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--r-circle, 999px);
  }
  .nav__mark img {
    width: 26px;
    height: auto;
    display: block;
    /* the export's own filter: the black mark rendered in the accent */
    filter: brightness(0) invert(84%) sepia(72%) saturate(1400%) hue-rotate(357deg) brightness(104%);
    transition: filter 0.5s ease;
  }
  .nav__mark:hover img { filter: brightness(0) invert(1); }

  .nav__close-label {
    position: absolute;
    left: 1285px;
    top: 52px;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.2em;
    color: rgba(255, 255, 255, 0.66);
    white-space: nowrap;
    pointer-events: none;
  }
  .nav__close {
    position: absolute;
    left: 1349px;
    top: 42px;
    width: 46px;
    height: 30px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }
  .nav__x {
    position: absolute;
    left: 10px;
    top: 14px;
    width: 26px;
    height: 2px;
    display: block;
  }
  .nav__x i {
    position: absolute;
    left: 0;
    top: 0;
    display: block;
    width: 26px;
    height: 2px;
    background: #fff;
    transform-origin: 50% 50%;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .nav__x i:first-child { transform: rotate(45deg); }
  .nav__x i:last-child { transform: rotate(-45deg); }
  .nav__close:hover .nav__x i:first-child { transform: rotate(135deg); }
  .nav__close:hover .nav__x i:last-child { transform: rotate(45deg); }

  /* ── left: navigation ── */
  .nav__col { position: absolute; left: 39px; top: 150px; width: 400px; height: 614px; }
  .nav__kicker {
    position: absolute;
    left: 0;
    top: 0;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.2em;
    color: rgba(255, 255, 255, 0.45);
    white-space: nowrap;
  }
  .nav__accent { position: absolute; left: 0; top: 26px; width: 16px; height: 1.5px; background: var(--c-accent, #ffd400); }

  .nav__row {
    position: absolute;
    left: 0;
    width: 400px;
    height: 60px;
    display: block;
    padding: 0;
    border: 0;
    background: none;
    text-align: left;
    font: inherit;
    color: inherit;
    cursor: pointer;
    transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.5s ease;
  }
  .nav__rule { position: absolute; left: 0; top: 0; width: 400px; height: 1px; background: rgba(255, 255, 255, 0.12); }
  .nav__rule--last { top: 59px; }
  .nav__n {
    position: absolute;
    left: 0;
    top: 26px;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.18em;
    color: rgba(255, 255, 255, 0.62);
  }
  .nav__dot {
    position: absolute;
    left: 26px;
    top: 30px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--c-accent, #ffd400);
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .nav__label {
    position: absolute;
    left: 44px;
    top: 14px;
    font-size: 32px;
    font-weight: 600;
    line-height: 36px;
    letter-spacing: -0.05em;
    color: rgba(255, 255, 255, 0.72);
    white-space: nowrap;
    transition: color 0.3s ease;
  }
  .nav__meta {
    position: absolute;
    right: 52px; /* = 400 - 348, the shared right edge */
    top: 27px;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.16em;
    color: rgba(255, 255, 255, 0.6);
    white-space: nowrap;
  }
  .nav__arrow {
    font-weight: 400;
    position: absolute;
    left: 372px;
    top: 22px;
    font-size: 16px;
    line-height: 16px;
    color: rgba(255, 255, 255, 0.6);
    opacity: 0;
    transform: translateX(-8px);
    transition: opacity 0.3s ease, transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .nav__row[aria-current='true'] { transform: translateX(10px); }
  .nav__row[aria-current='true'] .nav__label { color: #fff; }
  .nav__row[aria-current='true'] .nav__dot { opacity: 1; }
  .nav__row[aria-current='true'] .nav__arrow { opacity: 1; transform: translateX(0); }

  .nav__split { position: absolute; left: 470px; top: 150px; width: 1px; height: 614px; background: rgba(255, 255, 255, 0.14); }

  /* ── right: panels ── */
  .nav__panels { position: absolute; left: 520px; top: 150px; width: 881px; height: 614px; }
  .pane {
    position: absolute;
    left: 0;
    top: 0;
    width: 881px;
    height: 614px;
    transition: opacity 0.4s ease, transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .pane[hidden] { display: none; }
  @starting-style { .pane { opacity: 0; transform: translateY(-10px); } }

  .pane__eyebrow {
    position: absolute;
    left: 0;
    top: 0;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.2em;
    color: rgba(255, 255, 255, 0.45);
    white-space: nowrap;
  }
  .pane__accent { position: absolute; left: 0; top: 26px; width: 16px; height: 1.5px; background: var(--c-accent, #ffd400); }
  .pane__title {
    position: absolute;
    left: 0;
    top: 56px;
