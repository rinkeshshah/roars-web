---
/**
 * Fixed top bar. Inner block at 39,36 sized 1366x111 on the 1440 canvas.
 *
 * Ink inverts over dark sections. That is driven by IntersectionObserver over
 * [data-ground="dark"] in src/scripts/topbar.ts, NOT by the prototypes'
 * hard-coded pixel bands, which break the moment content length changes.
 *
 * The bar itself ships no island. topbar.ts is a plain module: one observer
 * plus a rAF-throttled scroll read for the progress ring.
 */
import LogoChip from './LogoChip.astro'
import GhostButton from './GhostButton.astro'
import { site } from '../lib/site'
import { PORTRAIT } from '../lib/media'

/**
 * The prototypes carry two variants of this call to action and neither is a
 * mistake: Main, Agency, Projects, Project Detail, Insights and Insight
 * Details say "Contact Now"; Approach, Contact, Industries, Resources, Guides
 * and the service pages say "Setup a Meeting". Brand Guidelines shows
 * "Contact Now", so that is the default and the other is opt-in per page.
 */
interface Props {
  cta?: 'contact' | 'meeting'
}
const { cta = 'contact' } = Astro.props
const CTA = {
  contact: { label: 'Contact Now', note: 'Reach out to start your project' },
  meeting: { label: 'Setup a Meeting', note: 'We reply within 24 hours' },
}[cta]
---

<header class="topbar" data-topbar>
  <div class="wrap topbar__inner">
    <LogoChip />

    <div class="topbar__right">
      <div class="topbar__meet">
        <div class="topbar__meet-row">
          {/* The founder's face, attached to the pill's left edge — 42px
              white circle with a 32px image inset 5px, exactly as the export
              draws it. It is the only thing in the bar that says a person is
              on the other end of "Contact Now". */}
          <span class="topbar__face" aria-hidden="true">
            <img src={PORTRAIT.founder} alt="" width="32" height="32" loading="eager" decoding="async" />
          </span>
          <GhostButton
            href={site.booking}
            label={CTA.label}
            width={243}
            external
          />
        </div>
        <span class="topbar__note" data-topbar-note>{CTA.note}</span>
      </div>

      <button
        class="topbar__burger"
        type="button"
        data-nav-trigger
        aria-expanded="false"
        aria-controls="nav-overlay"
      >
        <span class="visually-hidden">Open menu</span>
        <span class="topbar__bar" aria-hidden="true"></span>
        <span class="topbar__bar topbar__bar--short" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<style>
  .topbar {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    pointer-events: none;
  }
  .topbar__inner {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    padding-top: 32px;
  }
  .topbar__inner > :global(*) { pointer-events: auto; }
  .topbar__right { display: flex; align-items: flex-start; gap: 126px; }
  .topbar__meet { display: flex; flex-direction: column; }
  /* No gap: the export butts the pill against the face at x+42. */
  .topbar__meet-row { display: flex; align-items: center; }
  .topbar__face {
    flex: none;
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: var(--r-circle);
    overflow: hidden;
    background: var(--c-white);
  }
  .topbar__face img { width: 32px; height: 32px; border-radius: var(--r-circle); object-fit: cover; display: block; }
  /* With the portrait still 404ing, the white disc is a blob sitting next to
     the pill on every light ground. Collapse the whole slot until the file
     lands, rather than shipping the ring around nothing. */
  .topbar__face:has(img.is-missing) { display: none; }
  .topbar__note {
    margin-top: 29px;
    font-size: var(--fs-label);
    font-weight: var(--fw-medium);
    line-height: 20px;
    letter-spacing: var(--ls-item);
    color: var(--c-white);
    opacity: 0.75;
    transition: opacity var(--dur-fast) ease, translate var(--dur-fast) ease;
  }
  /* The note retires once the page has moved. */
  .topbar.is-scrolled .topbar__note { opacity: 0; translate: 0 -12px; pointer-events: none; }

  .topbar__burger {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-end;
    gap: 6px;
    width: 26px;
    height: 42px;   /* matches the pill, so it centres against it */
    margin-top: 0;
    align-self: flex-start;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }
  .topbar__bar { display: block; width: 26px; height: 2px; background: var(--c-white); transition: width var(--dur-fast) ease; }
  .topbar__bar--short { width: 18px; }
  .topbar__burger:hover .topbar__bar--short { width: 26px; }

  .topbar.is-light .topbar__bar { background: rgb(15, 15, 15); }
  .topbar.is-light .topbar__note { color: rgb(15, 15, 15); }

  .visually-hidden {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }

  @media (max-width: 1040px) { .topbar__right { gap: var(--sp-5); } }
  @media (max-width: 760px) {
    .topbar__inner { padding-top: var(--sp-3); align-items: center; }
    .topbar__meet { display: none; }
  }
</style>
