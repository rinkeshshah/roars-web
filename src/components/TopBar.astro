---
/**
 * Fixed top bar. Inner block at 39,36 sized 1366x111 on the 1440 canvas.
 *
 * Ink inverts over dark sections. That is driven by IntersectionObserver over
 * [data-ground="dark"] in src/scripts/topbar.ts, NOT by the prototypes'
 * hard-coded pixel bands, which break the moment content length changes.
 *
 * The bar itself ships no island. topbar.ts is a plain module: one observer
 * plus a rAF-throttled scroll read for the progress ring.
 */
import LogoChip from './LogoChip.astro'
import GhostButton from './GhostButton.astro'
import { site } from '../lib/site'
import { PORTRAIT } from '../lib/media'

/**
 * The prototypes carry two variants of this call to action and neither is a
 * mistake: Main, Agency, Projects, Project Detail, Insights and Insight
 * Details say "Contact Now"; Approach, Contact, Industries, Resources, Guides
 * and the service pages say "Setup a Meeting". Brand Guidelines shows
 * "Contact Now", so that is the default and the other is opt-in per page.
 */
interface Props {
  cta?: 'contact' | 'meeting'
  /**
   * The logo's section-change flash — pink as a section boundary reaches the
   * top of the screen, yellow either side of it, the ground ink elsewhere.
   * See initLogoFlash in src/scripts/topbar.ts.
   *
   * ON EVERYWHERE, so this is an opt-OUT. It shipped opt-in while the effect
   * was being judged and every page wanted it in the end; a default of true
   * is one line here rather than the same word repeated across twenty-two
   * call sites, where the twenty-third would have been forgotten. Pass
   * pulse={false} for a page that should not have it.
   */
  pulse?: boolean
}
const { cta = 'contact', pulse = true } = Astro.props
const CTA = {
  contact: { label: 'Contact Now', note: 'Reach out to start your project' },
  meeting: { label: 'Setup a Meeting', note: 'We reply within 24 hours' },
}[cta]
---

<header class="topbar" data-topbar data-topbar-pulse={pulse ? '' : undefined}>
  <div class="wrap topbar__inner">
    <LogoChip />

    <div class="topbar__right">
      <div class="topbar__meet">
        <div class="topbar__meet-row">
          {/* The founder's face, attached to the pill's left edge — 42px
              white circle with a 32px image inset 5px, exactly as the export
              draws it. It is the only thing in the bar that says a person is
              on the other end of "Contact Now". */}
          <span class="topbar__face" aria-hidden="true">
            <img src={PORTRAIT.founder} alt="" width="32" height="32" loading="eager" decoding="async" />
          </span>
          <GhostButton
            href={site.booking}
            label={CTA.label}
            width={243}
            external
          />
        </div>
        <span class="topbar__note" data-topbar-note>{CTA.note}</span>
      </div>

      <button
        class="topbar__burger"
        type="button"
        data-nav-trigger
        aria-expanded="false"
        aria-controls="nav-overlay"
      >
        <span class="visually-hidden">Open menu</span>
        <span class="topbar__bar" aria-hidden="true"></span>
        <span class="topbar__bar topbar__bar--short" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<style>
  .topbar {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    pointer-events: none;
  }

  /**
   * THE BAR NEEDS A GROUND ONCE THE PAGE IS MOVING.
   *
   * It is transparent on purpose at the top, where it composes with the hero.
   * Scrolled, that same transparency put the page's own copy straight through
   * the mark and the burger: "Awarded" reading as the logo with an A behind
   * it on /about-us/, the "AI automation" paragraph running through both on an
   * industry page, the client logos colliding with the mark on /work/. Every
   * page, every width, for as long as the bar has existed -- it never showed
   * up in a gate because assert-overlap measures the page at rest and nothing
   * overlaps at scroll zero.
   *
   * ON is-scrolled, which already existed and already fades the pill's note at
   * exactly this point: the author was thinking about this state and gave it
   * no ground. Same trigger, so the bar simplifies and becomes opaque in one
   * movement rather than two.
   *
   * SOLID, NOT FROSTED, and that was a decision rather than the first idea.
   * A translucent ground with a blur is the prettier answer -- it takes the
   * colour of whatever is behind it and leaves no seam against the greys and
   * photographs this bar crosses. It was built that way first and measured at
   * 0.82 alpha: the about page's grey plate read straight through it and took
   * the burger's contrast with it, which is the reported bug at a lower
   * opacity rather than a fix for it. backdrop-filter compositing cannot be
   * verified in the environment these gates run in, so the legibility of the
   * only navigation on the page is not going to depend on it. Opaque, with a
   * hairline under it so the edge reads as an edge and not as a mistake.
   *
   * inset: 0 covers it -- measured, the bar's box encloses both controls at
   * every width (390: bar 0-68, mark 24-60, burger 21-63).
   */
  .topbar::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--c-footer);
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    opacity: 0;
    transition: opacity var(--dur-med) var(--ease-out);
    pointer-events: none;
  }
  .topbar.is-scrolled::before { opacity: 1; }
  /* is-light means the bar is NOT over a dark section, so the ground is pale. */
  .topbar.is-light::before {
    background: var(--c-white);
    border-bottom-color: rgba(20, 20, 20, 0.1);
  }

  @media (prefers-reduced-motion: reduce) {
    .topbar::before { transition: none; }
  }
  .topbar__inner {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    padding-top: 32px;
  }
  .topbar__inner > :global(*) { pointer-events: auto; }
  .topbar__right { display: flex; align-items: flex-start; gap: 126px; }
  .topbar__meet { display: flex; flex-direction: column; }
  /* No gap: the export butts the pill against the face at x+42. */
  .topbar__meet-row { display: flex; align-items: center; }
  .topbar__face {
    flex: none;
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: var(--r-circle);
    overflow: hidden;
    background: var(--c-white);
  }
  .topbar__face img { width: 32px; height: 32px; border-radius: var(--r-circle); object-fit: cover; display: block; }
  /* With the portrait still 404ing, the white disc is a blob sitting next to
     the pill on every light ground. Collapse the whole slot until the file
     lands, rather than shipping the ring around nothing. */
  .topbar__face:has(img.is-missing) { display: none; }
  .topbar__note {
    margin-top: 29px;
    font-size: var(--fs-label);
    font-weight: var(--fw-medium);
    line-height: 20px;
    letter-spacing: var(--ls-item);
    color: var(--c-white);
    opacity: 0.75;
    transition: opacity var(--dur-fast) ease, translate var(--dur-fast) ease;
  }
  /* The note retires once the page has moved. */
  .topbar.is-scrolled .topbar__note { opacity: 0; translate: 0 -12px; pointer-events: none; }

  /* THE PILL RETIRES WHILE YOU READ DOWNWARDS, and comes back the moment you
     scroll up. src/scripts/topbar.ts sets the class; the mark and the burger
     are deliberately not in here.

     It lifts out through the top of the bar rather than fading on the spot,
     so the movement says "parked above" rather than "gone". pointer-events
     off while it is away, or an invisible 285px target still swallows clicks
     over the page it is covering.

     The transition is on .topbar__meet permanently, not only in this rule,
     so returning is animated too. --dur-fast, because a control coming back
     because you asked for it should already be there when you look. */
  .topbar__meet {
    transition: opacity var(--dur-fast) var(--ease-out), translate var(--dur-fast) var(--ease-out);
  }
  .topbar.is-pill-away .topbar__meet {
    opacity: 0;
    translate: 0 -28px;
    pointer-events: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .topbar__meet { transition: opacity var(--dur-fast) linear; }
    .topbar.is-pill-away .topbar__meet { translate: none; }
  }

  /* THE CALL TO ACTION ARRIVES. The mark does its quarter turn at 300ms and
     this follows it in: the pill drops in at 380, the founder's face pops
     just behind it, and the line underneath settles last. Three beats over
     about half a second, then the block is still — the trailing dot's
     four-second pulse in GhostButton is what keeps it alive after that, and
     two things competing for the same corner would be one too many.

     from-ONLY KEYFRAMES, with `backwards` rather than `both`. The missing
     `to` is synthesised from the element's own computed style, so each one
     animates to whatever it would otherwise be and stops mattering after
     that. It has to work this way for the note: its resting opacity is 0.75
     and it drops to 0 on scroll, and a forwards fill would have pinned it at
     1 and killed both. */
  .topbar__meet-row { animation: meetIn 700ms var(--ease-spring) 380ms backwards; }
  .topbar__face     { animation: faceIn 620ms var(--ease-spring) 520ms backwards; }
  .topbar__note     { animation: noteIn 700ms var(--ease-out) 640ms backwards; }

  @keyframes meetIn { from { opacity: 0; transform: translateY(-12px); } }
  @keyframes faceIn { from { opacity: 0; transform: scale(0.55); } }
  @keyframes noteIn { from { opacity: 0; transform: translateY(-8px); } }

  @media (prefers-reduced-motion: reduce) {
    .topbar__meet-row, .topbar__face, .topbar__note { animation: none; }
  }

  .topbar__burger {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-end;
    gap: 6px;
    width: 26px;
    height: 42px;   /* matches the pill, so it centres against it */
    margin-top: 0;
    align-self: flex-start;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }
  .topbar__bar { display: block; width: 26px; height: 2px; background: var(--c-white); transition: width var(--dur-fast) ease; }
  .topbar__bar--short { width: 18px; }
  .topbar__burger:hover .topbar__bar--short { width: 26px; }

  .topbar.is-light .topbar__bar { background: rgb(15, 15, 15); }
  .topbar.is-light .topbar__note { color: rgb(15, 15, 15); }

  .visually-hidden {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }

  @media (max-width: 1040px) { .topbar__right { gap: var(--sp-5); } }
  @media (max-width: 760px) {
    .topbar__inner { padding-top: var(--sp-3); align-items: center; }
    .topbar__meet { display: none; }
  }
</style>
