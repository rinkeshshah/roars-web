    .wp-tall__scroll { height: min(60vh, 520px); }
    .wp-team { align-self: flex-start; }
  }
</style>

<script>
  /* The reel. One picture at a time, a counter, prev/next and a list that
     jumps. Progressive: with no JS the first screen and its copy are already
     in the document and the list is a row of inert buttons. */
  const reel = document.querySelector<HTMLElement>('.wp-reel')
  if (reel) {
    const slides = [...reel.querySelectorAll<HTMLElement>('[data-reel-slide]')]
    const copies = [...reel.querySelectorAll<HTMLElement>('[data-reel-copy]')]
    const picks = [...reel.querySelectorAll<HTMLButtonElement>('[data-reel-pick]')]
    const count = reel.querySelector<HTMLElement>('[data-reel-count]')
    const total = slides.length
    let at = 0

    const show = (n: number) => {
      at = (n + total) % total
      slides.forEach((s, i) => s.classList.toggle('is-on', i === at))
      copies.forEach((c, i) => { c.hidden = i !== at })
      picks.forEach((b, i) => b.classList.toggle('is-on', i === at))
      if (count) {
        count.textContent =
          String(at + 1).padStart(2, '0') + ' / ' + String(total).padStart(2, '0')
      }
    }

    picks.forEach((b, i) => b.addEventListener('click', () => show(i)))
    reel.querySelector('[data-reel-prev]')?.addEventListener('click', () => show(at - 1))
    reel.querySelector('[data-reel-next]')?.addEventListener('click', () => show(at + 1))
  }
</script>
