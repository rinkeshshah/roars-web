---
/**
 * THE CASE-STUDY PRESENTATION, from `Roars v2 - Work Presentation.dc.html`.
 *
 * Built from the handoff the owner sent on 17 Sep. Every number in here — type
 * sizes, clamps, gutters, the ring-field pitches, the gradient stops — is the
 * design's own, transcribed rather than interpreted. Where this departs from
 * the artboard it is written down at the departure.
 *
 * THREE DEPARTURES, all deliberate:
 *
 *  1. NO CASE-SWITCHER RAIL. The design's dark strip carries a row of pills —
 *     Advisee, Concierges, Snowman … — that swap the case in place. That is how
 *     you review seven cases inside one document. On the site each case is its
 *     own URL with its own canonical, so the rail would be seven links to
 *     pages the reader is already one click from. Dropped on the owner's
 *     instruction, and it would have gone anyway.
 *
 *  2. THE HEADER AND FOOTER ARE OURS. The artboard redraws the Roars top strip
 *     and footer because a standalone document has to. This site already ships
 *     both as components that assert-styles and assert-overlap cover. Drawing
 *     them again here would be two copies of one design, diverging the first
 *     time anybody edits one.
 *
 *  3. "NEXT CASE" IS COMPUTED, NOT AUTHORED. The design hardcodes a chain —
 *     each case names the next. The site knows its own order, and which twelve
 *     projects are held back, so the neighbour comes from the same function
 *     prev/next already uses. A hardcoded chain would eventually point at a
 *     noindex page, which is the thing assert-held-back exists to stop.
 *
 * The rest is the design.
 */
import type { CollectionEntry } from 'astro:content'
import RingField from './RingField.astro'

interface Props {
  d: CollectionEntry<'projects'>['data']
  next?: { slug: string; client: string }
  nextImg?: string
  faces: string[]
}
const { d, next, nextImg, faces } = Astro.props
const p = d.presentation!

/* The act numbers run 01, 02, 03 … over the acts this case actually has, which
   is what makes an image-poor case read as complete rather than as one with
   gaps in its numbering. The design computes the same way. */
let step = 1
const idx = () => String(++step).padStart(2, '0')
const wiresIndex = p.wires.length ? idx() : null
const systemIndex = p.artifacts.length ? idx() : null
const screensIndex = p.screens.length ? idx() : null
const buildIndex = idx()
const outcomeIndex = idx()

/* Four plinth grounds, cycled. Two white, one navy, one tinted — so a logo on
   white and a colour ramp on navy both sit on something that suits them. */
const PLINTHS = ['p0', 'p1', 'p2', 'p3']

/* THE COVER FALLS BACK TO THE PROJECT'S OWN HEADER PHOTOGRAPH.
   The design draws a striped "COVER IMAGE — TO BE SUPPLIED" plate when a case
   has none, which is the right thing inside a design document and the wrong
   thing on a live page — it tells a visitor we did not finish. Two of the seven
   have no plate in the handoff: FlowRow's names a file that is in neither the
   client folder nor the WordPress export, and the President's Club never had
   one. Both already have a header photograph, the same file /work/ puts on
   their card, so the page shows that instead. It is a photograph, so it takes
   the scrim.

   The design's striped placeholder is NOT built. It is the right thing inside
   a design document and the wrong thing on a live page — it tells a visitor we
   did not finish. With the header photograph as the fallback there is no case
   that reaches it anyway: all twenty-four projects have one, which assert-styles
   confirmed by reporting the rule as matching nothing. A project with neither
   simply opens without a plate. */
const cover = p.coverPlate ?? (d.heroImage ? { src: d.heroImage, alt: '', w: 2400, h: 1200 } : undefined)
const coverIsPhoto = p.coverPlate ? p.coverIsPhoto : true
---

{/* ── 01 Cover ─────────────────────────────────────────────── */}
<section class="wp-cover" id="cover">
  <a class="wp-back" href="/work/" data-reveal>
    <span>See all Projects</span>
    <span class="wp-dots"><i></i><i class="on"></i></span>
  </a>

  <div class="wp-head" data-reveal>
    <div class="wp-head__main">
      {p.constraints.length > 0 && (
        <div class="wp-pills">
          {p.constraints.map((c) => <span>{c}</span>)}
        </div>
      )}
      <h1 class="wp-name">{d.headline ?? d.client}</h1>
      <p class="wp-line">{p.line}</p>
      {d.dateLabel && <span class="wp-date">{d.dateLabel}</span>}
    </div>
    {faces.length > 0 && (
      <div class="wp-team">
        <div class="wp-team__faces">
          {faces.map((f) => <img src={f} alt="" width="42" height="42" loading="lazy" />)}
        </div>
        <span class="wp-team__label">Team Members<br />Involved</span>
      </div>
    )}
  </div>

  {cover && (
    <div class="wp-plate" data-reveal>
      <img
        src={cover.src}
        alt={cover.alt}
        width={cover.w}
        height={cover.h}
        loading="lazy"
        decoding="async"
      />
      {/* A photograph gets a scrim, a screenshot does not. The design's rule:
          rings and gradients go ON photographs and BEHIND screenshots. */}
      {coverIsPhoto && <div class="wp-plate__scrim" aria-hidden="true"></div>}
    </div>
  )}

  {p.meta.length > 0 && (
    <div class="wp-meta" data-reveal>
      {p.meta.map((m) => (
        <div><span class="wp-meta__k">{m.k}</span><span class="wp-meta__v">{m.v}</span></div>
      ))}
    </div>
  )}
</section>

{/* ── 01 The Challenge ─────────────────────────────────────── */}
<section class="wp-split" id="challenge">
  <div class="wp-split__rail" data-reveal>
    <span class="wp-label">01 &mdash; The Challenge</span>
    <span class="wp-split__name">What we were handed</span>
  </div>
  <div class="wp-split__body">
    <p class="wp-split__lead" data-reveal>{p.challengeLead}</p>
    <p class="wp-split__more" data-reveal>{p.challengeBody}</p>
  </div>
</section>

{/* ── Groundwork ───────────────────────────────────────────── */}
{p.wires.length > 0 && (
  <section class="wp-act wp-act--grey" id="groundwork">
    <div class="wp-act__head" data-reveal>
      <div>
        <span class="wp-label">{wiresIndex} &mdash; Groundwork</span>
        <h2 class="wp-h2">Structure before surface</h2>
      </div>
      <p class="wp-act__note">
        Every flow was argued in grey first. Nothing went to visual design until the
        journey held up.
      </p>
    </div>
    <div class="wp-wires">
      {p.wires.map((w) => (
        <figure data-reveal>
          <div class="wp-wires__frame">
            <img src={w.img.src} alt={w.img.alt} width={w.img.w} height={w.img.h} loading="lazy" />
          </div>
          <figcaption>
            <span class="wp-kicker">{w.label}</span>
            <span class="wp-wires__note">{w.note}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>
)}

{/* ── Design system ────────────────────────────────────────── */}
{p.artifacts.length > 0 && (
  <section class="wp-act wp-act--grey" id="system">
    <div class="wp-act__head" data-reveal>
      <div>
        <span class="wp-label">{systemIndex} &mdash; Design System</span>
        <h2 class="wp-h2">The kit of parts</h2>
      </div>
      <p class="wp-act__note">
        The decisions taken before a single screen was drawn. Everything after this is
        assembly.
      </p>
    </div>
    <div class="wp-arts">
      {p.artifacts.map((a, i) => (
        <div data-reveal>
          <div class:list={['wp-arts__plinth', `wp-arts__plinth--${PLINTHS[i % PLINTHS.length]}`]}>
            <img src={a.img.src} alt={a.img.alt} width={a.img.w} height={a.img.h} loading="lazy" />
          </div>
          <div class="wp-arts__cap">
            <div class="wp-arts__name"><span class="wp-tick"></span>{a.label}</div>
            <span class="wp-arts__note">{a.note}</span>
          </div>
        </div>
      ))}
    </div>
  </section>
)}

{/* ── What shipped ─────────────────────────────────────────── */}
{p.screens.length > 0 && (
  <section class="wp-act wp-act--dark wp-reel" id="screens">
    <RingField />
    <div class="wp-act__head" data-reveal>
      <div>
        <span class="wp-label wp-label--dark">{screensIndex} &mdash; What shipped</span>
        <h2 class="wp-h2 wp-h2--dark">One screen, one decision</h2>
      </div>
      <div class="wp-reel__ctrl">
        <span class="wp-reel__count" data-reel-count>
          01 / {String(p.screens.length).padStart(2, '0')}
        </span>
        <div>
          <button type="button" data-reel-prev aria-label="Previous screen">&lsaquo;</button>
          <button type="button" data-reel-next aria-label="Next screen">&rsaquo;</button>
        </div>
      </div>
    </div>
    <div class="wp-reel__body">
      <div class="wp-reel__stage">
        {p.screens.map((s, i) => (
          <figure data-reel-slide={i} class={i === 0 ? 'is-on' : undefined}>
            <img
              src={s.img.src}
              alt={s.img.alt}
              width={s.img.w}
              height={s.img.h}
              loading={i === 0 ? 'eager' : 'lazy'}
              decoding="async"
            />
          </figure>
        ))}
      </div>
      <div class="wp-reel__side">
        {p.screens.map((s, i) => (
          <div class="wp-reel__copy" data-reel-copy={i} hidden={i !== 0}>
            <span class="wp-reel__kicker">{s.kicker}</span>
            <span class="wp-reel__title">{s.title}</span>
            <span class="wp-reel__note">{s.note}</span>
          </div>
        ))}
        <div class="wp-reel__list">
          {p.screens.map((s, i) => (
            <button type="button" data-reel-pick={i} class={i === 0 ? 'is-on' : undefined}>
              <span class="wp-reel__n">{String(i + 1).padStart(2, '0')}</span>
              <span>{s.title}</span>
            </button>
          ))}
        </div>
      </div>
    </div>
  </section>
)}

{/* ── Full page ────────────────────────────────────────────── */}
{p.tall && (
  <section class="wp-tall" id="depth">
    <div class="wp-tall__rail" data-reveal>
      <span class="wp-label">Full page</span>
      <span class="wp-tall__title">{p.tallTitle}</span>
      <span class="wp-tall__note">{p.tallNote}</span>
    </div>
    <div class="wp-tall__scroll" data-reveal>
      <img src={p.tall.src} alt={p.tall.alt} width={p.tall.w} height={p.tall.h} loading="lazy" />
    </div>
  </section>
)}

{/* ── In the hand ──────────────────────────────────────────── */}
{p.mobile.length > 0 && (
  <section class="wp-act wp-act--dark wp-hand" id="mobile">
    <RingField />
    <div class="wp-hand__head" data-reveal>
      <span class="wp-label wp-label--dark">In the hand</span>
      <h2 class="wp-h2 wp-h2--dark wp-h2--sm">{p.mobileTitle ?? 'Built for the phone first'}</h2>
    </div>
    <div class="wp-hand__grid">
      {p.mobile.map((m) => (
        <figure data-reveal>
          <div class="wp-hand__frame" style={`aspect-ratio:${p.mobileRatio ?? '16/10'}`}>
            <img src={m.img.src} alt={m.img.alt} width={m.img.w} height={m.img.h} loading="lazy" />
            {/* Rings go ON a photograph, never on a screenshot. */}
            {!m.screenshot && <span class="wp-hand__rings" aria-hidden="true"></span>}
          </div>
          <figcaption>{m.label}</figcaption>
        </figure>
      ))}
    </div>
  </section>
)}

{/* ── Tech & architecture ──────────────────────────────────── */}
<section class="wp-split" id="build">
  <div class="wp-split__rail" data-reveal>
    <span class="wp-label">{buildIndex} &mdash; How it runs</span>
    <span class="wp-split__name">Tech &amp; architecture</span>
  </div>
  <div class="wp-split__body">
    <p class="wp-split__lead wp-split__lead--sm" data-reveal>{p.buildLead}</p>
    <div class="wp-stack">
      {p.stack.map((s) => (
        <div data-reveal><span class="wp-stack__k">{s.k}</span><span class="wp-stack__v">{s.v}</span></div>
      ))}
    </div>
  </div>
</section>

{/* ── Outcomes ─────────────────────────────────────────────── */}
<section class="wp-act wp-act--grey wp-out" id="outcome">
  <div class="wp-out__head" data-reveal>
    <span class="wp-label">{outcomeIndex} &mdash; Outcomes</span>
    <h2 class="wp-h2">{p.outcomeLead}</h2>
  </div>
  <div class="wp-out__grid">
    {p.outcomes.map((o) => (
      <div data-reveal><span class="wp-out__big">{o.big}</span><span class="wp-out__label">{o.label}</span></div>
    ))}
  </div>
</section>

{/* ── Client ───────────────────────────────────────────────── */}
{d.testimonial && (
  <section class="wp-act wp-act--dark wp-voice" id="voice">
    <div data-reveal>
      <span class="wp-tick wp-tick--wide"></span>
      <blockquote>{d.testimonial.quote}</blockquote>
      <div class="wp-voice__who">
        {d.testimonial.portrait && (
          <img src={d.testimonial.portrait} alt={d.testimonial.name} width="64" height="64" loading="lazy" />
        )}
        <div>
          <span class="wp-voice__name">{d.testimonial.name}</span>
          <span class="wp-voice__role">{d.testimonial.role}</span>
        </div>
      </div>
    </div>
  </section>
)}

{/* ── Next ─────────────────────────────────────────────────── */}
<section class="wp-next" id="next">
  <div class="wp-next__top" data-reveal>
    <div>
      <span class="wp-label wp-label--dark">Where it goes next</span>
      <span class="wp-next__note">{p.nextNote}</span>
    </div>
    <a class="wp-ghost" href="/contact-us/">
      <span>Start a project like this</span>
      <span class="wp-dots"><i></i><i class="on on--white"></i></span>
    </a>
  </div>
  {next && (
    <a class="wp-next__case" href={`/work/${next.slug}/`} rel="next" data-reveal>
      <div class="wp-next__copy">
        <div>
          <span class="wp-label wp-label--dark">Next case</span>
          <span class="wp-next__name">{next.client}</span>
        </div>
        <span class="wp-next__open">
          <span>Open case</span>
          <span class="wp-dots"><i></i><i class="on on--accent"></i></span>
        </span>
      </div>
      {nextImg && (
        <div class="wp-next__shot">
          <img src={nextImg} alt="" width="2400" height="1200" loading="lazy" />
        </div>
      )}
    </a>
  )}
</section>

<style>
  /* ── tokens, from DESIGN-NOTES.md and the artboard ───────────
     Scoped to this component so they cannot leak into the pages that still
     run the previous template. */
  .wp-cover,
  .wp-split,
  .wp-act,
  .wp-tall,
  .wp-next {
    --wp-gut: clamp(20px, 3vw, 39px);
    --wp-dark: linear-gradient(100deg, #0d0d0c 0%, #121110 46%, #17150e 78%, #0a0a0a 100%);
    --wp-accent: #ffd400;
    position: relative;
    padding-inline: var(--wp-gut);
  }

  .wp-label {
    font-size: 14px; font-weight: 600; letter-spacing: -0.06em; color: #919191;
  }
  .wp-label--dark { color: rgba(255, 255, 255, 0.55); }
  .wp-h2 {
    margin: 0; font-size: clamp(34px, 5vw, 72px); font-weight: 600;
    line-height: 1; letter-spacing: -0.05em; color: #242424;
  }
  .wp-h2--dark { color: #fbfbfb; }
  .wp-h2--sm { font-size: clamp(30px, 4.4vw, 62px); }
  .wp-kicker {
    font-size: 10px; font-weight: 600; letter-spacing: 0.14em; color: #919191;
  }
  .wp-tick { display: block; width: 15px; height: 2px; background: var(--wp-accent); }
  .wp-tick--wide { width: 38px; }
  .wp-dots { display: flex; gap: 3px; }
  .wp-dots i {
    width: 8px; height: 8px; border-radius: 50%; background: rgba(153, 152, 149, 0.6);
  }
  .wp-dots i.on { background: rgb(20, 20, 20); }
  .wp-dots i.on--white { background: #fff; }
  .wp-dots i.on--accent { background: var(--wp-accent); }

  /* ── cover ───────────────────────────────────────────────── */
  .wp-cover {
    overflow: hidden; background: #fff;
    display: flex; flex-direction: column; gap: clamp(26px, 4vh, 44px);
    padding-block: clamp(44px, 7vh, 76px) clamp(40px, 6vh, 72px);
  }
  /* The design draws this as bare 14px type, which measures 22px tall — under
     the 24px a finger needs and well under the 44px that is comfortable. The
     padding is vertical only and cancelled by an equal negative margin, so the
     link sits exactly where the artboard puts it and the target is 44px. */
  .wp-back {
    display: inline-flex; align-items: center; gap: 10px; align-self: flex-start;
    padding-block: 11px; margin-block: -11px;
    font-size: 14px; font-weight: 600; letter-spacing: -0.06em; color: #000;
  }
  .wp-head {
    display: flex; flex-wrap: wrap; align-items: flex-end; gap: clamp(24px, 4vw, 64px);
  }
  .wp-head__main {
    flex: 1 1 460px; min-width: 0;
    display: flex; flex-direction: column; gap: clamp(12px, 1.6vw, 18px);
  }
  .wp-pills { display: flex; flex-wrap: wrap; gap: 6px; }
  .wp-pills span {
    display: flex; align-items: center; height: 26px; padding: 0 12px;
    border-radius: 60px; box-shadow: inset 0 0 0 1px rgba(20, 20, 20, 0.16);
    font-size: 10px; font-weight: 600; letter-spacing: 0.12em; color: rgba(20, 20, 20, 0.7);
  }
  .wp-name {
    margin: 0; font-size: clamp(56px, 9vw, 124px); font-weight: 600;
    line-height: 0.9; letter-spacing: -0.05em; color: rgb(20, 20, 20);
  }
  .wp-line {
    margin: 0; max-width: 26ch; font-size: clamp(20px, 2.2vw, 26px); font-weight: 600;
    line-height: 1.42; letter-spacing: -0.04em; color: #000; text-wrap: pretty;
  }
  .wp-date { font-size: 16px; font-weight: 500; letter-spacing: -0.06em; color: #000; }
  .wp-team {
    flex: 0 0 auto; display: flex; align-items: center; gap: 14px; align-self: flex-end;
  }
  .wp-team__faces { display: flex; align-items: center; }
  .wp-team__faces img {
    width: 42px; height: 42px; border-radius: 60px; object-fit: cover;
    box-shadow: 0 0 0 2px #fff;
  }
  .wp-team__faces img + img { margin-left: -10px; }
  .wp-team__label {
    font-size: 15px; font-weight: 500; line-height: 21px; letter-spacing: -0.03em;
    color: rgb(20, 20, 20);
  }
  .wp-plate {
    position: relative; border-radius: 12px; overflow: hidden; background: rgb(30, 30, 30);
  }
  .wp-plate img { display: block; width: 100%; height: auto; }
  .wp-plate__scrim {
    position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(
      180deg, rgba(11, 11, 11, 0) 38%, rgba(11, 11, 11, 0.28) 74%, rgba(11, 11, 11, 0.6) 100%
    );
  }
  .wp-meta {
    display: flex; flex-wrap: wrap; gap: clamp(20px, 4vw, 68px);
    padding-top: clamp(18px, 3vh, 28px); border-top: 1.5px solid rgba(153, 152, 149, 0.7);
  }
  .wp-meta > div { display: flex; flex-direction: column; gap: 6px; min-width: 120px; }
  .wp-meta__k { font-size: 12px; font-weight: 500; letter-spacing: -0.06em; color: #919191; }
  .wp-meta__v {
    font-size: 16px; font-weight: 500; letter-spacing: -0.04em; color: rgb(20, 20, 20);
  }

  /* ── two-column acts: challenge, tech ────────────────────── */
  .wp-split {
    background: #fff; padding-block: clamp(76px, 14vh, 160px);
    display: flex; flex-wrap: wrap; gap: clamp(28px, 5vw, 88px);
  }
  .wp-split__rail { flex: 0 0 190px; display: flex; flex-direction: column; gap: 9px; }
  .wp-split__name {
    font-size: 19px; font-weight: 600; letter-spacing: -0.04em; color: #141414;
  }
  .wp-split__body {
    flex: 1 1 430px; min-width: 0;
    display: flex; flex-direction: column; gap: clamp(20px, 3vw, 34px);
  }
  .wp-split__lead {
    margin: 0; font-size: clamp(23px, 2.7vw, 36px); font-weight: 500;
    line-height: 1.32; letter-spacing: -0.04em; color: #141414; text-wrap: pretty;
  }
  .wp-split__lead--sm {
    max-width: 44ch; font-size: clamp(21px, 2.4vw, 32px); line-height: 1.34;
  }
  .wp-split__more {
    margin: 0; max-width: 60ch; font-size: 18px; font-weight: 500; line-height: 28px;
    letter-spacing: -0.03em; color: rgb(71, 71, 71); opacity: 0.85; text-wrap: pretty;
  }
  .wp-stack { display: flex; flex-direction: column; }
  .wp-stack > div {
    display: flex; flex-wrap: wrap; gap: 16px; align-items: baseline;
    padding: 18px 0; border-top: 1px solid rgba(20, 20, 20, 0.12);
  }
  .wp-stack__k {
    flex: 0 0 150px; font-size: 14px; font-weight: 600; letter-spacing: -0.02em; color: #141414;
  }
  .wp-stack__v {
    flex: 1 1 240px; min-width: 0; font-size: 15px; font-weight: 500; line-height: 1.55;
    letter-spacing: -0.03em; color: rgba(20, 20, 20, 0.68);
  }

  /* ── generic act shell ───────────────────────────────────── */
  .wp-act {
    overflow: hidden; padding-block: clamp(76px, 13vh, 150px);
    display: flex; flex-direction: column; gap: clamp(30px, 5vh, 58px);
  }
  .wp-act--grey { background: #f5f5f5; }
  .wp-act--dark { background: var(--wp-dark); }
  .wp-act__head {
    position: relative; display: flex; flex-wrap: wrap;
    align-items: flex-end; justify-content: space-between; gap: 22px;
  }
  .wp-act__head > div:first-child { display: flex; flex-direction: column; gap: 10px; }
  .wp-act__note {
    margin: 0; max-width: 32ch; font-size: 16px; font-weight: 500; line-height: 1.55;
    letter-spacing: -0.03em; color: rgba(20, 20, 20, 0.62);
  }

  /* ── groundwork ──────────────────────────────────────────── */
  .wp-wires {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: clamp(14px, 2vw, 26px);
  }
  .wp-wires figure { margin: 0; display: flex; flex-direction: column; gap: 14px; }
  .wp-wires__frame {
    border: 1px solid rgba(20, 20, 20, 0.1); background: #fff; padding: clamp(12px, 1.4vw, 20px);
  }
  .wp-wires__frame img { display: block; width: 100%; height: auto; filter: grayscale(1); }
  .wp-wires figcaption { display: flex; flex-direction: column; gap: 6px; }
  .wp-wires__note {
