---
/**
 * THE CASE-STUDY PRESENTATION, from `Roars v2 - Work Presentation.dc.html`.
 *
 * Built from the handoff the owner sent on 17 Sep. Every number in here — type
 * sizes, clamps, gutters, the ring-field pitches, the gradient stops — is the
 * design's own, transcribed rather than interpreted. Where this departs from
 * the artboard it is written down at the departure.
 *
 * THREE DEPARTURES, all deliberate:
 *
 *  1. NO CASE-SWITCHER RAIL. The design's dark strip carries a row of pills —
 *     Advisee, Concierges, Snowman … — that swap the case in place. That is how
 *     you review seven cases inside one document. On the site each case is its
 *     own URL with its own canonical, so the rail would be seven links to
 *     pages the reader is already one click from. Dropped on the owner's
 *     instruction, and it would have gone anyway.
 *
 *  2. THE HEADER AND FOOTER ARE OURS. The artboard redraws the Roars top strip
 *     and footer because a standalone document has to. This site already ships
 *     both as components that assert-styles and assert-overlap cover. Drawing
 *     them again here would be two copies of one design, diverging the first
 *     time anybody edits one.
 *
 *  3. "NEXT CASE" IS COMPUTED, NOT AUTHORED. The design hardcodes a chain —
 *     each case names the next. The site knows its own order, and which twelve
 *     projects are held back, so the neighbour comes from the same function
 *     prev/next already uses. A hardcoded chain would eventually point at a
 *     noindex page, which is the thing assert-held-back exists to stop.
 *
 * The rest is the design.
 */
import type { CollectionEntry } from 'astro:content'
import RingField from './RingField.astro'
import GrainField from './GrainField.astro'

interface Props {
  d: CollectionEntry<'projects'>['data']
  next?: { slug: string; client: string }
  nextImg?: string
  nextLine?: string
  faces: string[]
}
const { d, next, nextImg, nextLine, faces } = Astro.props
const p = d.presentation!

/* The act numbers run 01, 02, 03 … over the acts this case actually has, which
   is what makes an image-poor case read as complete rather than as one with
   gaps in its numbering. The design computes the same way. */
const hasChallenge = Boolean(p.challengeLead || p.challengeBody)
const hasBuild = Boolean(p.buildLead || p.stack.length)
const hasOutcome = Boolean(p.outcomeLead || p.outcomes.length)
let step = 0
const idx = () => String(++step).padStart(2, '0')
const challengeIndex = hasChallenge ? idx() : null
const wiresIndex = p.wires.length ? idx() : null
const systemIndex = p.artifacts.length ? idx() : null
const screensIndex = p.screens.length ? idx() : null
const buildIndex = hasBuild ? idx() : null
const outcomeIndex = hasOutcome ? idx() : null

/* Four plinth grounds, cycled. Two white, one navy, one tinted — so a logo on
   white and a colour ramp on navy both sit on something that suits them. */
const PLINTHS = ['p0', 'p1', 'p2', 'p3']

/* THE COVER FALLS BACK TO THE PROJECT'S OWN HEADER PHOTOGRAPH.
   The design draws a striped "COVER IMAGE — TO BE SUPPLIED" plate when a case
   has none, which is the right thing inside a design document and the wrong
   thing on a live page — it tells a visitor we did not finish. Two of the seven
   have no plate in the handoff: FlowRow's names a file that is in neither the
   client folder nor the WordPress export, and the President's Club never had
   one. Both already have a header photograph, the same file /work/ puts on
   their card, so the page shows that instead. It is a photograph, so it takes
   the scrim.

   The design's striped placeholder is NOT built. It is the right thing inside
   a design document and the wrong thing on a live page — it tells a visitor we
   did not finish. With the header photograph as the fallback there is no case
   that reaches it anyway: all twenty-four projects have one, which assert-styles
   confirmed by reporting the rule as matching nothing. A project with neither
   simply opens without a plate. */
/* THE FACTS RAIL, out of what the project already says about itself.
 *
 * `presentation.meta` is an authored k/v list and it is the only place these
 * facts exist. The brief asks for Client, Services, Year and Platform, so
 * those four lead, in that order, mapped onto the keys that hold them:
 *
 *   Client    meta.CLIENT      all eleven
 *   Services  meta.SCOPE       all eleven
 *   Year      from dateLabel   all eleven
 *   Platform  meta.PLATFORM    TWO: GymBait and The President's Club
 *
 * Nothing is invented and nothing is relabelled to fill a row. The nine
 * projects with no PLATFORM key simply have no Platform line. SURFACES is not
 * pressed into that slot: it names which screens were built, which is a
 * different fact from which platform they run on.
 *
 * The keys a project carries beyond those four -- SECTOR on ten of eleven,
 * MARKET on GymBait -- follow underneath in their authored order rather than
 * being dropped, because they are facts somebody wrote about that project.
 *
 * YEAR is the one derived value: the four digits out of dateLabel, which is
 * the same date the head prints in full. It is a reformat of existing data,
 * not a new claim, and a label with no year in it yields no row.
 */
const CANON = [
  ['Client', 'CLIENT'],
  ['Services', 'SCOPE'],
] as const
const metaBy = new Map(p.meta.map((m) => [m.k.toUpperCase(), m.v]))
const year = d.dateLabel?.match(/\b(19|20)\d{2}\b/)?.[0]

const facts: { k: string; v: string }[] = []
for (const [label, key] of CANON) {
  const v = metaBy.get(key)
  if (v) facts.push({ k: label, v })
}
if (year) facts.push({ k: 'Year', v: year })
const platform = metaBy.get('PLATFORM')
if (platform) facts.push({ k: 'Platform', v: platform })

/* Whatever else the project authored, in its own order, minus the four above. */
const USED = new Set(['CLIENT', 'SCOPE', 'PLATFORM'])
for (const m of p.meta) {
  if (!USED.has(m.k.toUpperCase())) facts.push({ k: m.k, v: m.v })
}

const cover = p.coverPlate ?? (d.heroImage ? { src: d.heroImage, alt: '', w: 2400, h: 1200 } : undefined)
const coverIsPhoto = p.coverPlate ? p.coverIsPhoto : true
---

{/* ── The dark strip the page opens on ─────────────────────────
    The design's top band: the gradient, the yellow glow bleeding off the left,
    and the site header sitting over it. Only the row of case pills is gone.
    `data-ground="dark"` is what src/scripts/topbar.ts reads to put the bar in
    its light ink, which is why the logo comes back yellow and the hamburger
    white instead of the black-on-white it had with no band under it. */}
<div class="wp-strip" data-ground="dark" aria-hidden="true">
  <span class="wp-strip__glow"></span>
</div>

{/* ── 01 Cover ─────────────────────────────────────────────── */}
<section class="wp-cover" id="cover">
  <a class="wp-back" href="/work/" data-reveal>
    <span>See all Projects</span>
    <span class="wp-dots"><i></i><i class="on"></i></span>
  </a>

  {/* TWO COLUMNS, because the right half of this band was empty on ten of the
      eleven cases. It held the team faces, and only Snowman has a team list,
      so every other case opened on a title, a line of summary and a void as
      wide again. The facts were already on the page -- they sat under the
      cover as a row of labels nobody had a reason to reach. Moving them up
      fills the space with the thing a reader actually wants at this point:
      who it was for, what we did, when. They stack under the summary below
      880px, which is where the two columns stop fitting. */}
  <div class="wp-head" data-reveal>
    <div class="wp-head__main">
      {p.constraints.length > 0 && (
        <ul class="wp-tags">
          {p.constraints.map((c) => <li>{c}</li>)}
        </ul>
      )}
      <h1 class="wp-name">{d.headline ?? d.client}</h1>
      <p class="wp-line">{p.line}</p>
      {d.dateLabel && <span class="wp-date">{d.dateLabel}</span>}
    </div>

    {(facts.length > 0 || faces.length > 0) && (
      <div class="wp-head__aside">
        {facts.length > 0 && (
          <dl class="wp-facts">
            {facts.map((f) => (
              <div class="wp-facts__row">
                <dt>{f.k}</dt>
                <dd>{f.v}</dd>
              </div>
            ))}
          </dl>
        )}
        {faces.length > 0 && (
          <div class="wp-team">
            <div class="wp-team__faces">
              {faces.map((f) => <img src={f} alt="" width="42" height="42" loading="lazy" />)}
            </div>
            <span class="wp-team__label">Team Members<br />Involved</span>
          </div>
        )}
      </div>
    )}
  </div>

  {cover && (
    <div class="wp-plate wp-bleed" data-reveal>
      <img
        src={cover.src}
        alt={cover.alt}
        width={cover.w}
        height={cover.h}
        loading="lazy"
        decoding="async"
      />
      {/* A photograph gets a scrim, a screenshot does not. The design's rule:
          rings and gradients go ON photographs and BEHIND screenshots. */}
      {coverIsPhoto && <div class="wp-plate__scrim" aria-hidden="true"></div>}
    </div>
  )}

</section>

{/* ── The Challenge ────────────────────────────────────────── */}
{hasChallenge && (
  <section class="wp-split" id="challenge">
    <div class="wp-split__rail" data-reveal>
      <span class="wp-label">{challengeIndex} &mdash; The Challenge</span>
      <span class="wp-split__name">What we were handed</span>
    </div>
    <div class="wp-split__body">
      {p.challengeLead && <p class="wp-split__lead" data-reveal>{p.challengeLead}</p>}
      {p.challengeBody && <p class="wp-split__more" data-reveal>{p.challengeBody}</p>}
    </div>
  </section>
)}

{/* ── Groundwork ───────────────────────────────────────────── */}
{p.wires.length > 0 && (
  <section class="wp-act wp-act--grey" id="groundwork">
    <div class="wp-act__head" data-reveal>
      <div>
        <span class="wp-label">{wiresIndex} &mdash; Groundwork</span>
        <h2 class="wp-h2">Structure before surface</h2>
      </div>
      <p class="wp-act__note">
        Every flow was argued in grey first. Nothing went to visual design until the
        journey held up.
      </p>
    </div>
    <div class="wp-wires">
      {p.wires.map((w) => (
        <figure data-reveal>
          <div class="wp-wires__frame">
            <img src={w.img.src} alt={w.img.alt} width={w.img.w} height={w.img.h} loading="lazy" />
          </div>
          <figcaption>
            <span class="wp-kicker">{w.label}</span>
            <span class="wp-wires__note">{w.note}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>
)}

{/* ── Design system ────────────────────────────────────────── */}
{p.artifacts.length > 0 && (
  <section class="wp-act wp-act--grey" id="system">
    <div class="wp-act__head" data-reveal>
      <div>
        <span class="wp-label">{systemIndex} &mdash; Design System</span>
        <h2 class="wp-h2">The kit of parts</h2>
      </div>
      <p class="wp-act__note">
        The decisions taken before a single screen was drawn. Everything after this is
        assembly.
      </p>
    </div>
    <div class="wp-arts">
      {p.artifacts.map((a, i) => (
        <div data-reveal>
          <div class:list={['wp-arts__plinth', `wp-arts__plinth--${PLINTHS[i % PLINTHS.length]}`]}>
            <img src={a.img.src} alt={a.img.alt} width={a.img.w} height={a.img.h} loading="lazy" />
          </div>
          <div class="wp-arts__cap">
            <div class="wp-arts__name"><span class="wp-tick"></span>{a.label}</div>
            <span class="wp-arts__note">{a.note}</span>
          </div>
        </div>
      ))}
    </div>
  </section>
)}

{/* ── What shipped ─────────────────────────────────────────── */}
{p.screens.length > 0 && (
  <section class="wp-act wp-act--dark wp-reel" id="screens">
    <RingField />
    <div class="wp-act__head" data-reveal>
      <div>
        <span class="wp-label wp-label--dark">{screensIndex} &mdash; What shipped</span>
        <h2 class="wp-h2 wp-h2--dark">One screen, one decision</h2>
      </div>
      <div class="wp-reel__ctrl">
        <span class="wp-reel__count" data-reel-count>
          01 / {String(p.screens.length).padStart(2, '0')}
        </span>
        <div>
          <button type="button" data-reel-prev aria-label="Previous screen">&lsaquo;</button>
          <button type="button" data-reel-next aria-label="Next screen">&rsaquo;</button>
        </div>
      </div>
    </div>
    <div class="wp-reel__body">
      <div class="wp-reel__stage">
        {p.screens.map((s, i) => (
          <figure data-reel-slide={i} class={i === 0 ? 'is-on' : undefined}>
            <img
              src={s.img.src}
              alt={s.img.alt}
              width={s.img.w}
              height={s.img.h}
              loading={i === 0 ? 'eager' : 'lazy'}
              decoding="async"
            />
          </figure>
        ))}
      </div>
      <div class="wp-reel__side">
        {p.screens.map((s, i) => (
          <div class="wp-reel__copy" data-reel-copy={i} hidden={i !== 0}>
            <span class="wp-reel__kicker">{s.kicker}</span>
            <span class="wp-reel__title">{s.title}</span>
            <span class="wp-reel__note">{s.note}</span>
          </div>
        ))}
        <div class="wp-reel__list">
          {p.screens.map((s, i) => (
            <button type="button" data-reel-pick={i} class={i === 0 ? 'is-on' : undefined}>
              <span class="wp-reel__n">{String(i + 1).padStart(2, '0')}</span>
              <span>{s.title}</span>
            </button>
          ))}
        </div>
      </div>
    </div>
  </section>
)}

{/* ── Full page ────────────────────────────────────────────── */}
{p.tall && (
  <section class="wp-tall" id="depth">
    <div class="wp-tall__rail" data-reveal>
      <span class="wp-label">Full page</span>
      <span class="wp-tall__title">{p.tallTitle}</span>
      <span class="wp-tall__note">{p.tallNote}</span>
    </div>
    <div class:list={['wp-tall__scroll', p.tallFullBleed && 'wp-bleed']} data-reveal>
      <img src={p.tall.src} alt={p.tall.alt} width={p.tall.w} height={p.tall.h} loading="lazy" />
    </div>
  </section>
)}

{/* ── In the hand ──────────────────────────────────────────── */}
{p.mobile.length > 0 && (
  <section class="wp-act wp-act--dark wp-hand" id="mobile">
    {/* NOT WHEN THE REEL IS DIRECTLY ABOVE. Both acts are the same dark
        gradient with the same ring field, so back to back they read as one
        very long band with a seam through it — Parqly and Snowman have no
        tall plate between them and showed exactly that. Where a white act
        does separate them, the rings stay on both. */}
    {!(p.screens.length > 0 && !p.tall) && <RingField />}
    <div class="wp-hand__head" data-reveal>
      <span class="wp-label wp-label--dark">In the hand</span>
      <h2 class="wp-h2 wp-h2--dark wp-h2--sm">{p.mobileTitle ?? 'Built for the phone first'}</h2>
    </div>
    <div class="wp-hand__grid">
      {p.mobile.map((m) => (
        <figure data-reveal>
          <div class="wp-hand__frame" style={`aspect-ratio:${p.mobileRatio ?? '16/10'}`}>
            <img src={m.img.src} alt={m.img.alt} width={m.img.w} height={m.img.h} loading="lazy" />
          </div>
          <figcaption>{m.label}</figcaption>
        </figure>
      ))}
    </div>
  </section>
)}

{/* ── Tech & architecture ──────────────────────────────────── */}
{hasBuild && (
<section class="wp-split" id="build">
  <div class="wp-split__rail" data-reveal>
    <span class="wp-label">{buildIndex} &mdash; How it runs</span>
    <span class="wp-split__name">Tech &amp; architecture</span>
  </div>
  <div class="wp-split__body">
    {p.buildLead && <p class="wp-split__lead wp-split__lead--sm" data-reveal>{p.buildLead}</p>}
    <div class="wp-stack">
      {p.stack.map((s) => (
        <div data-reveal><span class="wp-stack__k">{s.k}</span><span class="wp-stack__v">{s.v}</span></div>
      ))}
    </div>
  </div>
</section>
)}

{/* ── Outcomes ─────────────────────────────────────────────── */}
{hasOutcome && (
<section class="wp-act wp-act--grey wp-out" id="outcome">
  <div class="wp-out__head" data-reveal>
    <span class="wp-label">{outcomeIndex} &mdash; Outcomes</span>
    {p.outcomeLead && <h2 class="wp-h2">{p.outcomeLead}</h2>}
  </div>
  <div class="wp-out__grid">
    {p.outcomes.map((o) => (
      <div data-reveal><span class="wp-out__big">{o.big}</span><span class="wp-out__label">{o.label}</span></div>
    ))}
  </div>
</section>
)}

{/* ── Client ───────────────────────────────────────────────── */}
{/* GREY, not the dark gradient. On the dark it made three grounds in a row at
    the end of the page — dark quote, yellow band, dark next case — and the
    yellow read as a stripe cut through rather than a place to land. On the
    light grey it belongs to the Outcomes act above it, and the yellow band
    below becomes the one change of ground at the end. A hairline separates the
    two greys so they do not merge into one long panel. */}
{d.testimonial && (
  <section class="wp-act wp-act--grey wp-voice" id="voice">
    <div data-reveal>
      <span class="wp-tick wp-tick--wide"></span>
      <blockquote>{d.testimonial.quote}</blockquote>
      <div class="wp-voice__who">
        {d.testimonial.portrait && (
          <img src={d.testimonial.portrait} alt={d.testimonial.name} width="64" height="64" loading="lazy" />
        )}
        <div>
          <span class="wp-voice__name">{d.testimonial.name}</span>
          <span class="wp-voice__role">{d.testimonial.role}</span>
        </div>
      </div>
    </div>
  </section>
)}

{/* ── Next ─────────────────────────────────────────────────── */}
<section class="wp-next" id="next">
  {/* THE YELLOW BAND SITS HERE, not under the next case.
      This is the one call to action on the page — "where it goes next" and the
      way to start one — and on the dark ground it was the quietest thing in the
      act, under an 84px client name. The homepage hero's gradient is the site's
      loudest ground and it is used exactly where something has to be taken up.
      The next-case plate below stays black: a yellow ground there would fight
      the accent that marks "Open case", and the accent only works because it is
      rare. */}
  {/* ALWAYS. This band is the one call to action on the page, and it was tied
      to `nextNote` — so GISAID, which has no record of what comes next, lost
      the "start a project" button along with the sentence. The sentence is the
      optional part; the ask is not. */}
  <div class="wp-next__top" data-reveal>
    <GrainField tone="yellow" />
    <div class="wp-next__top-in">
      <div>
        <span class="wp-label wp-label--sun">{p.nextNote ? 'Where it goes next' : 'Start here'}</span>
        <span class="wp-next__note wp-next__note--sun">
          {p.nextNote ?? 'Tell us what you are building. We will come back with what it takes and what it costs.'}
        </span>
      </div>
      <a class="wp-ghost wp-ghost--sun" href="/contact-us/">
        <span>Start a project like this</span>
        <span class="wp-dots"><i></i><i class="on"></i></span>
      </a>
    </div>
  </div>
  {next && (
    <a class="wp-next__case" href={`/work/${next.slug}/`} rel="next" data-reveal>
      <div class="wp-next__copy">
        <div>
          <span class="wp-label wp-label--dark">Next case</span>
          <span class="wp-next__name">{next.client}</span>
          {nextLine && <span class="wp-next__line">{nextLine}</span>}
        </div>
        <span class="wp-next__open">
          <span>Open case</span>
          <span class="wp-dots"><i></i><i class="on on--accent"></i></span>
        </span>
      </div>
      {nextImg && (
        <div class="wp-next__shot">
          <img src={nextImg} alt="" width="2400" height="1200" loading="lazy" />
          <span class="wp-next__rings" aria-hidden="true"></span>
        </div>
      )}
    </a>
  )}
</section>

<style>
  /* ── tokens, from DESIGN-NOTES.md and the artboard ───────────
     Scoped to this component so they cannot leak into the pages that still
     run the previous template. */
  .wp-strip,
  .wp-cover,
  .wp-split,
  .wp-act,
  .wp-tall,
  .wp-next {
    /* THE SAME LEFT EDGE AS THE HEADER, AND NOT BY COINCIDENCE.
       This was `clamp(20px, 3vw, 39px)` with no cap, which is a gutter and not
       a container. TopBar sits in .wrap, which is 1362px of content centred
       inside a 39px gutter, so the two agreed only up to 1440 and then walked
       apart: at 1920 the logo started at 279 and the case study's title at 39,
       224px to its left. They also drifted 5px at 768, where 3vw is 23 and the
       page gutter is 28.

       So the padding does the centring itself, out of .wrap's own two tokens.
       Below 1362 + 2 gutters the second term is negative and the gutter wins;
       above it, the padding grows to hold the content at --content-max. Every
       width now lands on .wrap's left edge to the pixel, and it stays that way
       if either token is ever changed, because there is no second copy of the
       number here to fall out of date.

       The sections stay full-width so their grounds still bleed; it is only
       what is inside them that is held to the container. */
    --wp-gut: max(var(--page-gutter), calc((100% - var(--content-max)) / 2));
    --wp-dark: linear-gradient(100deg, #0d0d0c 0%, #121110 46%, #17150e 78%, #0a0a0a 100%);
    --wp-accent: #ffd400;
    position: relative;
    padding-inline: var(--wp-gut);
  }
  .wp-strip { padding-inline: 0; }

  /* FULL BLEED, out of the container and back to both viewport edges.
     THE VW IS DELIBERATE, and it is the one place on this page that uses one.

     `margin-inline: calc(-1 * var(--wp-gut))` is the obvious way to write this
     and it is wrong, which cost a measurement to find: --wp-gut holds a
     percentage, and a percentage in a custom property is resolved where it is
     USED, not where it is declared. On the section it resolves against the
     viewport and gives 279 at 1920; on a child inside that section it resolves
     against the 1362px content box and gives 39. The plate came back 240px
     short at each edge and looked, plausibly, like a container that was simply
     too narrow.

     So the bleed computes its own pull from 100vw, which does not depend on
     the box it is written in. The two expressions differ on purpose: the
     padding uses 100% because that is what keeps this page on the header's
     left edge when a scrollbar narrows the viewport, and the bleed uses 100vw
     because that is what reaches the actual edge of the glass. Where a
     classic scrollbar exists the two disagree by its width, so the plate
     overshoots by half of it at each side -- symmetric, invisible, and clipped
     by the section rather than scrolled to. */
  .wp-bleed {
    margin-inline: calc(-1 * max(var(--page-gutter), (100vw - var(--content-max)) / 2));
    border-radius: 0;
  }
  /* The clip that makes the overshoot above a non-event. .wp-cover already had
     it; .wp-tall is the other section a bleed can appear in. `clip`, not
     `hidden`: hidden on one axis forces the other to `auto` and would make
     this a scroll container, which steals the sticky rail's containing block
     and lands a focus ring inside a box nobody can scroll. */
  .wp-tall { overflow-x: clip; }

  /* The strip has to CLEAR the header, not approximate it. Sized at the 42px
     pill alone it ended 19px short, so the bar's second line — "Reach out to
     start your project" — was white type on the white cover below and simply
     vanished. The design's column is the 42px pill, a 14px gap and that 20px
     line, inside its own top and bottom padding. */
  .wp-strip {
    position: relative; overflow: hidden;
    height: calc(clamp(28px, 4vh, 38px) + 76px + clamp(34px, 5vh, 44px));
    background: linear-gradient(100deg, #0d0d0c 0%, #121110 46%, #17150e 78%, #0a0a0a 100%);
  }
  .wp-strip__glow {
    position: absolute; left: 8%; top: -120%; width: 56%; height: 260%;
    border-radius: 50%; pointer-events: none;
    background: radial-gradient(circle, rgba(255, 212, 0, 0.16) 0%, rgba(255, 212, 0, 0) 62%);
  }

  .wp-label {
    font-size: 14px; font-weight: 600; letter-spacing: -0.06em; color: #919191;
  }
  .wp-label--dark { color: rgba(255, 255, 255, 0.55); }
  .wp-h2 {
    margin: 0; font-size: clamp(34px, 5vw, 72px); font-weight: 600;
    line-height: 1; letter-spacing: -0.05em; color: #242424;
  }
  .wp-h2--dark { color: #fbfbfb; }
  .wp-h2--sm { font-size: clamp(30px, 4.4vw, 62px); }
  .wp-kicker {
    font-size: 10px; font-weight: 600; letter-spacing: 0.14em; color: #919191;
  }
  .wp-tick { display: block; width: 15px; height: 2px; background: var(--wp-accent); }
  .wp-tick--wide { width: 38px; }
  .wp-dots { display: flex; gap: 3px; }
  .wp-dots i {
    width: 8px; height: 8px; border-radius: 50%; background: rgba(153, 152, 149, 0.6);
  }
  .wp-dots i.on { background: rgb(20, 20, 20); }
  .wp-dots i.on--accent { background: var(--wp-accent); }

  /* SQUARE CORNERS ON EVERY PICTURE ON THIS PAGE. The design rounds each
     frame at 12px; at the sizes these run, a 12px radius is not a shape, it is
     a softening you notice only as a slight lack of edge. The round things
     left here are the ones that are meant to be round: 50% dots and 60px
     avatars. ── cover ───────────────────────────────────────────── */
  .wp-cover {
    overflow: hidden; background: #fff;
    display: flex; flex-direction: column; gap: clamp(26px, 4vh, 44px);
    padding-block: clamp(44px, 7vh, 76px) clamp(40px, 6vh, 72px);
  }
  /* The design draws this as bare 14px type, which measures 22px tall — under
     the 24px a finger needs and well under the 44px that is comfortable. The
     padding is vertical only and cancelled by an equal negative margin, so the
     link sits exactly where the artboard puts it and the target is 44px. */
  .wp-back {
    display: inline-flex; align-items: center; gap: 10px; align-self: flex-start;
    padding-block: 11px; margin-block: -11px;
    font-size: 14px; font-weight: 600; letter-spacing: -0.06em; color: #000;
  }
  .wp-head {
    display: flex; flex-wrap: wrap; align-items: flex-end; gap: clamp(24px, 4vw, 64px);
  }
  .wp-head__main {
    flex: 1 1 460px; min-width: 0;
    display: flex; flex-direction: column; gap: clamp(12px, 1.6vw, 18px);
  }
  /* The right column. flex-basis 300 with the main column's 460 means the two
     sit side by side from about 880px up and wrap below it, which is the width
     at which the facts stop having room to be a column rather than a squeeze. */
  .wp-head__aside {
    flex: 1 1 300px; max-width: 420px; min-width: 0;
    display: flex; flex-direction: column; gap: clamp(20px, 3vh, 32px);
  }

  /* TAGS AS TYPE, NOT AS PILLS. They were 26px capsules with a 1px ring, which
     reads as a control -- something to press -- for a row of words that does
     nothing. Uppercase labels with a hairline between them say the same thing
     and stop pretending to be buttons. 12px is the floor for this, up from the
     10px the pills used, because at 0.12em tracking 10px stops being readable
     before it stops being legible. */
  .wp-tags {
    display: flex; flex-wrap: wrap; align-items: center;
    gap: 0 14px; margin: 0; padding: 0; list-style: none;
  }
  .wp-tags li {
    display: flex; align-items: center; gap: 14px;
    font-size: 12px; font-weight: 600; letter-spacing: 0.12em;
    text-transform: uppercase; color: rgba(20, 20, 20, 0.72);
  }
  /* The rule belongs to the item BEFORE it, not the one after.
     Written the other way -- a ::before on `li + li` -- a row that wraps opens
     its second line with a divider and no tag to its left, which reads as a
     missing word. On this side the stray rule lands at the END of the wrapped
     line instead, where it reads as "continues below". Neither is perfect;
     that one is the one a reader forgives. */
  .wp-tags li:not(:last-child)::after {
    content: ''; width: 1px; height: 11px; background: rgba(20, 20, 20, 0.28);
  }

  /* THE FACTS RAIL. Label over value, hairline between rows, nothing else --
     no card, no ground, no shadow. The line is the same ink as the rules in
     the rest of this page. */
  .wp-facts { margin: 0; display: flex; flex-direction: column; }
  .wp-facts__row {
    display: flex; flex-direction: column; gap: 4px;
    padding-block: 13px; border-top: 1px solid rgba(20, 20, 20, 0.16);
  }
  .wp-facts__row:last-child { border-bottom: 1px solid rgba(20, 20, 20, 0.16); }
  .wp-facts dt {
    font-size: 11px; font-weight: 600; letter-spacing: 0.14em;
    text-transform: uppercase; color: rgba(20, 20, 20, 0.5);
  }
  .wp-facts dd {
    margin: 0; font-size: 16px; font-weight: 500; line-height: 1.45;
    letter-spacing: -0.03em; color: rgb(20, 20, 20); text-wrap: pretty;
  }
  .wp-name {
    margin: 0; font-size: clamp(56px, 9vw, 124px); font-weight: 600;
    line-height: 0.9; letter-spacing: -0.05em; color: rgb(20, 20, 20);
  }
  .wp-line {
    margin: 0; max-width: 26ch; font-size: clamp(20px, 2.2vw, 26px); font-weight: 600;
    line-height: 1.42; letter-spacing: -0.04em; color: #000; text-wrap: pretty;
  }
  .wp-date { font-size: 16px; font-weight: 500; letter-spacing: -0.06em; color: #000; }
  .wp-team { display: flex; align-items: center; gap: 14px; }
  .wp-team__faces { display: flex; align-items: center; }
  .wp-team__faces img {
    width: 42px; height: 42px; border-radius: 60px; object-fit: cover;
    box-shadow: 0 0 0 2px #fff;
  }
  .wp-team__faces img + img { margin-left: -10px; }
  .wp-team__label {
    font-size: 15px; font-weight: 500; line-height: 21px; letter-spacing: -0.03em;
    color: rgb(20, 20, 20);
  }
  /* Square, and edge to edge. .wp-bleed cancels the container padding; the
     radius went with the rounded corners on every other shot on this page. */
  .wp-plate {
    position: relative; overflow: hidden; background: rgb(30, 30, 30);
  }
  .wp-plate img { display: block; width: 100%; height: auto; }
  .wp-plate__scrim {
    position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(
      180deg, rgba(11, 11, 11, 0) 38%, rgba(11, 11, 11, 0.28) 74%, rgba(11, 11, 11, 0.6) 100%
    );
  }
  /* ── two-column acts: challenge, tech ────────────────────── */
  .wp-split {
    background: #fff; padding-block: clamp(76px, 14vh, 160px);
    display: flex; flex-wrap: wrap; gap: clamp(28px, 5vw, 88px);
  }
  .wp-split__rail { flex: 0 0 190px; display: flex; flex-direction: column; gap: 9px; }
  .wp-split__name {
    font-size: 19px; font-weight: 600; letter-spacing: -0.04em; color: #141414;
  }
  .wp-split__body {
    flex: 1 1 430px; min-width: 0;
    display: flex; flex-direction: column; gap: clamp(20px, 3vw, 34px);
  }
  .wp-split__lead {
    margin: 0; font-size: clamp(23px, 2.7vw, 36px); font-weight: 500;
    line-height: 1.32; letter-spacing: -0.04em; color: #141414; text-wrap: pretty;
  }
  .wp-split__lead--sm {
    max-width: 44ch; font-size: clamp(21px, 2.4vw, 32px); line-height: 1.34;
  }
  .wp-split__more {
    margin: 0; max-width: 60ch; font-size: 18px; font-weight: 500; line-height: 28px;
    letter-spacing: -0.03em; color: rgb(71, 71, 71); opacity: 0.85; text-wrap: pretty;
  }
  .wp-stack { display: flex; flex-direction: column; }
  .wp-stack > div {
    display: flex; flex-wrap: wrap; gap: 16px; align-items: baseline;
    padding: 18px 0; border-top: 1px solid rgba(20, 20, 20, 0.12);
  }
  .wp-stack__k {
    flex: 0 0 150px; font-size: 14px; font-weight: 600; letter-spacing: -0.02em; color: #141414;
  }
  .wp-stack__v {
    flex: 1 1 240px; min-width: 0; font-size: 15px; font-weight: 500; line-height: 1.55;
    letter-spacing: -0.03em; color: rgba(20, 20, 20, 0.68);
  }

  /* ── generic act shell ───────────────────────────────────── */
  .wp-act {
    overflow: hidden; padding-block: clamp(76px, 13vh, 150px);
    display: flex; flex-direction: column; gap: clamp(30px, 5vh, 58px);
  }
  .wp-act--grey { background: #f5f5f5; }
  .wp-act--dark { background: var(--wp-dark); }
  .wp-act__head {
    position: relative; display: flex; flex-wrap: wrap;
    align-items: flex-end; justify-content: space-between; gap: 22px;
  }
  .wp-act__head > div:first-child { display: flex; flex-direction: column; gap: 10px; }
  .wp-act__note {
    margin: 0; max-width: 32ch; font-size: 16px; font-weight: 500; line-height: 1.55;
    letter-spacing: -0.03em; color: rgba(20, 20, 20, 0.62);
  }

  /* ── groundwork ──────────────────────────────────────────── */
  .wp-wires {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: clamp(14px, 2vw, 26px);
  }
  .wp-wires figure { margin: 0; display: flex; flex-direction: column; gap: 14px; }
  .wp-wires__frame {
    border: 1px solid rgba(20, 20, 20, 0.1); background: #fff; padding: clamp(12px, 1.4vw, 20px);
  }
  .wp-wires__frame img { display: block; width: 100%; height: auto; filter: grayscale(1); }
  .wp-wires figcaption { display: flex; flex-direction: column; gap: 6px; }
  .wp-wires__note {
    font-size: 15px; font-weight: 500; line-height: 1.5; letter-spacing: -0.03em;
    color: rgba(20, 20, 20, 0.78); text-wrap: pretty;
  }

  /* ── design system ───────────────────────────────────────── */
  .wp-arts {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: clamp(14px, 1.8vw, 24px);
  }
  .wp-arts > div { display: flex; flex-direction: column; gap: 15px; }
  .wp-arts__plinth {
    display: flex; align-items: center; justify-content: center;
    padding: clamp(18px, 2vw, 30px); aspect-ratio: 4 / 3; overflow: hidden;
    border: 1px solid rgba(20, 20, 20, 0.08);
  }
  .wp-arts__plinth img {
    display: block; max-width: 100%; max-height: 100%; width: auto; height: auto;
    object-fit: contain;
  }
  .wp-arts__plinth--p0, .wp-arts__plinth--p2 { background: #fff; }
  .wp-arts__plinth--p1 { background: #0b2e5e; }
  .wp-arts__plinth--p3 { background: #eef4fb; }
  .wp-arts__cap { display: flex; flex-direction: column; gap: 7px; }
  .wp-arts__name {
    display: flex; align-items: center; gap: 10px;
    font-size: 14px; font-weight: 600; letter-spacing: -0.02em; color: #141414;
  }
  .wp-arts__note {
    font-size: 14px; font-weight: 500; line-height: 1.55; letter-spacing: -0.02em;
    color: rgba(20, 20, 20, 0.6); text-wrap: pretty;
  }

  /* ── what shipped: the reel ──────────────────────────────── */
  .wp-reel { min-height: 100vh; gap: clamp(26px, 4vh, 44px); }
  .wp-reel__ctrl { display: flex; align-items: center; gap: 18px; }
  .wp-reel__count {
    font-size: 13px; font-weight: 600; letter-spacing: 0.08em; color: rgba(255, 255, 255, 0.55);
  }
  .wp-reel__ctrl > div { display: flex; gap: 10px; }
  .wp-reel__ctrl button {
    width: 46px; height: 46px; border-radius: 60px; border: 0;
    background: rgba(255, 255, 255, 0.1); color: #fff; font-size: 17px; cursor: pointer;
    transition: background var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
  }
  .wp-reel__ctrl button:hover,
  .wp-reel__ctrl button:focus-visible { background: var(--wp-accent); color: #000; }
  .wp-reel__body {
    position: relative; display: flex; flex-wrap: wrap;
    gap: clamp(22px, 3vw, 48px); align-items: flex-start;
  }
  .wp-reel__stage {
    position: relative; flex: 1 1 560px; min-width: 0;
    overflow: hidden; background: #141414;
    box-shadow: 0 40px 90px rgba(0, 0, 0, 0.6);
  }
  /* Every slide is in the document — the reader can be on any of them, and a
     stack that swaps `hidden` keeps the stage height honest for the tallest. */
  .wp-reel__stage figure { margin: 0; display: none; }
  .wp-reel__stage figure.is-on { display: block; }
  .wp-reel__stage img { display: block; width: 100%; height: auto; }
  .wp-reel__side {
    flex: 0 1 300px; min-width: 0; display: flex; flex-direction: column;
    gap: clamp(20px, 3vh, 32px);
  }
  .wp-reel__copy { display: flex; flex-direction: column; gap: 12px; }
  .wp-reel__copy[hidden] { display: none; }
  .wp-reel__kicker {
    font-size: 11px; font-weight: 600; letter-spacing: 0.14em; color: var(--wp-accent);
  }
  .wp-reel__title {
    font-size: clamp(22px, 2.4vw, 30px); font-weight: 600; line-height: 1.16;
    letter-spacing: -0.04em; color: #fbfbfb; text-wrap: pretty;
  }
  .wp-reel__note {
    font-size: 16px; font-weight: 500; line-height: 1.6; letter-spacing: -0.03em;
    color: rgba(255, 255, 255, 0.66); text-wrap: pretty;
  }
  .wp-reel__list { display: flex; flex-direction: column; gap: 2px; }
  .wp-reel__list button {
    display: flex; align-items: baseline; gap: 14px; width: 100%; padding: 13px 0;
    border: 0; border-top: 1px solid rgba(255, 255, 255, 0.12); background: transparent;
    font: inherit; font-size: 14px; font-weight: 500; letter-spacing: -0.03em;
    cursor: pointer; text-align: left; color: rgba(255, 255, 255, 0.55);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .wp-reel__list button.is-on { color: var(--wp-accent); }
  .wp-reel__list button > span:last-child { text-align: left; flex: 1; }
  .wp-reel__n { font-size: 10px; font-weight: 600; letter-spacing: 0.1em; opacity: 0.6; }
  .wp-reel__list button.is-on .wp-reel__n { opacity: 1; }

  /* ── full page ───────────────────────────────────────────── */
  .wp-tall {
    background: #fff; padding-block: clamp(76px, 13vh, 140px);
    display: flex; flex-wrap: wrap; gap: clamp(26px, 4vw, 64px); align-items: flex-start;
  }
  .wp-tall__rail {
    flex: 1 1 280px; min-width: 0; display: flex; flex-direction: column; gap: 16px;
    position: sticky; top: 110px;
  }
  .wp-tall__title {
    font-size: clamp(26px, 3vw, 42px); font-weight: 600; line-height: 1.14;
    letter-spacing: -0.05em; color: #242424; text-wrap: pretty;
  }
  .wp-tall__note {
    max-width: 36ch; font-size: 18px; font-weight: 500; line-height: 28px;
    letter-spacing: -0.03em; color: rgb(71, 71, 71); opacity: 0.85; text-wrap: pretty;
  }
  .wp-tall__scroll {
    flex: 1 1 440px; min-width: 0; height: min(78vh, 760px); overflow: auto;
    background: rgb(30, 30, 30);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.14);
  }
  .wp-tall__scroll img { display: block; width: 100%; height: auto; }

  /* ── in the hand ─────────────────────────────────────────── */
  .wp-hand { padding-block: clamp(60px, 10vh, 110px) clamp(76px, 13vh, 140px); }
  .wp-hand__head { position: relative; display: flex; flex-direction: column; gap: 10px; }
  .wp-hand__grid {
    position: relative; display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: clamp(16px, 2vw, 28px); align-items: end;
  }
  .wp-hand__grid figure { margin: 0; display: flex; flex-direction: column; gap: 14px; }
  .wp-hand__frame {
    position: relative; overflow: hidden; background: rgb(30, 30, 30);
  }
  .wp-hand__frame img {
    display: block; width: 100%; height: 100%; object-fit: cover; object-position: top center;
  }
  .wp-hand__grid figcaption {
    font-size: 14px; font-weight: 500; line-height: 1.5; letter-spacing: -0.03em;
    color: rgba(255, 255, 255, 0.6);
  }

  /* ── outcomes ────────────────────────────────────────────── */
  .wp-out { gap: clamp(34px, 5vh, 60px); }
  .wp-out__head { display: flex; flex-direction: column; gap: 12px; }
  .wp-out .wp-h2 { max-width: 26ch; line-height: 1.02; text-wrap: pretty; }
  .wp-out__grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
    gap: clamp(20px, 3vw, 44px);
  }
  .wp-out__grid > div {
    display: flex; flex-direction: column; gap: 14px; padding-top: 20px;
    border-top: 1.5px solid rgba(153, 152, 149, 0.7);
  }
  .wp-out__big {
    font-size: clamp(44px, 5.4vw, 84px); font-weight: 600; line-height: 1;
    letter-spacing: -0.05em; color: rgb(20, 20, 20);
  }
  .wp-out__label {
    font-size: 16px; font-weight: 500; line-height: 23px; letter-spacing: -0.06em;
    color: rgb(71, 71, 71); text-wrap: pretty;
  }

  /* ── client ──────────────────────────────────────────────── */
  .wp-voice {
    padding-block: clamp(76px, 14vh, 160px); align-items: center;
  }
  .wp-voice > div {
    position: relative; max-width: 1000px;
    display: flex; flex-direction: column; gap: clamp(24px, 4vh, 40px);
  }
  .wp-voice blockquote {
    margin: 0; font-size: clamp(24px, 3.2vw, 44px); font-weight: 500; line-height: 1.28;
    letter-spacing: -0.045em; text-wrap: pretty;
  }
  .wp-voice__who { display: flex; align-items: center; gap: 16px; }
  .wp-voice__who img {
    width: 64px; height: 64px; border-radius: 60px; object-fit: cover;
    object-position: top center; flex: 0 0 auto;
  }
  .wp-voice__who > div { display: flex; flex-direction: column; gap: 4px; }
  .wp-voice__name { font-size: 15px; font-weight: 600; letter-spacing: -0.03em; }
  .wp-voice__role { font-size: 14px; font-weight: 500; letter-spacing: -0.03em; }
  .wp-voice { border-top: 1.5px solid rgba(153, 152, 149, 0.7); }
  .wp-voice blockquote { color: #242424; }
  .wp-voice .wp-voice__name { color: var(--c-black); }
  .wp-voice .wp-voice__role { color: rgba(20, 20, 20, 0.6); }

  /* ── next ────────────────────────────────────────────────── */
  /* No gap between a sun-ground quote and the band: they are one region, so the
     band drops its own top padding when the section above it is yellow. */
  .wp-next {
    background: linear-gradient(100deg, #0a0a0a 0%, #121110 54%, #0d0d0c 100%);
    padding-block: 0 clamp(70px, 10vh, 120px);
    display: flex; flex-direction: column; gap: clamp(30px, 5vh, 56px);
  }
  /* Full-bleed out of the section's own gutters, so the gradient runs edge to
     edge the way every other yellow band on the site does. */
  .wp-next__top {
    position: relative; overflow: hidden; isolation: isolate;
    margin-inline: calc(var(--wp-gut) * -1);
    padding: clamp(30px, 4vh, 44px) var(--wp-gut);
  }
  .wp-next__top-in {
    position: relative; z-index: 1;
    display: flex; flex-wrap: wrap; gap: clamp(20px, 3vw, 44px);
    align-items: center; justify-content: space-between;
  }
  .wp-next__top-in > div {
    flex: 1 1 420px; min-width: 0; display: flex; flex-direction: column; gap: 10px;
  }
  .wp-next__note {
    max-width: 46ch; font-size: clamp(19px, 1.7vw, 24px); font-weight: 500; line-height: 1.32;
    letter-spacing: -0.04em; color: rgba(255, 255, 255, 0.86); text-wrap: pretty;
  }
  .wp-ghost {
    flex: 0 0 auto; align-self: flex-start;
    display: flex; align-items: center; gap: 40px; height: 47px; padding: 0 25px;
    border-radius: 60px; box-shadow: inset 0 0 0 2px rgba(255, 255, 255, 0.25); color: #fff;
    font-size: 14px; font-weight: 500; letter-spacing: -0.03em;
    transition: box-shadow var(--dur-med) var(--ease-out);
  }
  .wp-ghost:hover, .wp-ghost:focus-visible { box-shadow: inset 0 0 0 2px var(--wp-accent); }
  .wp-next__case {
    display: flex; flex-wrap: wrap; align-items: stretch; gap: clamp(20px, 3vw, 44px);
    padding-top: clamp(26px, 4vh, 44px); border-top: 1.5px solid rgba(255, 255, 255, 0.18);
  }
  .wp-next__copy {
    flex: 1 1 300px; min-width: 0; display: flex; flex-direction: column;
    justify-content: space-between; gap: clamp(20px, 3vh, 30px);
  }
  .wp-next__copy > div { display: flex; flex-direction: column; gap: 12px; }
  .wp-next__name {
    font-size: clamp(40px, 6vw, 84px); font-weight: 600; line-height: 0.96;
    letter-spacing: -0.05em; color: #fbfbfb;
  }
  /* Three lines, then it stops. A project with the presentation block gives a
     one-line claim and never reaches the clamp; one without falls back to its
     about line, which runs to 320 characters and would be ten lines in a 28ch
     column — a teaser that is longer than the thing it teases. */
  .wp-next__line {
    max-width: 28ch; font-size: 18px; font-weight: 500; line-height: 28px;
    letter-spacing: -0.03em; color: rgba(255, 255, 255, 0.68); text-wrap: pretty;
    display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3;
    overflow: hidden;
  }
  /* 16px rather than the 14 the design sets these at. At 14 with -0.06em
     tracking they are the two smallest things in a band whose headline is 84px,
     and on a phone they read as captions rather than as the two controls this
     band exists for. Only this band; the section labels keep the design's 14. */
  .wp-next .wp-label--dark { font-size: 16px; letter-spacing: -0.04em; }
  .wp-next__open {
    display: flex; align-items: center; gap: 10px;
    font-size: 16px; font-weight: 600; letter-spacing: -0.04em; color: var(--wp-accent);
  }
  .wp-next__shot {
    flex: 1 1 440px; min-width: 0; overflow: hidden;
    background: rgb(30, 30, 30); aspect-ratio: 16 / 10;
  }
  .wp-next__shot { position: relative; }
  /* DARK INK ON THE YELLOW, and declared here rather than up beside
     .wp-next__top — where these first went, above the rules they override, so
     .wp-next__note won on source order and the sentence printed white on
     yellow. Same specificity, later wins; that is the whole fix. */
  .wp-label--sun { color: rgba(20, 20, 20, 0.66); }
  .wp-next__note--sun { color: var(--c-black); }
  .wp-ghost--sun {
    /* `align-self: center` because .wp-ghost sets flex-start, which beats the
       container's `align-items: center` — so the button sat on the first line
       of a two-line note, 25px above the middle of the band. */
    align-self: center;
    box-shadow: inset 0 0 0 2px rgba(20, 20, 20, 0.3); color: var(--c-black);
  }
  .wp-ghost--sun:hover, .wp-ghost--sun:focus-visible {
    box-shadow: inset 0 0 0 2px var(--c-black); background: rgba(20, 20, 20, 0.06);
  }
  .wp-ghost--sun .wp-dots i { background: rgba(20, 20, 20, 0.35); }
  .wp-ghost--sun .wp-dots i.on { background: var(--c-black); }

  .wp-next__shot img {
    display: block; width: 100%; height: 100%; object-fit: cover; object-position: top center;
  }
  /* The photo-graphic treatment, ON the photograph — which is the design's own
     rule for a photograph as opposed to a screenshot. Two masked layers centred
     off the bottom-left: white hairlines at 42px pitch, yellow at 214. Without
     it this plate is the one picture on the page wearing nothing. */
  .wp-next__rings {
    position: absolute; inset: 0; pointer-events: none;
    background:
      repeating-radial-gradient(
        circle at -6% 112%, rgba(255, 255, 255, 0.3) 0 1px, rgba(255, 255, 255, 0) 1px 42px
      ),
      repeating-radial-gradient(
        circle at -6% 112%, rgba(255, 212, 0, 0.9) 0 1.5px, rgba(255, 212, 0, 0) 1.5px 214px
      );
    mask-image: radial-gradient(
      circle at -6% 112%, rgba(0, 0, 0, 0.2) 0%, #000 26%, rgba(0, 0, 0, 0.4) 58%, rgba(0, 0, 0, 0) 94%
    );
  }

  /* ── phone ───────────────────────────────────────────────────
     The artboard is fluid — every size in it is a clamp against vw — so most
     of it already holds at 390. These are the places where a flex-basis is
     wider than the viewport and the row would otherwise wrap into a column
     with a stranded second half. */
  @media (max-width: 760px) {
    .wp-split__rail { flex-basis: 100%; }
    .wp-reel__side { flex: 1 1 100%; }
    .wp-tall__rail { position: static; }
    /* A tall plate inside a 78vh scroller is fine on a laptop and is most of
       a phone screen. Shorter, so the section does not become the page. */
    .wp-tall__scroll { height: min(60vh, 520px); }
    .wp-team { align-self: flex-start; }
  }
</style>

<script>
  /* The reel. One picture at a time, a counter, prev/next and a list that
     jumps. Progressive: with no JS the first screen and its copy are already
     in the document and the list is a row of inert buttons. */
  const reel = document.querySelector<HTMLElement>('.wp-reel')
  if (reel) {
    const slides = [...reel.querySelectorAll<HTMLElement>('[data-reel-slide]')]
    const copies = [...reel.querySelectorAll<HTMLElement>('[data-reel-copy]')]
    const picks = [...reel.querySelectorAll<HTMLButtonElement>('[data-reel-pick]')]
    const count = reel.querySelector<HTMLElement>('[data-reel-count]')
    const total = slides.length
    let at = 0

    const show = (n: number) => {
      at = (n + total) % total
      slides.forEach((s, i) => s.classList.toggle('is-on', i === at))
      copies.forEach((c, i) => { c.hidden = i !== at })
      picks.forEach((b, i) => b.classList.toggle('is-on', i === at))
      if (count) {
        count.textContent =
          String(at + 1).padStart(2, '0') + ' / ' + String(total).padStart(2, '0')
      }
    }

    picks.forEach((b, i) => b.addEventListener('click', () => show(i)))
    reel.querySelector('[data-reel-prev]')?.addEventListener('click', () => show(at - 1))
    reel.querySelector('[data-reel-next]')?.addEventListener('click', () => show(at + 1))
  }
</script>
