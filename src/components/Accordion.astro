---
/**
 * Accordion. Real <button> with aria-expanded, one row open at a time.
 * Rule above each row, plus/minus circle on the left: 36px circle, "+" at
 * 28/300, "-" at 26/300.
 *
 * Closed 90px, open 178px in the prototype. Height here is driven by content
 * rather than fixed, because fixed heights break the moment an answer runs to
 * three lines, and the measured values are what a two-line answer produced.
 *
 * FAQ schema, where a page has one, must match this visible text word for word.
 */
interface Item { question: string; answer: string }
interface Props {
  items: Item[]
  /** Unique per instance so ids do not collide when two are on a page. */
  name: string
}
const { items, name } = Astro.props
---

<div class="acc" data-accordion>
  {items.map((item, i) => (
    <div class="acc__row">
      <h3 class="acc__h">
        <button
          class="acc__trigger"
          type="button"
          aria-expanded="false"
          aria-controls={`${name}-panel-${i}`}
          id={`${name}-trigger-${i}`}
        >
          <span class="acc__icon" aria-hidden="true"></span>
          <span class="acc__q">{item.question}</span>
        </button>
      </h3>
      <div
        class="acc__panel"
        id={`${name}-panel-${i}`}
        role="region"
        aria-labelledby={`${name}-trigger-${i}`}
        hidden
      >
        <div class="acc__inner"><p>{item.answer}</p></div>
      </div>
    </div>
  ))}
</div>

<style>
  .acc__row { border-top: 1.5px solid var(--rule); }
  .acc__h { margin: 0; font-size: inherit; font-weight: inherit; }
  .acc__trigger {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
    width: 100%;
    padding: var(--sp-4) 0;
    min-height: 90px;
    border: 0;
    background: none;
    font-family: inherit;
    font-size: var(--fs-item);
    font-weight: var(--fw-semi);
    letter-spacing: var(--ls-item);
    line-height: 1.3;
    color: var(--ink);
    text-align: left;
    cursor: pointer;
  }
  .acc__icon {
    position: relative;
    flex: 0 0 var(--icon-circle);
    width: var(--icon-circle);
    height: var(--icon-circle);
    border-radius: var(--r-circle);
    background: var(--c-footer);
    transition: background var(--dur-fast) ease;
  }
  /* "+" and "-" drawn as two bars so the crossfade to "-" is one transform
     rather than a glyph swap, which would jump between font metrics. */
  .acc__icon::before,
  .acc__icon::after {
    content: '';
    position: absolute;
    inset: 50% auto auto 50%;
    translate: -50% -50%;
    background: var(--c-white);
    transition: opacity var(--dur-fast) ease, rotate var(--dur-fast) ease;
  }
  .acc__icon::before { width: 13px; height: 1.5px; }
  .acc__icon::after { width: 1.5px; height: 13px; }
  [aria-expanded='true'] .acc__icon { background: var(--c-accent); }
  [aria-expanded='true'] .acc__icon::before,
  [aria-expanded='true'] .acc__icon::after { background: var(--c-footer); }
  [aria-expanded='true'] .acc__icon::after { opacity: 0; }

  .acc__panel { overflow: hidden; height: 0; transition: height var(--dur-fast) ease; }
  .acc__panel[hidden] { display: block; height: 0; }
  .acc__inner { padding: 0 0 var(--sp-5) calc(var(--icon-circle) + var(--sp-4)); }
  .acc__inner p {
    max-width: 640px;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    letter-spacing: var(--ls-item);
    color: var(--ink-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .acc__panel { transition: none; }
  }
</style>
