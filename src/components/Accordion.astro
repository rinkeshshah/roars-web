---
/**
 * Accordion. Real <button> with aria-expanded, one row open at a time.
 *
 * Toggle treatment follows the rendered prototype, which the brand doc and the
 * mock disagree on: Brand Guidelines specifies a 36px dark circle on the left,
 * the prototype renders a 36px WHITE circle at the RIGHT end of the row with a
 * light-weight glyph. On the #F5F5F5 ground that reads as a bare +/- rather
 * than a button, which is the intended effect. The prototype wins here by
 * decision; docs/DESIGN-SYSTEM.md records the divergence.
 *
 * Question is --fs-intro throughout; the open state is carried by weight
 * (500 -> 600), not by size, so the row does not reflow when it opens.
 *
 * Height is driven by content rather than fixed. Fixed heights break the
 * moment an answer runs to three lines, and the prototype's measured values
 * are what a two-line answer produced.
 *
 * FAQ schema, where a page has one, must match this visible text word for word.
 */
interface Item { question: string; answer: string }
interface Props {
  items: Item[]
  /** Unique per instance so ids do not collide when two are on a page. */
  name: string
}
const { items, name } = Astro.props
---

<div class="acc" data-accordion>
  {items.map((item, i) => (
    <div class="acc__row">
      <h3 class="acc__h">
        <button
          class="acc__trigger"
          type="button"
          aria-expanded="false"
          aria-controls={`${name}-panel-${i}`}
          id={`${name}-trigger-${i}`}
        >
          <span class="acc__q">{item.question}</span>
          <span class="acc__icon" aria-hidden="true"></span>
        </button>
      </h3>
      <div
        class="acc__panel"
        id={`${name}-panel-${i}`}
        role="region"
        aria-labelledby={`${name}-trigger-${i}`}
        hidden
      >
        <div class="acc__inner"><p>{item.answer}</p></div>
      </div>
    </div>
  ))}
</div>

<style>
  .acc__row { border-top: 1.5px solid var(--rule); }
  .acc__h { margin: 0; font-size: inherit; font-weight: inherit; }
  .acc__trigger {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--sp-5);
    width: 100%;
    padding: 26px 0 0;
    min-height: 90px;
    border: 0;
    background: none;
    font-family: inherit;
    color: var(--ink);
    text-align: left;
    cursor: pointer;
  }
  .acc__q {
    max-width: 700px;
    font-size: var(--fs-intro);
    font-weight: var(--fw-medium);
    line-height: 22px;
    letter-spacing: var(--ls-body);
    color: rgb(20, 20, 20);
    transition: font-weight var(--dur-fast) ease;
  }
  [aria-expanded='true'] .acc__q { font-weight: var(--fw-semi); }

  /* White disc, black glyph, at the right end of the row. */
  .acc__icon {
    position: relative;
    flex: 0 0 var(--icon-circle);
    width: var(--icon-circle);
    height: var(--icon-circle);
    border-radius: var(--r-pill);
    background: var(--c-white);
    transition: background var(--dur-fast) ease;
  }
  /* "+" and "-" drawn as two bars so the change to "-" is one transform
     rather than a glyph swap, which would jump between font metrics. */
  .acc__icon::before,
  .acc__icon::after {
    content: '';
    position: absolute;
    inset: 50% auto auto 50%;
    translate: -50% -50%;
    background: var(--c-black);
    transition: opacity var(--dur-fast) ease;
  }
  .acc__icon::before { width: 13px; height: 1.25px; }
  .acc__icon::after { width: 1.25px; height: 13px; }
  [aria-expanded='true'] .acc__icon::after { opacity: 0; }
  .acc__trigger:hover .acc__icon { background: var(--c-accent); }

  .acc__panel { overflow: hidden; height: 0; transition: height var(--dur-fast) ease; }
  .acc__panel[hidden] { display: block; height: 0; }
  .acc__inner { padding: 4px 0 var(--sp-5); }
  .acc__inner p {
    margin: 0;
    max-width: 613px;
    font-size: var(--fs-body);
    font-weight: var(--fw-medium);
    line-height: 22px;
    letter-spacing: var(--ls-body);
    color: rgb(20, 20, 20);
  }

  @media (prefers-reduced-motion: reduce) {
    .acc__panel { transition: none; }
    .acc__q { transition: none; }
  }
</style>
