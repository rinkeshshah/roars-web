---
/**
 * Shared CTA band. 1440x540 dark, 42/52 headline, one primary button.
 * The defaults are verbatim from design/specs/CTA Band.md.
 *
 * THE COPY IS PER PAGE, THE BAND IS NOT. One component keeps the geometry,
 * the rule, the label and the ink from drifting apart across fourteen pages;
 * the sentence inside it is the page's own. That is what the export already
 * does — AI Automation closes on "Bring us your least favourite part of the
 * week", Industries on "Bring unique food & restaurant app ideas to life",
 * Resources and Guides on "Let's get your project started." One shared
 * sentence everywhere is a weaker page and a weaker search result.
 *
 * A page written as .astro passes these props. A page driven by a collection
 * carries its copy in front matter under `cta`, where Zod checks it like
 * everything else — see src/content.config.ts. Omitting them is not a silent
 * failure: you get the shipped default, which is a real sentence.
 */
import Section from './Section.astro'
import Button from './Button.astro'
import { site } from '../lib/site'

interface Props {
  /** Small rail label above the headline. */
  label?: string
  heading?: string
  body?: string
  ctaLabel?: string
  ctaHref?: string
}
const {
  label = 'A to B',
  heading = 'Find how we can help you get from A to B',
  body = 'Our love for innovation design and technology is evident in all our works. No detail is too small. Together, we’ll make your business grow, manifold.',
  ctaLabel = 'Request a Callback',
  ctaHref = site.booking,
} = Astro.props

/** External only when it actually leaves the site. An in-site href must not
 *  pick up target=_blank and rel=noopener just because the default does. */
const external = /^https?:\/\//.test(ctaHref)
---

<Section ground="dark" rings>
  <div class="cta__grid">
    <div data-reveal class="cta__left">
      <div class="cta__rule"></div>
      <span class="cta__label">{label}</span>
      <p class="cta__head">{heading}</p>
      <p class="cta__phones">
        USA {site.phones.US.display} &middot; UK {site.phones.UK.display}
      </p>
    </div>
    <div data-reveal class="cta__right" style="transition-delay:80ms">
      <p class="cta__body">{body}</p>
      <Button href={ctaHref} label={ctaLabel} variant="light" external={external} />
    </div>
  </div>
</Section>

<style>
  .cta__grid {
    display: grid;
    grid-template-columns: minmax(0, 922fr) minmax(0, 440fr);
    column-gap: var(--sp-5);
    padding-block: 100px;
  }
  .cta__rule { height: 1.5px; background: rgba(180, 174, 174, 0.35); margin-bottom: var(--sp-4); }
  .cta__label {
    display: block;
    font-size: var(--fs-label); line-height: var(--lh-label);
    font-weight: var(--fw-semi);
    letter-spacing: var(--ls-body);
    color: var(--c-ink-label);
  }
  .cta__head {
    margin-top: 42px;
    max-width: 760px;
    font-size: clamp(34px, 2.9vw, var(--fs-stat));
    font-weight: var(--fw-semi);
    line-height: 1.24;
    letter-spacing: var(--ls-display);
    color: var(--c-white);
  }
  .cta__phones {
    margin-top: var(--sp-6);
    font-size: var(--fs-label); line-height: var(--lh-label);
    letter-spacing: var(--ls-item);
    color: var(--c-on-dark-50);
  }
  .cta__right { display: flex; flex-direction: column; gap: 58px; align-items: flex-start; padding-top: 96px; }
  .cta__body {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    letter-spacing: var(--ls-item);
    color: rgba(255, 255, 255, 0.72);
  }

  @media (max-width: 1040px) {
    .cta__grid { grid-template-columns: 1fr; row-gap: var(--sp-5); padding-block: var(--sp-7); }
    .cta__right { padding-top: 0; gap: var(--sp-5); }
    .cta__head { margin-top: var(--sp-4); }
    .cta__phones { margin-top: var(--sp-4); }
  }
</style>
