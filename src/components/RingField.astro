---
/**
 * The Roar Ring as a section ground — turn 8a and 8b of
 * "Roars v2 - Photo Graphic Elements".
 *
 * NOT ON THE CARDS, BEHIND THEM. The export's reasoning, kept here because it
 * is the whole rule: project listings show product screenshots, not
 * photography. Hairlines drawn over a dashboard read as damage, and grading
 * the image down to carry them makes the work unreadable. So on a listing the
 * ring moves off the image and onto the section ground: the cards stay exactly
 * as they are, the rings pass behind them, and a yellow one crosses the gutter
 * between cards. Same instrument, one layer further back.
 *
 * TWO LAYERS, NOT ONE SET OF RINGS. A grey field at a 42px pitch, and a yellow
 * one at 372px — so roughly every ninth ring is the accent. They are separate
 * elements because they carry DIFFERENT masks: the grey peaks at 24% out from
 * the centre, the yellow at 48%, which is what keeps a yellow ring in the
 * middle distance where it can cross a gutter rather than clustering at the
 * origin with everything else.
 *
 * repeating-radial-gradient, not SVG circles. An earlier pass drew sixty-four
 * <circle> elements with a per-ring opacity falloff; it worked, but the greys
 * came out at half the alpha the design asks for and the two falloffs fought
 * each other. The CSS is the design's own, values included, and the centre in
 * percentages scales with the band instead of being pinned to a viewBox.
 *
 * Static, so there is nothing for prefers-reduced-motion to switch off, and it
 * costs no JavaScript.
 */
interface Props {
  /**
   * dark: white hairlines and #FFD400, for a dark ground, centred off the
   *   bottom-left corner. Turn 8a.
   * light: the same rings inverted onto paper — 16% black and #D6B200,
   *   because #FFD400 disappears on light grey — centred off the top-right.
   *   Turn 8b.
   */
  tone?: 'dark' | 'light'
  /** Override the centre, e.g. "86% 112%". Defaults per tone. */
  at?: string
}

const { tone = 'dark', at } = Astro.props

const centre = at ?? (tone === 'dark' ? '-6% 108%' : '104% -8%')
const hair = tone === 'dark' ? 'rgba(255,255,255,0.26)' : 'rgba(20,20,20,0.16)'
const hairOut = tone === 'dark' ? 'rgba(255,255,255,0)' : 'rgba(20,20,20,0)'
const accent = tone === 'dark' ? 'rgba(255,212,0,0.9)' : 'rgba(214,178,0,0.75)'
const accentOut = tone === 'dark' ? 'rgba(255,212,0,0)' : 'rgba(214,178,0,0)'

/* The masks. Neither starts solid: both open faint at the origin and peak
   further out, which is what stops the field reading as a target. */
const maskHair =
  tone === 'dark'
    ? `radial-gradient(circle at ${centre},rgba(0,0,0,0.2) 0%,#000 24%,rgba(0,0,0,0.45) 56%,rgba(0,0,0,0.12) 82%,rgba(0,0,0,0) 97%)`
    : `radial-gradient(circle at ${centre},rgba(0,0,0,0.25) 0%,#000 26%,rgba(0,0,0,0.4) 58%,rgba(0,0,0,0) 94%)`
const maskAccent =
  tone === 'dark'
    ? `radial-gradient(circle at ${centre},rgba(0,0,0,0) 2%,rgba(0,0,0,0.4) 22%,#000 48%,rgba(0,0,0,0.28) 76%,rgba(0,0,0,0) 95%)`
    : `radial-gradient(circle at ${centre},rgba(0,0,0,0) 4%,rgba(0,0,0,0.4) 24%,#000 50%,rgba(0,0,0,0.25) 78%,rgba(0,0,0,0) 96%)`

const hairStyle = [
  `background:repeating-radial-gradient(circle at ${centre},${hair} 0 1px,${hairOut} 1px 42px)`,
  `-webkit-mask-image:${maskHair}`,
  `mask-image:${maskHair}`,
].join(';')

const accentStyle = [
  `background:repeating-radial-gradient(circle at ${centre},${accent} 0 1.5px,${accentOut} 1.5px 372px)`,
  `-webkit-mask-image:${maskAccent}`,
  `mask-image:${maskAccent}`,
].join(';')
---

<span class="rf" aria-hidden="true">
  <span class="rf__l" style={hairStyle}></span>
  <span class="rf__l" style={accentStyle}></span>
</span>

<style>
  /* Full bleed off the band's own centre, which is the viewport's centre
     because .wrap is a centred max-width box. Same move as .icz__ground. */
  .rf {
    position: absolute; left: 50%; top: 0; z-index: -1;
    display: block; width: 100vw; height: 100%;
    transform: translateX(-50%);
    overflow: hidden; pointer-events: none;
  }
  /* The two ring layers fill the field, so their percentage centres resolve
     against the same box and the yellow lands on a grey ring rather than
     between two. */
  .rf__l { position: absolute; inset: 0; display: block; }
</style>
