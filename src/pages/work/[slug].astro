---
/**
 * Case study detail. Twenty-three live URLs at /work/[slug]/.
 *
 * Routes come from the inventory. Client names come from src/lib/projects.ts.
 * Bodies and hero images arrive with the content migration, so these render
 * the pending state with the real client name in the heading and carry
 * noindex until then.
 */
import { getCollection, render } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import MarketingPage from '../../components/MarketingPage.astro'
import Section from '../../components/Section.astro'
import TopBar from '../../components/TopBar.astro'
import NavOverlay from '../../components/NavOverlay.astro'
import SiteFooter from '../../components/SiteFooter.astro'
import GrainField from '../../components/GrainField.astro'
import RingField from '../../components/RingField.astro'
import { PORTRAIT, workHeroFor } from '../../lib/media'
import { slugsOf, nameFromSlug } from '../../lib/inventory'
import { clientFor, isHeldBack } from '../../lib/projects'
import { site } from '../../lib/site'

export async function getStaticPaths() {
  const entries = await getCollection('projects')
  const byId = new Map(entries.map((e) => [e.id, e]))
  return slugsOf('post(work)').map((slug) => ({
    params: { slug },
    props: { entry: byId.get(slug) },
  }))
}

const { slug } = Astro.params
const { entry } = Astro.props
const path = `/work/${slug}/`

/* Built, but not offered: off the /work/ index and noindex here. The URL keeps
   resolving to the real case study, so the named receipts that industry and
   service pages carry for these projects still land somewhere true. See
   HELD_BACK in src/lib/projects.ts for why this is not a redirect. */
const heldBack = isHeldBack(slug as string)
const client = entry?.data.client ?? clientFor(slug) ?? nameFromSlug(slug)

const schema = entry
  ? [
      {
        '@context': 'https://schema.org',
        '@type': 'CreativeWork',
        '@id': `${site.url}${path}#work`,
        name: entry.data.title,
        about: client,
        creator: { '@id': `${site.url}/#organization` },
        datePublished: entry.data.publishedAt.toISOString(),
        description: entry.data.seo.description,
      },
      {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
          { '@type': 'ListItem', position: 2, name: 'Work', item: `${site.url}/work/` },
          { '@type': 'ListItem', position: 3, name: client },
        ],
      },
    ]
  : []

const { Content } = entry ? await render(entry) : { Content: null }
const d = entry?.data
/* Designed when the case study has its about line. One of the twenty-three
   today; the rest keep the pending state, which is noindex, rather than a
   layout wrapped around a client name. */
const designed = Boolean(d?.about)

/* The header photo. One value shared with every band that credits this
   project, so what a reader sees on an industry page is what they get when
   they follow the link.
   A content file's own heroImage wins; the registry is the fallback, and the
   two must not disagree — a band showing one photo and the page showing
   another is the bug this is here to prevent. */
const registryHero = workHeroFor(`/work/${slug}/`)
if (d?.heroImage && registryHero && d.heroImage !== registryHero) {
  throw new Error(
    `work/${slug}: heroImage is "${d.heroImage}" but src/lib/projects.ts says ` +
      `"${registryHero}". The work page header and the featured bands that ` +
      'credit this project must show the same photograph. Fix one of them.',
  )
}
const heroSrc = d?.heroImage ?? registryHero
const faces = (d?.team ?? [])
  .map((k) => PORTRAIT[k as keyof typeof PORTRAIT])
  .filter(Boolean)

/**
 * THE PICTURES, GROUPED BY WHAT THEY ARE.
 *
 * gallery / showcase / screens record where the old WordPress page put a
 * picture, not what the picture is. Reading them as three layout slots is
 * what gave Tanishq and Snowman four empty dark boxes — the showcase drew
 * its frames whether or not there was anything to put in them — while
 * GymBait's thirteen app screens were tipped into one undifferentiated grid
 * at the bottom under "13 MORE FROM THE BUILD".
 *
 * So the three arrays are flattened and re-sorted by `kind`, and the page is
 * built from chapters that appear only when they hold something. Eleven case
 * studies carrying between two and sixteen pictures then use one template,
 * and the thin ones come out short rather than broken.
 */
const media = [...(d?.gallery ?? []), ...(d?.showcase ?? []), ...(d?.screens ?? [])]
const pick = (...kinds: string[]) => media.filter((m) => m.kind && kinds.includes(m.kind))
/** The process: how it was structured, and how it was dressed. */
const groundwork = pick('wireframe', 'study')
/** The product. Phone screens and web screens are different shapes and want
 *  different grids, so they stay apart. */
const appShots = pick('app')
const webShots = pick('web')
/** Photographs and anything nobody classified. Never dropped; shown last. */
const rest = media.filter((m) => !m.kind || m.kind === 'photo')
---

{designed && d ? (
  <BaseLayout
    title={d.seo.title}
    description={d.seo.description}
    path={path}
    schema={schema}
    noindex={d.needsReview || heldBack}
  >
    <TopBar slot="topbar" cta="contact" />
    <NavOverlay />

    {/* ── Banner, 1440x196 ──────────────────────────────────────
        The export crops the project's own photo into this strip under a 0.35
        wash. At 196px that is a sliver of a picture — you cannot read it, and
        it competes with the same photo shown properly 250px lower.
        So it takes the ground every other inner page opens on instead: the
        warm dark gradient, the drift and the grain, at the export's height.
        The project image is then shown once, large, with nothing arguing
        with it. ────────────────────────────────────────────────────────── */}
    <Section ground="dark" bleed>
      <div class="pb">
        <GrainField tone="dark" second />
      </div>
    </Section>

    {/* ── The case study, 1440x5534 in the export ──────────────────────── */}
    <Section ground="light">
      <div class="pd">
        <div class="pd__head">
          <a class="pd__back" href="/work/">
            See all Projects
            <span class="pd__dot pd__dot--grey" aria-hidden="true"></span>
            <span class="pd__dot pd__dot--ink" aria-hidden="true"></span>
          </a>
          <h1 class="pd__client">{d.headline ?? d.client}</h1>
          {d.dateLabel && <p class="pd__date">{d.dateLabel}</p>}

          {faces.length > 0 && (
            <div class="pd__team">
              {/* A staggered cluster, not a row: the export offsets the second
                  column 8px so five faces read as a team rather than a list. */}
              <span class="pd__faces">
                {faces.map((src, i) => (
                  <img src={src} alt="" width="40" height="40" loading="lazy" style={`--i:${i}`} />
                ))}
              </span>
              <span class="pd__team-label">Team Members Involved</span>
            </div>
          )}
        </div>

        {heroSrc && (
          <div class="pd__hero" data-reveal>
            <img
              src={heroSrc}
              alt={d.heroAlt || ''}
              width="2400" height="1200" loading="lazy" decoding="async"
            />
            <RingField variant="sweep" />
          </div>
        )}

        <div class="pd__about" data-reveal>
          <span class="pd__label">About:</span>
          <p class="pd__statement">{d.about}</p>
          {d.facts.length > 0 && (
            <dl class="pd__facts">
              {d.facts.map((f) => (
                <div><dt>{f.k}</dt><dd>{f.v}</dd></div>
              ))}
            </dl>
          )}
          {/* The export draws a "Live Version" pill here. NOT BUILT: this is
              an internal warehouse system, there is no public URL for it, and
              a button pointing at the client's marketing site would be a link
              to the wrong thing. `liveUrl` is in the schema for the case
              studies that do have one. */}
        </div>


        {d.blocks[0] && (
          <div class="pd__block" data-reveal>
            <h2 class="pd__block-h">{d.blocks[0].heading}</h2>
            <div class="pd__block-body">
              <p class="pd__lead">{d.blocks[0].lead}</p>
              {d.blocks[0].body && <p class="pd__more">{d.blocks[0].body}</p>}
            </div>
          </div>
        )}

        {/* GROUNDWORK — the wireframes and the colour and type studies.
            These are working documents, not the product, and they used to be
            shown at the same size and in the same grid as finished screens,
            which flattered neither. Smaller, captioned, on their own rule, so
            the page reads process first and product second. */}
        {groundwork.length > 0 && (
          <section class="pd__chapter pd__chapter--ground" data-reveal>
            <span class="pd__ch-tick" aria-hidden="true"></span>
            <h2 class="pd__ch-h">Groundwork</h2>
            <p class="pd__ch-sub">Structure first, then the look of it.</p>
            <ul class="pd__ground">
              {groundwork.map((m, i) => (
                <li data-reveal style={`transition-delay:${Math.min(i, 5) * 60}ms`}>
                  <img src={m.src} alt={m.alt} loading="lazy" decoding="async" />
                  <span class="pd__cap">{m.kind === 'wireframe' ? 'Wireframe' : 'Colour and type'}</span>
                </li>
              ))}
            </ul>
          </section>
        )}

        {d.blocks.slice(1).map((b) => (
          <div class="pd__block" data-reveal>
            <h2 class="pd__block-h">{b.heading}</h2>
            <div class="pd__block-body">
              <p class="pd__lead">{b.lead}</p>
              {b.body && <p class="pd__more">{b.body}</p>}
            </div>
          </div>
        ))}

        {/* THE PRODUCT. Web screens are landscape and app screens portrait, so
            they get separate grids rather than one grid that suits neither.
            Either chapter is skipped when the project has none of that kind,
            which is how a three-picture case study and a sixteen-picture one
            use the same template. */}
        {(webShots.length > 0 || appShots.length > 0 || rest.length > 0) && (
          <section class="pd__chapter" data-reveal>
            <span class="pd__ch-tick" aria-hidden="true"></span>
            <h2 class="pd__ch-h">What shipped</h2>
            <p class="pd__ch-sub">
              {[webShots.length && `${webShots.length} web`, appShots.length && `${appShots.length} app`]
                .filter(Boolean).join(' · ') || 'From the build'}
            </p>

            {webShots.length > 0 && (
              <ul class="pd__web">
                {webShots.map((m, i) => (
                  <li data-reveal style={`transition-delay:${Math.min(i, 4) * 60}ms`}>
                    <img src={m.src} alt={m.alt} loading="lazy" decoding="async" />
                  </li>
                ))}
              </ul>
            )}

            {appShots.length > 0 && (
              <ul class="pd__app">
                {appShots.map((m, i) => (
                  <li data-reveal style={`transition-delay:${Math.min(i, 5) * 50}ms`}>
                    <img src={m.src} alt={m.alt} loading="lazy" decoding="async" />
                  </li>
                ))}
              </ul>
            )}

            {rest.length > 0 && (
              <ul class="pd__web">
                {rest.map((m, i) => (
                  <li data-reveal style={`transition-delay:${Math.min(i, 4) * 60}ms`}>
                    <img src={m.src} alt={m.alt} loading="lazy" decoding="async" />
                  </li>
                ))}
              </ul>
            )}
          </section>
        )}

        {/* THE CLIENT'S VERDICT, after the work rather than before it. A quote
            placed above the pictures asks the reader to take the outcome on
            trust; placed here it lands on something they have just seen.
            Only ever a quote whose role names this client outright — see the
            note on `testimonial` in content.config.ts. */}
        {d.testimonial && (
          <figure class="pd__say" data-reveal>
            <span class="pd__say-mark" aria-hidden="true">&ldquo;</span>
            <blockquote class="pd__say-q">{d.testimonial.quote}</blockquote>
            <figcaption class="pd__say-who">
              {d.testimonial.portrait
                ? <img src={d.testimonial.portrait} alt="" width="56" height="56" loading="lazy" />
                : <span class="pd__say-mono" aria-hidden="true">
                    {d.testimonial.name.split(' ').map((w) => w[0]).slice(0, 2).join('')}
                  </span>}
              <span>
                <b>{d.testimonial.name}</b>
                <i>{d.testimonial.role}</i>
              </span>
            </figcaption>
          </figure>
        )}

        {/* The migrated body. The export has no slot for it; a case study with
            four sentences is not a case study, and this is the page that has
            to answer "have they done logistics". Given its own header and
            numbered sections so it reads as part of the page rather than as
            text that got appended to it. */}
        {Content && (
          <div class="pd__long" data-reveal>
            <span class="pd__long-tick" aria-hidden="true"></span>
            <span class="pd__long-eyebrow">THE LONG VERSION</span>
            <div class="pd__prose"><Content /></div>
          </div>
        )}
      </div>
    </Section>

    <SiteFooter
      slot="footer"
      blurbTitle="Got a floor that runs on clipboards?"
      blurb="Most operations problems look like software problems once you watch the shift. Tell us what the shift looks like."
      tagline="proof, not promises"
      ctaLabel="Shall we chat?"
      ctaHref="https://meet.roarsinc.com/sales"
    />
  </BaseLayout>
) : (
<MarketingPage
  topCta="contact"
  title={entry?.data.seo.title ?? `${client} Case Study | ${site.name}`}
  description={entry?.data.seo.description}
  path={path}
  label="Case study"
  heading={client}
  schema={schema}
  pending={!entry}
>
  {Content && <Content />}
</MarketingPage>
)}

<style>
  /* ── banner ─────────────────────────────────────────────── */
  .pb { position: relative; height: 196px; overflow: hidden; background: var(--c-black); }

  /* ── the case study ─────────────────────────────────────── */
  .pd { position: relative; padding-block: 102px 120px; }

  /* The head is a fixed 1358x330 with three anchors — back link at 206,
     client at 182, date at 311 — so the client name sits BESIDE the link
     rather than under it, which is the whole arrangement. */
  .pd__head { position: relative; height: 330px; }
  .pd__back {
    position: absolute; left: 0; top: 206px;
    font-size: 18px; line-height: 19px; font-weight: var(--fw-semi);
    letter-spacing: -0.06em; color: var(--c-black);
  }
  .pd__dot { position: absolute; width: 8px; height: 8px; border-radius: 50%; }
  .pd__back .pd__dot { top: 7px; }
  .pd__back .pd__dot--grey { left: 130px; background: rgb(153, 152, 149); opacity: 0.6; }
  .pd__back .pd__dot--ink { left: 141px; background: rgb(20, 20, 20); }
  .pd__client {
    position: absolute; left: 452px; top: 182px; margin: 0;
    font-size: clamp(56px, 8.62vw, 124px); line-height: 86px; font-weight: var(--fw-semi);
    letter-spacing: -0.04em; color: rgb(20, 20, 20); white-space: nowrap;
  }
  .pd__date {
    position: absolute; left: 457px; top: 311px; margin: 0;
    font-size: 20px; line-height: 19px; font-weight: var(--fw-medium);
    letter-spacing: -0.06em; color: var(--c-black);
  }

  .pd__team { position: absolute; left: 67.988%; top: 0; width: 31.718%; height: 134px; }
  .pd__faces { position: relative; display: block; width: 83px; height: 134px; }
  .pd__faces img {
    position: absolute; width: 40px; height: 40px; border-radius: 50%;
    background: rgb(217, 217, 217); object-fit: cover;
  }
  /* Two columns, the right one lifted 8px. The export places five faces by
     hand; this is the same five positions expressed once. */
  .pd__faces img:nth-child(1) { left: 0; top: 8px; }
  .pd__faces img:nth-child(2) { left: 43px; top: 0; }
  .pd__faces img:nth-child(3) { left: 0; top: 55px; }
  .pd__faces img:nth-child(4) { left: 43px; top: 47px; }
  .pd__faces img:nth-child(5) { left: 43px; top: 94px; }
  .pd__team-label {
    position: absolute; left: 117px; top: 4px; width: 180px;
    font-size: 18px; line-height: 24px; font-weight: var(--fw-medium);
    letter-spacing: -0.03em; color: rgb(20, 20, 20);
  }

  /* AMBER DUSK, THE DETAIL-PAGE VERSION. The /work/ card and this header now
     belong to one family, which is the point — but they are not the same
     picture doing the same job, so they are not the same treatment.

     The CARD carries the client name, the sector and the year ON the
     photograph, so it needs brightness .62 and a directional ink gradient
     dense enough to hold white type. Neither of those is about the picture;
     both are about the copy.

     THIS HEADER CARRIES NO TYPE AT ALL. The name and the date sit above it on
     white. So the ink gradient is dropped — there is nothing to protect, and a
     dense left edge would just be a dark half for no reason — and the
     exposure comes back to .82, because here the photograph IS the subject
     rather than a ground. What carries across is the amber from the far
     corner, which is the family resemblance and the one place yellow touches
     an image anywhere on the site. */
  .pd__hero { position: relative; margin-top: 27px; overflow: hidden; border-radius: 12px; background: rgb(30, 30, 30); }
  /* 2:1, THE SHAPE THE FILES ARE CUT TO. The box was a fixed 737px on a
     1358px column, 1.84:1, so a 2:1 photograph lost a strip off each side to
     `object-fit: cover` — the same fault the /work/ card had before it was
     unified. scripts/build-work-headers.mjs crops every header to 2:1 once, at
     build time, so nothing needs cropping again here.
     Saturation is baked into the file at 0.8 rather than applied as a CSS
     filter: one source of truth, and no filter to composite on a 2400px image
     at paint time. */
  .pd__hero img { display: block; width: 100%; aspect-ratio: 2 / 1; object-fit: cover; filter: var(--sweep-grade); }

  /* ── about ──────────────────────────────────────────────── */
  .pd__about { position: relative; margin-top: 83px; }
  .pd__label {
    position: absolute; left: 0; top: 0;
    font-size: var(--fs-body); line-height: 24px; font-weight: var(--fw-medium);
    letter-spacing: var(--ls-item); color: rgba(71, 71, 71, 0.8);
  }
  .pd__statement {
    margin: 0 0 0 461px; max-width: 689px;
    font-size: 26px; line-height: 37px; font-weight: var(--fw-semi);
    letter-spacing: var(--ls-item); color: var(--c-black);
  }
  .pd__facts { margin: 74px 0 0 457px; }
  .pd__facts > div { position: relative; display: flex; height: 42px; padding-top: 17px; }
  .pd__facts > div::before {
    content: ''; position: absolute; left: 0; top: 0;
    width: 897px; height: 0.5px; background: rgba(71, 71, 71, 0.2);
  }
  .pd__facts > div + div { margin-top: 18px; }
  .pd__facts dt {
    width: 465px;
    font-size: var(--fs-label); line-height: 24px; font-weight: var(--fw-medium);
    letter-spacing: -0.02em; color: rgba(71, 71, 71, 0.8);
  }
  .pd__facts dd {
    margin: 0;
    font-size: var(--fs-body); line-height: 24px; font-weight: var(--fw-medium);
    letter-spacing: var(--ls-item); color: var(--c-black);
  }
  /* ── the pair ───────────────────────────────────────────── */
  /* ── the client's verdict ───────────────────────────────── */
  .pd__say {
    margin: 104px 0 0; padding: 48px 0 0;
    border-top: 1.5px solid var(--c-rule-strong);
    max-width: 900px;
  }
  .pd__say-mark {
    display: block; font-size: 84px; line-height: 0.6;
    font-weight: var(--fw-semi); color: var(--c-accent);
  }
  .pd__say-q {
    margin: 24px 0 0; font-size: var(--fs-intro); line-height: var(--lh-intro);
    font-weight: var(--fw-medium); letter-spacing: var(--ls-item); color: var(--c-ink-heading);
  }
  .pd__say-who { display: flex; align-items: center; gap: 16px; margin-top: 32px; }
  .pd__say-who img, .pd__say-mono {
    width: 56px; height: 56px; border-radius: var(--r-circle);
    object-fit: cover; flex: none; background: rgb(233, 233, 231);
  }
  .pd__say-mono {
    display: grid; place-items: center;
    font-size: var(--fs-label); font-weight: var(--fw-semi);
    letter-spacing: var(--ls-item); color: var(--c-ink-heading);
  }
  .pd__say-who b, .pd__say-who i {
    display: block; font-style: normal; letter-spacing: var(--ls-body);
  }
  .pd__say-who b { font-size: var(--fs-body); font-weight: var(--fw-semi); color: var(--c-ink-heading); }
  .pd__say-who i { margin-top: 3px; font-size: var(--fs-label); font-weight: var(--fw-medium); color: var(--c-ink-muted); }

  /* ── chapters ───────────────────────────────────────────────
     FIXED HEIGHTS ARE GONE. The old showcase was four slots at 737, 700, 700
     and 754px that drew whether or not they held an image, which is why four
     of the eleven case studies shipped dark holes. Nothing here has a height:
     a chapter that has no pictures is not rendered at all, and the grids size
     to what is in them. */
  .pd__chapter { margin-top: 104px; }
  .pd__ch-tick { display: block; width: 16px; height: 1.5px; background: var(--c-rule-strong); }
  .pd__ch-h {
    margin: 22px 0 0; font-size: var(--fs-stat); line-height: var(--lh-stat);
    font-weight: var(--fw-semi); letter-spacing: var(--ls-display); color: var(--c-ink-heading);
  }
  .pd__ch-sub {
    margin: 10px 0 0; font-size: var(--fs-body); line-height: var(--lh-body);
    font-weight: var(--fw-medium); letter-spacing: var(--ls-body); color: var(--c-ink-muted);
  }

  /* GROUNDWORK reads smaller than the product on purpose. A wireframe shown
     at the same scale as a finished screen claims to be one. Three across,
     on paper rather than on the dark card the product screens sit on, and
     each one captioned with what it actually is. */
  .pd__ground {
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px; margin: 40px 0 0; padding: 0; list-style: none;
  }
  .pd__ground li { display: flex; flex-direction: column; gap: 12px; }
  /* SPACE IS RESERVED AND NOTHING IS CROPPED. These are migrated WordPress
     uploads with no dimensions in the content, so `height: auto` gives the
     browser nothing to hold: the page reflows as each one loads, and a file
     that 404s collapses its row to a hairline. An aspect-ratio on the frame
     reserves the space; object-fit: contain means a picture that is not that
     shape is letterboxed rather than cut, which matters when the picture is
     a wireframe whose edges are the content. */
  .pd__ground img {
    display: block; width: 100%; height: auto; aspect-ratio: 4 / 3;
    object-fit: contain; border-radius: 12px;
    background: rgb(244, 244, 242);
    box-shadow: inset 0 0 0 1px rgba(20, 20, 20, 0.08);
  }
  .pd__cap {
    font-size: var(--fs-micro); line-height: 1; font-weight: var(--fw-semi);
    letter-spacing: 0.16em; text-transform: uppercase; color: rgba(20, 20, 20, 0.5);
  }

  /* WEB screens are landscape: two across, and one on its own goes full width
     rather than sitting in half a row with a gap beside it. */
  .pd__web {
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 34px; margin: 44px 0 0; padding: 0; list-style: none;
  }
  .pd__web:has(> :only-child) { grid-template-columns: minmax(0, 1fr); }
  .pd__web img {
    display: block; width: 100%; height: auto; aspect-ratio: 16 / 10;
    object-fit: cover; border-radius: 12px;
    background: rgb(30, 30, 30);
  }

  /* APP screens are portrait phone captures at wildly different crops, so
     nothing here forces an aspect ratio — cropping them would hide the
     interface the page exists to show. */
  .pd__app {
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 28px; margin: 44px 0 0; padding: 0; list-style: none;
  }
  .pd__app li {
    background: rgb(244, 244, 242);
    box-shadow: inset 0 0 0 1px rgba(20, 20, 20, 0.08);
    border-radius: 12px; overflow: hidden;
  }
  /* Portrait, and contained rather than covered: phone captures arrive at
