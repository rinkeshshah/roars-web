---
/**
 * Case study detail. Twenty-three live URLs at /work/[slug]/.
 *
 * Routes come from the inventory. Client names come from src/lib/projects.ts.
 * Bodies and hero images arrive with the content migration, so these render
 * the pending state with the real client name in the heading and carry
 * noindex until then.
 */
import { getCollection, render } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import MarketingPage from '../../components/MarketingPage.astro'
import Section from '../../components/Section.astro'
import TopBar from '../../components/TopBar.astro'
import NavOverlay from '../../components/NavOverlay.astro'
import SiteFooter from '../../components/SiteFooter.astro'
import GrainField from '../../components/GrainField.astro'
import RingField from '../../components/RingField.astro'
import { PORTRAIT, workHeroFor } from '../../lib/media'
import { slugsOf, nameFromSlug } from '../../lib/inventory'
import { clientFor, isHeldBack, PROJECTS } from '../../lib/projects'
import { site } from '../../lib/site'

export async function getStaticPaths() {
  const entries = await getCollection('projects')
  const byId = new Map(entries.map((e) => [e.id, e]))
  return slugsOf('post(work)').map((slug) => ({
    params: { slug },
    props: { entry: byId.get(slug) },
  }))
}

const { slug } = Astro.params
const { entry } = Astro.props
const path = `/work/${slug}/`

/* Built, but not offered: off the /work/ index and noindex here. The URL keeps
   resolving to the real case study, so the named receipts that industry and
   service pages carry for these projects still land somewhere true. See
   HELD_BACK in src/lib/projects.ts for why this is not a redirect. */
const heldBack = isHeldBack(slug as string)
const client = entry?.data.client ?? clientFor(slug) ?? nameFromSlug(slug)

const schema = entry
  ? [
      {
        '@context': 'https://schema.org',
        '@type': 'CreativeWork',
        '@id': `${site.url}${path}#work`,
        name: entry.data.title,
        about: client,
        creator: { '@id': `${site.url}/#organization` },
        datePublished: entry.data.publishedAt.toISOString(),
        description: entry.data.seo.description,
      },
      {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
          { '@type': 'ListItem', position: 2, name: 'Work', item: `${site.url}/work/` },
          { '@type': 'ListItem', position: 3, name: client },
        ],
      },
    ]
  : []

const { Content } = entry ? await render(entry) : { Content: null }
const d = entry?.data
/* Designed when the case study has its about line. One of the twenty-three
   today; the rest keep the pending state, which is noindex, rather than a
   layout wrapped around a client name. */
const designed = Boolean(d?.about)

/* The header photo. One value shared with every band that credits this
   project, so what a reader sees on an industry page is what they get when
   they follow the link.
   A content file's own heroImage wins; the registry is the fallback, and the
   two must not disagree — a band showing one photo and the page showing
   another is the bug this is here to prevent. */
const registryHero = workHeroFor(`/work/${slug}/`)
if (d?.heroImage && registryHero && d.heroImage !== registryHero) {
  throw new Error(
    `work/${slug}: heroImage is "${d.heroImage}" but src/lib/projects.ts says ` +
      `"${registryHero}". The work page header and the featured bands that ` +
      'credit this project must show the same photograph. Fix one of them.',
  )
}
const heroSrc = d?.heroImage ?? registryHero
const faces = (d?.team ?? [])
  .map((k) => PORTRAIT[k as keyof typeof PORTRAIT])
  .filter(Boolean)

/**
 * THE PICTURES, GROUPED BY WHAT THEY ARE.
 *
 * gallery / showcase / screens record where the old WordPress page put a
 * picture, not what the picture is. Reading them as three layout slots is
 * what gave Tanishq and Snowman four empty dark boxes — the showcase drew
 * its frames whether or not there was anything to put in them — while
 * GymBait's thirteen app screens were tipped into one undifferentiated grid
 * at the bottom under "13 MORE FROM THE BUILD".
 *
 * So the three arrays are flattened and re-sorted by `kind`, and the page is
 * built from chapters that appear only when they hold something. Eleven case
 * studies carrying between two and sixteen pictures then use one template,
 * and the thin ones come out short rather than broken.
 */
const media = [...(d?.gallery ?? []), ...(d?.showcase ?? []), ...(d?.screens ?? [])]
const pick = (...kinds: string[]) => media.filter((m) => m.kind && kinds.includes(m.kind))

/**
 * NOT PHONE-SHAPED, WHICH IS A DIFFERENT QUESTION FROM WHAT IT IS.
 *
 * A file 1536 across and 806 tall is a contact sheet: four phone screens laid
 * out side by side. A file 1170 across and 2532 tall is one screen. Both come
 * through the migration tagged `app`, and the template used to put both in a
 * 9/16 box — right for the second, and it destroys the first. On Parqly that
 * turned five sheets, twenty screens of interface, into five grey squares
 * with an unreadable band across the middle.
 *
 * This asked "is it wider than 1.2" for two builds and that was the wrong
 * test, in a way GymBait made obvious: its contact sheet is 1497 x 1536, an
 * eighteen-screen board in six columns, and at a ratio of 0.97 it failed a
 * wide test and went into the 9/16 portrait grid — the exact failure the
 * whole rule was written to prevent, arrived at from a new direction.
 *
 * A single phone capture is the only thing that belongs in that grid, and a
 * phone capture is unmistakable: 0.42 to 0.56, tall and narrow, because that
 * is the shape of a phone. Everything else is a board, a sheet, a photograph
 * or a study, and all of those want the column. So the line is 0.7, with a
 * wide margin on both sides of it and nothing anywhere near.
 */
const PHONE_MAX = 0.7
/**
 * AND IT ONLY APPLIES TO `app`. A web capture is a picture of a website, and a
 * website is a wide thing whatever the capture's height: Advisee's are 1.05 to
 * 1.59 and one full blog page is 0.70, all of them taller than the 16/10 box
 * the web grid was cropping them into, so every one lost its bottom half. A
 * `web` entry with dimensions takes the column at its own shape, full stop.
 * The portrait grid exists for one thing, a phone screen, and nothing else
 * belongs in it.
 */
const isPhoneShaped = (m: { w?: number; h?: number; kind?: string }) =>
  m.kind === 'app' && Boolean(m.w && m.h && m.w / m.h <= PHONE_MAX)
/**
 * AND BIG ENOUGH TO FILL THE COLUMN.
 *
 * Shape alone is not sufficient. Snowman's design study is 824 x 521 — the
 * right shape, and a 1.65x upscale if it takes the 1362 column, which is a
 * soft picture on a page whose whole argument is that you can read the
 * interface. 1200 keeps the upscale under about 1.15x at the widest layout,
 * and anything smaller goes in the grid where it is shown at a size it has
 * the pixels for.
 */
const MIN_FULL = 1200
const isWide = (m: { w?: number; h?: number; kind?: string }) =>
  Boolean(m.w && m.h && m.w >= MIN_FULL && !isPhoneShaped(m))

/** The process: how it was structured, and how it was dressed. Split by shape,
 *  because a wireframe sheet and a single wireframe want different room. */
const groundwork = pick('wireframe', 'study')
const groundSheets = groundwork.filter(isWide)
const groundGrid = groundwork.filter((m) => !isWide(m))

/** The product. Web screens are landscape and app screens portrait, so they
 *  keep their own grids; anything wide leaves both and gets the full column. */
const shipped = pick('app', 'web')
const sheets = shipped.filter(isWide)
const appShots = pick('app').filter((m) => !isWide(m))
const webShots = pick('web').filter((m) => !isWide(m))

/** Photographs and anything nobody classified. Never dropped.
 *  A photograph is the one picture on a case study that is of the real world,
 *  so it gets a stage of its own rather than a cell in a grid. */
const rest = media.filter((m) => !m.kind || m.kind === 'photo')
const photoStages = rest.filter(isWide)
const restGrid = rest.filter((m) => !isWide(m))

/** Inline style that both reserves the space and stops the wide pictures
 *  reflowing the page as they load. */
const ratio = (m: { w?: number; h?: number }) =>
  m.w && m.h ? `aspect-ratio:${m.w} / ${m.h}` : undefined

/**
 * THE PROJECT EITHER SIDE OF THIS ONE.
 *
 * Walks LISTED_PROJECTS, which is the same order /work/ prints, so "next" is
 * the card that was below this one on the page the reader came from rather
 * than an order invented here.
 *
 * IT WRAPS. Eleven listed projects, and stopping at the ends leaves the first
 * and last case study with one lonely link and a gap where the other should
 * be. Wrapping keeps the band the same shape everywhere and, at this length, a
 * reader who walks off the end lands back at the start rather than at a dead
 * stop. "All projects" sits between the two for anyone who wants out.
 *
 * EVERY DETAIL PAGE GETS A BAND, AND ONLY LISTED PROJECTS ARE DESTINATIONS.
 * Twelve of the twenty-three are held back: off /work/ and noindex, but their
 * URLs still resolve because industry and service pages name them. Walking
 * LISTED_PROJECTS alone left those twelve with no way onward at all except
 * the footer. So the walk runs over the FULL order, which is where a
 * held-back project does have a position, and steps outward past anything
 * held back until it finds one that is offered. A page nobody is meant to
 * find is never the thing at the end of an arrow.
 */
const ORDER = PROJECTS.map((p) => p.slug)
const hereAll = ORDER.indexOf(slug as string)
const neighbour = (dir: 1 | -1) => {
  if (hereAll < 0) return undefined
  for (let step = 1; step <= ORDER.length; step++) {
    const p = PROJECTS[(hereAll + dir * step + ORDER.length * ORDER.length) % ORDER.length]
    if (p && p.slug !== slug && !isHeldBack(p.slug)) return p
  }
  return undefined
}
const prevProject = neighbour(-1)
const nextProject = neighbour(1)
---

{designed && d ? (
  <BaseLayout
    title={d.seo.title}
    description={d.seo.description}
    path={path}
    schema={schema}
    noindex={d.needsReview || heldBack}
  >
    <TopBar slot="topbar" cta="contact" />
    <NavOverlay />

    {/* ── Banner, 1440x196 ──────────────────────────────────────
        The export crops the project's own photo into this strip under a 0.35
        wash. At 196px that is a sliver of a picture — you cannot read it, and
        it competes with the same photo shown properly 250px lower.
        So it takes the ground every other inner page opens on instead: the
        warm dark gradient, the drift and the grain, at the export's height.
        The project image is then shown once, large, with nothing arguing
        with it. ────────────────────────────────────────────────────────── */}
    <Section ground="dark" bleed>
      <div class="pb">
        <GrainField tone="dark" second />
      </div>
    </Section>

    {/* ── The case study, 1440x5534 in the export ──────────────────────── */}
    <Section ground="light">
      <div class="pd">
        <div class="pd__head">
          <a class="pd__back" href="/work/">
            See all Projects
            <span class="pd__dot pd__dot--grey" aria-hidden="true"></span>
            <span class="pd__dot pd__dot--ink" aria-hidden="true"></span>
          </a>
          {/* Title and date in one flowing block, absolutely placed as a
              pair. They used to be two absolute boxes at top 182 and top 311,
              which only works while the title is one line — and it is not.
              "The President's Club" at the top of the clamp is about 1400px
              of nowrap type starting at x=452, so it ran clean off the right
              of the page. Now it wraps and the date follows it down. */}
          <div class="pd__title">
            <h1 class="pd__client">{d.headline ?? d.client}</h1>
            {d.dateLabel && <p class="pd__date">{d.dateLabel}</p>}
          </div>

          {faces.length > 0 && (
            <div class="pd__team">
              {/* A staggered cluster, not a row: the export offsets the second
                  column 8px so five faces read as a team rather than a list. */}
              <span class="pd__faces">
                {faces.map((src, i) => (
                  <img src={src} alt="" width="40" height="40" loading="lazy" style={`--i:${i}`} />
                ))}
              </span>
              <span class="pd__team-label">Team Members Involved</span>
            </div>
          )}
        </div>

        {heroSrc && (
          <div class="pd__hero" data-reveal>
            <img
              src={heroSrc}
              alt={d.heroAlt || ''}
              width="2400" height="1200" loading="lazy" decoding="async"
            />
            <RingField variant="sweep" />
          </div>
        )}

        <div class="pd__about" data-reveal>
          <span class="pd__label">About:</span>
          <p class="pd__statement">{d.about}</p>
          {d.facts.length > 0 && (
            <dl class="pd__facts">
              {d.facts.map((f) => (
                <div><dt>{f.k}</dt><dd>{f.v}</dd></div>
              ))}
            </dl>
          )}
          {/* The export draws a "Live Version" pill here. NOT BUILT: this is
              an internal warehouse system, there is no public URL for it, and
              a button pointing at the client's marketing site would be a link
              to the wrong thing. `liveUrl` is in the schema for the case
              studies that do have one. */}
        </div>


        {d.blocks[0] && (
          <div class="pd__block" data-reveal>
            <h2 class="pd__block-h">{d.blocks[0].heading}</h2>
            <div class="pd__block-body">
              <p class="pd__lead">{d.blocks[0].lead}</p>
              {d.blocks[0].body && <p class="pd__more">{d.blocks[0].body}</p>}
            </div>
          </div>
        )}

        {/* GROUNDWORK — the wireframes and the colour and type studies.
            These are working documents, not the product, and they used to be
            shown at the same size and in the same grid as finished screens,
            which flattered neither. Smaller, captioned, on their own rule, so
            the page reads process first and product second. */}
        {groundwork.length > 0 && (
          <section class="pd__chapter pd__chapter--ground" data-reveal>
            <span class="pd__ch-tick" aria-hidden="true"></span>
            <h2 class="pd__ch-h">Groundwork</h2>
            <p class="pd__ch-sub">Structure first, then the look of it.</p>

            {/* Wide sheets take the column. A wireframe sheet is four screens
                of thinking and it is the only thing on this page that shows
                the argument before the paint. */}
            {groundSheets.length > 0 && (
              <ul class="pd__sheets pd__sheets--ground">
                {groundSheets.map((m, i) => (
                  <li data-reveal style={`transition-delay:${Math.min(i, 4) * 70}ms`}>
                    <span class="pd__sheet-vp">
                      <img
                        src={m.src} alt={m.alt} width={m.w} height={m.h}
                        style={ratio(m)} loading="lazy" decoding="async"
                      />
                    </span>
                    <span class="pd__cap">
                      <b>{String(i + 1).padStart(2, '0')}</b>
                      {m.caption ?? (m.kind === 'wireframe' ? 'Wireframe' : 'Colour and type')}
                    </span>
                  </li>
                ))}
              </ul>
            )}

            {groundGrid.length > 0 && (
              <ul class="pd__ground">
                {groundGrid.map((m, i) => (
                  <li data-reveal style={`transition-delay:${Math.min(i, 5) * 60}ms`}>
                    {/* Its own shape where we know it. A brand sheet is a
                        palette strip at 3:1 next to a moodboard at 1.45:1, and
                        forcing both into a 4/3 box leaves the strip as a thin
                        line floating in grey. 4/3 stays as the fallback for
                        the migrated entries that carry no dimensions. */}
                    <img
                      src={m.src} alt={m.alt} width={m.w} height={m.h}
                      style={ratio(m)} loading="lazy" decoding="async"
                    />
                    <span class="pd__cap">{m.caption ?? (m.kind === 'wireframe' ? 'Wireframe' : 'Colour and type')}</span>
                  </li>
                ))}
              </ul>
            )}
          </section>
        )}

        {/* THE PHOTOGRAPHS ARE DEALT BETWEEN THE PARAGRAPHS, one after each
            block, rather than swept into the grid at the bottom.

            A case study that puts every picture after every word asks the
            reader to hold four paragraphs in their head and then go looking
            for what they described. Parqly's photograph of a hand holding the
            app next to the actual yellow lock on the actual driveway is the
            single most convincing thing on the page, and it belongs against
            the paragraph about hardware integration, not eight screens later
            in a 16/10 crop.

            Run out of photographs and the blocks simply carry on. */}
        {d.blocks.slice(1).map((b, i) => (
          <>
            <div class="pd__block" data-reveal>
              <h2 class="pd__block-h">{b.heading}</h2>
              <div class="pd__block-body">
                <p class="pd__lead">{b.lead}</p>
                {b.body && <p class="pd__more">{b.body}</p>}
              </div>
            </div>
            {photoStages[i] && (
              <figure
                class:list={['pd__stage', photoStages[i].ground === 'dark' && 'pd__stage--dark']}
                data-reveal
              >
                <img
                  src={photoStages[i].src}
                  alt={photoStages[i].alt}
                  width={photoStages[i].w}
                  height={photoStages[i].h}
                  style={ratio(photoStages[i])}
                  loading="lazy"
                  decoding="async"
                />
                {photoStages[i].caption && (
                  <figcaption class="pd__stage-cap">{photoStages[i].caption}</figcaption>
                )}
              </figure>
            )}
          </>
        ))}

        {/* Any photograph the blocks ran out of room for still gets a stage. */}
        {photoStages.slice(Math.max(0, d.blocks.length - 1)).map((m) => (
          <figure class:list={['pd__stage', m.ground === 'dark' && 'pd__stage--dark']} data-reveal>
            <img
              src={m.src} alt={m.alt} width={m.w} height={m.h}
              style={ratio(m)} loading="lazy" decoding="async"
            />
            {m.caption && <figcaption class="pd__stage-cap">{m.caption}</figcaption>}
          </figure>
        ))}

        {/* THE PRODUCT. Web screens are landscape and app screens portrait, so
            they get separate grids rather than one grid that suits neither.
            Either chapter is skipped when the project has none of that kind,
            which is how a three-picture case study and a sixteen-picture one
            use the same template. */}
        {(webShots.length > 0 || appShots.length > 0 || sheets.length > 0 || restGrid.length > 0) && (
          <section class="pd__chapter" data-reveal>
            <span class="pd__ch-tick" aria-hidden="true"></span>
            <h2 class="pd__ch-h">What shipped</h2>
            <p class="pd__ch-sub">
              {[
                sheets.length && `${sheets.length} screen ${sheets.length === 1 ? 'sheet' : 'sheets'}`,
                webShots.length && `${webShots.length} web`,
                appShots.length && `${appShots.length} app`,
              ].filter(Boolean).join(' · ') || 'From the build'}
            </p>

            {/* THE SHEETS, FULL COLUMN AND STACKED. Four screens in one file
                is a row of an interface, and a row of an interface read at a
                quarter of the column is a texture, not a screen. Numbered,
                because stacked at this size they are a sequence. */}
            {sheets.length > 0 && (
              <ul class="pd__sheets">
                {sheets.map((m, i) => (
                  <li data-reveal style={`transition-delay:${Math.min(i, 4) * 70}ms`}>
                    <span class="pd__sheet-vp">
                      <img
                        src={m.src} alt={m.alt} width={m.w} height={m.h}
                        style={ratio(m)} loading="lazy" decoding="async"
                      />
                    </span>
                    {m.caption && (
                      <span class="pd__cap">
                        <b>{String(i + 1).padStart(2, '0')}</b>{m.caption}
                      </span>
                    )}
                  </li>
                ))}
              </ul>
            )}

            {webShots.length > 0 && (
              <ul class="pd__web">
                {webShots.map((m, i) => (
                  <li data-reveal style={`transition-delay:${Math.min(i, 4) * 60}ms`}>
                    <img src={m.src} alt={m.alt} loading="lazy" decoding="async" />
                  </li>
                ))}
              </ul>
            )}

            {appShots.length > 0 && (
              <ul class="pd__app">
                {appShots.map((m, i) => (
                  <li data-reveal style={`transition-delay:${Math.min(i, 5) * 50}ms`}>
                    <img src={m.src} alt={m.alt} loading="lazy" decoding="async" />
                  </li>
                ))}
              </ul>
            )}

            {restGrid.length > 0 && (
              <ul class="pd__web">
                {restGrid.map((m, i) => (
                  <li data-reveal style={`transition-delay:${Math.min(i, 4) * 60}ms`}>
                    <img src={m.src} alt={m.alt} loading="lazy" decoding="async" />
                  </li>
                ))}
              </ul>
            )}
          </section>
        )}

        {/* THE CLIENT'S VERDICT, after the work rather than before it. A quote
            placed above the pictures asks the reader to take the outcome on
            trust; placed here it lands on something they have just seen.
            Only ever a quote whose role names this client outright — see the
            note on `testimonial` in content.config.ts. */}
        {d.testimonial && (
          <figure class="pd__say" data-reveal>
            <span class="pd__say-mark" aria-hidden="true">&ldquo;</span>
            <blockquote class="pd__say-q">{d.testimonial.quote}</blockquote>
            <figcaption class="pd__say-who">
              {d.testimonial.portrait
                ? <img src={d.testimonial.portrait} alt="" width="56" height="56" loading="lazy" />
                : <span class="pd__say-mono" aria-hidden="true">
                    {d.testimonial.name.split(' ').map((w) => w[0]).slice(0, 2).join('')}
                  </span>}
              <span>
                <b>{d.testimonial.name}</b>
                <i>{d.testimonial.role}</i>
              </span>
            </figcaption>
          </figure>
        )}

        {/* The migrated body. The export has no slot for it; a case study with
            four sentences is not a case study, and this is the page that has
            to answer "have they done logistics". Given its own header and
            numbered sections so it reads as part of the page rather than as
            text that got appended to it. */}
        {Content && (
          <div class="pd__long" data-reveal>
            <span class="pd__long-tick" aria-hidden="true"></span>
            <span class="pd__long-eyebrow">THE LONG VERSION</span>
            <div class="pd__prose"><Content /></div>
          </div>
        )}
      </div>
    </Section>

    {/* Where to go next, which until now was "back up to the header link or
        out through the footer". A case study is the end of a path, and the
        useful thing to offer at the end of one is the next one. */}
    {(prevProject || nextProject) && (
      <Section ground="accent" bleed>
        <GrainField tone="yellow" />
        <nav class="wrap pdnav" aria-label="More case studies">
          {prevProject && (
            <a class="pdnav__side pdnav__side--prev" href={`/work/${prevProject.slug}/`} rel="prev">
              <span class="pdnav__dir"><i aria-hidden="true">&larr;</i>Previous</span>
              <span class="pdnav__name">{prevProject.client}</span>
            </a>
          )}
          <a class="pdnav__all" href="/work/">All projects</a>
          {nextProject && (
            <a class="pdnav__side pdnav__side--next" href={`/work/${nextProject.slug}/`} rel="next">
              <span class="pdnav__dir">Next<i aria-hidden="true">&rarr;</i></span>
              <span class="pdnav__name">{nextProject.client}</span>
            </a>
          )}
        </nav>
      </Section>
    )}

    <SiteFooter
      slot="footer"
      blurbTitle="Got a floor that runs on clipboards?"
      blurb="Most operations problems look like software problems once you watch the shift. Tell us what the shift looks like."
      tagline="proof, not promises"
      ctaLabel="Shall we chat?"
      ctaHref="https://meet.roarsinc.com/sales"
    />
  </BaseLayout>
) : (
<MarketingPage
  topCta="contact"
  title={entry?.data.seo.title ?? `${client} Case Study | ${site.name}`}
  description={entry?.data.seo.description}
  path={path}
  label="Case study"
  heading={client}
  schema={schema}
  pending={!entry}
>
  {Content && <Content />}
</MarketingPage>
)}

<style>
  /* ── banner ─────────────────────────────────────────────── */
  .pb { position: relative; height: 196px; overflow: hidden; background: var(--c-black); }

  /* ── the case study ─────────────────────────────────────── */
  .pd { position: relative; padding-block: 102px 120px; }

  /* The head is a fixed 1358x330 with three anchors — back link at 206,
     client at 182, date at 311 — so the client name sits BESIDE the link
     rather than under it, which is the whole arrangement. */
  /* The title is IN FLOW and the offsets are padding, so a two-line name
     pushes this band taller instead of spilling into the photograph below.
     min-height keeps the export's 330 for the short names, which is every
     other case study. The back link and the team cluster stay absolute:
     neither grows, and both are anchored to the top of the band. */
  .pd__head { position: relative; min-height: 330px; padding-top: 182px; }
  .pd__back {
    position: absolute; left: 0; top: 206px;
    font-size: 18px; line-height: 19px; font-weight: var(--fw-semi);
    letter-spacing: -0.06em; color: var(--c-black);
  }
  .pd__dot { position: absolute; width: 8px; height: 8px; border-radius: 50%; }
  .pd__back .pd__dot { top: 7px; }
  .pd__back .pd__dot--grey { left: 130px; background: rgb(153, 152, 149); opacity: 0.6; }
  .pd__back .pd__dot--ink { left: 141px; background: rgb(20, 20, 20); }
  /* The title block. 452 is the export's left anchor, and the width runs to
     the right edge of the 1362 column, which is what a long client name needs
     and what nowrap was refusing to give it. */
  .pd__title { margin-left: 452px; }
  .pd__client {
    margin: 0; max-width: 100%;
    /* 0.86em rather than a fixed 86px: at 124px that is the export's exact
       leading, and it stays proportional when the clamp shrinks the type, so
       two lines of a long name set tight instead of drifting apart. */
    font-size: clamp(48px, 7.4vw, 124px); line-height: 0.86;
    font-weight: var(--fw-semi); letter-spacing: -0.04em; color: rgb(20, 20, 20);
    text-wrap: balance;
  }
  .pd__date {
    margin: 28px 0 0 5px;
    font-size: 20px; line-height: 19px; font-weight: var(--fw-medium);
    letter-spacing: -0.06em; color: var(--c-black);
  }

  .pd__team { position: absolute; left: 67.988%; top: 0; width: 31.718%; height: 134px; }
  .pd__faces { position: relative; display: block; width: 83px; height: 134px; }
  .pd__faces img {
    position: absolute; width: 40px; height: 40px; border-radius: 50%;
    background: rgb(217, 217, 217); object-fit: cover;
  }
  /* Two columns, the right one lifted 8px. The export places five faces by
     hand; this is the same five positions expressed once. */
  .pd__faces img:nth-child(1) { left: 0; top: 8px; }
  .pd__faces img:nth-child(2) { left: 43px; top: 0; }
  .pd__faces img:nth-child(3) { left: 0; top: 55px; }
  .pd__faces img:nth-child(4) { left: 43px; top: 47px; }
  .pd__faces img:nth-child(5) { left: 43px; top: 94px; }
  .pd__team-label {
    position: absolute; left: 117px; top: 4px; width: 180px;
    font-size: 18px; line-height: 24px; font-weight: var(--fw-medium);
    letter-spacing: -0.03em; color: rgb(20, 20, 20);
  }

  /* AMBER DUSK, THE DETAIL-PAGE VERSION. The /work/ card and this header now
     belong to one family, which is the point — but they are not the same
     picture doing the same job, so they are not the same treatment.

     The CARD carries the client name, the sector and the year ON the
     photograph, so it needs brightness .62 and a directional ink gradient
     dense enough to hold white type. Neither of those is about the picture;
     both are about the copy.

     THIS HEADER CARRIES NO TYPE AT ALL. The name and the date sit above it on
     white. So the ink gradient is dropped — there is nothing to protect, and a
     dense left edge would just be a dark half for no reason — and the
     exposure comes back to .82, because here the photograph IS the subject
     rather than a ground. What carries across is the amber from the far
     corner, which is the family resemblance and the one place yellow touches
     an image anywhere on the site. */
  .pd__hero { position: relative; margin-top: 27px; overflow: hidden; border-radius: 12px; background: rgb(30, 30, 30); }
  /* 2:1, THE SHAPE THE FILES ARE CUT TO. The box was a fixed 737px on a
     1358px column, 1.84:1, so a 2:1 photograph lost a strip off each side to
     `object-fit: cover` — the same fault the /work/ card had before it was
     unified. scripts/build-work-headers.mjs crops every header to 2:1 once, at
     build time, so nothing needs cropping again here.
     Saturation is baked into the file at 0.8 rather than applied as a CSS
     filter: one source of truth, and no filter to composite on a 2400px image
     at paint time. */
  .pd__hero img { display: block; width: 100%; aspect-ratio: 2 / 1; object-fit: cover; filter: var(--sweep-grade); }

  /* ── about ──────────────────────────────────────────────── */
  .pd__about { position: relative; margin-top: 83px; }
  .pd__label {
    position: absolute; left: 0; top: 0;
    font-size: var(--fs-body); line-height: 24px; font-weight: var(--fw-medium);
    letter-spacing: var(--ls-item); color: rgba(71, 71, 71, 0.8);
  }
  .pd__statement {
    margin: 0 0 0 461px; max-width: 689px;
    font-size: 26px; line-height: 37px; font-weight: var(--fw-semi);
    letter-spacing: var(--ls-item); color: var(--c-black);
  }
  .pd__facts { margin: 74px 0 0 457px; }
  .pd__facts > div { position: relative; display: flex; height: 42px; padding-top: 17px; }
  .pd__facts > div::before {
    content: ''; position: absolute; left: 0; top: 0;
    width: 897px; height: 0.5px; background: rgba(71, 71, 71, 0.2);
  }
  .pd__facts > div + div { margin-top: 18px; }
  .pd__facts dt {
    width: 465px;
    font-size: var(--fs-label); line-height: 24px; font-weight: var(--fw-medium);
    letter-spacing: -0.02em; color: rgba(71, 71, 71, 0.8);
  }
  .pd__facts dd {
    margin: 0;
    font-size: var(--fs-body); line-height: 24px; font-weight: var(--fw-medium);
    letter-spacing: var(--ls-item); color: var(--c-black);
  }
  /* ── the pair ───────────────────────────────────────────── */
  /* ── the client's verdict ───────────────────────────────── */
  .pd__say {
    margin: 104px 0 0; padding: 48px 0 0;
    border-top: 1.5px solid var(--c-rule-strong);
    max-width: 900px;
  }
  .pd__say-mark {
    display: block; font-size: 84px; line-height: 0.6;
    font-weight: var(--fw-semi); color: var(--c-accent);
  }
  .pd__say-q {
    margin: 24px 0 0; font-size: var(--fs-intro); line-height: var(--lh-intro);
    font-weight: var(--fw-medium); letter-spacing: var(--ls-item); color: var(--c-ink-heading);
  }
  .pd__say-who { display: flex; align-items: center; gap: 16px; margin-top: 32px; }
  .pd__say-who img, .pd__say-mono {
    width: 56px; height: 56px; border-radius: var(--r-circle);
    object-fit: cover; flex: none; background: rgb(233, 233, 231);
  }
  .pd__say-mono {
    display: grid; place-items: center;
    font-size: var(--fs-label); font-weight: var(--fw-semi);
    letter-spacing: var(--ls-item); color: var(--c-ink-heading);
  }
  .pd__say-who b, .pd__say-who i {
    display: block; font-style: normal; letter-spacing: var(--ls-body);
  }
  .pd__say-who b { font-size: var(--fs-body); font-weight: var(--fw-semi); color: var(--c-ink-heading); }
  .pd__say-who i { margin-top: 3px; font-size: var(--fs-label); font-weight: var(--fw-medium); color: var(--c-ink-muted); }

  /* ── chapters ───────────────────────────────────────────────
     FIXED HEIGHTS ARE GONE. The old showcase was four slots at 737, 700, 700
     and 754px that drew whether or not they held an image, which is why four
     of the eleven case studies shipped dark holes. Nothing here has a height:
     a chapter that has no pictures is not rendered at all, and the grids size
     to what is in them. */
  .pd__chapter { margin-top: 104px; }
  .pd__ch-tick { display: block; width: 16px; height: 1.5px; background: var(--c-rule-strong); }
  .pd__ch-h {
    margin: 22px 0 0; font-size: var(--fs-stat); line-height: var(--lh-stat);
    font-weight: var(--fw-semi); letter-spacing: var(--ls-display); color: var(--c-ink-heading);
  }
  .pd__ch-sub {
    margin: 10px 0 0; font-size: var(--fs-body); line-height: var(--lh-body);
    font-weight: var(--fw-medium); letter-spacing: var(--ls-body); color: var(--c-ink-muted);
  }

  /* GROUNDWORK reads smaller than the product on purpose. A wireframe shown
     at the same scale as a finished screen claims to be one. Three across,
     on paper rather than on the dark card the product screens sit on, and
     each one captioned with what it actually is. */
  /* Two across by default, three once there are three of them. A single
     groundwork picture in a three-column grid sits in the left third with two
     thirds of nothing beside it, and at 430px a study collage is too small to
     read. Two columns give it 660, which is also about the size the smaller
     files have the pixels for. */
  .pd__ground {
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px; margin: 40px 0 0; padding: 0; list-style: none;
  }
  .pd__ground:has(> :nth-child(3)) { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .pd__ground li { display: flex; flex-direction: column; gap: 12px; }
  /* SPACE IS RESERVED AND NOTHING IS CROPPED. These are migrated WordPress
     uploads with no dimensions in the content, so `height: auto` gives the
     browser nothing to hold: the page reflows as each one loads, and a file
     that 404s collapses its row to a hairline. An aspect-ratio on the frame
     reserves the space; object-fit: contain means a picture that is not that
     shape is letterboxed rather than cut, which matters when the picture is
     a wireframe whose edges are the content. */
  .pd__ground img {
    display: block; width: 100%; height: auto; aspect-ratio: 4 / 3;
    object-fit: contain; border-radius: 12px;
    background: rgb(244, 244, 242);
    box-shadow: inset 0 0 0 1px rgba(20, 20, 20, 0.08);
  }
  .pd__cap {
    font-size: var(--fs-micro); line-height: 1; font-weight: var(--fw-semi);
    letter-spacing: 0.16em; text-transform: uppercase; color: rgba(20, 20, 20, 0.5);
  }

  /* ── CONTACT SHEETS ─────────────────────────────────────────
     A sheet is several screens in one wide file. It gets the whole column and
     nothing beside it, because at half the column each screen inside it is
     about 160px across and you are looking at a pattern rather than an
     interface.

     aspect-ratio comes from the entry's own w and h as an inline style, so
     the box is the picture's real shape: no letterboxing, no crop, and the
     space is reserved before the file arrives. These are migrated uploads
     with no dimensions in the markup, and without this the page grew by
     several thousand pixels as each one landed.

     PAPER, NOT A DARK CARD. Every one of these sheets is artwork on white, so
     a dark frame around it draws a hard rectangle the designer never drew.
     The hairline is enough to say where the picture ends. */
  .pd__sheets { margin: 44px 0 0; padding: 0; list-style: none; display: grid; gap: 44px; }
  /* min-width: 0, or the grid item sizes to its content instead of its track
     and the sideways-scrolling viewport below just makes the row wider. */
  .pd__sheets li { min-width: 0; }
  .pd__sheet-vp { display: block; max-width: 100%; }
  .pd__sheets img {
    display: block; width: 100%; height: auto;
    aspect-ratio: 16 / 9;            /* fallback until w/h override it inline */
    object-fit: contain;
    border-radius: 14px;
    background: rgb(250, 250, 249);
    box-shadow: inset 0 0 0 1px rgba(20, 20, 20, 0.07);
  }
  .pd__sheets .pd__cap { display: flex; align-items: baseline; gap: 10px; margin-top: 14px; }
  .pd__sheets .pd__cap b { font-weight: var(--fw-semi); color: rgba(20, 20, 20, 0.28); }
  /* Groundwork reads quieter than the product, here as everywhere else on
     this page: the same sheet, inset, on a flatter ground. */
  .pd__sheets--ground img { background: rgb(244, 244, 242); border-radius: 12px; }
  .pd__sheets--ground { gap: 34px; }

  /* ── THE PHOTOGRAPH STAGE ───────────────────────────────────
     THE CONTAINER, AND THE WHOLE OF IT.
     Two wrong answers before this one. First it ran to the viewport with a
     40px gutter, which ignored the column the rest of the page is set to and
     read as a different website for one scroll. Then it was capped at 1040,
     which fixed that and introduced a worse problem: the photographs came out
     narrower than the contact sheets directly above them, so a band of
     pictures had two different left edges.

     One measure. A photograph and a screen sheet are both pictures on the
     same page and they line up. The height follows from the file's own aspect
     ratio and is not something to negotiate with. */
  .pd__stage {
    position: relative; margin: 64px 0 0;
    border-radius: 16px; overflow: clip;
  }
  .pd__stage img { display: block; width: 100%; height: auto; object-fit: cover; }
  .pd__stage-cap {
    position: absolute; left: 24px; bottom: 20px; margin: 0;
    padding: 7px 14px; border-radius: 40px;
    background: rgba(255, 255, 255, 0.86);
    backdrop-filter: blur(6px);
    font-size: var(--fs-micro); line-height: 1.4; font-weight: var(--fw-semi);
    letter-spacing: var(--ls-item); color: rgb(20, 20, 20);
  }
  /* A picture that is already black on black needs no frame and no white
     caption chip. The ground carries through to the edge of the file. */
  .pd__stage--dark { background: rgb(12, 12, 12); }
  .pd__stage--dark .pd__stage-cap {
    background: rgba(20, 20, 20, 0.72); color: var(--c-white);
  }

  /* WEB screens are landscape: two across, and one on its own goes full width
     rather than sitting in half a row with a gap beside it. */
  .pd__web {
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 34px; margin: 44px 0 0; padding: 0; list-style: none;
  }
  .pd__web:has(> :only-child) { grid-template-columns: minmax(0, 1fr); }
  .pd__web img {
    display: block; width: 100%; height: auto; aspect-ratio: 16 / 10;
    object-fit: cover; border-radius: 12px;
    background: rgb(30, 30, 30);
  }

  /* APP screens are portrait phone captures at wildly different crops, so
     nothing here forces an aspect ratio — cropping them would hide the
     interface the page exists to show. */
  .pd__app {
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 28px; margin: 44px 0 0; padding: 0; list-style: none;
  }
  .pd__app li {
    background: rgb(244, 244, 242);
    box-shadow: inset 0 0 0 1px rgba(20, 20, 20, 0.08);
    border-radius: 12px; overflow: hidden;
  }
  /* Portrait, and contained rather than covered: phone captures arrive at
     every crop there is and cropping them again hides the interface. */
  .pd__app img {
    display: block; width: 100%; height: auto; aspect-ratio: 9 / 16;
    object-fit: contain;
  }

  /* ── previous / next ────────────────────────────────────────
     Three columns with the middle one auto, so the two names sit hard against
     the gutters and "All projects" stays centred on the page rather than
     centred between two labels of different lengths. */
  /* THE SAME GROUND AS THE HOMEPAGE HERO. GrainField tone="yellow" is the one
     place that gradient is written down, so this cannot drift from the hero;
     z-index 1 lifts the links above it because GrainField paints inset 0. */
  .pdnav {
    position: relative; z-index: 1;
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center;
    gap: 24px; padding-block: 82px;
  }
  .pdnav__side { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
  .pdnav__side--next { text-align: right; align-items: flex-end; }
  /* The one in the middle is a way out, not a destination, so it reads at
     label weight while the two names read as headings. */
  .pdnav__all {
    justify-self: center;
    font-size: var(--fs-micro); line-height: 1; font-weight: var(--fw-semi);
    letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-muted);
    transition: color var(--dur-fast) ease;
  }
  .pdnav__all:hover { color: var(--ink); }
  .pdnav__dir {
    display: flex; align-items: center; gap: 8px;
    font-size: var(--fs-micro); line-height: 1; font-weight: var(--fw-semi);
    letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-muted);
  }
  .pdnav__dir i { font-style: normal; transition: translate var(--dur-fast) var(--ease-out); }
  .pdnav__name {
    font-size: 30px; line-height: 1.16; font-weight: var(--fw-semi);
    letter-spacing: var(--ls-item); color: var(--ink);
    transition: opacity var(--dur-fast) ease;
    overflow-wrap: anywhere;
  }
  /* The arrow leans the way you are going. Nothing else moves, so the whole
     band does not shift under the pointer. */
  .pdnav__side--prev:hover .pdnav__dir i { translate: -4px 0; }
  .pdnav__side--next:hover .pdnav__dir i { translate: 4px 0; }
  .pdnav__side:hover .pdnav__name { opacity: 0.66; }
  @media (prefers-reduced-motion: reduce) {
    .pdnav__dir i { transition: none; }
    .pdnav__side--prev:hover .pdnav__dir i,
    .pdnav__side--next:hover .pdnav__dir i { translate: none; }
  }

  /* ── goals and outcome ──────────────────────────────────── */
  .pd__block { position: relative; margin-top: 82px; }
  .pd__block-h {
    position: absolute; left: 0; top: 0; margin: 0; width: 380px;
    font-size: 26px; line-height: 37px; font-weight: var(--fw-semi);
    letter-spacing: var(--ls-item); color: var(--c-black);
  }
  .pd__block-body { margin-left: 461px; max-width: 707px; }
  .pd__lead {
    margin: 0;
    font-size: 26px; line-height: 37px; font-weight: var(--fw-semi);
    letter-spacing: var(--ls-item); color: var(--c-black);
  }
  .pd__more {
    margin: 25px 0 0;
    font-size: 18px; line-height: 28px; font-weight: var(--fw-medium);
    letter-spacing: -0.03em; color: rgba(71, 71, 71, 0.85);
  }

  /* ── the migrated body ──────────────────────────────────────
     The page has one rhythm — label left at 0, prose right at 461 — and
     Goals and Outcome both use it. Left in a single column the body ignored
     it and ran as one slab against an empty rail.
     Each heading FLOATS back into that rail with a negative margin, so it
     lines up with the paragraph it belongs to instead of sitting above it.
     That is the only way to get the pairing out of plain markdown, which has
     no element to wrap a section in. `clear: left` keeps one section's
     heading from riding up beside the previous one's. */
  .pd__long { margin-top: 104px; }
  .pd__long-tick { display: block; width: 16px; height: 1.5px; background: var(--c-rule-strong); }
  .pd__long-eyebrow {
    display: block; margin-top: 20px;
    font-size: var(--fs-micro); line-height: 19px; font-weight: var(--fw-medium);
    letter-spacing: 0.18em; color: var(--c-ink-label);
  }
  /* The screens grid. Sized by the image rather than by a fixed panel: these
     are phone captures of wildly different crops, and forcing them into one
     aspect ratio would crop the interface the page exists to show. */

  /**
   * THE LONG VERSION. A GRID, NOT A FLOAT.
   *
   * This paired a heading with its paragraph by floating the heading into the
   * rail and letting the paragraph flow beside it. That is the only two-column
   * pairing plain markdown allows, since markdown gives no element to wrap a
   * section in — and it is pairing by visual adjacency, which is not the same
   * thing as pairing by markup.
   *
   * It broke twice on Advisee. Its body has two group titles with no paragraph
   * of their own, "Objectives" and "Project Outcome", so each captured the next
   * item's copy and everything below slid up by one. Fixing that left a second
   * failure: a paragraph SHORTER than its heading does not push the next
   * heading past it, so the next heading floats up beside the previous
   * paragraph. Measured on the built page, six of nine sections were still
   * showing another section's copy.
   *
   * So the pairing stops being positional. The heading spans both columns and
   * the paragraph sits in the second one, which is a grid placement rather
   * than a float, and a heading with no paragraph simply has nothing under it.
   * There is no arrangement of headings and paragraphs that can mis-pair,
   * because nothing is being paired: each element is placed where it belongs.
   */
  .pd__prose {
    counter-reset: sec; margin: 56px 0 0; max-width: 1168px;
    display: grid; grid-template-columns: 461px minmax(0, 707px);
  }
  .pd__prose :global(h2) {
    grid-column: 1 / -1; margin: 0;
    font-size: 26px; line-height: 37px; font-weight: var(--fw-semi);
    letter-spacing: var(--ls-item); color: var(--c-black);
  }
  /* Numbered by CSS counter, because markdown gives no element to hang a
     number on and the copy should not carry one — "01" is presentation.
     Set LARGE, because the rail is otherwise empty for the whole depth of
     each section and a 11px label left it looking like a mistake. The big
     tinted numeral is the same device the proof stats use. */
  .pd__prose :global(h2)::before {
    counter-increment: sec;
    content: '0' counter(sec);
    display: block; margin-bottom: 10px;
    font-size: 52px; line-height: 1; font-weight: var(--fw-semi);
    letter-spacing: var(--ls-display); color: rgba(20, 20, 20, 0.18);
  }
  /* A HEADING WITH NO PARAGRAPH IS A GROUP LABEL, NOT AN ITEM. "Objectives"
     and "Project Outcome" are titles over the items beneath them, not items.
     `content: none` on the ::before also stops the counter, which is what
     keeps the numbering on the items rather than the labels. */
  .pd__prose :global(h2:has(+ h2)) {
    font-size: var(--fs-micro); line-height: 19px; font-weight: var(--fw-semi);
    letter-spacing: 0.18em; text-transform: uppercase; color: var(--c-ink-label);
  }
  .pd__prose :global(h2:has(+ h2))::before { content: none; }

  /* Column two, always. The paragraph lands under its own heading and beside
     nothing, whatever the heading above it did. */
  .pd__prose :global(p) {
    grid-column: 2; margin: 0;
    font-size: 18px; line-height: 28px; font-weight: var(--fw-medium);
    letter-spacing: -0.03em; color: rgba(71, 71, 71, 0.85);
  }
  .pd__prose :global(p + p) { margin-top: 20px; }
  .pd__prose :global(h2 + p) { margin-top: 18px; }

  /* A hairline opens each section, drawn across both columns. It can hang off
     the heading now rather than off the first paragraph, because the heading
     is no longer floated and a section with no paragraph still gets its rule. */
  .pd__prose :global(h2:not(:first-child)) {
    margin-top: 96px; padding-top: 46px;
    border-top: 0.5px solid var(--c-rule-soft);
  }
  .pd__prose :global(h2:has(+ h2) + h2) { margin-top: 40px; padding-top: 0; border-top: 0; }

  /* ── below the design grid ──────────────────────────────── */
  @media (max-width: 1360px) {
    .pd { padding-block: 64px 72px; }
    /* THE TITLE WAS INVISIBLE ON A PHONE. Every child of .pd__head was reset
       here except .pd__title itself, which kept the desktop
       `margin-left: 452px` that clears the back link's rail. In a 350px column
       that leaves the block NEGATIVE room, so it measured x=472, width 0: the
       client name was laid out past the right edge of a box with no width, and
       nothing painted. `min-height` and the 182px `padding-top` came along too,
       which is why there was an empty half-screen above the place the title
       was not. `height: auto` was the only thing being reset, and height was
       never what was holding the box open. */
    .pd__head { min-height: 0; height: auto; padding-top: 0; }
    .pd__title { margin-left: 0; }
    .pd__back, .pd__client, .pd__date, .pd__team { position: static; width: auto; height: auto; }
    .pd__back { display: inline-block; }
    .pd__client { margin-top: 28px; line-height: 1.04; }
    .pd__date { margin-top: 10px; }
    .pd__team { display: flex; align-items: center; gap: 18px; margin-top: 32px; }
    .pd__team-label { position: static; width: auto; }
    .pd__about { margin-top: 48px; }
    .pd__label { position: static; display: block; }
    .pd__statement { margin: 14px 0 0; max-width: 620px; }
    .pd__facts { margin: 40px 0 0; }
    .pd__facts > div { flex-direction: column; height: auto; gap: 4px; padding-bottom: 14px; }
    .pd__facts > div::before { width: 100%; }
    .pd__facts dt { width: auto; }
    .pd__live { margin: 32px 0 0; }
