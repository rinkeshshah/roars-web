---
/**
 * Resource pages. Fifteen live URLs at /resources/[slug]/. Gated downloads.
 *
 * Routes come from docs/URL-INVENTORY.csv, not from the collection, so every
 * ranking URL resolves even before its body is migrated. Seeded entries render
 * their real content; the rest render the pending state and carry noindex.
 */
import { getCollection, render } from 'astro:content'
import MarketingPage from '../../components/MarketingPage.astro'
import { slugsOf, nameFromSlug } from '../../lib/inventory'
import { site } from '../../lib/site'

export async function getStaticPaths() {
  const entries = await getCollection('resources')
  const byId = new Map(entries.map((e) => [e.id, e]))
  return slugsOf('free_stuff').map((slug) => ({
    params: { slug },
    props: { entry: byId.get(slug) },
  }))
}

const { slug } = Astro.params
const { entry } = Astro.props
const path = `/resources/${slug}/`
const name = entry?.data.title ?? nameFromSlug(slug)

const schema = entry
  ? [
      {
        '@context': 'https://schema.org',
        '@type': 'WebPage',
        '@id': `${site.url}${path}#webpage`,
        name,
        description: entry.data.seo.description,
        isPartOf: { '@id': `${site.url}/#website` },
      },
      {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
          { '@type': 'ListItem', position: 2, name: 'Resources', item: `${site.url}/resources/` },
          { '@type': 'ListItem', position: 3, name },
        ],
      },
    ]
  : []

const { Content } = entry ? await render(entry) : { Content: null }
---

<MarketingPage
  title={entry?.data.seo.title ?? `${name} | ${site.name}`}
  description={entry?.data.seo.description}
  path={path}
  label="Resource"
  heading={name}
  schema={schema}
  pending={!entry}
>
  {Content && <Content />}
</MarketingPage>
