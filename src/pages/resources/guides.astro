---
/**
 * The guide library, at /resources/guides/.
 *
 * A ROUTE THE CSV DOES NOT CARRY. The inventory has fifteen flat
 * /resources/<slug>/ rows and no index of any kind; this page and /resources/
 * are both additions, asked for directly. That is allowed and the flat rule in
 * CLAUDE.md still holds — it governs where a GUIDE lives, and guides still
 * live at /resources/<slug>/. Nothing that ranks has moved.
 *
 * Built against design/prototypes/Roars v2 - Guides.dc.html.
 * Canvas, section-relative: Hero 700, Library 2740.
 *
 * The export's hero says "10 GUIDES" and its chip row reads "10 / 10". The
 * CSV has fifteen, and the CSV wins — both counts are computed, so neither can
 * drift from what is actually on the shelf.
 *
 * The chip row is approved island 3 (filter chips) — client-side only, so a
 * filtered view never becomes its own indexable URL. See docs/SEO-SPEC.md.
 */
import { getCollection } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import Section from '../../components/Section.astro'
import TopBar from '../../components/TopBar.astro'
import NavOverlay from '../../components/NavOverlay.astro'
import SiteFooter from '../../components/SiteFooter.astro'
import GrainField from '../../components/GrainField.astro'
import CanvasPlate from '../../components/CanvasPlate.astro'
import { slugsOf, nameFromSlug } from '../../lib/inventory'
import { GUIDE_COVER, GUIDE_SET } from '../../lib/media'
import { site } from '../../lib/site'
import star5 from '../../assets/star-5.svg'

const path = '/resources/guides/'

/* The export lays the shelf out grouped by category, not in inventory order:
   business model, then our favourite, problem discovery, strategy. Reading a
   shelf means scanning for the group you need, so the grouping IS the design.
   The five with no copy written anywhere have no category and fall to the end
   rather than being filed somewhere invented. */
const SHELF_ORDER = [
  'business-model-canvas', 'building-partnerships', 'business-plan',
  'swot-analysis', 'learning-loop',
  'product-solution-benefit', 'value-proposition', 'target-group', 'prototype-testing-plan',
  'evidence-planning',
]
const rank = (slug: string) => {
  const i = SHELF_ORDER.indexOf(slug)
  return i === -1 ? SHELF_ORDER.length : i
}

/* Cards come from the INVENTORY, not the collection, so all fifteen live URLs
   are reachable. Ten carry the export's copy; the other five have none written
   anywhere and get their real name and no blurb rather than an invented one. */
const entries = await getCollection('resources')
const byId = new Map(entries.map((e) => [e.id, e]))
const items = slugsOf('free_stuff').map((slug) => {
  const d = byId.get(slug)?.data
  return {
    slug,
    href: `/resources/${slug}/`,
    name: d?.title ?? nameFromSlug(slug),
    summary: d?.summary,
    category: d?.category,
    /* Absent only for the five whose cover path is recorded nowhere. See
       src/lib/media.ts. */
    cover: GUIDE_COVER[slug],
  }
}).sort((x, y) => rank(x.slug) - rank(y.slug))

/* The chip row is built from what the entries actually carry, in the export's
   order. A category nothing is filed under never gets a chip, so no chip can
   return an empty shelf. */
const ORDER = ['BUSINESS MODEL', 'OUR FAVOURITE', 'PROBLEM DISCOVERY', 'STRATEGY']
const present = new Set(items.map((i) => i.category).filter(Boolean) as string[])
const categories = ORDER.filter((c) => present.has(c))
const key = (c: string) => c.toLowerCase().replace(/\s+/g, '-')

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    '@id': `${site.url}${path}#collection`,
    name: 'Guides',
    isPartOf: { '@id': `${site.url}/#website` },
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: items.length,
      itemListElement: items.map((it, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: it.name,
        url: `${site.url}${it.href}`,
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Resources', item: `${site.url}/resources/` },
      { '@type': 'ListItem', position: 3, name: 'Guides' },
    ],
  },
]
---

<BaseLayout
  title="15 Free One-Page Guides & Templates | Roars"
  description="Browse all 15 one-page guides: business model canvas, SWOT analysis, value proposition canvas, pitching checklist and more. Free PDF downloads."
  path={path}
  schema={schema}
>
  <TopBar slot="topbar" cta="meeting" />
  <NavOverlay />

  {/* ── Hero, 1440x700 ───────────────────── */}
  <Section ground="dark" bleed>
    <div class="gh">
      <GrainField tone="dark" second />
      <div class="wrap gh__inner">
        <div class="gh__rail" data-reveal>
          <a class="gh__back" href="/resources/">← RESOURCES / GUIDES</a>
          <span class="gh__tick" aria-hidden="true"></span>
          <p class="gh__statement">
            Everything you need to know about innovation, in our free PDF guides, with
            examples, templates, agendas.
          </p>
          <ul class="gh__pills">
            <li>{items.length} GUIDES</li>
            <li>PDF</li>
            <li>FREE</li>
          </ul>
        </div>

        <div class="gh__mast" data-reveal>
          <span class="g-chip">
            <span>roars</span>
            <span class="starmark g-chip__star" style={`--m:url(${star5.src})`} aria-hidden="true"></span>
          </span>
          <h1 class="gh__large">Guides</h1>
          <p class="gh__standfirst">Examples, templates, agendas</p>
        </div>

        {/* Three offset sheets with the set's own cover on top. Served from
            /wp-content/uploads/ like every other photograph here, so it 404s
            in this build and resolves on the webspace. */}
        <div class="gh__preview" data-reveal aria-hidden="true">
          <span class="gh__sheet gh__sheet--3"></span>
          <span class="gh__sheet gh__sheet--2"></span>
          <span class="gh__sheet gh__sheet--1">
            <span class="gh__cover">
              <CanvasPlate />
              <img src={GUIDE_SET} alt="" width="256" height="186" loading="lazy" decoding="async" />
            </span>
            <em class="gh__stamp">THE GUIDE SET</em>
            <em class="gh__page">PDF · 01</em>
          </span>
        </div>
      </div>
    </div>
  </Section>

  {/* ── The library, 1440x2740 ─────────────────────────────── */}
  <Section ground="light">
    <div class="rl">
      <span class="r-rule" aria-hidden="true"></span>
      <span class="r-eyebrow">ALL CATEGORIES</span>
      <h2 class="rl__h">the shelf</h2>
      <p class="rl__intro" data-reveal>
        One page each. Print it, fill it in, take it into the room. Filter by what you are
        trying to work out.
      </p>

      <div class="rl__chips" data-filter-group="guides">
        <button type="button" data-filter="all" aria-pressed="true">ALL</button>
        {categories.map((c) => (
          <button type="button" data-filter={key(c)} aria-pressed="false">{c}</button>
        ))}
        <span class="rl__count" data-filter-readout>{items.length} / {items.length}</span>
      </div>

      <ul class="rl__grid">
        {items.map((it, i) => (
          <li
            class="rl__card"
            data-filter-item="guides"
            data-cats={it.category ? key(it.category) : ''}
            data-reveal
            style={`transition-delay:${(i % 3) * 70}ms`}
          >
            <a href={it.href}>
              <span class="rl__cat">{it.category ?? 'GUIDE'}</span>
              <span class="rl__thumb" aria-hidden="true">
                <CanvasPlate shape={it.category === 'OUR FAVOURITE' ? 'quad' : 'grid'} />
                {it.cover && (
                  <img src={it.cover} alt="" width="434" height="200" loading="lazy" decoding="async" />
                )}
              </span>
              <span class="rl__name">{it.name}</span>
              {it.summary && <span class="rl__sum">{it.summary}</span>}
              <span class="rl__dl">Download <span aria-hidden="true">↓</span></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </Section>

  <SiteFooter
    slot="footer"
    blurbTitle="Want the one page version of your problem?"
    blurb="Take a template into the room first. If the problem turns out to be bigger than a page, that is worth a call."
    tagline="ours to make, yours to download"
    ctaLabel="Shall we chat?"
    ctaHref="https://meet.roarsinc.com/sales"
  />
</BaseLayout>

<style>
  /* ── shared ──────────────────────────────── */
  .r-eyebrow {
    display: block;
    font-size: var(--fs-micro); line-height: 19px; font-weight: var(--fw-medium);
    letter-spacing: 0.18em; color: var(--c-ink-label);
  }
  .r-rule { display: block; height: 1.5px; background: var(--c-rule-strong); }
  .g-chip { position: relative; display: flex; align-items: flex-start; height: 24px; margin-left: 8px; }
  .g-chip > span:first-child {
    font-size: 20px; line-height: 20px; font-weight: var(--fw-semi);
    letter-spacing: var(--ls-item); color: #fbfbfb; padding-top: 4px;
  }
  .g-chip__star { position: absolute; left: 52px; top: 0; width: 10px; height: 10px; color: #fbfbfb; }

  /* ── hero ────────────────────────────────── */
  .gh { position: relative; }
  .gh__inner {
    position: relative; z-index: 1;
    display: grid; grid-template-columns: 380px 632px minmax(0, 1fr);
    align-content: start; padding-block: 180px 0; min-height: 700px;
  }
  /* Fixed offsets, as the export authors them: 0 / 38 / 64 / 186. */
  .gh__rail { position: relative; grid-column: 1; grid-row: 1; width: 400px; height: 300px; }
  .gh__back {
    display: block;
    font-size: var(--fs-micro); line-height: 19px; font-weight: var(--fw-medium);
    letter-spacing: 0.18em; color: rgba(255, 255, 255, 0.55);
    transition: color var(--dur-fast) ease;
  }
  .gh__back:hover { color: rgba(255, 255, 255, 0.9); }
  .gh__tick { position: absolute; top: 38px; display: block; width: 16px; height: 1.5px; background: var(--c-accent); }
  .gh__statement {
    position: absolute; top: 64px; margin: 0; width: 390px;
    font-size: var(--fs-intro); line-height: 30px; font-weight: var(--fw-medium);
    letter-spacing: var(--ls-item); color: rgba(255, 255, 255, 0.94);
  }
  .gh__pills {
    position: absolute; top: 186px; left: 0; margin: 0; padding: 0; list-style: none;
    display: flex; flex-wrap: wrap; gap: 8px; width: 400px;
  }
  .gh__pills li {
    padding: 7px 14px; border-radius: var(--r-pill);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.22);
    font-size: 11px; line-height: normal; font-weight: var(--fw-medium);
    letter-spacing: 0.12em; color: rgba(255, 255, 255, 0.88);
  }

  .gh__mast { grid-column: 2; grid-row: 1; margin-top: 160px; }
  .gh__large {
    margin: 24px 0 0; white-space: nowrap;
    font-size: clamp(56px, 10.28vw, 148px); line-height: 140px; font-weight: var(--fw-semi);
    letter-spacing: -0.055em; color: rgb(251, 251, 251);
  }
  .gh__standfirst {
    margin: 16px 0 0 6px; max-width: 560px;
    font-size: var(--fs-item); line-height: 34px; font-weight: var(--fw-medium);
    letter-spacing: var(--ls-item); color: rgba(255, 255, 255, 0.72);
  }

  /* Fills its track rather than fixing 350px, which is only correct at a
     1440 viewport and overhangs the edge at every width below it. */
  .gh__preview { position: relative; grid-column: 3; grid-row: 1; width: 100%; max-width: 350px; height: 330px; margin-top: -12px; }
  /* Percentages of the preview, which now fills its track. Fixed 300px
     sheets inside a shrinking box hang off the right edge. */
  .gh__sheet { position: absolute; display: block; width: 85.715%; height: 286px; }
  .gh__sheet--3 { left: 7.429%; top: 26px; background: rgba(251, 251, 249, 0.32); }
  .gh__sheet--2 { left: 4%; top: 14px; background: rgba(251, 251, 249, 0.6); }
  .gh__sheet--1 { left: 0; top: 0; background: rgb(251, 251, 249); border-top: 4px solid var(--c-accent); }
  .gh__cover { position: absolute; left: 22px; top: 30px; overflow: hidden; width: 256px; height: 186px; background: rgb(240, 240, 237); }
  .gh__cover img { display: block; width: 100%; height: 100%; object-fit: contain; }
  .gh__stamp, .gh__page {
    position: absolute; top: 217px; font-style: normal; line-height: normal;
    font-size: 10px; font-weight: var(--fw-semi); letter-spacing: 0.2em; color: rgba(20, 20, 20, 0.5);
  }
  .gh__stamp { left: 22px; }
  .gh__page { left: 216px; font-weight: var(--fw-medium); letter-spacing: 0.16em; color: rgba(20, 20, 20, 0.4); }

  /* ── the library ────────────────────────────────────────── */
  .rl { position: relative; padding-block: 80px 100px; }
  .rl .r-eyebrow { margin-top: 24px; }
  .rl__h {
    margin: 18px 0 0 -7px;
    font-size: clamp(46px, 5.84vw, var(--fs-display)); line-height: 86px;
    font-weight: var(--fw-semi); letter-spacing: var(--ls-display); color: var(--c-ink-heading);
  }
  .rl__intro {
    position: absolute; left: 67.695%; top: 156px; width: 32.305%; margin: 0;
    font-size: var(--fs-body); line-height: 23px; font-weight: var(--fw-medium);
    letter-spacing: var(--ls-item); color: rgba(20, 20, 20, 0.62);
  }
  .rl__chips { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; margin-top: 62px; }
  .rl__chips button {
    padding: 8px 16px; border: 0; border-radius: var(--r-pill); cursor: pointer;
    background: transparent; box-shadow: inset 0 0 0 1px rgba(20, 20, 20, 0.16);
    font-size: 11px; line-height: normal; font-weight: var(--fw-medium);
    letter-spacing: 0.12em; color: rgb(20, 20, 20);
    transition: background var(--dur-fast) ease, box-shadow var(--dur-fast) ease;
  }
  .rl__chips button:hover { box-shadow: inset 0 0 0 1px rgba(20, 20, 20, 0.4); }
  .rl__chips button[aria-pressed='true'] { background: var(--c-accent); box-shadow: none; }
  .rl__count {
    margin-left: 12px;
    font-size: 11px; line-height: normal; font-weight: var(--fw-medium);
    letter-spacing: 0.14em; color: var(--c-ink-label);
  }

  .rl__grid {
    list-style: none; margin: 61px 0 0; padding: 0;
    display: grid; grid-template-columns: repeat(3, 434fr); column-gap: 30px; row-gap: 50px;
  }
  /* Fixed 434x530, everything pinned to the export's offsets — 20 / 50 / 268 /
     348 / 490. Five of the fifteen have no blurb and two of those share a row
     with one that does; left in flow their "Download" lands wherever the copy
     stops, and the row reads as a mistake. */
  .rl__card { position: relative; }
  .rl__card a { display: block; position: relative; height: 640px; }
  .rl__card a::before {
    content: ''; position: absolute; left: 0; top: 0;
    width: 100%; height: 0.5px; background: var(--c-rule-soft);
  }
  .rl__cat {
    position: absolute; top: 20px; left: 0;
    font-size: 11px; line-height: normal; font-weight: var(--fw-medium);
    letter-spacing: 0.14em; color: var(--c-ink-label);
  }
  /* Served from /wp-content/uploads/ like every other photograph on the site,
     so it 404s in this build and resolves on the webspace; media.ts blanks it
     meanwhile and the slot reads as the drawn block it is now. */
  /* THE BOX IS THE SHAPE OF THE ARTWORK, AND THE FIT IS `contain`.
     It was 434x200 with `object-fit: cover`, which is the pair that cut the
     covers. The guide covers are slide exports at roughly 4:3; cover scales
     the art until it fills the box and discards the overflow, so a 2.17:1 box
     sliced about 60px off the top and the bottom of every card — the Roars
     logo lost its top half and the illustration lost its feet.
     Raising the height alone would not have fixed it: cover always fills, so
     any box that is not exactly the art's ratio still crops. `contain` fits
     the whole image in and can never cut, and the height below makes the box
     ~1.4:1 so what it leaves over is a few pixels rather than grey bands. */
  .rl__thumb {
    position: absolute; top: 50px; left: 0; display: block;
    overflow: hidden; width: 100%; height: 310px; background: rgb(244, 244, 242);
  }
  .rl__thumb img { position: relative; display: block; width: 100%; height: 100%; object-fit: contain; }
  .rl__name {
    position: absolute; top: 378px; left: 0; display: block; width: 420px;
    font-size: 28px; line-height: 34px; font-weight: var(--fw-semi);
    letter-spacing: -0.045em; color: var(--c-ink-heading);
    transition: color var(--dur-fast) ease;
  }
  .rl__card a:hover .rl__name { color: var(--c-black); }
  .rl__sum {
    position: absolute; top: 458px; left: 0; display: block; width: 420px;
    font-size: 15px; line-height: 23px; font-weight: var(--fw-medium);
    letter-spacing: -0.045em; color: rgba(20, 20, 20, 0.72);
  }
  .rl__dl {
    position: absolute; top: 600px; left: 0; display: block;
    font-size: var(--fs-body); line-height: 22px; font-weight: var(--fw-semi);
    letter-spacing: var(--ls-item); color: rgb(20, 20, 20);
  }

  /* ── below the design grid ───────────────────── */
  @media (max-width: 1360px) {
    .gh__inner { grid-template-columns: 1fr; min-height: 0; padding-block: 130px 72px; row-gap: 40px; }
    .gh__rail, .gh__mast, .gh__preview { grid-column: 1; grid-row: auto; margin-top: 0; width: auto; height: auto; }
    .gh__rail { max-width: 460px; }
    .gh__tick, .gh__statement, .gh__pills { position: static; top: auto; width: auto; max-width: 440px; }
    .gh__tick { margin-top: 19px; }
    .gh__statement { margin-top: 27px; }
    .gh__pills { margin-top: 26px; }
    .gh__large { white-space: normal; line-height: 1.02; }
    .gh__preview { width: 350px; height: 320px; }

    .rl { padding-block: 64px 72px; }
    .rl__h { line-height: 1.06; margin-left: 0; }
    .rl__intro { position: static; width: auto; max-width: 560px; margin-top: 28px; }
    .rl__chips { margin-top: 36px; }
    .rl__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 24px; }
    .rl__card a { height: auto; padding-top: 20px; }
    .rl__cat, .rl__thumb, .rl__name, .rl__sum, .rl__dl { position: static; top: auto; width: auto; }
    /* The column is narrower here, so a fixed 310px box would stop matching
       the artwork and start showing bands again. Let the ratio hold it.

       POSITION STAYS RELATIVE. The rule above turns the whole card static, and
       that quietly broke the plate: CanvasPlate positions its parts absolutely,
       so with a static thumb their containing block became the card instead,
       and `overflow: hidden` does not clip a box whose containing block is
       outside it. The plate's blocks escaped and drew over the copy below. */
    .rl__thumb { position: relative; margin-top: 30px; height: auto; aspect-ratio: 434 / 310; }
    .rl__name { margin-top: 18px; }
    .rl__sum { margin-top: 12px; }
    .rl__dl { margin-top: 22px; }
  }
  @media (max-width: 780px) {
    .rl__grid { grid-template-columns: 1fr; }
    .rl__name { font-size: var(--fs-item); line-height: 1.25; }
  }
</style>
