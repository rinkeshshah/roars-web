---
/**
 * The two resource CATEGORY ARCHIVES: /resource/staff-picks/ and
 * /resource/tools/.
 *
 * THEY ARE ARCHIVES, NOT PAGES. Each one lists its own children, the same way
 * /resources/guides/ lists the guide items. That is the thing this file does
 * NOT yet have, so it holds the URL and says so.
 *
 * WHAT WENT WRONG HERE, so nobody repeats it. An earlier version of this file
 * read the two shelf cards on /resources/ as two standalone pages and built
 * them: a hand-written "shortlist" for staff picks, and a re-cut of the
 * fifteen guide PDFs for tools. Both were wrong. Staff Picks and Tools are
 * categories with their own item pages underneath them, and nothing in this
 * repository lists those items.
 *
 * WHY THE CHILDREN ARE NOT IN THE INVENTORY. docs/URL-INVENTORY-FINDINGS.md
 * says the inventory came from the six live Squirrly sitemaps, crawled 13 Sep
 * 2026, and those sitemaps carry fifteen /resources/<slug>/ items and no
 * taxonomy archives at all. So the two category URLs were missing, and so is
 * every child under them. They are not absent because they do not exist; they
 * are absent because the crawl could not see them.
 *
 * HOW TO FINISH THIS. Run scripts/wordpress-export/wp-rest-export.sh from a
 * machine that can reach the site. It now pulls every registered taxonomy,
 * every term, and the items filed under each. That gives the real child list
 * for both archives, and this file becomes the same shape as
 * /resources/guides/.
 *
 * The URLs themselves are real and are inventory rows: both are marked KEEP
 * with "migrate at the identical URL" in docs/migration/roars-url-decisions.csv,
 * and design/specs/Resources.md links both absolute URLs from the shelf cards
 * it draws. Note the SINGULAR /resource/, which is not a typo.
 */
import MarketingPage from '../../components/MarketingPage.astro'
import { site } from '../../lib/site'

export function getStaticPaths() {
  return [{ params: { archive: 'staff-picks' } }, { params: { archive: 'tools' } }]
}

const { archive } = Astro.params
const path = `/resource/${archive}/`

const META = {
  'staff-picks': {
    name: 'Staff Picks',
    /* The export's own shelf copy, verbatim, which is the one thing about
       these two that is real. */
    blurb: 'A selection of our favorite books, tools, podcasts, guides, and more.',
  },
  tools: {
    name: 'Tools',
    blurb:
      'Actionable tools for change-makers. We have transformed a lot of boring innovation management theory into hands-on, easy-to-use, actionable innovation tools. Explore our library of PDFs, free for you to download.',
  },
} as const

const m = META[archive as keyof typeof META]

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Resources', item: `${site.url}/resources/` },
      { '@type': 'ListItem', position: 3, name: m.name },
    ],
  },
]
---

<MarketingPage
  title={`${m.name} | ${site.name}`}
  description={m.blurb}
  path={path}
  label="Resources"
  heading={m.name}
  schema={schema}
  pending
/>
