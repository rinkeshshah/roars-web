    gap: 40px;
  }
  .cv__item { padding-top: 26px; border-top: 1.5px solid var(--c-rule-strong); }
  /* A monogram: these are real, named clients and there is no portrait of any
     of them. Same call as the homepage testimonial deck. */
  .cv__avatar {
    display: grid; place-items: center;
    width: 56px; height: 56px; border-radius: var(--r-circle);
    background: rgb(226, 224, 218);
    font-size: 19px; line-height: 1; font-weight: var(--fw-semi);
    letter-spacing: var(--ls-item); color: rgb(64, 63, 60);
  }
  .cv__name { margin: 16px 0 0; font-size: var(--fs-label); line-height: 19px; font-weight: var(--fw-semi); letter-spacing: var(--ls-body); color: rgb(31, 31, 31); }
  .cv__role { margin: 0; font-size: var(--fs-label); line-height: 19px; font-weight: var(--fw-medium); letter-spacing: var(--ls-body); color: var(--c-ink-label); }
  .cv__quote { margin: 18px 0 0; font-size: var(--fs-intro); line-height: 28px; font-weight: var(--fw-medium); letter-spacing: var(--ls-item); color: var(--c-ink-heading); }

  @media (max-width: 1360px) {
    .ch__in { padding-block: 116px 88px; }
    .cn, .cs, .cp, .cw, .cy, .cq { padding-block: 72px 64px; }
    .cs__grid, .cy__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .cv { padding-block: 64px; }
    /* Two columns rather than four: at this width four cells are about 185px
       each and "09:00 to 18:00 GMT" has nowhere to go. The hairline selector
       changes with the column count, because it is the count that decides
       which cells start a row. */
    .cd { grid-template-columns: repeat(2, 1fr); }
    .cd__item:not(:nth-child(4n + 1)) { box-shadow: none; }
    /* Two columns: the line is on every cell that is not first in its row,
       and the second row also takes a line along its top — which the grid gap
       used to draw and no longer does. */
    .cd__item:not(:nth-child(2n + 1)) { box-shadow: inset 1px 0 0 var(--cd-line); }
    .cd__item:nth-child(n + 3) { box-shadow: inset 0 1px 0 var(--cd-line); }
    .cd__item:nth-child(n + 3):not(:nth-child(2n + 1)) {
      box-shadow: inset 1px 0 0 var(--cd-line), inset 0 1px 0 var(--cd-line);
    }
  }

  @media (max-width: 760px) {
    .ch__in { padding-block: 96px 68px; }
    .cn, .cs, .cp, .cw, .cy, .cq { padding-block: 56px 52px; }
    .cv { padding-block: 52px; }
    /* One column, and the cell padding loses its right inset so the values do
       not sit against the gutter. */
    .cd { grid-template-columns: 1fr; margin-left: 0; }
    .cd__item { padding: 22px 0 24px; }
    /* One column: nothing is beside anything, so the lines are all horizontal
       and the first cell takes none. */
    .cd__item { box-shadow: none; }
    .cd__item:nth-child(n + 2) { box-shadow: inset 0 1px 0 var(--cd-line); }
    .cn__list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .cs__grid, .cy__grid, .cq__list { grid-template-columns: minmax(0, 1fr); }
  }
