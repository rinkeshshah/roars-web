  /* ── Questions ───────────────────────────────────────────────
     TWO COLUMNS, NOT THREE. The answers run to four or five lines where a
     .cy__body runs to two, and three columns of that is a wall. A <dl> rather
     than a list of headings because that is what a question and its answer
     are, and the div wrapper is the one way to group a dt with its dd that
     the HTML spec allows. */
  .cq { padding-block: 104px 96px; }
  .cq__list {
    margin: 56px 0 0; padding: 0;
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 44px 56px;
  }
