  .cq__a { margin: 12px 0 0; font-size: var(--fs-body); line-height: 24px; font-weight: var(--fw-medium); letter-spacing: -0.045em; color: rgb(90, 90, 88); }

  /* ── Voices ──────────────────────────────────────────────── */
  .cv { padding-block: 96px; }
  .cv__grid {
