---
/**
 * /approach/ — path matches the spec exactly, no correction needed.
 * Copy verbatim from design/specs/Approach.md.
 */
import MarketingPage from '../components/MarketingPage.astro'
import { site } from '../lib/site'

const phases = [
  {
    n: '01',
    name: 'Explore',
    lead: 'Understanding your customers, business, and where you’re losing opportunity',
    body: 'Conduct focused interviews to uncover real customer behavior, not assumptions. Analyze how users currently interact with your product or service. Identify gaps, friction points, and missed opportunities in your existing experience. Map where your business can create more value through better journeys or new offerings.',
    tags: ['PEOPLE', 'STRATEGY', 'INTERACTION', 'TECHNOLOGY'],
  },
  {
    n: '02',
    name: 'Define',
    lead: 'Aligning insights into clear product direction and priorities.',
    body: 'Translate research into actionable insights that guide decisions. Define the problems worth solving based on impact and feasibility. Align business goals with user needs and product direction. Prioritize features and opportunities to avoid unnecessary complexity.',
    tags: ['CUSTOMER', 'BUSINESS', 'OBJECTIVES', 'INSIGHT'],
  },
  {
    n: '03',
    name: 'Ideate',
    lead: 'Exploring solutions and validating ideas before building.',
    body: 'Generate multiple solution directions based on defined problems. Create quick prototypes to visualize and test concepts early. Gather feedback to refine ideas and remove weak assumptions. Iterate rapidly to arrive at solutions that are both usable and viable.',
    tags: ['HYPOTHESIS', 'DESIGN', 'TEST', 'EVALUATE'],
  },
  {
    n: '04',
    name: 'Transform',
    lead: 'Designing, building, and improving products that perform.',
    body: 'Translate validated ideas into scalable product experiences. Design and develop with a focus on usability, speed, and clarity. Continuously test and optimize based on real user behavior. Evolve the product to improve performance, engagement, and growth.',
    tags: ['GUIDE', 'IMPLEMENT', 'SUPPORT'],
  },
]

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': `${site.url}/approach/#webpage`,
    name: 'Approach',
    isPartOf: { '@id': `${site.url}/#website` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Approach' },
    ],
  },
]
---

<MarketingPage
  title="Our Approach: One Process, Four Phases | Roars"
  description="At Roars we don't start with screens. We start with what's broken in your business, then design, build and scale products that actually move metrics."
  path="/approach/"
  label="Method"
  heading="Approach"
  intro="We start with what’s broken in your business."
  schema={schema}
>
  <p>
    At Roars, we don’t start with screens. We start with what’s broken in your
    business. Then we design, build, and scale products that actually move
    metrics.
  </p>

  <ol class="ph">
    {phases.map((p) => (
      <li class="ph__row">
        <div class="ph__head">
          <span class="ph__n">{p.n}</span>
          <h2 class="ph__name">{p.name}</h2>
          <p class="ph__lead">{p.lead}</p>
        </div>
        <p class="ph__body">{p.body}</p>
        <ul class="ph__tags">
          {p.tags.map((t) => <li class="ph__tag">{t}</li>)}
        </ul>
      </li>
    ))}
  </ol>
</MarketingPage>

<style>
  .ph { list-style: none; margin: var(--sp-6) 0 0; padding: 0; counter-reset: none; }
  .ph__row {
    display: grid; grid-template-columns: minmax(0, 420px) minmax(0, 400px) minmax(0, 340px);
    gap: var(--sp-5);
    padding: var(--sp-6) 0;
    border-top: 0.5px solid var(--c-rule-soft);
  }
  .ph__n { font-size: var(--fs-label); font-weight: var(--fw-semi); letter-spacing: var(--ls-body); color: var(--c-ink-label); }
  .ph__name {
    margin: var(--sp-3) 0 0 !important;
    font-size: clamp(46px, 5.8vw, var(--fs-display)) !important;
    font-weight: var(--fw-semi); line-height: 1.02;
    letter-spacing: var(--ls-display); color: var(--c-ink-heading);
  }
  .ph__lead {
    margin-top: var(--sp-4) !important;
    font-size: var(--fs-lead, 20px) !important;
    line-height: 1.4; letter-spacing: var(--ls-item);
    color: rgba(20, 20, 20, 0.78) !important;
  }
  .ph__body { font-size: var(--fs-body) !important; line-height: 1.56; color: rgba(20, 20, 20, 0.8) !important; }
  .ph__tags { display: flex; flex-wrap: wrap; gap: var(--sp-2); list-style: none; margin: 0 !important; padding: 0; }
  .ph__tag {
    font-size: 13px; font-weight: var(--fw-semi); letter-spacing: -0.02em;
    color: var(--c-ink-body); border-radius: var(--r-pill);
    box-shadow: inset 0 0 0 1px rgba(20, 20, 20, 0.16);
    padding: 8px 14px; margin: 0 !important;
    transition: box-shadow var(--dur-fast) ease, background var(--dur-fast) ease;
  }
  .ph__tag:hover { box-shadow: inset 0 0 0 1px var(--c-accent); background: rgba(255, 212, 0, 0.14); }

  @media (max-width: 1040px) { .ph__row { grid-template-columns: 1fr; } }
</style>
