---
/**
 * /approach/ — path matches the export's own name; no correction needed.
 *
 * Built against design/prototypes/Roars v2 - Approach.dc.html, measured with
 * scripts/export-geometry.mjs. Canvas 1440x5545: Header 0-780 (dark, grained),
 * Process 780-3020 (white), Track record 3020-3660 (#F5F5F5), Practices
 * 3660-4440 (white), Footer 4440.
 *
 * Coordinates in the comments are SECTION-relative as the export authors
 * them; the content box starts at the 39px gutter, so a child at x503 sits
 * 464 into the box.
 *
 * The header is the same lockup as /about-us/ — something in the rail, a
 * masthead at 450, a caption at 696, a fourth column on the right — but the
 * fourth column differs (a trust row at 929 there, a phase list at 1050 here)
 * and so does the rail. Sharing a component would mean a prop per difference,
 * so these two share a structure and not code.
 */
import BaseLayout from '../layouts/BaseLayout.astro'
import Section from '../components/Section.astro'
import TopBar from '../components/TopBar.astro'
import NavOverlay from '../components/NavOverlay.astro'
import SiteFooter from '../components/SiteFooter.astro'
import GrainField from '../components/GrainField.astro'
import { PORTRAIT } from '../lib/media'
import { site } from '../lib/site'
import quote from '../assets/quote.svg'

/* ------------------------------------------------------------ content */

const phases = [
  {
    n: '01',
    name: 'Explore',
    lead: 'Understanding your customers, business, and where you’re losing opportunity',
    body: 'Conduct focused interviews to uncover real customer behavior, not assumptions. Analyze how users currently interact with your product or service. Identify gaps, friction points, and missed opportunities in your existing experience. Map where your business can create more value through better journeys or new offerings.',
    tags: ['PEOPLE', 'STRATEGY', 'INTERACTION', 'TECHNOLOGY'],
  },
  {
    n: '02',
    name: 'Define',
    lead: 'Aligning insights into clear product direction and priorities.',
    body: 'Translate research into actionable insights that guide decisions. Define the problems worth solving based on impact and feasibility. Align business goals with user needs and product direction. Prioritize features and opportunities to avoid unnecessary complexity.',
    tags: ['CUSTOMER', 'BUSINESS', 'OBJECTIVES', 'INSIGHT'],
  },
  {
    n: '03',
    name: 'Ideate',
    lead: 'Exploring solutions and validating ideas before building.',
    body: 'Generate multiple solution directions based on defined problems. Create quick prototypes to visualize and test concepts early. Gather feedback to refine ideas and remove weak assumptions. Iterate rapidly to arrive at solutions that are both usable and viable.',
    tags: ['HYPOTHESIS', 'DESIGN', 'TEST', 'EVALUATE'],
  },
  {
    n: '04',
    name: 'Transform',
    lead: 'Designing, building, and improving products that perform.',
    body: 'Translate validated ideas into scalable product experiences. Design and develop with a focus on usability, speed, and clarity. Continuously test and optimize based on real user behavior. Evolve the product to improve performance, engagement, and growth.',
    tags: ['GUIDE', 'IMPLEMENT', 'SUPPORT'],
  },
]

const record = [
  { n: '20', suffix: '+', label: 'Years in product development' },
  { n: '250', suffix: '+', label: 'Projects delivered' },
  { n: '96', suffix: '%', pct: true, label: 'Returning customers' },
]

/** Every href is an existing /s/ route from docs/URL-INVENTORY.csv. */
const practices = [
  { n: '01', name: 'Product Development', href: '/s/product-development-company/' },
  { n: '02', name: 'User Experience Design', href: '/s/user-experience-design-agency/' },
  { n: '03', name: 'Mobile App Development', href: '/s/mobile-app-development/' },
  { n: '04', name: 'MVP Development', href: '/s/mvp-development/' },
  { n: '05', name: 'AI Automation Services', href: '/s/ai-automation-services/' },
]

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': `${site.url}/approach/#webpage`,
    name: 'Approach',
    isPartOf: { '@id': `${site.url}/#website` },
  },
  /* The page is a four-step method with a named outcome, which is what HowTo
     describes. Built from the same array the page renders, so the marked-up
     steps are the visible ones. */
  {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    '@id': `${site.url}/approach/#howto`,
    name: 'How a Roars engagement runs',
    step: phases.map((p, i) => ({
      '@type': 'HowToStep',
      position: i + 1,
      name: p.name,
      text: p.lead,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Approach' },
    ],
  },
]
---

<BaseLayout
  title="Our Approach | Problem First, Then Product"
  description="We do not start with screens. We start with what is broken in your business, then design, build and scale products that move metrics. Four phases, run since 2005."
  path="/approach/"
  schema={schema}
>
  <TopBar slot="topbar" cta="meeting" />
  <NavOverlay />

  {/* ── Header, 1440x780 ─────────────────────────────────────── */}
  <Section ground="dark" bleed>
    <div class="aph">
      <GrainField tone="dark" second />
      <div class="wrap aph__inner">
        {/* Quote block at the gutter, 384 wide, opening at 150. */}
        <div class="aph__quote" data-reveal>
          <img class="aph__mark" src={quote.src} alt="" width="32" height="27" />
          <p class="aph__statement">Most products don’t fail because of bad design.</p>
          <p class="aph__sub">They fail because no one fixed the problem first.</p>
          <div class="aph__by">
            <img class="aph__face" src={PORTRAIT.founder} alt="" width="42" height="42" />
            <span class="aph__by-text">
              <span class="aph__by-name">Rinkesh A Shah</span>
              <span class="aph__by-role">CEO / Founder</span>
            </span>
          </div>
        </div>

        {/* No union.svg under the title — see docs/HANDOFF.md. */}
        <div class="aph__mast" data-reveal>
          <span class="aph__chip"><span>roars</span></span>
          <h1 class="aph__h1">Approach</h1>
        </div>

        <p class="aph__caption" data-reveal>We start with what’s broken<br />in your business.</p>

        <div class="aph__phases" data-reveal>
          <span class="aph__phases-label">One process, four phases</span>
          <ol class="aph__phases-list">
            {phases.map((p) => (
              <li><span>{p.n}</span>{p.name}</li>
            ))}
          </ol>
        </div>
      </div>
    </div>
  </Section>

  {/* ── Process, 1440x2240 ───────────────────────────────────── */}
  <Section ground="light">
    <div class="apr">
      <span class="apr__rule" aria-hidden="true"></span>
      <span class="apr__label">Method</span>
      <h2 class="apr__h">problem first</h2>
      <div class="apr__intro" data-reveal>
        <p class="apr__intro-a">At Roars, we don’t start with screens. We start with what’s broken in your business.</p>
        <p class="apr__intro-b">Then we design, build, and scale products that actually move metrics.</p>
      </div>

      <span class="apr__rule2" aria-hidden="true"></span>
      <div class="apr__legend">
        <span>The process, end to end</span>
        <span class="apr__legend-r">problem ↓ performance</span>
      </div>

      {/* One 1500px spine with a node per phase, not a border on each row.
          The accent fills it as the section is read and lights each node as it
          passes — src/scripts/spine.ts. The first node ships lit so the rule
          is never a bare hairline, which is also the resting state under
          reduced motion. */}
      <div class="apr__spine" data-spine aria-hidden="true">
        <span class="apr__spine-line"></span>
        <span class="apr__spine-fill" data-spine-fill></span>
        {[0, 390, 790, 1190].map((t, i) => (
          <span
            class:list={['apr__node', i === 0 && 'is-on']}
            data-spine-node
            style={`top:${t}px`}
          ></span>
        ))}
        <span class="apr__node apr__node--end" data-spine-node style="top:1493px"></span>
      </div>

      <ol class="apr__steps">
        {phases.map((p) => (
          <li class="apr__step" data-reveal>
            <span class="apr__step-n">{p.n}</span>
            <h3 class="apr__step-name">{p.name}</h3>
            <p class="apr__step-lead">{p.lead}</p>
            <div class="apr__step-detail">
              <span class="apr__hair" aria-hidden="true"></span>
              <p>{p.body}</p>
            </div>
            <div class="apr__step-tags">
              <span class="apr__hair" aria-hidden="true"></span>
              <ul>{p.tags.map((t) => <li>{t}</li>)}</ul>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </Section>

  {/* ── Track record, 1440x640 on #F5F5F5 ────────────────────── */}
  <Section ground="surface">
    <div class="apt">
      <span class="apt__tick" aria-hidden="true"></span>
      <span class="apr__label">Track record</span>
      <h2 class="apt__h">Practised since 2005</h2>
      <p class="apt__intro" data-reveal>The same four phases, run for startups and enterprises across five countries.</p>
      <ul class="apt__stats">
        {record.map((r, i) => (
          <li data-reveal style={`transition-delay:${i * 60}ms`}>
            <span class="apt__hair" aria-hidden="true"></span>
            <span class="apt__n">{r.n}<i class:list={[r.pct && 'apt__pct']}>{r.suffix}</i></span>
            <span class="apt__label">{r.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </Section>

  {/* ── Practices, 1440x780 ──────────────────────────────────── */}
  <Section ground="light">
    <div class="aps">
      <span class="apr__rule" aria-hidden="true"></span>
      <span class="apr__label">Where we apply it</span>
      <h2 class="aps__h">what we build</h2>
      <p class="aps__intro" data-reveal>Five practices, one process. Every engagement runs Explore through Transform.</p>
      <ul class="aps__rows">
        {practices.map((p, i) => (
          <li data-reveal style={`transition-delay:${i * 40}ms`}>
            <a href={p.href}>
              <span class="aps__hair" aria-hidden="true"></span>
              <span class="aps__n">{p.n}</span>
              <span class="aps__name">{p.name}</span>
              <span class="aps__arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
        {/* The list closes on a rule, which is why there is one more child
            than there are rows. */}
        <li class="aps__end"><span class="aps__hair" aria-hidden="true"></span></li>
      </ul>
    </div>
  </Section>

  <SiteFooter
    slot="footer"
    tagline="problem first, always"
    blurbTitle="Got something that isn’t working?"
    blurb="Tell us what is broken. We will tell you whether it is a design problem, a product problem, or neither."
  />
</BaseLayout>

<style>
  /* ── Header ─────────────────────────────────────────────────
     Four tracks on the 1362 box: the rail, the masthead at 450, the caption
     at 696, the phase list at 1050. align-content:start, or the 780
     min-height is handed to the auto rows and everything in row two drops —
     the same trap as /about-us/. */
  .aph { position: relative; }
  .aph__inner {
    position: relative; z-index: 1;
    display: grid;
    grid-template-columns: 450fr 246fr 354fr 312fr;
    align-content: start;
    padding-block: 150px 0;
    min-height: 780px;
  }

  .aph__quote { position: relative; grid-column: 1; grid-row: 1; width: 384px; min-height: 300px; }
  .aph__mark { position: absolute; left: 0; top: 0; width: 32px; height: 27px; opacity: 0.55; filter: invert(1); }
  /* The glyph sits in the first line's indent rather than above the
     paragraph, which is why line one is short and the rest run full measure.
     Same construction as /about-us/. */
  .aph__statement {
    margin: 34px 0 0; width: 384px; text-indent: 46px;
    font-size: var(--fs-intro); line-height: 30px; font-weight: var(--fw-medium);
    letter-spacing: var(--ls-item); color: rgba(255, 255, 255, 0.94);
  }
  .aph__sub {
    margin: 18px 0 0; width: 384px;
    font-size: var(--fs-body); line-height: 23px; font-weight: var(--fw-medium);
    letter-spacing: var(--ls-item); color: rgba(255, 255, 255, 0.62);
  }
  .aph__by { display: flex; align-items: flex-start; gap: 14px; margin-top: 32px; height: 42px; }
  .aph__face { width: 42px; height: 42px; border-radius: var(--r-circle); object-fit: cover; background: rgba(255, 255, 255, 0.14); }
  .aph__by-text { display: flex; flex-direction: column; padding-top: 3px; }
  .aph__by-name { font-size: var(--fs-label); line-height: 20px; font-weight: var(--fw-semi); letter-spacing: -0.05em; color: rgba(255, 255, 255, 0.95); }
  .aph__by-role { font-size: var(--fs-label); line-height: 20px; font-weight: var(--fw-medium); letter-spacing: -0.05em; color: rgba(255, 255, 255, 0.6); }

  /* Row one closes at 450 (150 + the 300-tall quote block); these three
     margins are the export's 463 / 653 / 454 measured from there. */
  .aph__mast { grid-column: 2 / 4; grid-row: 2; margin-top: 13px; }
  .aph__chip { display: flex; align-items: flex-start; height: 24px; margin-left: 13px; }
  .aph__chip > span { font-size: 20px; line-height: 20px; font-weight: var(--fw-semi); letter-spacing: var(--ls-item); color: #fbfbfb; padding-top: 4px; }
  .aph__h1 {
    margin: 28px 0 0 6px; white-space: nowrap;
    font-size: clamp(var(--fs-heading-m), 8.62vw, var(--fs-heading));
    line-height: 86px; font-weight: var(--fw-semi);
    letter-spacing: -0.04em; color: rgb(251, 251, 251);
  }
  .aph__caption {
    grid-column: 3; grid-row: 2; margin-top: 203px; align-self: start;
    font-size: var(--fs-label); line-height: 20px; font-weight: var(--fw-medium);
    letter-spacing: var(--ls-body); color: var(--c-white); opacity: 0.89;
  }
  .aph__phases { grid-column: 4; grid-row: 2; margin-top: 4px; align-self: start; }
  .aph__phases-label {
    display: block;
    font-size: var(--fs-label); line-height: 19px; font-weight: var(--fw-semi);
    letter-spacing: var(--ls-body); color: rgba(255, 255, 255, 0.5);
  }
  .aph__phases-list { list-style: none; margin: 11px 0 0; padding: 0; }
  /* The number LEADS the row. Right-aligned against a 233px row it sat 215px
     out, and the list read as a price list rather than a numbered sequence. */
  .aph__phases-list li {
    display: flex; gap: 14px; width: 300px;
    font-size: var(--fs-label); line-height: 25px; font-weight: var(--fw-medium);
    letter-spacing: var(--ls-item); color: rgba(255, 255, 255, 0.8);
  }
  .aph__phases-list li span { color: rgba(255, 255, 255, 0.45); }

  /* ── Process ────────────────────────────────────────────── */
  .apr { position: relative; padding-block: 80px 160px; min-height: 2240px; }
  .apr__rule { display: block; height: 1.5px; background: var(--c-rule-strong); }
  .apr__label {
    display: block; margin-top: 24px;
    font-size: var(--fs-label); line-height: 19px; font-weight: var(--fw-semi);
    letter-spacing: var(--ls-body); color: var(--c-ink-label);
  }
  /* 110px leading on a 124px face — the words stack tighter than the glyphs,
     which is why this is not --lh-display. */
  .apr__h {
    margin: 27px 0 0 -7px; max-width: 900px;
    font-size: clamp(var(--fs-heading-m), 8.62vw, var(--fs-heading));
    line-height: 110px; font-weight: var(--fw-semi);
    letter-spacing: var(--ls-display); color: var(--c-ink-heading);
  }
  .apr__intro { position: absolute; left: 922px; top: 158px; width: 440px; }
  /* The export gives this a 130px box and puts the line under it at 150, so
     the gap is to the BLOCK, not to the last line of copy. */
  .apr__intro-a {
    min-height: 130px;
    font-size: var(--fs-intro); line-height: 32px; font-weight: var(--fw-medium);
    letter-spacing: var(--ls-item); color: rgb(20, 20, 20);
  }
  .apr__intro-b {
    margin-top: 20px;
    font-size: var(--fs-body); line-height: 23px; font-weight: var(--fw-medium);
    letter-spacing: var(--ls-item); color: rgba(20, 20, 20, 0.62);
  }
  .apr__rule2 { position: absolute; left: 1px; right: 0; top: 396px; height: 0.5px; background: var(--c-rule-soft); }
  .apr__legend {
    position: absolute; left: 1px; right: 0; top: 500px;
    /* The right label is placed at 1080, not pushed to the gutter — with
       space-between it landed 87px out. */
    display: grid; grid-template-columns: 1079fr 283fr;
    font-size: 18px; line-height: 24px; font-weight: var(--fw-semi);
    letter-spacing: var(--ls-display); color: rgb(107, 107, 107);
  }
  .apr__legend-r { font-weight: var(--fw-medium); letter-spacing: var(--ls-item); color: rgba(20, 20, 20, 0.62); }

  .apr__spine { position: absolute; left: 81px; top: 570px; width: 20px; height: 1500px; }
  .apr__spine-line { position: absolute; left: 0; top: 0; width: 1px; height: 100%; background: rgba(153, 152, 149, 0.45); }
  /* A height rather than a scaled transform: the rule is 1px wide and scaling
     a hairline blurs it. */
  .apr__spine-fill { position: absolute; left: 0; top: 0; width: 2px; height: 0; background: var(--c-accent); }
  .apr__node {
    position: absolute; left: -9.5px; width: 19px; height: 19px; border-radius: 50%;
    background: var(--c-white); box-shadow: inset 0 0 0 1px rgba(153, 152, 149, 0.45);
  }
  /* Lit by src/scripts/spine.ts as the fill reaches each one. .is-* classes
     are runtime-only and exempt from assert-styles by its own rule. */
  .apr__node.is-on { background: var(--c-accent); box-shadow: none; }
  .apr__node--end { left: -6.5px; width: 13px; height: 13px; }

  .apr__steps { list-style: none; margin: 0; padding: 0; }
  /* 550, then every 400. The first sits 20px ABOVE the spine's own top, so
     these are not four equal rows hung under the legend. */
  .apr__step { position: absolute; left: 1px; right: 0; height: 330px; }
  .apr__step:nth-child(1) { top: 550px; }
  .apr__step:nth-child(2) { top: 950px; }
  .apr__step:nth-child(3) { top: 1350px; }
  .apr__step:nth-child(4) { top: 1750px; }
  .apr__step-n {
    position: absolute; left: 110px; top: 2px;
    font-size: var(--fs-label); line-height: 19px; font-weight: var(--fw-semi);
    letter-spacing: var(--ls-body); color: var(--c-ink-label);
  }
  .apr__step-name {
    position: absolute; left: 75px; top: 42px; margin: 0;
    font-size: var(--fs-display); line-height: 86px; font-weight: var(--fw-semi);
    letter-spacing: var(--ls-display); color: var(--c-ink-heading);
  }
  .apr__step-lead {
    position: absolute; left: 78px; top: 156px; width: 420px;
    font-size: 20px; line-height: 28px; font-weight: var(--fw-medium);
    letter-spacing: var(--ls-item); color: rgba(20, 20, 20, 0.78);
  }
  .apr__hair { display: block; height: 0.5px; background: var(--c-rule-soft); }
  .apr__step-detail { position: absolute; left: 580px; top: 14px; width: 400px; }
  .apr__step-detail p {
    margin-top: 24px;
    font-size: var(--fs-body); line-height: 25px; font-weight: var(--fw-medium);
    letter-spacing: var(--ls-item); color: rgba(20, 20, 20, 0.8);
  }
  .apr__step-tags { position: absolute; left: 1022px; top: 14px; width: 340px; }
  .apr__step-tags ul { list-style: none; margin: 24px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .apr__step-tags li {
    padding: 6px 14px; border-radius: var(--r-pill);
    box-shadow: inset 0 0 0 1px rgba(20, 20, 20, 0.16);
    font-size: 13px; line-height: normal; font-weight: var(--fw-semi); letter-spacing: -0.02em; color: rgb(20, 20, 20);
  }

  /* ── Track record ───────────────────────────────────────── */
  .apt { position: relative; padding-block: 90px 160px; min-height: 640px; }
  .apt__tick { display: block; width: 16px; height: 1.5px; background: var(--c-rule-strong); }
  .apt .apr__label { margin-top: 20px; }
  .apt__h {
    margin: 13px 0 0 -4px; max-width: 700px;
    font-size: var(--fs-stat); line-height: 50px; font-weight: var(--fw-semi);
    letter-spacing: var(--ls-display); color: var(--c-ink-heading);
  }
  .apt__intro {
    position: absolute; left: 922px; top: 150px; width: 440px;
    font-size: var(--fs-body); line-height: 23px; font-weight: var(--fw-medium);
    letter-spacing: var(--ls-item); color: rgba(20, 20, 20, 0.62);
  }
  /* 420 / 420 / 440 at 0, 461 and 922. The third block is wider and the two
     gaps are not equal. Drawn that way. */
  .apt__stats {
    list-style: none; margin: 0; padding: 0;
    position: absolute; left: 1px; right: 0; top: 320px;
    display: grid; grid-template-columns: 420fr 41fr 420fr 41fr 440fr;
  }
  .apt__stats > :nth-child(2) { grid-column: 3; }
  .apt__stats > :nth-child(3) { grid-column: 5; }
  .apt__hair { display: block; height: 1px; background: var(--c-rule-strong); }
  .apt__n {
    display: block; height: 86px; margin: 34px 0 0 -3px;
    font-size: var(--fs-display); line-height: 86px; font-weight: var(--fw-semi);
    letter-spacing: var(--ls-display); color: var(--c-ink-heading);
  }
  .apt__n i {
    font-size: 36px; line-height: 86px; font-weight: var(--fw-medium); font-style: normal;
    letter-spacing: var(--ls-display);
  }
  .apt__n i.apt__pct { font-size: 26px; font-weight: 700; }
  .apt__label {
    display: block; margin-top: 14px;
    font-size: var(--fs-label); line-height: 19px; font-weight: var(--fw-semi);
    letter-spacing: var(--ls-body); color: var(--c-ink-label);
  }

  /* ── Practices ──────────────────────────────────────────── */
  .aps { position: relative; padding-block: 80px 122px; min-height: 780px; }
  .aps__h {
    margin: 26px 0 0 -7px; max-width: 900px;
    font-size: clamp(42px, 5.84vw, var(--fs-display)); line-height: 86px;
    font-weight: var(--fw-semi); letter-spacing: var(--ls-display); color: var(--c-ink-heading);
  }
  .aps__intro {
    position: absolute; left: 922px; top: 160px; width: 440px;
    font-size: var(--fs-body); line-height: 23px; font-weight: var(--fw-medium);
    letter-spacing: var(--ls-item); color: rgba(20, 20, 20, 0.62);
  }
  .aps__rows { list-style: none; margin: 0; padding: 0; position: absolute; left: 1px; right: 0; top: 348px; }
  .aps__rows a { position: relative; display: block; height: 62px; }
  .aps__hair { display: block; height: 0.5px; background: var(--c-rule-soft); }
  .aps__n {
    position: absolute; left: 14px; top: 26px;
    font-size: var(--fs-micro); line-height: 19px; font-weight: var(--fw-medium);
