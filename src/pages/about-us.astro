---
/**
 * /about-us/ — inventory path. The design calls this page "Agency" and
 * proposes /agency/; docs/URL-INVENTORY.csv wins and the nav label stays
 * "Agency". Copy is the export's, verbatim.
 *
 * Built against design/prototypes/Roars v2 - Agency.dc.html, measured with
 * scripts/export-geometry.mjs. Canvas 1440x6179: Header 0-802 (dark, grained),
 * About 802-5096 (white), Footer 5074. Coordinates in the comments below are
 * SECTION-relative, as the export authors them; the content box starts at the
 * 39px gutter, so a child at x503 sits 464 into the box.
 *
 * This page previously rendered the generic MarketingPage shell — a rail
 * header and a prose slot — which is why its table was 196 rows of MISSING:
 * the team grid, the client grid, the awards list, the 37 counter and the
 * masthead were simply not built.
 */
import BaseLayout from '../layouts/BaseLayout.astro'
import Section from '../components/Section.astro'
import TopBar from '../components/TopBar.astro'
import NavOverlay from '../components/NavOverlay.astro'
import SiteFooter from '../components/SiteFooter.astro'
import GrainField from '../components/GrainField.astro'
import Button from '../components/Button.astro'
import { PORTRAIT, AGENCY_IMG, CLIENT_LOGOS } from '../lib/media'
import { site } from '../lib/site'
import star3 from '../assets/star-3.svg'
import star5 from '../assets/star-5.svg'
import quote from '../assets/quote.svg'

/* ------------------------------------------------------------ content */

/** The export's three, with the suffix metrics it sets per figure: the "+"
 *  is 39px/400 and the "%" 26px/700, and they sit at different offsets
 *  because the numerals they follow are different widths. */
/* site.statSets.alt, in the shape this band draws. The ALT trio, not the
   primary one: the homepage and /approach/ both show 20 / 4,000 / 63, and a
   third page repeating them reads as a template. See src/lib/site.ts.
   The offsets are per figure because the numerals they follow are different
   widths, so "2,500" takes a wider one than "250" did. */
const stats = [
  { n: '2,500', suffix: '+', sx: 168, sy: 20, ss: 39, sw: 400, label: 'Happy Customers' },
  { n: '20', suffix: '+', sx: 83, sy: 20, ss: 39, sw: 400, label: 'Years of Excellence' },
  { n: '7', suffix: '+', sx: 46, sy: 20, ss: 39, sw: 400, label: 'Global Awards' },
]

/** Five named people and a counter for the rest. The export's own roster and
 *  its own file mapping — Avinash carries Nitin.webp and Kevin carries
 *  Abhishek.webp, which is the export's choice, not a substitution made here.
 *  The name spelling is corrected per docs/HANDOFF.md: "Rinkesh A Shah" is
 *  permanent, the export ships it scrambled. */
const team = [
  { name: 'Rinkesh A Shah', role: 'CEO / Founder', img: PORTRAIT.founder },
  { name: 'Suzanne Martin', role: 'Global Sales', img: PORTRAIT.suzanne },
  { name: 'Avinash Kumar', role: 'Project Manager', img: PORTRAIT.nitin },
  { name: 'Kevin Jacob', role: 'Web Team Leader', img: PORTRAIT.abhishek },
  { name: 'Chetna Shah', role: 'UI/UX Lead', img: PORTRAIT.chetna },
]

/** The client marks, drawn as discs rather than as the strip on the homepage. */
/* All fifteen, from the one registry, so the about grid and the homepage
   strip cannot drift apart. The year is gone: every client carried "2021",
   which is not a fact about any of them. */
const clients = CLIENT_LOGOS

/* THE COUNTER'S FIGURE, FROM THE TOKEN, IN BOTH PLACES.
   The design spec sets "250" in the disc AND "More than 250 Clients" beside
   it. The label was later moved to the owner's own figure and the disc was
   not, so the tile read "250" next to "More than 2,500 Clients" — two
   different numbers about the same thing, nine inches apart. Both now come
   off site.stats.happyCustomers, which is the same '2,500+' the stats band at
   the top of this page already prints. The '+' is dropped because "More
   than" and "+" say the same thing twice. */
const clientCount = site.stats.happyCustomers.replace('+', '')

/**
 * Read off the award badges on the live site, so the years are the ones the
 * badges actually carry.
 *
 * The list this replaces ran 2026, 2025, 2025, 2024, 2024, which is not what
 * any of the plaques say: the Clutch marks are 2022 and 2020, and the CIO
 * Review one is 2018. Where a badge names a region it is kept, because "Top
 * B2B Companies, Global" and "Top IT Services, India" are different awards.
 *
 * The two GoodFirms badges carry no year on the plaque, so none is written
 * here. An invented year on an award is the kind of small false detail that
 * costs more than the empty column does.
 *
 * "Top 15th User Experience Company" is not in this list: it is the headline
 * above it, and repeating it would have it read twice.
 */

const awards = [
  { year: '2022', title: 'Top IT Services, India', body: 'Clutch', no: '/01' },
  { year: '2020', title: 'Top Mobile App Developers', body: 'Clutch', no: '/02' },
  { year: '2020', title: 'Top B2B Companies, Global', body: 'Clutch', no: '/03' },
  { year: '', title: 'Top Software Developer', body: 'GoodFirms', no: '/04' },
  { year: '', title: 'Top App Designer', body: 'GoodFirms', no: '/05' },
  { year: '2018', title: '20 Most Promising UI/UX Solution Providers', body: 'CIO Review', no: '/06' },
]

/**
 * The five ventures Roars runs for itself.
 *
 * Names and domains are the owner's, given verbatim. Each card carries the
 * mark and the domain and NOTHING ELSE — no one-line description of what the
 * product does, because nobody has written one and inferring it from a name
 * would put a claim about a live business on a public page. The slot is there
 * in the markup's shape if a line ever arrives.
 *
 * Widths and heights are the real output of scripts/build-venture-logos.mjs,
 * which normalises all five to a common 60px height. They are declared so the
 * row reserves its space before the images load.
 */
const VENTURES = [
  { name: 'Produit', domain: 'produit.co', logo: '/ventures/produit.png', w: 253, h: 60 },
  { name: 'Hostwala', domain: 'hostwala.co', logo: '/ventures/hostwala.png', w: 250, h: 60 },
  { name: 'UX Audit Pro', domain: 'uxauditpro.com', logo: '/ventures/uxauditpro.png', w: 280, h: 59 },
  { name: 'MicroKopy', domain: 'microkopy.com', logo: '/ventures/microkopy.png', w: 280, h: 58 },
  { name: 'GetAutomation', domain: 'getautomation.ai', logo: '/ventures/getautomation.png', w: 280, h: 60 },
]

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    '@id': `${site.url}/about-us/#aboutpage`,
    name: 'About Roars',
    isPartOf: { '@id': `${site.url}/#website` },
    about: { '@id': `${site.url}/#organization` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Agency' },
    ],
  },
]
---

<BaseLayout
  title="About Roars | 4,000+ Products Since 2005"
  description="We work alongside entrepreneurs and visionaries, using agile methodologies to produce brilliant, scalable, technology-based products and services."
  path="/about-us/"
  schema={schema}
>
  <TopBar slot="topbar" cta="contact" />
  <NavOverlay />

  {/* ── Header ──────────────────────────────────────────────── */}
  <Section ground="dark" bleed>
    <div class="agh">
      <GrainField tone="dark" second />

      <div class="wrap agh__inner">
        {/* Founder block at 39,96, width 384. */}
        <div class="agh__founder" data-reveal>
          <img class="agh__face" src={PORTRAIT.founder} alt="" width="42" height="42" />
          <span class="agh__name">Rinkesh A Shah</span>
          <span class="agh__role">CEO</span>
          <img class="agh__quote" src={quote.src} alt="" width="32" height="27" />
          <p class="agh__intro">
            We work alongside entrepreneurs and visionaries, using agile
            methodologies to produce brilliant, scalable, technology-based
            products and services.
          </p>
        </div>

        {/* Masthead at 450 in the content box: chip at +15, title at +6,
            underline at +1. Those three offsets are the export's and they do
            not align — the lockup is deliberately ragged on its left edge. */}
        <div class="agh__mast" data-reveal>
          <span class="agh__chip">
            <span>roars</span>
            <span class="starmark" style={`--m:url(${star5.src});width:10px;height:10px`}></span>
          </span>
          <h1 class="agh__h1">Agency</h1>
          {/* NO union.svg under the title. The export draws its hand-drawn
              dashed rule here and on Projects and Insights; it was asked for
              twice and removed, so it does not ship on any inner page. Do not
              restore it from the export. */}
        </div>

        {/* Trust row at 929 in the box, 26 below the masthead's top. */}
        <div class="agh__trust" data-reveal>
          <img class="agh__trust-face" src={PORTRAIT.suzanne} alt="" width="42" height="42" />
          <img class="agh__trust-face" src={PORTRAIT.chetna} alt="" width="42" height="42" />
          <span class="agh__count"><span>37</span>
            <span class="starmark" style={`--m:url(${star3.src});width:9px;height:9px`}></span>
          </span>
          <span class="agh__trust-label">Trusted by our Clients</span>
        </div>

        <span class="agh__caption" data-reveal>About Our<br />Product Company</span>
      </div>
    </div>
  </Section>

  {/* ── About ───────────────────────────────────────────────── */}
  <Section ground="light">
    <div class="agb">
      {/* Intro row at 168, then the stat row 303 below it.

          `id="agency"` is the menu's target for "The agency". The About panel
          had two rows both pointing at /about-us/, so picking either one did
          the same thing. Set on the intro rather than the Section, so the
          heading lands under the fixed top bar rather than behind it. */}
      <div class="agb__intro" id="agency" data-reveal>
        <span class="agb__stars" aria-hidden="true">
          <span class="starmark" style={`--m:url(${star3.src});width:17px;height:17px`}></span>
          <span class="starmark" style={`--m:url(${star5.src});width:17px;height:17px`}></span>
        </span>
        <p class="agb__lede"><strong>Roars</strong> helps founders stand out with bold
          product design and smart digital solutions. We mix strategy, creativity
          and technology to craft work that’s clean, purposeful and built to last.</p>
        <p class="agb__creed">Driven by ideas. Focused on results. Built for the future.
          Simple ideas. Strong products. Real impact.</p>
      </div>

      <ul class="agb__stats" data-reveal>
        {stats.map((s) => (
          <li class="agb__stat">
            <span class="agb__stat-rule" aria-hidden="true"></span>
            <span class="agb__stat-n"><span>{s.n}</span></span>
            <span
              class="agb__stat-suffix"
              style={`left:${s.sx}px;top:${s.sy}px;font-size:${s.ss}px;font-weight:${s.sw}`}
            >{s.suffix}</span>
            <span class="agb__stat-label">{s.label}</span>
          </li>
        ))}
      </ul>

      {/* Team. Four across, then ONE card under the second column and the
          counter under the fourth — the second row is not a row, and that
          gap is drawn. */}
      <ul class="agb__grid agb__grid--team" id="team" data-reveal>
        {team.map((m) => (
          <li class="agb__person">
            <span class="agb__disc"><img src={m.img} alt="" width="198" height="198" loading="lazy" /></span>
            <span class="agb__person-name">{m.name}</span>
            <span class="agb__person-role">{m.role}</span>
          </li>
        ))}
        <li class="agb__rest">
          <span class="agb__rest-disc" aria-hidden="true">
            <span class="agb__rest-n">25<span class="starmark" style={`--m:url(${star3.src});width:17px;height:17px`}></span></span>
          </span>
          <span class="agb__rest-label">The rest of the<br />Roars Fam</span>
        </li>
      </ul>

      <div class="agb__plate" data-reveal>
        <img src={AGENCY_IMG.office} alt="The Roars studio" width="1361" height="764" loading="lazy" />
      </div>

      <h2 class="agb__h2 agb__h2--clients">Clients:</h2>
      <ul class="agb__grid agb__grid--clients" data-reveal>
        {clients.map((c) => (
          <li class="agb__person">
            <span class="agb__cell"><img src={c.src} alt={`${c.alt} logo`} width="160" height="64" loading="lazy" decoding="async" /></span>
            <span class="agb__person-name">{c.alt}</span>
          </li>
        ))}
        <li class="agb__rest">
          <span class="agb__rest-disc" aria-hidden="true">
            <span class="agb__rest-n">{clientCount}<span class="starmark" style={`--m:url(${star3.src});width:17px;height:17px`}></span></span>
          </span>
          <span class="agb__rest-label">More than {clientCount}<br />Clients</span>
        </li>
      </ul>

      <div class="agb__cta" data-reveal>
        <span class="agb__stars" aria-hidden="true">
          <span class="starmark" style={`--m:url(${star3.src});width:17px;height:17px`}></span>
          <span class="starmark" style={`--m:url(${star5.src});width:17px;height:17px`}></span>
        </span>
        <p class="agb__cta-text">If you want to become one of our happy clients,
          get in touch with us right now.</p>
        <Button href="/contact-us/" label="Get Started" />
      </div>


      <h2 class="agb__h2 agb__h2--awards">Awarded</h2>
      {/* The lead the awards block was missing: what the recognition is for,
          rather than a bare list of plaques. Copy supplied by the client. */}
      <div class="agb__lead-award" data-reveal>
        <h3 class="agb__lead-award-title">Top 15th User Experience Company</h3>
        <p class="agb__lead-award-body">Our team is dedicated to delivering outstanding
          experiences. We go above and beyond simply producing technology-based
          solutions; we are focused on creating positive experiences for our users.</p>
      </div>
      <ul class="agb__awards" data-reveal>
        {awards.map((a) => (
          <li class="agb__award">
            <span class="agb__award-stub" aria-hidden="true"></span>
            <span class="agb__award-year">{a.year}</span>
            <span class="agb__award-rule" aria-hidden="true"></span>
            <span class="agb__award-title"><span>{a.title}</span></span>
            <span class="agb__award-body"><span class="agb__award-dot" aria-hidden="true"></span><span>{a.body}</span></span>
            <span class="agb__award-no"><span>{a.no}</span></span>
          </li>
        ))}
      </ul>
    </div>
  </Section>

  {/* ── Our ventures ─────────────────────────────────────────
      The five products Roars runs for itself, immediately before the footer.
      It earns that position: everything above it is work done for other
      people, and this answers "do they only do it for hire".

      THE MARKS ARE GREY UNTIL THE CURSOR REACHES THEM, which is the ask, and
      it also does a job — five logos in five house palettes shouting at once
      would pull rank on this page's own yellow. Grey holds them as one set and
      colour is the reward for pointing at one. It is a CSS filter, so a single
      colour file serves both states. */}
  <Section ground="surface">
    <div class="agv">
      <span class="agv__tick" aria-hidden="true"></span>
      <div class="agv__head">
        <div class="agv__rail">
          <span class="agv__eyebrow">Our ventures</span>
          <h2 class="agv__h">We build for ourselves too.</h2>
        </div>
        <p class="agv__lede">
          Five products of our own, run on the same process we sell. They are where we
          find out what a decision costs before we recommend it to anybody else.
        </p>
      </div>

      <ul class="agv__grid">
        {VENTURES.map((v, i) => (
          <li data-reveal style={`transition-delay:${i * 60}ms`}>
            <a class="agv__card" href={`https://${v.domain}`} target="_blank" rel="noopener">
              <span class="agv__shot">
                <img src={v.logo} alt={v.name} width={v.w} height={v.h} loading="lazy" decoding="async" />
              </span>
              <span class="agv__go">
                <span>{v.domain}</span>
                <span class="agv__arrow" aria-hidden="true">↗</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </Section>

  {/* This page's own close. The default is a real sentence, but a visitor who
      has just read twenty years of history should be answered in those terms
      rather than with the generic line. */}
  <SiteFooter
    slot="footer"
    tagline="4,000+ products since 2005"
    blurbTitle="Want the team behind 4,000+ products?"
    blurb="Tell us what you are building. We will tell you honestly whether we are the right fit, and what it would take."
  />
</BaseLayout>

<style>
  /* ── Header, section 1440x802 ───────────────────────────────
     Four tracks summing to the 1362 content box: the masthead opens at 450,
     the caption at 696, the trust row at 929. */
  .agh { position: relative; }
  .agh__inner {
    position: relative; z-index: 1;
    display: grid;
    grid-template-columns: 450fr 246fr 233fr 433fr;
    /* align-content:start, or the 802 min-height is distributed INTO the auto
       rows: row one stretched past the founder block's 232 and carried the
       masthead, the trust row and the caption 53px down with it. */
    align-content: start;
    padding-block: 96px 0;
    min-height: 802px;
  }

  /* One composed block, 384x232, with five items the export places against
     its own corner: avatar 0,0 · name 56,6 · role 56,25 · quote 0,64 ·
     intro 0,74. The quote and the intro OVERLAP by design — the glyph sits in
     the first line's indent rather than above the paragraph, which is why the
     first line is short and the rest run full measure. Stacking them in flow
     made the block taller and pushed the masthead, the trust row and the
     caption down with it. min-height, so real copy can still grow it. */
  .agh__founder { grid-column: 1; grid-row: 1; position: relative; width: 384px; min-height: 232px; }
  .agh__face { position: absolute; left: 0; top: 0; width: 42px; height: 42px; border-radius: var(--r-circle); object-fit: cover; background: rgba(255, 255, 255, 0.14); }
  .agh__name { position: absolute; left: 56px; top: 6px; font-size: var(--fs-label); line-height: 20px; font-weight: var(--fw-semi); letter-spacing: -0.05em; color: rgba(255, 255, 255, 0.95); }
  .agh__role { position: absolute; left: 56px; top: 25px; font-size: var(--fs-label); line-height: 20px; font-weight: var(--fw-medium); letter-spacing: -0.05em; color: rgba(255, 255, 255, 0.6); }
  .agh__quote { position: absolute; left: 0; top: 64px; width: 32px; height: 27px; opacity: 0.55; filter: invert(1); }
  .agh__intro { position: absolute; left: 0; top: 74px; width: 384px; margin: 0; text-indent: 46px; font-size: var(--fs-intro); line-height: 30px; font-weight: var(--fw-medium); letter-spacing: var(--ls-item); color: rgba(255, 255, 255, 0.92); }

  /* Row 1 closes at 328 (96 + the 232-tall founder block), so these three
     margins are the export's 414 / 440 / 653 measured from there. */
  /* 86 to the group's top at 414, then 51 more to the chip, which is the
     first thing drawn in it. */
  .agh__mast { grid-column: 2 / 4; grid-row: 2; margin-top: 86px; padding-top: 51px; }
  .agh__chip { display: flex; align-items: flex-start; gap: 8px; margin-left: 15px; height: 24px; }
  .agh__chip > span:first-child { font-size: 20px; line-height: 20px; font-weight: var(--fw-semi); letter-spacing: var(--ls-item); color: #fbfbfb; padding-top: 4px; }
  .agh__h1 { margin: 26px 0 0 6px; font-size: clamp(var(--fs-heading-m), 8.62vw, var(--fs-heading)); line-height: 86px; font-weight: var(--fw-semi); letter-spacing: -0.04em; color: rgb(251, 251, 251); }

  .agh__trust { grid-column: 4; grid-row: 2; margin-top: 112px; display: flex; align-items: flex-start; height: 43px; }
  .agh__trust-face { width: 42px; height: 42px; border-radius: var(--r-circle); object-fit: cover; background: rgba(255, 255, 255, 0.14); }
  .agh__trust-face + .agh__trust-face { margin-left: 9px; }
  .agh__count {
    position: relative; margin-left: 10px; margin-top: 1px;
    width: 42px; height: 42px; border-radius: var(--r-circle);
    background: var(--c-white); flex: 0 0 auto;
  }
  .agh__count > span:first-child { position: absolute; left: 10px; top: 8px; font-size: 18px; line-height: 24px; font-weight: var(--fw-semi); letter-spacing: var(--ls-item); color: var(--c-black); }
  .agh__count .starmark { position: absolute; left: 30px; top: 6px; color: var(--c-black); }
  .agh__trust-label { margin-left: 27px; padding-top: 2px; width: 127px; font-size: var(--fs-label); line-height: 20px; font-weight: var(--fw-medium); letter-spacing: -0.04em; color: var(--c-white); opacity: 0.75; }

  .agh__caption { grid-column: 3; grid-row: 2; margin-top: 325px; align-self: start; font-size: var(--fs-label); line-height: 20px; font-weight: var(--fw-medium); letter-spacing: var(--ls-body); color: var(--c-white); opacity: 0.89; }

  /* ── Body, section 1440x4294 ────────────────────────────────
     Every block below carries the export's own top offset. They are not a
     rhythm — 168, 471, 682, 1340, 2226, 2959, 3200, 3719 — so each gap is
     set once rather than derived. */
  .agb { padding-block: 168px 163px; }

  .agb__intro { display: grid; grid-template-columns: 468fr 462fr 432fr; }
  .agb__stars { display: flex; gap: 4px; padding-top: 7px; }
  .starmark { display: inline-block; background: currentColor; -webkit-mask: var(--m) center / contain no-repeat; mask: var(--m) center / contain no-repeat; }
  .agb__lede { width: 351px; margin: 0; font-size: var(--fs-intro); line-height: 32px; font-weight: var(--fw-medium); letter-spacing: var(--ls-item); color: var(--c-black); }
  /* 700 in the export, and the only bold weight on the page. */
  .agb__lede strong { font-weight: 700; }
  .agb__creed { width: 293px; margin: 0; font-size: var(--fs-body); line-height: 24px; font-weight: var(--fw-medium); letter-spacing: var(--ls-item); color: rgb(71, 71, 71); opacity: 0.8; }

  /* Three 435-wide blocks on a 1362 box: 0, 462, 925. */
  .agb__stats { list-style: none; margin: 111px 0 0; padding: 0; display: grid; grid-template-columns: 435fr 27fr 435fr 28fr 435fr; }
  .agb__stats > :nth-child(2) { grid-column: 3; }
  .agb__stats > :nth-child(3) { grid-column: 5; }
  .agb__stat { position: relative; height: 76px; }
  .agb__stat-rule { position: absolute; left: 0; top: 0; width: 433px; height: 1.5px; background: var(--c-rule-strong); }
  /* The figure and the title carry an inner span because their leading is
     SHORTER than their size (64 on 65, 19 on 24), so the glyphs overhang the
     box and the export measures the run, not the box. */
  .agb__stat-n { position: absolute; left: 0; top: 11px; font-size: 65px; line-height: 64px; font-weight: var(--fw-semi); letter-spacing: var(--ls-display); color: var(--c-black); }
  /* Placed, not run on: the two suffixes sit at different offsets because the
     numerals they follow are different widths, and letter-spacing inherits as
     a computed px so it is re-declared at their own size. */
  .agb__stat-suffix { position: absolute; line-height: 40px; letter-spacing: var(--ls-display); color: var(--c-black); }
  .agb__stat-label { position: absolute; left: 235px; top: 28px; width: 137px; font-size: 18px; line-height: 24px; font-weight: var(--fw-medium); letter-spacing: var(--ls-body); color: rgb(71, 71, 71); opacity: 0.78; }

  /* The grids open at 238 and 234 in the box, not at the rail. */
  .agb__grid { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(4, 198px); column-gap: 30px; row-gap: 38px; }
  .agb__grid--team { margin: 135px 0 0 238px; }
  /* 74, not the export's authored 117: that offset is measured from the top
