---
/**
 * /contact-us/ — inventory path, not the spec's /contact/.
 * Built against design/prototypes/Roars v2 - Contact.dc.html.
 * Canvas, section-relative: Header 780, Get in touch 620, Offices 780,
 * Say hello 1020.
 *
 * Copy is the export's own. Office addresses live in src/lib/site.ts so the
 * footer, the Organization schema and this page cannot disagree about where
 * the company is.
 *
 * The form posts to public/api/contact.php, the only server-side code in the
 * project. Turnstile renders only when a site key is configured, so the page
 * is not broken while the key is unset; the endpoint still refuses anything
 * without a valid token, so an unconfigured build cannot be used to spam.
 *
 * THE FIELDS CARRY REAL LABELS. The export draws four bare underlined inputs
 * with nothing naming them — fine in a picture, unusable with a screen reader
 * and hostile to anyone who tabs into the third box and has to guess. The
 * labels are visible rather than hidden, because a placeholder that vanishes
 * on focus is the same problem wearing a disguise.
 */
import BaseLayout from '../layouts/BaseLayout.astro'
import Section from '../components/Section.astro'
import TopBar from '../components/TopBar.astro'
import NavOverlay from '../components/NavOverlay.astro'
import SiteFooter from '../components/SiteFooter.astro'
import GrainField from '../components/GrainField.astro'
import { PORTRAIT } from '../lib/media'
import { site } from '../lib/site'
import star5 from '../assets/star-5.svg'

const turnstileKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? ''

const socials = [
  { label: 'Facebook', href: 'https://www.facebook.com/roarstech/' },
  { label: 'Instagram', href: 'https://www.instagram.com/roarstech' },
  { label: 'Twitter', href: 'https://twitter.com/roarstech' },
  { label: 'Linkedin', href: 'https://www.linkedin.com/company/roars-technologies-pvt.-ltd.' },
  { label: 'Envelope', href: `mailto:${site.email.contact}` },
]

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    '@id': `${site.url}/contact-us/#contactpage`,
    name: 'Contact Roars',
    isPartOf: { '@id': `${site.url}/#website` },
    about: { '@id': `${site.url}/#organization` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Contact' },
    ],
  },
]
---

<BaseLayout
  title="Contact Roars | Offices in 5 Countries"
  description="Send us your details and we'll call within 24 hours. Offices in India, the United States, the United Kingdom, Belgium and Germany."
  path="/contact-us/"
  schema={schema}
>
  <TopBar slot="topbar" cta="meeting" />
  <NavOverlay />

  {/* ── Header, 1440x780 ───────────────────────────────────── */}
  <Section ground="dark" bleed>
    <div class="ch">
      <GrainField tone="dark" second />
      <div class="wrap ch__inner">
        <div class="ch__rail" data-reveal>
          <span class="ch__who">
            <img src={PORTRAIT.founder} alt="" width="42" height="42" />
            <span class="ch__name">Rinkesh A Shah</span>
            <span class="ch__role">Founder</span>
          </span>
          <p class="ch__statement">
            We design innovative products and solutions that elevate businesses, products,
            and practices.
          </p>
        </div>

        <div class="ch__mast" data-reveal>
          <span class="ch__chip">
            <span>roars</span>
            <span class="starmark ch__star" style={`--m:url(${star5.src})`} aria-hidden="true"></span>
          </span>
          <h1 class="ch__large">Contact us</h1>
          <p class="ch__look">We look forward to hearing from you.</p>
        </div>

        <div class="ch__count" data-reveal>
          <span class="ch__disc">05</span>
          <span class="ch__count-label">Offices in five countries</span>
        </div>
      </div>
    </div>
  </Section>

  {/* ── Get in touch, 1440x620 ─────────────────────────────── */}
  <Section ground="light">
    <div class="cg">
      <span class="c-rule" aria-hidden="true"></span>
      <span class="c-label">Contact</span>
      <h2 class="cg__h">get in touch</h2>
      <div class="cg__intro" data-reveal>
        <p class="cg__intro-a">
          Whether you are just interested to know more about what we do or would like to
          enroll our services to grow your business, we would love to hear from you.
        </p>
        <p class="cg__intro-b">
          If you have any questions, comments, or simply fancy a chat about our company
          over a cup of coffee, please contact us using any of the methods outlined on
          this page.
        </p>
      </div>

      <div class="cg__ways" data-reveal>
        <div class="cg__way cg__way--write">
          <span class="c-label">Write to us</span>
          <a class="cg__email" href={`mailto:${site.email.sales}`}>{site.email.sales}</a>
        </div>
        <div class="cg__way cg__way--call">
          <span class="c-label">Call us</span>
          <a class="cg__tel" href={`tel:${site.phones.US.tel}`}>USA {site.phones.US.display}</a>
          <a class="cg__tel" href={`tel:${site.phones.UK.tel}`}>UK {site.phones.UK.display}</a>
        </div>
        <div class="cg__way cg__way--meet">
          <span class="c-label">Rather talk it through</span>
          <a class="c-pill" href={site.booking} target="_blank" rel="noopener">
            <span>Setup a Meeting</span>
            <span class="c-pill__dot c-pill__dot--grey" aria-hidden="true"></span>
            <span class="c-pill__dot c-pill__dot--white" aria-hidden="true"></span>
          </a>
        </div>
      </div>
    </div>
  </Section>

  {/* ── Offices, 1440x780 on #F5F5F5 ───────────────────────── */}
  <Section ground="surface">
    <div class="co">
      <span class="co__tick" aria-hidden="true"></span>
      <span class="c-label">Offices</span>
      <h2 class="co__h">Five places we work from</h2>
      <p class="co__intro" data-reveal>
        India, the United States, the United Kingdom, Belgium and Germany.
      </p>

      <ul class="co__grid">
        {site.offices.map((o, i) => (
          <li data-reveal style={`transition-delay:${(i % 3) * 60}ms`}>
            <span class="co__code">{o.code}</span>
            <span class="co__street">{o.street}</span>
            <span class="co__postal">{o.postal}</span>
            <a class="co__email" href={`mailto:${o.email}`}>{o.email}</a>
            {o.phone && <span class="co__phone">{o.phone}</span>}
          </li>
        ))}
      </ul>
    </div>
  </Section>

  {/* ── Say hello, 1440x1020 ───────────────────────────────── */}
  <Section ground="light" bleed>
    <div class="cs">
      {/* An 880px yellow panel bled to the left edge, the form on the white
          beside it. The panel is the only yellow ground below the homepage
          hero, which is what makes the form the loudest thing on the page. */}
      <div class="cs__panel">
        <GrainField tone="yellow" second />
        <div class="cs__panel-in">
          <span class="cs__eyebrow">Enquiry</span>
          <h2 class="cs__h">Say hello.</h2>
          <p class="cs__lede">
            If you are interested in any of our products or services, we’d love to discuss
            how we can help your business grow. Our dedicated team is always on hand to
            help. Simply send us your details and we’ll give you a call within 24 hours to
            discuss your requirements in depth.
          </p>
          <span class="cs__hair" aria-hidden="true"></span>
          <p class="cs__ask">Can we help you crack a complicated conundrum?</p>
          <p class="cs__note">
            Our love for innovation design and technology is evident in all our works. No
            detail is too small. Together, we’ll make your business grow, manifold.
          </p>
          <a class="c-pill cs__callback" href={site.booking} target="_blank" rel="noopener">
            <span>Request a Callback</span>
            <span class="c-pill__dot c-pill__dot--grey" aria-hidden="true"></span>
            <span class="c-pill__dot c-pill__dot--accent" aria-hidden="true"></span>
          </a>
        </div>
      </div>

      <div class="cs__form-wrap">
        <span class="cs__form-label">Leave us a quick message.</span>

        <form class="cf" action="/api/contact.php" method="post" data-contact-form>
          <input type="hidden" name="form" value="contact" />

          {/* Honeypot. Hidden from people, irresistible to bots. */}
          <div class="cf__pot" aria-hidden="true">
            <label for="c-website">Company website</label>
            <input id="c-website" name="company_website" type="text" tabindex="-1" autocomplete="off" />
          </div>

          <div class="cf__row">
            <label for="c-name">Your name *</label>
            <input id="c-name" name="name" type="text" required autocomplete="name" />
          </div>
          <div class="cf__row">
            <label for="c-email">Email *</label>
            <input id="c-email" name="email" type="email" required autocomplete="email" />
          </div>
          <div class="cf__row">
            <label for="c-phone">Phone</label>
            <input id="c-phone" name="phone" type="tel" autocomplete="tel" />
          </div>
          <div class="cf__row">
            <label for="c-message">Leave us a quick message.</label>
            <textarea id="c-message" name="message" rows="4"></textarea>
          </div>

          {turnstileKey && (
            <div class="cf-turnstile" data-sitekey={turnstileKey} data-theme="light"></div>
          )}

          <button class="cf__submit" type="submit">
            <span>Send message</span>
            <span class="cf__dots" aria-hidden="true"><i></i><i></i></span>
          </button>

          <p class="cf__status" data-form-status role="status" aria-live="polite"></p>

          <noscript>
            <p class="cf__status" data-state="error">
              This form needs JavaScript. Email <a href={`mailto:${site.email.sales}`}>{site.email.sales}</a> instead.
            </p>
          </noscript>
        </form>

        <ul class="cs__social">
          {socials.map((s) => (
            <li><a href={s.href} target="_blank" rel="noopener">{s.label}</a></li>
          ))}
        </ul>
      </div>
    </div>
  </Section>

  <SiteFooter
    slot="footer"
    blurbTitle="One of five offices will pick this up."
    blurb="Whichever timezone you are in, somebody here is awake. We reply within 24 hours, and it is a person rather than a queue."
    tagline="five countries, one team"
    ctaLabel="Setup a Meeting"
    ctaHref="https://meet.roarsinc.com/sales"
  />

  {turnstileKey && (
    <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  )}
</BaseLayout>

<style>
  /* ── shared ─────────────────────────────────────────────── */
  .c-label {
    display: block;
    font-size: var(--fs-label); line-height: 19px; font-weight: var(--fw-semi);
    letter-spacing: -0.06em; color: var(--c-ink-label);
  }
  .c-rule { display: block; height: 1.5px; background: var(--c-rule-strong); }
  .c-pill {
    position: relative; display: inline-flex; align-items: center;
    width: 204px; height: 47px; padding-left: 25px; border-radius: var(--r-pill);
    background: var(--c-black);
    font-size: var(--fs-label); line-height: 20px; font-weight: var(--fw-medium);
    letter-spacing: var(--ls-button); color: var(--c-white);
    transition: background var(--dur-fast) ease;
  }
  .c-pill:hover { background: rgb(38, 38, 38); }
  .c-pill__dot { position: absolute; top: 20px; width: 8px; height: 8px; border-radius: 50%; }
  .c-pill__dot--grey { left: 167px; background: rgba(153, 152, 149, 0.6); }
  .c-pill__dot--white { left: 177px; background: var(--c-white); }
  .c-pill__dot--accent { left: 177px; background: var(--c-accent); }

  /* ── header ─────────────────────────────────────────────── */
  .ch { position: relative; }
  .ch__inner {
    position: relative; z-index: 1;
    display: grid; grid-template-columns: 449px minmax(0, 1fr);
    align-content: start; padding-block: 96px 0; min-height: 780px;
  }
  .ch__rail { grid-column: 1; grid-row: 1; width: 384px; }
  .ch__who { position: relative; display: block; height: 42px; }
  .ch__who img { width: 42px; height: 42px; border-radius: 50%; object-fit: cover; background: rgba(255, 255, 255, 0.12); }
  .ch__name, .ch__role {
    position: absolute; left: 56px;
    font-size: var(--fs-label); line-height: 20px; letter-spacing: -0.05em;
  }
  .ch__name { top: 6px; font-weight: var(--fw-semi); color: rgba(255, 255, 255, 0.95); }
  .ch__role { top: 25px; font-weight: var(--fw-medium); color: rgba(255, 255, 255, 0.6); }
  .ch__statement {
    margin: 32px 0 0; width: 384px;
    font-size: var(--fs-intro); line-height: 30px; font-weight: var(--fw-medium);
    letter-spacing: var(--ls-item); color: rgba(255, 255, 255, 0.92);
  }

  .ch__mast { grid-column: 2; grid-row: 1; margin-top: 367px; }
  .ch__chip { position: relative; display: flex; align-items: flex-start; height: 24px; margin-left: 13px; }
  .ch__chip > span:first-child {
    font-size: 20px; line-height: 20px; font-weight: var(--fw-semi);
    letter-spacing: var(--ls-item); color: rgb(251, 251, 251); padding-top: 4px;
  }
  .ch__star { position: absolute; left: 52px; top: 0; width: 10px; height: 10px; color: rgb(251, 251, 251); }
  .ch__large {
    margin: 28px 0 0 6px;
    font-size: clamp(56px, 8.62vw, 124px); line-height: 86px; font-weight: var(--fw-semi);
    letter-spacing: -0.04em; color: rgb(251, 251, 251);
  }
  .ch__look {
    margin: 38px 0 0 246px; width: 220px;
    font-size: var(--fs-label); line-height: 20px; font-weight: var(--fw-medium);
    letter-spacing: -0.06em; color: rgba(255, 255, 255, 0.89);
  }
  /* The export sets this cluster at an absolute 968,440 — beside the
     masthead, not flush to the right edge. justify-self:end put it 113px too
     far out, because the content box is wider than the export's block. */
  .ch__count {
    position: absolute; left: 929px; top: 440px;
    display: flex; align-items: center; gap: 28px;
  }
  .ch__disc {
    display: flex; align-items: center; justify-content: center;
    width: 42px; height: 42px; border-radius: 50%; background: var(--c-white);
    font-size: var(--fs-body); line-height: 24px; font-weight: var(--fw-semi);
    letter-spacing: var(--ls-item); color: var(--c-black);
  }
  .ch__count-label {
    width: 148px;
    font-size: var(--fs-label); line-height: 20px; font-weight: var(--fw-medium);
    letter-spacing: var(--ls-item); color: rgba(255, 255, 255, 0.75);
  }

  /* ── get in touch ───────────────────────────────────────── */
  .cg { position: relative; padding-block: 80px 80px; min-height: 620px; }
  .cg .c-label { margin-top: 24px; }
  .cg__h {
    margin: 27px 0 0 -7px; max-width: 900px;
    font-size: clamp(52px, 8.62vw, 124px); line-height: 110px; font-weight: var(--fw-semi);
    letter-spacing: var(--ls-display); color: var(--c-ink-heading);
  }
  .cg__intro { position: absolute; left: 922px; top: 150px; width: 440px; }
  .cg__intro-a {
    margin: 0;
    font-size: var(--fs-intro); line-height: 32px; font-weight: var(--fw-medium);
    letter-spacing: var(--ls-item); color: rgb(20, 20, 20);
  }
  .cg__intro-b {
    position: absolute; left: 0; top: 160px; margin: 0; width: 100%;
    font-size: var(--fs-body); line-height: 23px; font-weight: var(--fw-medium);
    letter-spacing: var(--ls-item); color: rgba(20, 20, 20, 0.62);
  }

  /* Three ways to reach us, on the export's own columns: 0, 605, 922. */
  .cg__ways {
    position: absolute; left: 0; top: 440px; right: 0;
    display: grid; grid-template-columns: 605fr 317fr 440fr;
  }
  .cg__ways::before {
    content: ''; position: absolute; left: 0; top: -40px;
    width: 100%; height: 0.5px; background: var(--c-rule-soft);
  }
  .cg__email {
    display: block; margin-top: 11px;
    font-size: var(--fs-stat); line-height: 50px; font-weight: var(--fw-semi);
    letter-spacing: var(--ls-display); color: var(--c-ink-heading);
    transition: color var(--dur-fast) ease;
  }
  .cg__email:hover { color: var(--c-black); }
  .cg__tel {
    display: block; margin-top: 13px;
    font-size: 20px; line-height: 30px; font-weight: var(--fw-semi);
    letter-spacing: var(--ls-item); color: rgb(20, 20, 20);
  }
  .cg__tel + .cg__tel { margin-top: 0; }
  .cg__way--meet .c-pill { margin-top: 11px; }

  /* ── offices ────────────────────────────────────────────── */
  .co { position: relative; padding-block: 90px 90px; min-height: 780px; }
  .co__tick { display: block; width: 16px; height: 1.5px; background: var(--c-rule-strong); }
  .co .c-label { margin-top: 18.5px; }
  .co__h {
    margin: 11px 0 0 -4px; max-width: 700px;
    font-size: var(--fs-stat); line-height: 50px; font-weight: var(--fw-semi);
    letter-spacing: var(--ls-display); color: var(--c-ink-heading);
  }
  .co__intro {
    position: absolute; left: 922px; top: 148px; width: 440px; margin: 0;
    font-size: var(--fs-body); line-height: 23px; font-weight: var(--fw-medium);
    letter-spacing: var(--ls-item); color: rgba(20, 20, 20, 0.62);
  }
  .co__grid {
    list-style: none; margin: 0; padding: 0;
    position: absolute; left: 0; top: 250px; right: 0;
    display: grid; grid-template-columns: repeat(3, 435fr); column-gap: 26px; row-gap: 40px;
  }
  .co__grid li { position: relative; height: 230px; padding-top: 26px; }
  .co__grid li::before {
    content: ''; position: absolute; left: 0; top: 0;
    width: 433px; height: 1px; background: rgba(153, 152, 149, 0.7);
  }
  .co__code {
    position: absolute; left: -3px; top: 26px;
    font-size: var(--fs-display); line-height: 86px; font-weight: var(--fw-semi);
    letter-spacing: var(--ls-display); color: var(--c-ink-heading);
  }
  .co__street, .co__postal {
    position: absolute; left: 200px; width: 235px;
    font-size: var(--fs-body); line-height: 23px; font-weight: var(--fw-medium);
    letter-spacing: var(--ls-item);
  }
  .co__street { top: 60px; color: rgb(20, 20, 20); }
  .co__postal { top: 106px; color: rgba(20, 20, 20, 0.62); }
  .co__email, .co__phone {
    position: absolute; left: 0;
    font-size: var(--fs-body); line-height: 23px; font-weight: var(--fw-semi);
    letter-spacing: var(--ls-item);
  }
  .co__email { top: 176px; color: rgb(20, 20, 20); }
  .co__phone { top: 201px; font-weight: var(--fw-semi); color: rgba(20, 20, 20, 0.62); }

  /* ── say hello ──────────────────────────────────────────── */
  .cs { position: relative; display: grid; grid-template-columns: 880px minmax(0, 1fr); min-height: 1020px; }
  .cs__panel { position: relative; overflow: hidden; }
  /* Pinned to the export's own offsets — 86 / 124 / 250 / 520 / 556 / 648 /
     760 — rather than chained on margins, so a lede that wraps one line short
     does not pull the callback button 100px up the panel. */
  .cs__panel-in { position: relative; z-index: 1; height: 1020px; }
  .cs__eyebrow {
    position: absolute; left: 39px; top: 86px; display: block;
    font-size: 13px; line-height: 19px; font-weight: var(--fw-semi);
    letter-spacing: 0.14em; color: rgba(11, 11, 11, 0.7);
  }
  .cs__h {
    position: absolute; left: 39px; top: 124px; margin: 0; width: 760px;
    font-size: 72px; line-height: 74px; font-weight: var(--fw-semi);
    letter-spacing: var(--ls-display); color: rgb(11, 11, 11);
  }
  .cs__lede {
    position: absolute; left: 39px; top: 250px; margin: 0; width: 660px;
    font-size: 20px; line-height: 30px; font-weight: var(--fw-medium);
    letter-spacing: var(--ls-item); color: rgba(11, 11, 11, 0.82);
  }
  .cs__hair { position: absolute; left: 39px; top: 520px; display: block; width: 760px; height: 1px; background: rgba(11, 11, 11, 0.24); }
  .cs__ask {
    position: absolute; left: 39px; top: 556px; margin: 0; width: 660px;
    font-size: 30px; line-height: 38px; font-weight: var(--fw-semi);
    letter-spacing: -0.045em; color: rgb(11, 11, 11);
  }
  .cs__note {
    position: absolute; left: 39px; top: 648px; margin: 0; width: 640px;
    font-size: 17px; line-height: 25px; font-weight: var(--fw-medium);
    letter-spacing: var(--ls-item); color: rgba(11, 11, 11, 0.78);
  }
  .cs__callback { position: absolute; left: 39px; top: 760px; }

  .cs__form-wrap { padding: 86px 39px 86px 40px; max-width: 520px; }
  .cs__form-label {
    display: block;
    font-size: var(--fs-micro); line-height: 19px; font-weight: var(--fw-semi);
    letter-spacing: 0.14em; color: var(--c-ink-label);
  }
  .cf { margin-top: 44px; }
  .cf__pot { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .cf__row + .cf__row { margin-top: 26px; }
  .cf__row label {
    display: block;
    font-size: var(--fs-micro); line-height: 19px; font-weight: var(--fw-medium);
    letter-spacing: var(--ls-item); color: rgba(20, 20, 20, 0.62);
  }
  .cf__row input, .cf__row textarea {
    display: block; width: 100%; margin-top: 6px; padding: 0 0 10px;
    background: transparent; border: 0; border-bottom: 1px solid rgba(20, 20, 20, 0.22);
    font-family: inherit; font-size: 17px; line-height: 25px; font-weight: var(--fw-medium);
    letter-spacing: var(--ls-item); color: rgb(20, 20, 20);
  }
  .cf__row input { height: 44px; }
  .cf__row textarea { resize: vertical; min-height: 120px; }
  .cf__row input:focus-visible, .cf__row textarea:focus-visible {
    outline: none; border-bottom-color: rgb(20, 20, 20);
  }

  .cf__submit {
    position: relative; display: inline-flex; align-items: center;
    width: 204px; height: 47px; margin-top: 44px; padding-left: 25px;
    border: 0; border-radius: var(--r-pill); background: var(--c-black); cursor: pointer;
    font-family: inherit; font-size: var(--fs-label); line-height: 20px; font-weight: var(--fw-medium);
    letter-spacing: var(--ls-button); color: var(--c-white);
    transition: background var(--dur-fast) ease;
  }
  .cf__submit:hover { background: rgb(38, 38, 38); }
  .cf__submit:disabled { cursor: progress; opacity: 0.7; }
