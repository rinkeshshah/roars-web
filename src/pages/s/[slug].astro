---
/**
 * Service pages. Twelve live URLs at /s/[slug]/.
 *
 * Routes come from docs/URL-INVENTORY.csv, not from the collection, so every
 * ranking URL resolves even before its body is migrated.
 *
 * TWO RENDERINGS, ONE ROUTE:
 *   - An entry carrying `hero` gets the full designed page, built against
 *     design/prototypes/Roars v2 - AI Automation.dc.html, which the handoff
 *     names as the pattern for every service. Canvas 1440x6800: Hero 840,
 *     Services 1060, Featured work 620, Process 1000, Engagements 1120,
 *     Receipts 760, FAQ 940, CTA 460.
 *   - Anything else falls back to MarketingPage — prose if the body exists,
 *     the pending state if it does not. Eleven of the twelve are there today.
 *
 * Coordinates in the comments are SECTION-relative as the export authors
 * them; the content box starts at the 39px gutter, so a child at x504 sits
 * 465 into the box.
 */
import { getCollection, render } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import MarketingPage from '../../components/MarketingPage.astro'
import Section from '../../components/Section.astro'
import TopBar from '../../components/TopBar.astro'
import NavOverlay from '../../components/NavOverlay.astro'
import SiteFooter from '../../components/SiteFooter.astro'
import GrainField from '../../components/GrainField.astro'
import Accordion from '../../components/Accordion.astro'
import { slugsOf, nameFromSlug } from '../../lib/inventory'
import { workHeroFor } from '../../lib/media'
import { site } from '../../lib/site'

export async function getStaticPaths() {
  const entries = await getCollection('services')
  const byId = new Map(entries.map((e) => [e.id, e]))
  return slugsOf('service').map((slug) => ({
    params: { slug },
    props: { entry: byId.get(slug) },
  }))
}

const { slug } = Astro.params
const { entry } = Astro.props
const path = `/s/${slug}/`
const name = entry?.data.title ?? nameFromSlug(slug)
const d = entry?.data

const schema = entry
  ? [
      {
        '@context': 'https://schema.org',
        '@type': 'Service',
        '@id': `${site.url}${path}#service`,
        name,
        description: entry.data.seo.description,
        serviceType: entry.data.serviceType,
        provider: { '@id': `${site.url}/#organization` },
        areaServed: [
          { '@type': 'Country', name: 'United States' },
          { '@type': 'Country', name: 'United Kingdom' },
          { '@type': 'Country', name: 'India' },
        ],
        ...(entry.data.subServices.length
          ? {
              hasOfferCatalog: {
                '@type': 'OfferCatalog',
                name,
                itemListElement: entry.data.subServices.map((s) => ({
                  '@type': 'Offer',
                  itemOffered: { '@type': 'Service', name: s },
                })),
              },
            }
          : {}),
      },
      /* The page answers seven questions in full, so it is an FAQPage as well
         as a Service. Only emitted when the answers are actually on the page:
         marking up copy a visitor cannot see is exactly what the rich-result
         guidelines prohibit. */
      ...(entry.data.faq.length
        ? [
            {
              '@context': 'https://schema.org',
              '@type': 'FAQPage',
              '@id': `${site.url}${path}#faq`,
              mainEntity: entry.data.faq.map((f) => ({
                '@type': 'Question',
                name: f.question,
                acceptedAnswer: { '@type': 'Answer', text: f.answer },
              })),
            },
          ]
        : []),
      {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
          { '@type': 'ListItem', position: 2, name },
        ],
      },
    ]
  : []

const { Content } = entry ? await render(entry) : { Content: null }

/** The designed layout only applies where the entry supplies it. */
const designed = Boolean(d?.hero)
const capabilities = d?.bands?.find((b) => b.key === 'capabilities')
const engagements = d?.bands?.find((b) => b.key === 'engagements')

/** The anchor case's own photograph, from the same resolver /work/ uses.
 *  Undefined for a slug with no header file, and the band then reads as the
 *  flat dark ground it was before. */
const anchorShot = d?.anchor?.href ? workHeroFor(d.anchor.href) : undefined
---

{designed && d ? (
  <BaseLayout
    title={d.seo.title}
    description={d.seo.description}
    path={path}
    schema={schema}
    noindex={d.needsReview}
  >
    <TopBar slot="topbar" cta="meeting" />
    <NavOverlay />

    {/* ── Hero, 1440x840 ───────────────────────────────────── */}
    <Section ground="dark" bleed>
      <div class="sv-hero">
        <GrainField tone="dark" second />
        <div class="wrap sv-hero__inner">
          {/* Left column at the gutter, 400 wide, opening at 168. */}
          <div class="sv-hero__rail" data-reveal>
            {d.eyebrow && <span class="sv-eyebrow sv-eyebrow--dark">{d.eyebrow}</span>}
            {/* S1. The failure state, not the service name. The eyebrow above
                carries the service for wayfinding and for search; the reader
                gets the problem they arrived with. */}
            {d.frame && (
              <Fragment>
                <h1 class="sv-frame__h">{d.frame.h1}</h1>
                {/* THE QUALIFIER IS NOT DRAWN. It sat directly under the H1 —
                    two paragraphs of similar measure with 18px between them,
                    then the rule and the proof figure — and the rail read as
                    congested. The field is still in the schema and still
                    written on eleven of the twelve services, so this is a
                    rendering decision and no copy has been thrown away. See
                    the note in src/content.config.ts. */}
                {d.frame.proof && (
                  <p class="sv-frame__proof">
                    <b>{d.frame.proof.value}</b>
                    <i>{d.frame.proof.label}</i>
                  </p>
                )}
              </Fragment>
            )}
            <span class="sv-hero__tick" aria-hidden="true"></span>
            {/* The migrated statement, for pages that have no frame yet. A
                page with S1 says the same thing better and does not need
                both. */}
            {!d.frame && <p class="sv-hero__statement">{d.hero!.statement}</p>}
            {!d.frame && d.hero!.sub && <p class="sv-hero__sub">{d.hero!.sub}</p>}
            {d.hero!.pills.length > 0 && (
              <ul class="sv-hero__pills">
                {d.hero!.pills.map((p) => <li>{p}</li>)}
              </ul>
            )}
            {d.hero!.ctaLabel && d.hero!.ctaHref && (
              <a class="sv-ghost" href={d.hero!.ctaHref} target="_blank" rel="noopener">
                {d.hero!.ctaLabel}
                <span class="sv-ghost__dot sv-ghost__dot--grey" aria-hidden="true"></span>
                <span class="sv-ghost__dot sv-ghost__dot--accent" aria-hidden="true"></span>
              </a>
            )}
          </div>

          {/* Masthead. The small word sits above the large one and the two are
              set at different tracking — 66/-0.05 over 132/-0.055 — so they
              are separate elements, not one heading with a break. */}
          {d.headline && (
            <div class="sv-hero__mast" data-reveal>
              <span class="sv-chip"><span>roars</span></span>
              <span class="sv-hero__small">{d.headline.small}</span>
              <h1 class="sv-hero__large">{d.headline.large}</h1>
              {d.standfirst && <p class="sv-hero__standfirst">{d.standfirst}</p>}
            </div>
          )}

          {/* The readout panel. Real copy from the entry, so it is content and
              not decoration, but nothing on the page depends on its height. */}
          {d.hero!.console && (
            <aside class="sv-console" data-reveal>
              <div class="sv-console__head">
                <span>{d.hero!.console.label}</span>
                {d.hero!.console.ref && <span class="sv-console__ref">{d.hero!.console.ref}</span>}
              </div>
              <ul class="sv-console__rows">
                {d.hero!.console.rows.map((r, i) => (
                  <li style={`--i:${i}`}>
                    <span class="sv-console__k">{r.k}</span>
                    <span class="sv-console__v">{r.v}</span>
                  </li>
                ))}
              </ul>
              <p class="sv-console__label">{d.hero!.console.statusLabel}</p>
              <p class="sv-console__status">
                <span class="sv-console__led" aria-hidden="true"></span>{d.hero!.console.status}
              </p>
              <div class="sv-console__bar" aria-hidden="true">
                <span style={`width:${d.hero!.console.progress}%`}></span>
              </div>
              {d.hero!.console.note && <p class="sv-console__note">{d.hero!.console.note}</p>}
              {d.hero!.console.footnote && <p class="sv-console__foot">{d.hero!.console.footnote}</p>}
            </aside>
          )}
        </div>
      </div>
    </Section>

    {/* ── Capabilities, 1440x1060 on #F5F5F5 ───────────────── */}
    {/* S2. What continuing as-is costs. Short on purpose: past about sixty
        words this stops being a cost and starts being a funnel. */}
    {d.cost && (
      <Section ground="light">
        <div class="sv-cost">
          <span class="sv-eyebrow">{d.cost.label}</span>
          <h2 class="sv-cost__h" data-reveal>{d.cost.heading}</h2>
          <p class="sv-cost__body" data-reveal>{d.cost.body}</p>
        </div>
      </Section>
    )}

    {/* S3. Phases named by what you HAVE at the end of each one. */}
    {d.engagement && (
      <Section ground="surface">
        <div class="sv-eng">
          <span class="sv-eyebrow">{d.engagement.label}</span>
          <h2 class:list={['sv-eng__h', d.engagement.heading.length > 30 && 'sv-band__h--long']}>
            {d.engagement.heading}
          </h2>
          <ol class="sv-eng__list">
            {d.engagement.phases.map((ph, i) => (
              <li class="sv-eng__phase" data-reveal style={`transition-delay:${(i % 3) * 60}ms`}>
                <span class="sv-eng__rule" aria-hidden="true"></span>
                <span class="sv-eng__n">{ph.n}</span>
                <span class="sv-eng__dur">{ph.duration}</span>
                <h3 class="sv-eng__name">{ph.name}</h3>
                <p class="sv-eng__delivers">{ph.delivers}</p>
              </li>
            ))}
          </ol>
        </div>
      </Section>
    )}

    {/* S4. One case, in full. Not a carousel, and no logo grid on this page. */}
    {d.anchor && (
      <Section ground="dark">
        <div class="sv-anchor">
          {/* One case on this page, so its photograph can be the band's whole
              ground rather than a panel — same shape as the industry proof
              band. aria-hidden with an empty alt: it is a ground. */}
          {anchorShot && (
            <div class="sv-anchor__bg" aria-hidden="true">
              <img src={anchorShot} alt="" width="2400" height="1200" loading="lazy" decoding="async" />
            </div>
          )}
          <span class="sv-eyebrow sv-eyebrow--dark">{d.anchor.label}</span>
          <h2 class="sv-anchor__client" data-reveal>{d.anchor.client}</h2>
          <p class="sv-anchor__sit" data-reveal>{d.anchor.situation}</p>
          <ul class="sv-anchor__did" data-reveal>
            {d.anchor.did.map((x) => <li>{x}</li>)}
          </ul>
          {d.anchor.outcome && <p class="sv-anchor__out" data-reveal>{d.anchor.outcome}</p>}
          <a class="sv-ghost sv-anchor__cta" href={d.anchor.href}>
            {d.anchor.ctaLabel}
            {/* The two dots every other ghost button carries. This one asked
                for `.sv-dots`, which is a class that exists nowhere in the
                project — so the pair rendered as two empty <i> elements at
                zero size and the button lost its dots. */}
            <span class="sv-ghost__dot sv-ghost__dot--grey" aria-hidden="true"></span>
            <span class="sv-ghost__dot sv-ghost__dot--accent" aria-hidden="true"></span>
          </a>
        </div>
      </Section>
    )}

    {/* S5. In and out. Saying what we do not do makes the rest credible. */}
    {d.scope && (
      <Section ground="light">
        <div class="sv-scope">
          <span class="sv-eyebrow">{d.scope.label}</span>
          <h2 class:list={['sv-scope__h', d.scope.heading.length > 30 && 'sv-band__h--long']}>
            {d.scope.heading}
          </h2>
          <div class="sv-scope__cols">
            <div data-reveal>
              <h3 class="sv-scope__col-h">In</h3>
              <ul class="sv-scope__list">{d.scope.includes.map((x) => <li>{x}</li>)}</ul>
            </div>
            <div data-reveal style="transition-delay:80ms">
              <h3 class="sv-scope__col-h sv-scope__col-h--out">Out</h3>
              <ul class="sv-scope__list sv-scope__list--out">{d.scope.excludes.map((x) => <li>{x}</li>)}</ul>
            </div>
          </div>
        </div>
      </Section>
    )}

    {/* S6. Duration, team, what we need from you, how pricing works. */}
    {d.shape && (
      <Section ground="surface">
        <div class="sv-shape">
          <span class="sv-eyebrow">{d.shape.label}</span>
          <h2 class:list={['sv-shape__h', d.shape.heading.length > 30 && 'sv-band__h--long']}>
            {d.shape.heading}
          </h2>
          <dl class="sv-shape__grid">
            <div data-reveal>
              <dt>Typical duration</dt>
              <dd>{d.shape.duration}</dd>
            </div>
            <div data-reveal style="transition-delay:60ms">
              <dt>Who you work with</dt>
              <dd>
                <ul class="sv-shape__list">
                  {d.shape.team.map((t) => <li><b>{t.role}</b>{t.does}</li>)}
                </ul>
              </dd>
            </div>
            <div data-reveal style="transition-delay:120ms">
              <dt>What we need from you</dt>
              <dd>
                <ul class="sv-shape__list">{d.shape.needs.map((x) => <li>{x}</li>)}</ul>
              </dd>
            </div>
            <div data-reveal style="transition-delay:180ms">
              <dt>How pricing works</dt>
              <dd>{d.shape.pricing}</dd>
            </div>
          </dl>
        </div>
      </Section>
    )}

    {capabilities && (
      <Section ground="surface">
        <div class="sv-band">
          <span class="sv-band__rule" aria-hidden="true"></span>
          <div class="sv-band__head" data-reveal>
            <span class="sv-eyebrow">{capabilities.label}</span>
            <h2 class:list={['sv-band__h', (capabilities.heading).length > 30 && 'sv-band__h--long']}>{capabilities.heading}</h2>
          </div>
          {capabilities.intro && <p class="sv-band__intro" data-reveal>{capabilities.intro}</p>}
          <ul class="sv-cards">
            {capabilities.items.map((it, i) => (
              <li class="sv-card" data-reveal style={`transition-delay:${(i % 3) * 60}ms`}>
                <span class="sv-card__rule" aria-hidden="true"></span>
                <span class="sv-card__tag">{it.tag}</span>
                <h3 class="sv-card__name">{it.name}</h3>
                <p class="sv-card__body">{it.body}</p>
              </li>
            ))}
          </ul>
        </div>
      </Section>
    )}

    {/* ── Featured work, 1440x620 on black ─────────────────── */}
    {d.featured && (
      <Section ground="dark">
        <div class="sv-feat">
          <span class="sv-eyebrow sv-eyebrow--dark" data-reveal>{d.featured.label}</span>
          <h2 class="sv-feat__client" data-reveal>{d.featured.client}</h2>
          <div class="sv-feat__col" data-reveal style="transition-delay:60ms">
            <p class="sv-feat__body">{d.featured.body}</p>
            <dl class="sv-feat__meta">
              {d.featured.meta.map((m) => (
                <div><dt>{m.k}</dt><dd>{m.v}</dd></div>
              ))}
            </dl>
            <a class="sv-ghost" href={d.featured.href}>
              View Project
              <span class="sv-ghost__dot sv-ghost__dot--grey" aria-hidden="true"></span>
              <span class="sv-ghost__dot sv-ghost__dot--accent" aria-hidden="true"></span>
            </a>
          </div>
        </div>
      </Section>
    )}

    {/* ── Process, 1440x1000 on white ──────────────────────── */}
    {d.process && (
      <Section ground="light">
        <div class="sv-proc">
          <span class="sv-proc__tick" aria-hidden="true"></span>
          <div class="sv-proc__head" data-reveal>
            <span class="sv-eyebrow">{d.process.label}</span>
            <h2 class:list={['sv-band__h', (d.process.heading).length > 30 && 'sv-band__h--long']}>{d.process.heading}</h2>
          </div>
          {d.process.intro && <p class="sv-proc__intro" data-reveal>{d.process.intro}</p>}
          {/* The track runs behind the four steps, with the accent marking the
              first. It is one rule, not four borders.
              It is wrapped WITH the steps so it can be placed against them
              rather than against the section: the steps are in flow now, so
              their top is no longer a number this file knows. */}
          {/* COLUMN COUNT AND ACCENT LENGTH COME FROM THE STEPS THEMSELVES.
              Both were hardcoded to four — the artboard's number — and eleven
              of the twelve services write three, so those pages drew an empty
              fourth column and marked the first step with a quarter of a track
              that only spanned three. */}
          <div class="sv-proc__flow" style={`--n:${d.process.steps.length}`}>
          <div class="sv-proc__track" aria-hidden="true"><span></span></div>
          <ol class="sv-proc__steps">
            {d.process.steps.map((st, i) => (
              <li data-reveal style={`transition-delay:${i * 60}ms`}>
                {st.when && <span class="sv-proc__when">{st.when}</span>}
                {st.phase && <span class="sv-proc__phase">{st.phase}</span>}
                <h3 class="sv-proc__name">{st.name}</h3>
                <p class="sv-proc__body">{st.body}</p>
              </li>
            ))}
          </ol>
          </div>
          {d.process.closing && (
            <p class="sv-proc__closing" data-reveal>{d.process.closing}</p>
          )}
        </div>
      </Section>
    )}

    {/* ── Engagements, 1440x1120 on #F5F5F5 ────────────────── */}
    {engagements && (
      <Section ground="surface">
        <div class="sv-band sv-band--tall">
          <span class="sv-band__rule" aria-hidden="true"></span>
          <div class="sv-band__head" data-reveal>
            <span class="sv-eyebrow">{engagements.label}</span>
            <h2 class:list={['sv-band__h', (engagements.heading).length > 30 && 'sv-band__h--long']}>{engagements.heading}</h2>
          </div>
          {engagements.intro && <p class="sv-band__intro" data-reveal>{engagements.intro}</p>}
          <ul class="sv-cards sv-cards--tall">
            {engagements.items.map((it, i) => (
              <li class="sv-card" data-reveal style={`transition-delay:${(i % 3) * 60}ms`}>
                <span class="sv-card__rule" aria-hidden="true"></span>
                <span class="sv-card__tag">{it.tag}</span>
                <h3 class="sv-card__name sv-card__name--wide">{it.name}</h3>
                <p class="sv-card__body">{it.body}</p>
              </li>
            ))}
          </ul>
        </div>
      </Section>
    )}

    {/* ── Receipts, 1440x760 on black ──────────────────────── */}
    {d.receipts && (
      <Section ground="dark">
        <div class="sv-rec">
          <span class="sv-rec__tick" aria-hidden="true"></span>
          <div class="sv-rec__head" data-reveal>
            <span class="sv-eyebrow sv-eyebrow--dark">{d.receipts.label}</span>
            <h2 class="sv-rec__h">{d.receipts.heading}</h2>
          </div>
          {d.receipts.intro && <p class="sv-rec__intro" data-reveal>{d.receipts.intro}</p>}
          <span class="sv-rec__rule" aria-hidden="true"></span>
          {d.receipts.note && <p class="sv-rec__note" data-reveal>{d.receipts.note}</p>}
          <ul class="sv-rec__stats">
            {d.receipts.stats.map((s, i) => (
              <li data-reveal style={`transition-delay:${i * 60}ms`}>
                <span class="sv-rec__rule2" aria-hidden="true"></span>
                <span class="sv-rec__n">
                  {s.prefix && s.suffix && <i>{s.suffix}</i>}
                  <b>{s.n}</b>
                  {!s.prefix && s.suffix && <i>{s.suffix}</i>}
                </span>
                <span class="sv-rec__body">{s.body}</span>
              </li>
            ))}
          </ul>
        </div>
      </Section>
    )}

    {/* ── FAQ, 1440x940 on white ───────────────────────────── */}
    {d.faq.length > 0 && (
      <Section ground="light">
        <div class="sv-faq">
          <span class="sv-band__rule" aria-hidden="true"></span>
          <div class="sv-band__head" data-reveal>
            {d.faqLabel && <span class="sv-eyebrow">{d.faqLabel}</span>}
            <h2 class:list={['sv-band__h', (d.faqHeading ?? 'The honest answers.').length > 30 && 'sv-band__h--long']}>{d.faqHeading ?? 'The honest answers.'}</h2>
          </div>
          {d.faqIntro && <p class="sv-band__intro" data-reveal>{d.faqIntro}</p>}
          <div class="sv-faq__list" data-reveal>
            <Accordion items={d.faq} name="service-faq" />
          </div>
        </div>
      </Section>
    )}

    {/* S8. Internal links that carry a reason. A list of names is navigation;
        a reason is what makes somebody follow one. */}
    {d.next && (
      <Section ground="light">
        <div class="sv-next">
          <span class="sv-eyebrow">{d.next.label}</span>
          <h2 class:list={['sv-next__h', d.next.heading.length > 30 && 'sv-band__h--long']}>
            {d.next.heading}
          </h2>
          <div class="sv-next__cols">
            {d.next.services.length > 0 && (
              <div data-reveal>
                <h3 class="sv-next__col-h">Services</h3>
                <ul class="sv-next__list">
                  {d.next.services.map((x) => (
                    <li><a href={x.href}><b>{x.name}</b><span>{x.why}</span></a></li>
                  ))}
                </ul>
              </div>
            )}
            {d.next.industries.length > 0 && (
              <div data-reveal style="transition-delay:80ms">
                <h3 class="sv-next__col-h">Sectors</h3>
                <ul class="sv-next__list">
                  {d.next.industries.map((x) => (
                    <li><a href={x.href}><b>{x.name}</b><span>{x.why}</span></a></li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        </div>
      </Section>
    )}

    {/* The export ends on a grey band repeating the offer, and the footer
        directly under it now carries the same heading and the same paragraph.
        One scroll apart, twice. The band is gone; its button and contact line
        moved into the footer, which is where the closing action now lives. */}

    <SiteFooter
      slot="footer"
      {/* S9. The specific invitation wins over the migrated CTA when a page
          has one. "Send us the screen that is not converting" asks for one
          thing and says what it costs the reader; "Let's get your project
          started" asks them to do the framing. */}
      blurbTitle={d.close?.heading ?? d.cta?.footerTitle}
      blurb={d.close?.body ?? d.cta?.footerBlurb}
      tagline={d.cta?.footerTagline}
      ctaLabel={d.close?.ctaLabel}
      ctaHref={d.close?.ctaHref}
      contact={d.close?.contact}
    />
  </BaseLayout>
) : (
  <MarketingPage
    title={entry?.data.seo.title ?? `${name} | ${site.name}`}
    description={entry?.data.seo.description}
    path={path}
    label="Service"
    heading={name}
    schema={schema}
    pending={!entry}
    ctaCopy={entry?.data.cta}
  >
    {Content && <Content />}
  </MarketingPage>
)}

<style>
  /* ── shared ─────────────────────────────────────────────── */
  .sv-eyebrow {
    display: block;
    font-size: var(--fs-micro); line-height: 19px; font-weight: var(--fw-medium);
    letter-spacing: 0.18em; color: var(--c-ink-label);
  }
  .sv-eyebrow--dark { color: rgba(255, 255, 255, 0.55); }

  /* The pill button on dark, 195x42 with the two 8px dots. */
  .sv-ghost {
    position: relative; display: inline-flex; align-items: center;
    width: 195px; height: 42px; padding-left: 21px; border-radius: var(--r-pill);
    box-shadow: inset 0 0 0 1.5px var(--c-ring-dark);
    font-size: var(--fs-micro); line-height: 20px; font-weight: var(--fw-medium);
    color: var(--c-white);
    transition: box-shadow var(--dur-fast) ease;
  }
  .sv-ghost:hover { box-shadow: inset 0 0 0 1.5px var(--c-accent); color: var(--c-white); }
  .sv-ghost__dot { position: absolute; top: 17px; width: 8px; height: 8px; border-radius: 50%; }
  .sv-ghost__dot--grey { left: 158px; background: rgb(153, 152, 149); }
  .sv-ghost__dot--accent { left: 169px; background: var(--c-accent); }


  .sv-chip { display: flex; align-items: flex-start; height: 24px; margin-left: 8px; }
  .sv-chip > span {
    font-size: 20px; line-height: 20px; font-weight: var(--fw-semi);
    letter-spacing: var(--ls-item); color: #fbfbfb; padding-top: 4px;
  }

  /* ── hero ───────────────────────────────────────────────── */
  .sv-hero { position: relative; }
  .sv-hero__inner {
    position: relative; z-index: 1;
    display: grid;
    grid-template-columns: 381fr 710fr 271fr;
    align-content: start;
    padding-block: 168px 0;
    min-height: 840px;
  }
  .sv-hero__rail { grid-column: 1; grid-row: 1; width: 400px; }
  .sv-hero__tick { display: block; width: 16px; height: 1.5px; background: var(--c-accent); margin: 19px 0 0; }
  .sv-hero__statement {
    margin: 25px 0 0; width: 400px;
    font-size: var(--fs-intro); line-height: 30px; font-weight: var(--fw-medium);
    letter-spacing: var(--ls-item); color: rgba(255, 255, 255, 0.94);
  }
  .sv-hero__sub {
    margin: 12px 0 0; width: 380px;
    font-size: var(--fs-body); line-height: 23px; font-weight: var(--fw-medium);
    letter-spacing: var(--ls-item); color: rgba(255, 255, 255, 0.62);
  }
  .sv-hero__pills {
    list-style: none; margin: 20px 0 0; padding: 0;
    display: flex; flex-wrap: wrap; gap: 8px; width: 400px;
  }
  .sv-hero__pills li {
    padding: 7px 13px; border-radius: var(--r-pill);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.2);
    font-size: 11px; font-weight: var(--fw-medium); letter-spacing: 0.12em;
    color: rgba(255, 255, 255, 0.88);
  }
  .sv-hero__rail .sv-ghost { margin-top: 32px; }

  /* Masthead at 381 in the box, opening at 400 in the section — 232 below the
     rail's own top, which is where the grid row places it. */
  .sv-hero__mast { grid-column: 2; grid-row: 1; margin-top: 232px; }
  .sv-hero__small {
    display: block; margin: 20px 0 0 2px;
    font-size: 66px; line-height: 70px; font-weight: var(--fw-semi);
    letter-spacing: var(--ls-display); color: rgba(255, 255, 255, 0.62);
  }
  .sv-hero__large {
    margin: 2px 0 0; white-space: nowrap;
    font-size: clamp(56px, 9.17vw, 132px); line-height: 140px; font-weight: var(--fw-semi);
    letter-spacing: -0.055em; color: rgb(251, 251, 251);
  }
  .sv-hero__standfirst {
    margin: 4px 0 0 6px; max-width: 520px;
    font-size: var(--fs-item); line-height: 34px; font-weight: var(--fw-medium);
    letter-spacing: var(--ls-item); color: rgba(255, 255, 255, 0.72);
  }

  .sv-console {
    grid-column: 3; grid-row: 1;
    width: 272px; margin-top: 14px; padding: 18px;
    background: rgba(8, 8, 8, 0.92);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08);
  }
  .sv-console__head {
    display: flex; justify-content: space-between;
    font-size: 11px; font-weight: var(--fw-semi); letter-spacing: 0.2em;
    color: rgba(255, 255, 255, 0.55);
    padding-bottom: 16px; border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }
  .sv-console__ref { font-weight: var(--fw-medium); letter-spacing: 0.06em; }
  .sv-console__rows { list-style: none; margin: 16px 0 0; padding: 0; }
  /* The first row is the one being read; the rest are history. The export
     dims them to .34 and that is the whole effect. */
  .sv-console__rows li {
    display: flex; flex-direction: column; gap: 2px; margin-bottom: 14px;
    font-size: 11px; line-height: 19px; letter-spacing: 0.02em;
    opacity: 0.34;
  }
  .sv-console__rows li:first-child { opacity: 1; }
  .sv-console__k { color: rgba(255, 255, 255, 0.92); }
  .sv-console__v { color: rgba(255, 255, 255, 0.3); }
  .sv-console__rows li:first-child .sv-console__v { color: rgba(255, 255, 255, 0.62); }
  .sv-console__label {
    margin: 16px 0 0; padding-top: 16px; border-top: 1px solid rgba(255, 255, 255, 0.1);
    font-size: 10px; font-weight: var(--fw-semi); letter-spacing: 0.22em;
    color: rgba(255, 255, 255, 0.5);
  }
  .sv-console__status {
    display: flex; align-items: center; gap: 9px; margin: 14px 0 0;
    font-size: var(--fs-micro); font-weight: var(--fw-semi); letter-spacing: 0.04em;
    color: var(--c-white);
  }
  .sv-console__led { width: 7px; height: 7px; background: var(--c-accent); }
  .sv-console__bar { margin-top: 20px; height: 3px; background: rgba(255, 255, 255, 0.14); }
  .sv-console__bar span { display: block; height: 3px; background: var(--c-accent); }
  .sv-console__note {
    margin: 18px 0 0;
    font-size: 11px; line-height: 18px; letter-spacing: 0.02em;
    color: rgba(255, 255, 255, 0.55);
  }
  .sv-console__foot {
    margin: 18px 0 0;
    font-size: 10px; font-weight: var(--fw-medium); letter-spacing: 0.16em;
    color: rgba(255, 255, 255, 0.4);
  }

  /* ── banded card grids ──────────────────────────────────── */
  /* NO min-height, for the same reason as the other two: the card grid was
     placed absolutely at top 440 and could not grow its parent, so 1060 (or
     1120) was a guess at how tall six cards of someone else's copy would be.
     On four of the twelve it left up to 381px of nothing. The grid is in flow
     now and the band is as tall as its cards. */
  /* A TWO-COLUMN GRID, so the intro sits beside the heading instead of being
     placed absolutely over the section and having the content pushed past it
     with a hard margin. That margin was the artboard's 440px offset used as
     flow spacing: it double-counted the heading's own height and left 224px of
     nothing between a heading and its cards. Now the row is as tall as the
     taller of the two and the cards simply follow it. */
  .sv-band { position: relative; padding-block: 64px 80px; }
  .sv-band, .sv-faq, .sv-proc {
    display: grid; grid-template-columns: minmax(0, 1fr) 32.305%; column-gap: 40px;
    align-content: start;
  }
  .sv-band__rule, .sv-proc__tick { grid-column: 1 / -1; }
  .sv-band__head, .sv-proc__head { grid-column: 1; }
  .sv-band__intro, .sv-proc__intro { grid-column: 2; grid-row: 2; }
  .sv-cards, .sv-faq__list, .sv-proc__flow { grid-column: 1 / -1; }
  .sv-band__rule { display: block; height: 1.5px; background: var(--c-rule-strong); }
  .sv-band__head { padding-top: 24px; }
  /* The heading hangs 7px left of the gutter, which is the optical inset the
     export draws at this size. */
  .sv-band__h {
    margin: 44px 0 0 -7px; max-width: 880px;
    font-size: clamp(42px, 5.84vw, 84px); line-height: 92px; font-weight: var(--fw-semi);
    letter-spacing: var(--ls-display); color: var(--c-ink-heading);
  }
  /* A long heading comes down a step.
     Every block in these sections is absolutely placed at a fixed top — the
     process steps at 310, the track at 380, the intro at 158 — and all of
     those offsets assume the heading is one line, which the hand-built page's
     "Ask first. Build second." is. A migrated page's heading is its own
     section title: "Our User Experience Design Services and Solutions" set at
     84px is three lines, 276px tall, and it printed straight through the
     steps beneath it. At 52px the longest of them is two lines and clears
     310 with room. */
  .sv-band__h--long {
    font-size: clamp(34px, 3.8vw, 52px); line-height: 60px;
  }
  .sv-band__intro {
    margin-top: 52px;
    font-size: 18px; line-height: 27px; font-weight: var(--fw-medium);
    letter-spacing: var(--ls-item); color: rgba(20, 20, 20, 0.8);
  }
  .sv-cards {
    list-style: none; margin: 92px 0 0; padding: 0;
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: 30px;
  }
  /* The taller heading pushes the grid down on its own now, so --tall only
     needs to take the 20px the artboard gave it back. */
  .sv-cards--tall { margin-top: 92px; }
  .sv-cards > :nth-child(n + 4) { margin-top: 40px; }
  .sv-card { width: 100%; max-width: 434px; }
  .sv-card__rule { display: block; height: 0.5px; background: var(--c-rule-soft); }
  .sv-card__tag {
    display: block; margin-top: 22px;
    font-size: 11px; font-weight: var(--fw-medium); letter-spacing: 0.14em;
    color: var(--c-ink-label);
  }
  .sv-card__name {
    margin: 18px 0 0; max-width: 400px;
    font-size: var(--fs-item); line-height: 30px; font-weight: var(--fw-semi);
    letter-spacing: var(--ls-item); color: var(--c-ink-heading);
  }
  .sv-card__name--wide { max-width: 410px; line-height: 32px; }
  .sv-card__body {
    margin: 24px 0 0; max-width: 420px;
    font-size: var(--fs-body); line-height: 25px; font-weight: var(--fw-medium);
    letter-spacing: -0.045em; color: rgba(20, 20, 20, 0.75);
  }

  /* ── featured work ────────────────────────────────────────
     A GRID, so the section is as tall as its taller column.
     It was min-height 620 with the right-hand column placed absolutely, and
     an absolutely placed child does not grow its parent — so 620 was a guess
     at how tall the copy would be, and every service's copy is a different
     length. All twelve ended on 137-201px of nothing. */
  .sv-feat {
    position: relative; padding-block: 72px 80px;
    display: grid; grid-template-columns: minmax(0, 67.695%) minmax(0, 32.305%);
    align-content: start;
  }
  .sv-feat > .sv-eyebrow { grid-area: 1 / 1; }
  /* Capped short of the column at 67.695%. The heading is a block, so
     without a cap its box runs the full 1362 and a client name longer than
     "GYMBAIT.AI" would set type straight through the body copy beside it. */
  .sv-feat__client {
    grid-area: 2 / 1;
    margin: 40px 0 0 -6px; max-width: 62%;
    font-size: clamp(46px, 5.84vw, 84px); line-height: 86px; font-weight: var(--fw-semi);
    letter-spacing: var(--ls-display); color: rgb(251, 251, 251);
  }
  /* Spans both rows of the left column and starts 58px down, which is the
     168px the artboard measured from the section top, less its 110 padding. */
  .sv-feat__col { grid-area: 1 / 2 / span 2 / auto; margin-top: 58px; }
  .sv-feat__body {
    font-size: 18px; line-height: 27px; font-weight: var(--fw-medium);
    letter-spacing: var(--ls-item); color: rgba(255, 255, 255, 0.9);
  }
  .sv-feat__meta { margin: 30px 0 0; display: flex; flex-direction: column; gap: 18px; }
  .sv-feat__meta dt {
    font-size: 11px; font-weight: var(--fw-medium); letter-spacing: 0.16em;
    color: rgba(255, 255, 255, 0.55);
  }
  .sv-feat__meta dd {
    margin: 4px 0 0;
    font-size: 18px; line-height: 24px; font-weight: var(--fw-medium);
    letter-spacing: var(--ls-item); color: rgba(255, 255, 255, 0.9);
  }
  .sv-feat__col .sv-ghost { margin-top: 32px; }

  /* ── S1 frame ───────────────────────────────────────────── */
  /* In the hero rail, in flow. The rail is 400 wide, so the failure state is
     set at a size that takes three or four lines there rather than one line
     across the page. It is a sentence to read, not a banner. */
  .sv-frame__h {
    margin: 22px 0 0; max-width: 400px;
    font-size: 30px; line-height: 38px; font-weight: var(--fw-semi);
    letter-spacing: -0.03em; color: rgb(251, 251, 251);
  }
  /* flex-start, NOT baseline. The value is 24/28 and its label is 12/17, so
     aligning their first baselines dropped the label 9px below the value's
     cap and the pair read as misaligned. Starting both boxes at the same top
     puts the two cap heights within a pixel of each other, because the
     half-leading above each first line is nearly the same at both sizes. */
  .sv-frame__proof {
    display: flex; align-items: flex-start; gap: 12px; margin: 26px 0 0;
    padding-top: 20px; border-top: 1px solid rgba(255, 255, 255, 0.18);
  }
  /* The value can be a client name rather than a figure, and some of those
     are two words, so this wraps rather than being forced onto one line. */
  .sv-frame__proof b {
    max-width: 180px;
    font-size: 24px; line-height: 28px; font-weight: var(--fw-semi);
    letter-spacing: var(--ls-display); color: var(--c-accent);
  }
  .sv-frame__proof i {
    font-style: normal; max-width: 260px;
    font-size: var(--fs-micro); line-height: 17px; font-weight: var(--fw-medium);
    letter-spacing: 0.1em; text-transform: uppercase; color: rgba(255, 255, 255, 0.6);
  }

  /* ── S2 cost ────────────────────────────────────────────── */
  /* SECTION RHYTHM, 64/80. Every band on this page carried 96-130px of its
     own padding, so a boundary stacked two of them and came to 190-250px of
     nothing between the last line of one section and the eyebrow of the next.
     Measured with the reveals forced in, that was the ONLY thing still making
     the page read as empty — the earlier pass closed the holes INSIDE
     sections, not the ones between them. */
  .sv-cost { padding-block: 64px 80px; }
  .sv-cost__h {
    margin: 26px 0 0 -4px; max-width: 900px;
    font-size: clamp(32px, 3.6vw, 48px); line-height: 1.16; font-weight: var(--fw-semi);
    letter-spacing: var(--ls-display); color: var(--c-ink-heading);
  }
  .sv-cost__body {
    margin: 24px 0 0; max-width: 707px;
    font-size: 20px; line-height: 32px; font-weight: var(--fw-medium);
    letter-spacing: var(--ls-item); color: rgba(20, 20, 20, 0.78);
  }

  /* ── S3 engagement ──────────────────────────────────────── */
  .sv-eng { padding-block: 64px 80px; }
  .sv-eng__h {
    margin: 26px 0 0 -4px; max-width: 62%;
    font-size: clamp(32px, 3.6vw, 48px); line-height: 1.16; font-weight: var(--fw-semi);
    letter-spacing: var(--ls-display); color: var(--c-ink-heading);
  }
  .sv-eng__list {
    list-style: none; margin: 56px 0 0; padding: 0;
    display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 40px 30px;
  }
  .sv-eng__phase { display: flex; flex-direction: column; min-width: 0; }
  .sv-eng__rule { display: block; height: 2px; background: rgba(153, 152, 149, 0.4); }
  .sv-eng__phase:first-child .sv-eng__rule { background: var(--c-accent); }
  .sv-eng__n {
    margin-top: 18px;
    font-size: var(--fs-micro); font-weight: var(--fw-semi);
    letter-spacing: 0.16em; color: rgb(20, 20, 20);
  }
  .sv-eng__dur {
    margin-top: 8px;
    font-size: var(--fs-micro); font-weight: var(--fw-medium);
    letter-spacing: 0.16em; text-transform: uppercase; color: var(--c-ink-label);
  }
  .sv-eng__name {
    margin: 22px 0 0;
    font-size: 26px; line-height: 32px; font-weight: var(--fw-semi);
    letter-spacing: var(--ls-display); color: var(--c-ink-heading);
  }
  .sv-eng__delivers {
    margin: 14px 0 0;
    font-size: var(--fs-body); line-height: 25px; font-weight: var(--fw-medium);
    letter-spacing: -0.045em; color: rgba(20, 20, 20, 0.75);
  }

  /* ── S4 anchor ──────────────────────────────────────────── */
  /* Padded, because the ground behind it is now the case's own photograph and
     the copy cannot sit on the picture's edge. A panel rather than a full-bleed
     band: .sv-anchor is capped at 820px and left-aligned, so a 100vw child
     would resolve `left: 50%` against THAT box, not the viewport — and a panel
     is what .icz does on the industry pages, so the two read as one component
     wherever a case appears. */
  .sv-anchor { position: relative; isolation: isolate; padding: 54px 40px 62px; max-width: 900px; }
  /* Amber dusk at the card exposure: the client name, the situation, the
     bullets and the CTA all sit ON this photograph, and the copy runs down the
     left, which is the direction --dusk-ink already points. */
  .sv-anchor__bg {
    position: absolute; inset: 0; z-index: -1;
    border-radius: 12px; overflow: hidden; background: rgb(24, 24, 24);
  }
  .sv-anchor__bg img {
    display: block; width: 100%; height: 100%; object-fit: cover;
    filter: brightness(var(--dusk-exposure-card));
  }
  .sv-anchor__bg::before,
  .sv-anchor__bg::after { content: ''; position: absolute; inset: 0; }
  .sv-anchor__bg::before { z-index: 1; background: var(--dusk-amber); }
  .sv-anchor__bg::after { z-index: 2; background: var(--dusk-ink); }
  .sv-anchor__client {
    margin: 26px 0 0 -5px;
    font-size: clamp(40px, 5vw, 72px); line-height: 1.06; font-weight: var(--fw-semi);
    letter-spacing: var(--ls-display); color: rgb(251, 251, 251);
  }
  .sv-anchor__sit {
    margin: 26px 0 0;
    font-size: 20px; line-height: 30px; font-weight: var(--fw-medium);
    letter-spacing: var(--ls-item); color: rgba(255, 255, 255, 0.9);
  }
  .sv-anchor__did { list-style: none; margin: 28px 0 0; padding: 0; }
  .sv-anchor__did li {
    position: relative; margin-top: 12px; padding-left: 22px;
    font-size: var(--fs-body); line-height: 25px; font-weight: var(--fw-medium);
    letter-spacing: var(--ls-item); color: rgba(255, 255, 255, 0.72);
  }
  .sv-anchor__did li::before {
    content: ''; position: absolute; left: 0; top: 10px;
    width: 8px; height: 2px; background: var(--c-accent);
  }
  /* .sv-anchor__out IS DELIBERATELY ABSENT, same as .icz__out on the industry
     pages: every service `anchor.outcome` was a "[ NEEDS THE REAL FIGURE ]"
     placeholder and all of them were removed, so the rule matched nothing.
     THE MARKUP IS STILL WIRED — a real outcome renders again, unstyled, which
     is visible enough to catch. Restore this with the first real figure:
       margin: 30px 0 0; padding-top: 24px;
       border-top: 1px solid rgba(255, 255, 255, 0.18);
       font-size: 22px; line-height: 32px; font-weight: var(--fw-semi);
       letter-spacing: var(--ls-item); color: var(--c-accent); */
  .sv-anchor__cta { margin-top: 34px; }

  /* ── S5 scope ───────────────────────────────────────────── */
  .sv-scope { padding-block: 64px 80px; }
  .sv-scope__h {
    margin: 26px 0 0 -4px; max-width: 62%;
    font-size: clamp(32px, 3.6vw, 48px); line-height: 1.16; font-weight: var(--fw-semi);
    letter-spacing: var(--ls-display); color: var(--c-ink-heading);
  }
  .sv-scope__cols {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 48px 60px; margin-top: 52px;
  }
  .sv-scope__col-h {
    margin: 0 0 20px; padding-bottom: 14px;
    border-bottom: 2px solid var(--c-accent);
    font-size: 22px; line-height: 1; font-weight: var(--fw-semi);
    letter-spacing: var(--ls-display); color: var(--c-ink-heading);
  }
  .sv-scope__col-h--out { border-bottom-color: rgba(153, 152, 149, 0.5); }
  .sv-scope__list { list-style: none; margin: 0; padding: 0; }
  .sv-scope__list li {
    padding: 13px 0; border-bottom: 1px solid rgba(153, 152, 149, 0.28);
    font-size: var(--fs-body); line-height: 24px; font-weight: var(--fw-medium);
    letter-spacing: var(--ls-item); color: rgba(20, 20, 20, 0.82);
  }
  .sv-scope__list--out li { color: rgba(20, 20, 20, 0.52); }

  /* ── S6 shape ───────────────────────────────────────────── */
  .sv-shape { padding-block: 64px 80px; }
  .sv-shape__h {
    margin: 26px 0 0 -4px; max-width: 62%;
    font-size: clamp(32px, 3.6vw, 48px); line-height: 1.16; font-weight: var(--fw-semi);
    letter-spacing: var(--ls-display); color: var(--c-ink-heading);
  }
  .sv-shape__grid {
    margin: 52px 0 0;
    display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 44px 30px;
  }
  .sv-shape__grid dt {
    padding-bottom: 14px; border-bottom: 1px solid rgba(153, 152, 149, 0.4);
    font-size: var(--fs-micro); font-weight: var(--fw-semi);
    letter-spacing: 0.16em; text-transform: uppercase; color: var(--c-ink-label);
  }
  .sv-shape__grid dd {
    margin: 18px 0 0;
    font-size: var(--fs-body); line-height: 25px; font-weight: var(--fw-medium);
    letter-spacing: var(--ls-item); color: rgba(20, 20, 20, 0.82);
  }
  .sv-shape__list { list-style: none; margin: 0; padding: 0; }
  .sv-shape__list li { margin-top: 12px; }
  .sv-shape__list li:first-child { margin-top: 0; }
  .sv-shape__list b { display: block; font-weight: var(--fw-semi); color: var(--c-black); }

  /* ── S8 next ────────────────────────────────────────────── */
  .sv-next { padding-block: 64px 80px; }
  .sv-next__h {
    margin: 26px 0 0 -4px; max-width: 62%;
    font-size: clamp(32px, 3.6vw, 48px); line-height: 1.16; font-weight: var(--fw-semi);
    letter-spacing: var(--ls-display); color: var(--c-ink-heading);
  }
  .sv-next__cols {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 48px 60px; margin-top: 52px;
  }
  .sv-next__col-h {
    margin: 0 0 10px;
    font-size: var(--fs-micro); font-weight: var(--fw-semi);
    letter-spacing: 0.16em; text-transform: uppercase; color: var(--c-ink-label);
  }
  .sv-next__list { list-style: none; margin: 0; padding: 0; }
