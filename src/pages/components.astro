---
/**
 * Phase 1 exit test: every design system primitive rendered in one place,
 * on all three grounds, with its hover, focus and reduced-motion behaviour.
 *
 * Not part of the site. Permanently noindex, absent from the sitemap, and not
 * in docs/URL-INVENTORY.csv. Delete it or leave it; it costs one page.
 *
 * Copy here is either a real content fact from the specs or an obvious label
 * describing the component. No invented client names or metrics.
 */
import BaseLayout from '../layouts/BaseLayout.astro'
import Section from '../components/Section.astro'
import SectionHeader from '../components/SectionHeader.astro'
import Button from '../components/Button.astro'
import GhostButton from '../components/GhostButton.astro'
import FilterChip from '../components/FilterChip.astro'
import Accordion from '../components/Accordion.astro'
import AvatarStack from '../components/AvatarStack.astro'
import StatBlock from '../components/StatBlock.astro'
import TopBar from '../components/TopBar.astro'
import NavOverlay from '../components/NavOverlay.astro'
import CtaBand from '../components/CtaBand.astro'
import SiteFooter from '../components/SiteFooter.astro'
import { site } from '../lib/site'

/** Real team names, from the brand guidelines content facts. No images yet. */
const team = [
  { name: 'Rinkesh A Shah' },
  { name: 'Suzanne Martin' },
  { name: 'Avinash Kumar' },
  { name: 'Kevin Jacob' },
]

/** Real service names, from the content facts. */
const industries = [
  { value: 'all', label: 'All' },
  { value: 'product', label: 'Product Development' },
  { value: 'ux', label: 'User Experience Design' },
  { value: 'mobile', label: 'Mobile App Development' },
  { value: 'mvp', label: 'MVP Development' },
  { value: 'ai', label: 'AI Automation' },
]

/**
 * Placeholder Q&A. This component's real content comes from the Main and
 * AI Automation specs in Phase 3 and 4; these two exist only to prove the
 * open/close behaviour and are plainly labelled as such.
 */
const faq = [
  {
    question: 'Accordion row one, open by click',
    answer:
      'Only one row is open at a time. The trigger is a real button with aria-expanded, and the panel is a labelled region. Real FAQ copy arrives with the pages that carry FAQs.',
  },
  {
    question: 'Accordion row two, keyboard reachable',
    answer:
      'Tab to the trigger and press Enter or Space. Opening this row closes the other one.',
  },
]
---

<BaseLayout
  title="Design system components | Roars Technologies"
  description="Internal reference page rendering every Roars v2 design system primitive with its hover, focus and reduced-motion states."
  path="/components/"
  noindex={true}
>
  <TopBar slot="topbar" />
  <NavOverlay />

  <Section ground="light">
    <div class="pad">
      <SectionHeader
        label="Internal"
        heading="Components"
        level="h1"
        intro="Every primitive in the system, on each ground it has to work on. Not part of the site."
      />
    </div>
  </Section>

  <Section ground="light">
    <div class="pad">
      <h2 class="ex__h">Buttons</h2>
      <div class="ex__row">
        <Button href="/contact-us/" label="Contact Now" />
        <GhostButton href="/contact-us/" label="Contact Now" on="light" width={195} />
      </div>
      <p class="ex__note">
        Primary is 204&times;47 with the two dots at x167 and x177. Hover fills
        the accent. Ghost uses an inset ring, never a CSS border.
      </p>
    </div>
  </Section>

  <Section ground="dark">
    <div class="pad">
      <h2 class="ex__h ex__h--dark">Buttons on dark</h2>
      <div class="ex__row">
        <Button href={site.booking} label="Request a Callback" variant="light" external />
        <GhostButton href={site.booking} label="Setup a Meeting" on="dark" external />
      </div>
      <p class="ex__note ex__note--dark">
        The bar above should be showing white ink over this section.
      </p>
    </div>
  </Section>

  <Section ground="surface">
    <div class="pad">
      <h2 class="ex__h">Filter chips</h2>
      <div class="ex__row" data-filter-group="demo">
        {industries.map((c, i) => (
          <FilterChip
            value={c.value}
            label={c.label}
            active={i === 0}
            readout={i === 0 ? '5 / 5' : undefined}
          />
        ))}
      </div>
      <ul class="ex__cards">
        {industries.slice(1).map((c) => (
          <li class="ex__card" data-filter-item="demo" data-cats={c.value}>{c.label}</li>
        ))}
      </ul>
      <p class="ex__empty" data-filter-empty="demo" hidden>Nothing matches that filter.</p>
      <p class="ex__note">
        Client-side state only. No query URL, no history entry, so a filtered
        view never becomes its own indexable URL.
      </p>
    </div>
  </Section>

  <Section ground="light">
    <div class="pad">
      <h2 class="ex__h">Stat blocks</h2>
      <div class="ex__stats">
        <StatBlock value="20" suffix="+" label="Years in product development" />
        <StatBlock value="250" suffix="+" label="Projects delivered" />
        <StatBlock value="96" suffix="%" suffixStyle="percent" label="Returning customers" />
      </div>
      <p class="ex__note">Real figures, from the content facts in the brand guidelines.</p>
    </div>
  </Section>

  <Section ground="light">
    <div class="pad">
      <h2 class="ex__h">Avatar stack</h2>
      <AvatarStack people={team} count="+8" />
      <p class="ex__note">
        42px circles, &minus;9px overlap, 3px ring. No portrait images are in
        the repo yet, so each falls back to initials rather than a stock face.
      </p>
    </div>
  </Section>

  <Section ground="light">
    <div class="pad">
      <h2 class="ex__h">Accordion</h2>
      <Accordion items={faq} name="demo" />
    </div>
  </Section>

  <Section ground="light">
    <div class="pad">
      <h2 class="ex__h">Reveal on intersect</h2>
      <div class="ex__reveals">
        {[0, 1, 2, 3].map((i) => (
          <div data-reveal class="ex__tile" style={`transition-delay:${i * 90}ms`}>Tile {i + 1}</div>
        ))}
      </div>
      <p class="ex__note">
        CSS plus one shared IntersectionObserver, not an island. Skipped
        entirely under prefers-reduced-motion.
      </p>
    </div>
  </Section>

  <CtaBand />
  <SiteFooter slot="footer" />
</BaseLayout>

<style>
  .pad { padding-block: var(--sp-7); }
  .ex__h {
    margin: 0 0 var(--sp-5);
    font-size: var(--fs-item); line-height: var(--lh-item);
    font-weight: var(--fw-semi);
    letter-spacing: var(--ls-item);
    color: var(--c-ink-heading);
  }
  .ex__h--dark { color: var(--c-white); }
  .ex__row { display: flex; flex-wrap: wrap; gap: var(--sp-3); align-items: center; }
  .ex__note {
    margin-top: var(--sp-4);
    max-width: 560px;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--c-ink-muted);
  }
  .ex__note--dark { color: var(--c-on-dark-78); }
  .ex__cards { display: flex; flex-wrap: wrap; gap: var(--sp-2); list-style: none; margin: var(--sp-5) 0 0; padding: 0; }
  .ex__card {
    padding: var(--sp-3) var(--sp-4);
    background: var(--c-white);
    box-shadow: inset 0 0 0 1px rgba(20, 20, 20, 0.1);
    font-size: var(--fs-label); line-height: var(--lh-label);
  }
  .ex__empty { margin-top: var(--sp-4); color: var(--c-ink-muted); }
  .ex__stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--sp-5); }
  .ex__reveals { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--sp-3); }
  .ex__tile {
    padding: var(--sp-6) var(--sp-4);
    background: var(--c-surface);
    font-size: var(--fs-label); line-height: var(--lh-label);
    color: var(--c-ink-muted);
  }

  @media (max-width: 760px) {
    .ex__stats, .ex__reveals { grid-template-columns: 1fr 1fr; }
  }
</style>
