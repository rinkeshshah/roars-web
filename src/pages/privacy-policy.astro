---
/**
 * /privacy-policy/ — live and indexed.
 *
 * The text is legal copy that exists on the WordPress site and moves across
 * with the content migration. It is not written here: inventing a privacy
 * policy or terms of service would be both fabricated content and a liability,
 * and paraphrasing the existing one would change what the company has
 * published. The route exists so the URL keeps resolving.
 */
import MarketingPage from '../components/MarketingPage.astro'
---

<MarketingPage
  title="Privacy Policy | Roars Technologies"
  path="/privacy-policy/"
  label="Legal"
  heading="Privacy Policy"
  pending={true}
  cta={false}
/>
