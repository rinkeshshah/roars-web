---
/**
 * Not found. Built from design/prototypes/Roars v2 - 404.dc.html.
 *
 * MUST RETURN A REAL 404, not a 200 carrying a 404 page. nginx does that with
 * `error_page 404 /404.html` — see docs/DEPLOYMENT.md. A soft 404 is worse
 * than a hard one: Google keeps the URL in the index and reports it as a
 * crawl error, and a visitor's browser cannot tell the two apart.
 *
 * Everything that was ever indexed and has since moved is a 301 in
 * src/lib/redirects.mjs, emitted as real nginx rules by the postbuild step.
 * This page is for the rest: mistyped addresses, stale links from elsewhere,
 * and anything genuinely retired. It is not a redirect target — sending every
 * unmatched URL to the homepage would be a soft 404 with extra steps.
 *
 * THE PATH IS NOT ECHOED BACK. Printing "we could not find /whatever/" is the
 * oldest reflected-XSS hole there is, and it tells the visitor nothing they
 * do not already know. CLAUDE.md: never echo user input.
 *
 * WHAT CAME FROM THE DESIGN AND WHAT CAME FROM THE SITE. The band, the digits
 * with the hole punched between them, the copy, the two buttons and the route
 * list are the prototype's. The shell is this site's — TopBar, NavOverlay and
 * SiteFooter — because the prototype ships its own stand-in header and footer
 * that exist only so the artboard is a whole page. Following the real shell is
 * what keeps the 404 part of the site rather than a separate thing that looks
 * like it.
 *
 * THE MOTION IS ALL THERE, deliberately: the ring spins, the mark inside it
 * floats, the status dot pulses, the two grounds drift, and the whole stack
 * answers the pointer with a parallax. Accessibility is not handled by cutting
 * any of it — src/styles/tokens.css carries a site-wide
 * prefers-reduced-motion blanket that reduces every animation and transition
 * to 0.01ms, so a visitor who asks for stillness gets it without this page
 * shipping a second, quieter design.
 *
 * Always noindex, whatever the site-wide switch says.
 */
import BaseLayout from '../layouts/BaseLayout.astro'
import Section from '../components/Section.astro'
import TopBar from '../components/TopBar.astro'
import NavOverlay from '../components/NavOverlay.astro'
import SiteFooter from '../components/SiteFooter.astro'
import GrainField from '../components/GrainField.astro'
import { site } from '../lib/site'
import mark from '../assets/roars-mark.png'

/**
 * Where people actually meant to go. Every href is a live route.
 *
 * The prototype points these at its own artboards — Roars v2 - Main.dc.html
 * and friends — which are not URLs. Titles and notes are the design's; the
 * destinations are the inventory's, per CLAUDE.md rule 1.
 */
const routes = [
  { title: 'Home', note: 'Start over', href: '/' },
  { title: 'Projects', note: '250+ delivered', href: '/work/' },
  { title: 'Agency', note: 'Who we are', href: '/about-us/' },
  { title: 'Insights', note: 'How we work', href: '/our-journal/' },
  { title: 'Contact', note: 'Reply in 24 hours', href: '/contact-us/' },
]

const reportHref = `mailto:${site.email.sales}?subject=${encodeURIComponent('Broken link on roarsinc.com')}`
---

<BaseLayout
  title={`Page not found | ${site.name}`}
  description="That page does not exist, or it has moved. Here is the way back."
  path="/404/"
  noindex={true}
>
  <TopBar slot="topbar" cta="contact" />
  <NavOverlay />

  <Section ground="dark" bleed>
    <div class="nf" data-nf>
      <GrainField tone="dark" second />

      <div class="wrap nf__inner">
        <div class="nf__flag">
          <span class="nf__flag-text">Error 404</span>
          <span class="nf__pulse" aria-hidden="true"></span>
        </div>

        <div class="nf__stack" data-nf-stack>
          {/* The two figures with the hole punched between them. The middle
              slot is not a zero — it is a ring with the mark adrift inside,
              which is the joke the page is built on. */}
          <div class="nf__digits">
            <span class="nf__fig" data-nf-par=".05" aria-hidden="true">4</span>
            <span class="nf__hole" data-nf-hole>
              <span class="nf__ring" aria-hidden="true"></span>
              <span class="nf__orbit" style={`--mark:url(${mark.src})`} aria-hidden="true"></span>
            </span>
            <span class="nf__fig" data-nf-par=".05" aria-hidden="true">4</span>
            {/* The digits are decorative; the heading below carries the text.
                Screen readers get the number once, here, not as "4 4". */}
            <span class="visually-hidden">404.</span>
          </div>

          <div class="nf__cols">
            <div class="nf__rail">
              <span class="nf__rule" aria-hidden="true"></span>
              <h1 class="nf__h">This page drifted out of orbit.</h1>
              <p class="nf__body">
                The address is valid, the page is not — it was moved, renamed, or never
                existed. Nothing is broken on your side.
              </p>
              <div class="nf__actions">
                <a class="nf__home" href="/">
                  <span>Back to home</span>
                  <span class="nf__dots" aria-hidden="true">
                    <span class="nf__dot nf__dot--soft"></span>
                    <span class="nf__dot nf__dot--ink"></span>
                  </span>
                </a>
                <a class="nf__report" href={reportHref}>Report a broken link</a>
              </div>
            </div>

            <div class="nf__ways">
              <span class="nf__ways-label">Try one of these</span>
              {routes.map((r) => (
                <a class="nf__row" href={r.href}>
                  <span class="nf__row-title">{r.title}</span>
                  <span class="nf__row-note">{r.note}</span>
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </Section>

  <SiteFooter
    slot="footer"
    blurbTitle="Still not finding it?"
    blurb="Tell us what you were after. It is quicker than hunting through a nav, and somebody here has probably written about it."
    tagline="user experience matters"
    ctaLabel="Shall we chat?"
    ctaHref={site.booking}
  />
</BaseLayout>

<style>
  /* ── the band ───────────────────────────────────────────── */
  .nf { position: relative; }
  .nf__inner {
    position: relative; z-index: 1;
    display: flex; flex-direction: column;
    padding-block: 120px 96px; min-height: 620px;
  }

  /* The status flag. The prototype puts this in its own header; here the real
     TopBar owns that row, so it sits at the top of the band instead. */
  .nf__flag { display: flex; align-items: center; gap: 10px; }
  .nf__flag-text {
    font-size: var(--fs-micro); line-height: 19px; font-weight: var(--fw-semi);
    letter-spacing: 0.14em; text-transform: uppercase; color: rgba(255, 255, 255, 0.5);
    white-space: nowrap;
  }
  .nf__pulse {
    width: 8px; height: 8px; border-radius: 50%; background: var(--c-accent);
    animation: nfPulse 2.4s ease-in-out infinite;
  }

  .nf__stack {
    display: flex; flex-direction: column; gap: clamp(2px, 0.6vw, 8px);
    margin-top: clamp(10px, 2vh, 22px);
  }

  /* ── the digits ─────────────────────────────────────────── */
  /* LINE-HEIGHT IS `normal`, NOT THE PROTOTYPE'S 0.78.
     A Range over a text node reports the font's em box, not the line box, and
     at 360px Inter that is 436px against a 0.78 line box of 280px — so the
     numerals claimed 78px above and below the space they appeared to take.
     Nothing paints there (a "4" has no descender and its cap sits well below
     the ascender), but the box is real, and assert-overlap correctly reported
     it sitting on the flag above and the heading below.
     Making the line box match the glyph box is the honest fix: the row now
     reserves exactly what it occupies. The stack's own margin and gap are
     pulled in to compensate, so the ink lands close to where the prototype
     puts it rather than 78px lower. */
  .nf__digits {
    position: relative; display: flex; align-items: center;
    gap: clamp(4px, 1vw, 14px); line-height: normal; user-select: none;
  }
  .nf__fig {
    display: block;
    font-size: clamp(120px, 26vw, 360px); font-weight: var(--fw-semi);
    letter-spacing: -0.05em; color: #FBFBFB;
  }
  .nf__hole {
    position: relative; flex: none;
    width: clamp(96px, 21vw, 290px); height: clamp(96px, 21vw, 290px);
    display: flex; align-items: center; justify-content: center;
  }
  /* An ANNULUS, not a disc: a conic gradient with its middle masked out, so
     the "0" reads as an orbit the mark has come loose from. */
  .nf__ring {
    position: absolute; inset: 0; border-radius: var(--r-circle);
    background: conic-gradient(var(--c-accent) 0turn, rgba(255, 212, 0, 0.12) 0.72turn, rgba(255, 212, 0, 0.12) 1turn);
    mask: radial-gradient(circle, rgba(0, 0, 0, 0) 63%, #000 65%);
    -webkit-mask: radial-gradient(circle, rgba(0, 0, 0, 0) 63%, #000 65%);
    animation: nfSpin 26s linear infinite;
  }
  /* Masked rather than <img>, the same way LogoChip does it, so the mark takes
     a token colour instead of shipping a second recoloured raster. */
  .nf__orbit {
    position: relative; display: block;
    width: clamp(26px, 5vw, 64px); aspect-ratio: 1;
    background: var(--c-accent);
    mask: var(--mark) center / contain no-repeat;
    -webkit-mask: var(--mark) center / contain no-repeat;
    animation: nfFloat 9s ease-in-out infinite;
  }

  /* ── copy and routes ────────────────────────────────────── */
  .nf__cols { display: flex; flex-wrap: wrap; gap: clamp(22px, 4vw, 72px); align-items: flex-start; }
  .nf__rail { flex: 1 1 320px; min-width: 0; max-width: 560px; display: flex; flex-direction: column; gap: 14px; }
  .nf__rule { width: 100%; max-width: 520px; height: 1.5px; background: rgba(153, 152, 149, 0.6); }
  .nf__h {
    margin: 0;
    font-size: clamp(28px, 3.4vw, 44px); font-weight: var(--fw-semi); line-height: 1.08;
    letter-spacing: var(--ls-display); color: #FBFBFB; text-wrap: pretty;
  }
  .nf__body {
    margin: 0;
    font-size: clamp(15px, 1.3vw, 18px); font-weight: var(--fw-medium); line-height: 1.5;
    letter-spacing: var(--ls-item); color: rgba(255, 255, 255, 0.62); text-wrap: pretty;
  }

  .nf__actions { display: flex; flex-wrap: wrap; gap: 12px; padding-top: 8px; }
  .nf__home {
    display: flex; align-items: center; justify-content: space-between; gap: 24px;
    height: 47px; padding: 0 25px; border-radius: 60px; background: #FBFBFB;
    font-size: 14px; font-weight: var(--fw-medium); letter-spacing: -0.03em;
    color: #0B0B0B; white-space: nowrap;
    transition: background var(--dur-fast) ease;
  }
  .nf__home:hover { background: var(--c-accent); }
  .nf__dots { display: flex; gap: 3px; }
  .nf__dot { width: 8px; height: 8px; border-radius: 50%; }
  .nf__dot--soft { background: rgba(11, 11, 11, 0.35); }
  .nf__dot--ink { background: #0B0B0B; }
  .nf__report {
    display: flex; align-items: center; height: 47px; padding: 0 24px;
    border-radius: 60px; box-shadow: inset 0 0 0 2px rgba(255, 255, 255, 0.22);
    font-size: 13px; font-weight: var(--fw-medium); letter-spacing: -0.03em;
    color: var(--c-white); white-space: nowrap;
    transition: box-shadow var(--dur-fast) ease;
  }
  .nf__report:hover { box-shadow: inset 0 0 0 2px var(--c-accent); }

  .nf__ways { flex: 0 1 420px; min-width: 0; display: flex; flex-direction: column; gap: 6px; }
  .nf__ways-label {
    font-size: 13px; font-weight: var(--fw-semi); letter-spacing: var(--ls-body);
    color: var(--c-ink-label); padding-bottom: 10px;
  }
  .nf__row {
    display: flex; align-items: baseline; justify-content: space-between; gap: 20px;
    padding: 13px 0; border-top: 1px solid rgba(180, 174, 174, 0.22);
    transition: padding-left 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .nf__row:hover { padding-left: 10px; }
  .nf__row-title {
    font-size: clamp(18px, 1.6vw, 24px); font-weight: var(--fw-semi);
    letter-spacing: var(--ls-display); color: rgba(255, 255, 255, 0.92); white-space: nowrap;
  }
  .nf__row-note {
    font-size: 13px; font-weight: var(--fw-medium); letter-spacing: var(--ls-item);
    color: rgba(255, 255, 255, 0.45); text-align: right;
  }

  @keyframes nfSpin { to { transform: rotate(360deg); } }
  @keyframes nfPulse { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.4; transform: scale(0.8); } }
  @keyframes nfFloat { 0%, 100% { transform: translate3d(0, 0, 0); } 50% { transform: translate3d(14px, -18px, 0); } }

  @media (max-width: 900px) {
    .nf__inner { padding-block: 96px 72px; min-height: 0; }
    .nf__ways { flex-basis: 100%; }
    .nf__row-title { white-space: normal; }
  }
</style>

<script>
  /* The pointer parallax and the entrance stagger.
     Both are progressive enhancement: with no JS the page is already complete
     and the CSS animations still run. `matchMedia` is checked here as well as
     in the stylesheet because the Web Animations call below is JavaScript and
     the CSS blanket cannot reach it. */
  const page = document.querySelector<HTMLElement>('[data-nf]')
  if (page && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const stack = page.querySelector<HTMLElement>('[data-nf-stack]')
    if (stack) {
      ;[...stack.children].forEach((el, i) => {
        ;(el as HTMLElement).animate(
          [{ opacity: 0, transform: 'translateY(26px)' }, { opacity: 1, transform: 'none' }],
          { duration: 900, delay: 120 + i * 140, easing: 'cubic-bezier(.16,1,.3,1)', fill: 'both' },
        )
      })
    }

    const pars = [...page.querySelectorAll<HTMLElement>('[data-nf-par]')]
    const hole = page.querySelector<HTMLElement>('[data-nf-hole]')
    let tx = 0, ty = 0, cx = 0, cy = 0, raf = 0

    const loop = () => {
      cx += (tx - cx) * 0.08
      cy += (ty - cy) * 0.08
      pars.forEach((el) => {
        const k = parseFloat(el.getAttribute('data-nf-par') || '') || 0.03
        el.style.transform = `translate3d(${(cx * k * 900).toFixed(1)}px,${(cy * k * 600).toFixed(1)}px,0)`
      })
      /* The hole leads the digits slightly, and the other way, so the mark
         looks like it is falling out rather than riding along. */
      if (hole) hole.style.transform = `translate3d(${(cx * -26).toFixed(1)}px,${(cy * -18).toFixed(1)}px,0)`
      /* Stop the loop once it has settled, rather than burning a frame a tick
         forever on a page nobody stays on. */
      raf = Math.abs(tx - cx) > 0.0005 || Math.abs(ty - cy) > 0.0005 ? requestAnimationFrame(loop) : 0
    }

    addEventListener(
      'pointermove',
      (e) => {
        const r = page.getBoundingClientRect()
        tx = (e.clientX - r.left) / Math.max(1, r.width) - 0.5
        ty = (e.clientY - r.top) / Math.max(1, r.height) - 0.5
        if (!raf) raf = requestAnimationFrame(loop)
      },
      { passive: true },
    )
  }
</script>
