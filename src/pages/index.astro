  .ind__label { margin: 0; font-size: var(--fs-label); line-height: var(--lh-label); font-weight: var(--fw-medium); letter-spacing: var(--ls-display); color: var(--c-black); }
  .ind__sub { margin: 0; font-size: var(--fs-label); line-height: var(--lh-label); font-weight: var(--fw-regular); letter-spacing: var(--ls-display); color: var(--c-rule); }
  .ind__intro { margin-top: var(--sp-4); max-width: 756px; }
  .ind__grid { list-style: none; margin: 202px 0 0 var(--rail-width); padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 107px 20px; }

  /* Horizontal: ring circle on the left, name and cta to its right, rule
     above. Square boxes with inset rings were the earlier reading and are
     not what the prototype does. */
  .ind__card {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr);
    align-items: center;
    gap: var(--sp-3);
    padding-top: 28px;
