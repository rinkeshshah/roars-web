  /* The tags sit BELOW the description inside column 4, at y=157 in a row
     whose description starts at 26 — never beside the title. */
  .svc__stages {
    grid-row: 2; grid-column: 4;
    align-self: start;
    margin: 157px 0 0;
    max-width: 176px;
