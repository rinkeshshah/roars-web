---
/**
 * Homepage. Nine sections, spec in design/specs/Main.md.
 *
 * All copy here is verbatim from that spec, including its own punctuation.
 * Nothing is paraphrased and nothing is invented.
 *
 * MISSING IMAGERY. The spec sources every photograph from
 * roarsinc.com/wp-content/uploads/*. Those files are not in this repo yet:
 * they arrive with the uploads import in Phase 5, and CLAUDE.md forbids
 * hot-linking the live WordPress site. So every photo slot renders the
 * design's own placeholder ground, rgb(30,30,30), at the right dimensions,
 * which keeps the layout and the CLS budget honest. Each one is listed in the
 * build report. Nothing here is a stock stand-in.
 */
import BaseLayout from '../layouts/BaseLayout.astro'
import Section from '../components/Section.astro'
import TopBar from '../components/TopBar.astro'
import NavOverlay from '../components/NavOverlay.astro'
import SiteFooter from '../components/SiteFooter.astro'
import Button from '../components/Button.astro'
import Accordion from '../components/Accordion.astro'
import { site } from '../lib/site'
import { PORTRAIT, CLIENT_LOGOS, WORK, SERVICE_IMG, JOURNAL } from '../lib/media'
import GrainField from '../components/GrainField.astro'
/* Decorative furniture still used by About and Insights. The hero's own
   set — planet, starbelt, slash mark — went with the export 2 redesign. */
import star3 from '../assets/star-3.svg'
import star5 from '../assets/star-5.svg'

/* ------------------------------------------------------------ content */

const services = [
  {
    n: '/01',
    name: 'Product Development',
    body: 'We take products from idea to launch — strategy, design and engineering in one team',
    stages: 'Discovery, Architecture, Engineering, Launch',
    clients: ['Snowman Logistics', 'Parqly'],
    more: '+ 11',
    href: '/s/product-development-company/',
    pad: 40,
  },
  {
    n: '/02',
    name: 'UI/UX and Product Design',
    body: 'Human-centered design that turns complex ideas into easy, elegant user experiences',
    count: '40',
    href: '/s/user-experience-design-agency/',
    pad: 43,
  },
  {
    n: '/03',
    name: 'Mobile App Development',
    body: 'Native and cross-platform apps built to scale with your user base',
    count: '35',
    href: '/s/mobile-app-development/',
    pad: 58,
  },
  {
    n: '/04',
    name: 'AI Automation',
    body: 'Workflow automation and AI features wired into your product and operations.',
    count: '17',
    href: '/s/ai-automation-services/',
    pad: 0,
  },
]

/** Two featured case studies. Slugs from docs/URL-INVENTORY.csv. */
const featured = [
  {
    day: '02 Jul',
    year: '2025',
    name: 'Parqly.',
    href: '/work/parqly-parking-solution/',
    img: WORK.parqly,
    faces: [PORTRAIT.chetna, PORTRAIT.atul],
  },
  {
    day: '15 Oct',
    year: '2026',
    name: 'Snowman Logistics.',
    href: '/work/warehouse-compliance-checklist-app/',
    img: WORK.snowman,
    faces: [PORTRAIT.abhishek, PORTRAIT.suzanne],
  },
]

/**
 * The cascade. Four testimonials at four sizes and four vertical offsets,
 * measured off the rendered prototype. The irregularity IS the design, so the
 * per-item geometry lives here as data rather than as four hand-tuned CSS
 * blocks: `col` places it in the 7-track grid, the rest drive one shared rule
 * set through custom properties.
 */
const testimonials = [
  {
    col: 5, top: 0, avatar: 80, label: 14, qs: 24, lead: 32, star: 14, photo: PORTRAIT.suzanne,
    name: 'Jayeis Sonill',
    role: 'CEO, Aum Investment',
    quote:
      'Roars has consistently positioned themselves at the forefront of innovation and technology. They understand business needs and craft technologies to address them.',
  },
  {
    col: 3, top: 264, avatar: 65, label: 13, qs: 18, lead: 25, star: 12, photo: PORTRAIT.abhishek,
    name: 'James Hadley',
    role: 'CEO, Simthing New, LLC',
    quote:
      'I was pleased with the deliverables. I was able to see and understand the efforts required to scale the solution in development.',
  },
  {
    col: 1, top: 108, avatar: 57, label: 12, qs: 15, lead: 21, star: 11, photo: PORTRAIT.chetna,
    name: 'Avinash Kumar',
    role: 'Project Manager, Roars',
    quote:
      'From discovery to launch, the team brought our platform to life with precision. A genuine product partner.',
  },
  {
    col: 7, top: 230, avatar: 40, label: 10, qs: 12, lead: 17, star: 9, photo: PORTRAIT.khusboo,
    name: 'Khusboo Panchal',
    role: 'Digital Marketing',
    quote: 'Fast, smart and beautiful. We will be back for round two soon.',
  },
]

const industries = [
  { letter: 'R', name: 'Restaurant', href: '/industries/food-restaurant-app-development/' },
  { letter: 'F', name: 'Fitness', href: '/industries/on-demand-fitness-app-development/' },
  { letter: 'e', name: 'eCommerce', href: '/industries/retail-ecommerce-development/' },
  { letter: 'C', name: 'Concierge', href: '/industries/concierge-app-development/' },
  { letter: 'T', name: 'Travel', href: '/industries/travel-and-hospitality-app-development/' },
  { letter: 'L', name: 'Logistics', href: '/industries/logistics-transportation-app-development/' },
  { letter: 'S', name: 'SaaS', href: '/industries/saas-application-development-services/' },
  { letter: 'H', name: 'Healthcare', href: '/industries/healthcare-app-development-company/' },
]

/** Slugs resolved against docs/URL-INVENTORY.csv, not invented. */
const insights = [
  {
    day: '15',
    month: 'May',
    title: 'AI App Development vs Traditional App Development',
    img: JOURNAL.aiVsTraditional,
    href: '/our-journal/ai-app-development-vs-traditional-app-development-which-is-better-for-customer-engagement/',
  },
  {
    day: '04',
    month: 'May',
    title: '20 Years of Roars: Built on Purpose, Driven by Impact',
    img: JOURNAL.twentyYears,
    href: '/our-journal/20-years-of-roars-built-on-purpose-driven-by-impact/',
  },
  {
    day: '11',
    month: 'Dec',
    title: 'The Unexpected Insight — We built a meal planning app',
    img: JOURNAL.mealPlanning,
    href: '/our-journal/the-unexpected-insight-we-built-a-meal-planning-app/',
  },
]

const faq = [
  {
    question: 'How long does it take to build a product?',
    answer:
      'The timeline depends on complexity and specific requirements. An MVP typically runs eight to sixteen weeks. We provide a detailed timeline during the initial consultation to ensure clear expectations.',
  },
  {
    question: 'What’s included in your product strategy?',
    answer:
      'Discovery workshops, market and competitor review, product definition, technical feasibility and a costed delivery roadmap.',
  },
  {
    question: 'How does the monthly engagement model work?',
    answer:
      'A dedicated team bills monthly and works to your cadence. You can scale up or down at the end of any month, with a named project manager throughout.',
  },
  {
    question: 'Can you take over an existing product?',
    answer:
      'Yes. We start with a technical and design audit, then agree a plan to stabilise what exists before extending it.',
  },
  {
    question: 'Do you work with pre-seed startups?',
    answer:
      'Regularly. Much of our work is with founders building a first version, and we scope to the funding available.',
  },
]

/* ------------------------------------------------------------- schema */

/**
 * Organization + WebSite, homepage only, per docs/SEO-SPEC.md 7.1.
 * FAQPage is included because the accordion below renders the real Q&A in the
 * DOM and the answers match word for word, which is the condition for it.
 * No aggregateRating: there are no verifiable on-page reviews.
 */
const schema = [
  {
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': ['Organization', 'ProfessionalService'],
        '@id': `${site.url}/#organization`,
        name: site.name,
        legalName: site.legalName,
        alternateName: site.shortName,
        url: `${site.url}/`,
        foundingDate: site.founded,
        founder: { '@type': 'Person', name: 'Rinkesh A Shah', jobTitle: 'Founder and CEO' },
        sameAs: site.sameAs,
        email: site.email.sales,
        contactPoint: [
          {
            '@type': 'ContactPoint',
            telephone: site.phones.US.tel,
            contactType: 'sales',
            areaServed: ['US', 'CA'],
            availableLanguage: ['en'],
          },
          {
            '@type': 'ContactPoint',
            telephone: site.phones.UK.tel,
            contactType: 'sales',
            areaServed: ['GB', 'EU'],
            availableLanguage: ['en'],
          },
        ],
        address: site.offices.map((o) => ({
          '@type': 'PostalAddress',
          addressLocality: o.city,
          ...(o.region ? { addressRegion: o.region } : {}),
          addressCountry: o.country,
        })),
        knowsAbout: [
          'Product Development',
          'User Experience Design',
          'Mobile App Development',
          'MVP Development',
          'AI Automation',
          'Digital Transformation',
        ],
        numberOfEmployees: { '@type': 'QuantitativeValue', minValue: 11, maxValue: 50 },
      },
      {
        '@type': 'WebSite',
        '@id': `${site.url}/#website`,
        url: `${site.url}/`,
        name: site.name,
        publisher: { '@id': `${site.url}/#organization` },
        inLanguage: 'en-US',
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: { '@type': 'Answer', text: f.answer },
    })),
  },
]
---

<BaseLayout
  title="Product Development for Startups & SMEs | Roars"
  description="Roars is a product development and design agency. 250+ products shipped since 2005, across product strategy, UI/UX, mobile apps and AI automation."
  path="/"
  ogType="website"
  schema={schema}
>
  <TopBar slot="topbar" />
  <NavOverlay />

  {/* ── 1. Header ───────────────────────────────────────────── */}
  <Section ground="accent" bleed>
    {/* Export 2 replaces the space photograph with a full-bleed yellow
        ground. CLAUDE.md's "yellow is never a ground" rule was updated to
        allow exactly this, and only where the prototype does it. The old
        hero — panel, planet, starbelt, slash mark, wordmark, badge and the
        services rail — is gone with it, and space.jpg with that. */}
    <div class="hero">
      <GrainField tone="yellow" second />

      <div class="wrap hero__inner">
        <h1 class="hero__h1">
          Ship product<br />that{' '}
          <span class="hero__rotate" data-rotate data-words="scales|lasts|earns|works">scales</span>
        </h1>
        <p class="hero__lede">
          Roars is a product studio working out of the USA, UK and India.
          250 products shipped for startups and SMEs since 2005.
        </p>
        <a class="hero__cta" href="/contact-us/">
          Start a project<span class="hero__dot" aria-hidden="true"></span>
        </a>
        <div class="hero__rule" aria-hidden="true"></div>
        <ul class="hero__labels">
          <li>Product development</li>
          <li>UI/UX &amp; product design</li>
          <li>Mobile apps</li>
          <li>MVP in 12 weeks</li>
          <li>AI automation</li>
        </ul>
      </div>
    </div>
  </Section>

  {/* ── 2. About ────────────────────────────────────────────── */}
  <Section ground="light">
    <div class="about">
      {/* The paired star marks in the left rail. Decoration, so aria-hidden. */}
      <span class="about__stars" aria-hidden="true">
        <span class="starmark" style={`--m:url(${star3.src});width:20px;height:20px`}></span>
        <span class="starmark" style={`--m:url(${star5.src});width:20px;height:20px`}></span>
      </span>
      {/* All THREE stats live in one 1362x362 block in the export, and the
          third is nested inside it at an offset of 698,187 — it is not a
          second row under the first two, which is how it was built and why it
          sat 15px low with 2005 18px adrift. The two placements overlap in
          the same grid area, which is what grid overlap is for; nothing here
          is absolutely positioned. Columns 463/235/664 sum to the 1362
          content box, so they hold at any width. */}
      <div data-reveal class="about__stats">
        <div class="about__stat-pair">
          <div class="about__stat">
            <p class="about__stat-name">Projects Delivered</p>
            <div class="rule about__stat-rule"></div>
            <div class="about__stat-row">
              <span class="about__stat-num">250<span class="about__plus">+</span></span>
              <span class="about__stat-note">Products launched successfully since 2005</span>
            </div>
          </div>
          <div class="about__stat">
            <p class="about__stat-name">Returning Customers</p>
            <div class="rule about__stat-rule"></div>
            <div class="about__stat-row">
              <span class="about__stat-num">96<span class="about__pct">%</span></span>
              <span class="about__stat-note">Clients who return for their next product</span>
            </div>
          </div>
        </div>

        <div class="about__est">
          <p class="about__est-name">Year of Establishment</p>
          <div class="rule about__est-rule"></div>
          <div class="about__est-row">
            <span class="about__est-note">
              The year Rinkesh A Shah founded Roars — a first product for an
              early-stage startup.
            </span>
            <span class="about__est-side">
              <span class="about__stat-num about__est-num">2005</span>
              {/* Two 28px portraits under the year. Files arrive with the
                  Phase 5 uploads import; the discs hold their places. */}
              <span class="about__est-faces" aria-hidden="true">
                <img src={PORTRAIT.suzanne} alt="" width="28" height="28" loading="lazy" />
                <img src={PORTRAIT.nitin} alt="" width="28" height="28" loading="lazy" />
              </span>
            </span>
          </div>
        </div>
      </div>

      <div data-reveal class="about__team" style="transition-delay:120ms">
        <p class="about__team-name">Team of Roars</p>
        <div class="rule rule--short"></div>
        {/* Scattered cluster, not a row: the prototype offsets the four
            portraits on a 2x3 lattice with one cell left empty, and the count
            sits in that gap. Portraits arrive with the Phase 5 uploads
            import; the discs hold their places until then. */}
        <div class="about__cluster">
          <img class="about__face about__face--a" src={PORTRAIT.suzanne} alt="" width="42" height="42" loading="lazy" />
          <img class="about__face about__face--b" src={PORTRAIT.chetna} alt="" width="42" height="42" loading="lazy" />
          <img class="about__face about__face--c" src={PORTRAIT.nitin} alt="" width="42" height="42" loading="lazy" />
          <img class="about__face about__face--d" src={PORTRAIT.atul} alt="" width="42" height="42" loading="lazy" />
          <p class="about__team-count"><span>59</span></p>
        </div>
      </div>

      <div data-reveal class="about__who" style="transition-delay:160ms">
        <p class="about__who-name">Roars</p>
        <p class="about__who-sub">Product Company</p>
        <img class="about__who-face" src={PORTRAIT.founder} alt="" width="60" height="60" loading="lazy" />
        <p class="about__who-person">Rinkesh A Shah</p>
        <p class="about__who-role">CEO / Founder</p>
      </div>

      {/* The pitch and the logo strip share one column in the export — both
          sit in the block that opens at 584, at 79 and 296 into it. Given
          their own grid rows they were separated by the row gap and the strip
          landed 45px low. */}
      <div class="about__right">
        <div data-reveal class="about__pitch" style="transition-delay:200ms">
          <p>
            We work with you as thinkers, creators, consultants, designers and
            implementers{' '}
            <span class="about__pitch-mid">to turn your product into a high quality marketable offering.</span>{' '}
            <span class="about__pitch-low">Our approach is simple — we bring clarity to complex situations.</span>
          </p>
        </div>

        {/* Client logos. The files live on the WordPress install and arrive
            with the Phase 5 uploads import; CLAUDE.md forbids hot-linking the
            live site, so the row holds its 44px height and its edge fades
            until then and is listed in the build report. */}
        <div class="about__logos" data-reveal>
          <div class="about__logo-row">
            {CLIENT_LOGOS.map((l, i) => (
              <img
                src={l.src}
                alt={l.alt}
                height={l.h}
                style={`--i:${i}`}
                loading="lazy"
                decoding="async"
              />
            ))}
          </div>
        </div>
      </div>
    </div>
  </Section>

  {/* ── 3. Services ─────────────────────────────────────────── */}
  <Section ground="surface">
    <div class="svc">
      <h2 class="display">Services</h2>

      {/* Accordion. Approved island 2 of 4, shared with the FAQ below.

          THE ROWS ALTERNATE. Odd rows take the wide inner track — name at 502,
          body at 966, toggle at the far right — and even rows take the narrow
          rail track: name at 39, body at 503, toggle at 901. A zigzag.

          This was previously flattened to the rail on every row and logged as
          artboard drift, on the reasoning that two rows disagreed with two
          rows and there was no majority. There was no majority because it
          alternates. Where the prototype is irregular, the irregularity is
          the design; see CLAUDE.md. */}
      {/* Accordion. Approved island 2 of 4, shared with the FAQ below.

          MEASURED GEOMETRY, container at 38,306 sized 1364x647:
            row 1  left   0  top   0  h195  OPEN   6 tracks
            row 2  left   0  top 235  h119  closed 4 tracks
            row 3  left 463  top 397  h 96  closed 4 tracks, indented
            row 4  left   1  top 551  h 96  closed 4 tracks

          So two things alternate and one does not, which is why flattening
          this twice looked defensible and was wrong both times:
            - the INDENT alternates. Rows 1 and 3 start at the rail (464),
              rows 2 and 4 at the container edge. A zigzag.
            - the TRACKS depend on open/closed, not on the indent. A closed
              row is always name(465) desc(232) count(166) toggle(36); the
              open row is rail(463) name(241) photo(223) desc(231)
              clients(167) toggle(37).

          The toggle is the BUTTON, and the title is a heading beside it. It
          used to be one button wrapping the title, the description, the
          count and the icon — a button containing flow content, and the
          reason the description existed twice in the row and drew through
          the title on every open. One description, placed by grid. */}
      <ul class="svc__list" data-accordion>
        {services.map((s, i) => (
          <li
            id={`svc-row-${i}`}
            data-svc-row
            class:list={['svc__row', i % 2 === 0 ? 'svc__row--inner' : 'svc__row--rail']}
            data-open={i === 0 ? 'true' : 'false'}
            style={`--svc-pad:${s.pad}px`}
          >
            {/* Rules are ELEMENTS, not a border-top on the row. A border spans
                the row's whole box, and the box stays the full 1364 even when
                the tracks are packed left — so every row drew one rule from
                38 to 1400, which is the first thing that looks wrong here.
                The export draws the OPEN row as a 16px stub in the rail plus
                a separate 898px rule starting at the title, and every CLOSED
                row as a single 898px rule stopping where the toggle does. */}
            <span class="svc__stub" aria-hidden="true"></span>
            <span class="svc__rule" aria-hidden="true"></span>

            <span class="svc__n">{s.n}</span>
            <h3 class="svc__name">{s.name}</h3>
            {/* ONE description element, moved by grid: column 4 when the row
                is open, column 2 when it is closed. Two copies — one in the
                trigger, one in the panel — is what drew the tag line through
                the title on every open, four screenshots running. */}
            <p class="svc__body">{s.body}</p>

            {/* Both states ship in the DOM and `display: contents` drops their
                children straight into the row's tracks, so the accordion
                swaps which is shown without a script having to build either.
                The row is the panel; there is no separate box to overlap. */}
            <div class="svc__open" data-svc-open>
              <div class="svc__media" aria-hidden="true">
                {/* Grey ground on the WRAPPER, as the export has it, so the
                    138px slot still reads at the right size while the uploads
                    are outstanding. On the img it vanished with the image. */}
                <span class="svc__disc">
                  <img src={SERVICE_IMG.productConsultant} alt="" width="138" height="138" loading="lazy" decoding="async" />
                </span>
                <span class="svc__disc svc__disc--sm">
                  <img src={SERVICE_IMG.beautifulExperience} alt="" width="37" height="37" loading="lazy" decoding="async" />
                </span>
              </div>
              {s.stages && <p class="svc__stages">{s.stages}</p>}
              {s.clients && (
                <ul class="svc__clients">
                  {s.clients.map((c) => <li>{c}</li>)}
                  <li class="svc__more">{s.more}</li>
                </ul>
              )}
            </div>

            <p class="svc__count" data-svc-closed>
              {s.count && <><span>{s.count}</span> Projects</>}
            </p>

            <button
              class="svc__icon"
              type="button"
              aria-expanded={i === 0 ? 'true' : 'false'}
              aria-controls={`svc-row-${i}`}
            >
              <span class="visually-hidden">{s.name}</span>
            </button>
          </li>
        ))}
      </ul>

      <div class="svc__foot">
        <p class="intro">
          Roars helps founders stand out with bold product design and smart
          digital solutions. We mix strategy, creativity and technology.
        </p>
        <Button href="/contact-us/" label="Start a Project" />
      </div>
    </div>
  </Section>

  {/* ── 4. Projects ─────────────────────────────────────────── */}
  <Section ground="dark" bleed>
    <div class="proj">
    <GrainField tone="dark" />

    <div class="wrap proj__inner">
      <div class="proj__head">
        <h2 class="display display--on-dark">Projects</h2>
        <p class="proj__count">250<span>+</span></p>
        <ul class="proj__legend">
          {['Recent Projects', 'Product Development', 'UI/UX and Product Design', 'Mobile and AI'].map((l) => (
            <li><span>{l}</span><i aria-hidden="true"></i></li>
          ))}
        </ul>
      </div>

      <div class="proj__stage" data-crossfade>
        {featured.map((f, i) => (
          <article
            class="proj__slide"
            data-slide
            style={`opacity:${i === 0 ? 1 : 0};visibility:${i === 0 ? 'visible' : 'hidden'}`}
            aria-hidden={i === 0 ? undefined : 'true'}
          >
            <div class="proj__date">
              <span class="proj__day">{f.day}</span>
              <div class="rule rule--thin"></div>
              <span class="proj__year">{f.year}</span>
            </div>
            <a class="proj__card" href={f.href}>
              <img class="proj__ph" src={f.img} alt="" width="1129" height="580" loading="lazy" decoding="async" />
              <span class="proj__faces" aria-hidden="true">
                {f.faces.map((src) => <img src={src} alt="" width="42" height="42" loading="lazy" />)}
              </span>
              <span class="proj__name">{f.name}</span>
            </a>
          </article>
        ))}
      </div>

      <div class="proj__foot">
        <span class="proj__stars" aria-hidden="true">
          <span class="starmark" style={`--m:url(${star3.src});width:17px;height:17px`}></span>
          <span class="starmark" style={`--m:url(${star5.src});width:17px;height:17px`}></span>
        </span>
        <Button href="/work/" label="All Projects" variant="light" />
      </div>
    </div>
    </div>
  </Section>

  {/* ── 5. People say ───────────────────────────────────────── */}
  <Section ground="light">
    <div class="say">
      <h2 class="display">People say</h2>
      <p class="say__score">4.9/5</p>

      {/* A cascade, not a row of four equal cards. The four columns do not
          overlap horizontally, so this is one grid with uneven tracks plus a
          per-item top offset — flow layout, no absolute positioning. */}
      <ul class="say__list">
        {testimonials.map((t, i) => (
          <li
            class="say__item"
            data-reveal
            style={`--col:${t.col};--top:${t.top}px;--av:${t.avatar}px;--lb:${t.label}px;--qt:${t.qs}px;--ld:${t.lead}px;--st:${t.star}px;transition-delay:${i * 70}ms`}
          >
            <img class="say__avatar" src={t.photo} alt="" width={t.avatar} height={t.avatar} loading="lazy" decoding="async" />
            <p class="say__name">{t.name}</p>
            <p class="say__role">{t.role}</p>
            <div class="say__rule"></div>
