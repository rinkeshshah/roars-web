  .say__stack > * + * { margin-left: var(--avatar-overlap); }
  .say__count {
    display: flex; align-items: center; justify-content: center;
    background: rgb(20, 20, 20);
    font-size: 15px; font-weight: var(--fw-semi);
    letter-spacing: var(--ls-item); color: var(--c-white);
  }
  .say__meta { margin: 0; font-size: 13px; font-weight: var(--fw-medium); line-height: 18px; letter-spacing: var(--ls-display); color: rgb(71, 71, 71); }

  /* 6. industries ------------------------------------------------------ */
  .ind { padding-block: 120px; position: relative; }
