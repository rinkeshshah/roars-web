  .ind__text { display: flex; flex-direction: column; gap: 2px; }
  .ind__name { font-size: var(--fs-intro); font-weight: var(--fw-semi); line-height: 28px; letter-spacing: var(--ls-display); color: var(--c-ink-heading); }
  .ind__cta { font-size: var(--fs-micro); font-weight: var(--fw-medium); line-height: 19px; letter-spacing: var(--ls-item); color: var(--c-rule); }
  .ind__foot { display: grid; grid-template-columns: 232px auto; margin-top: var(--sp-7); }
