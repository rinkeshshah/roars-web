  .proj__day { font-size: var(--fs-item); line-height: var(--lh-item); font-weight: var(--fw-medium); letter-spacing: var(--ls-body); color: #fbfbfb; }
  .proj__date .rule { margin-block: var(--sp-3); width: 85px; }
  .proj__year { font-size: var(--fs-label); line-height: var(--lh-label); letter-spacing: var(--ls-body); color: var(--c-rule); }
  .proj__card { position: relative; display: block; border-radius: var(--r-card, 12px); overflow: hidden; }
  .proj__ph { display: block; width: 100%; height: 100%; object-fit: cover; background: rgb(30, 30, 30); }
  /* Two ringed faces at the card's top right, as the export draws them. */
  .proj__faces { position: absolute; right: var(--sp-4); top: var(--sp-4); display: flex; flex-direction: column; gap: 6px; }
  .proj__faces img { width: var(--avatar); height: var(--avatar); border-radius: var(--r-circle); object-fit: cover; box-shadow: var(--shadow-ring); }
  /* Placeholder ground from the design system: rgb(30,30,30) at the card's
     real aspect so the layout and CLS budget hold once the photo lands. */
  .proj__ph { aspect-ratio: 1129 / 579; background: rgb(30, 30, 30); border-radius: 12px; }
  .proj__name {
    position: absolute; left: 50%; bottom: 62px;
