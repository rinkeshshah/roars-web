  .svc__row[data-open='true'] .svc__icon { grid-column: 6; margin-top: 29px; }
  .svc__icon::before, .svc__icon::after {
    content: ''; position: absolute; inset: 50% auto auto 50%;
    translate: -50% -50%; background: var(--c-black);
    transition: opacity var(--dur-fast) ease;
  }
  .svc__icon::before { width: 13px; height: 1.25px; }
  .svc__icon::after { width: 1.25px; height: 13px; }
  .svc__row[data-open='true'] .svc__icon::after { opacity: 0; }
  .svc__icon:hover { background: var(--c-accent); }

  .svc__clients { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; font-size: var(--fs-body); font-weight: var(--fw-semi); line-height: 22px; letter-spacing: var(--ls-item); }
  .svc__more { font-weight: var(--fw-medium); color: rgb(145, 144, 142); }

  .svc__foot {
    /* The pill sits at 967, one rail width from the paragraph's 503 — so the
       first track is 464 with no gap, not 356 plus a gap. */
    display: grid; grid-template-columns: 464px 1fr; gap: 0;
    margin-top: 72px; margin-left: var(--rail-width);
    align-items: start;
  }
  .svc__foot .intro { max-width: 356px; }
  .svc__foot :global(a) { justify-self: start; }

  /* 4. projects -------------------------------------------------------- */
  .proj { position: relative; background: var(--c-black); }
  /* Section 1340 tall, the all-line ending at 1195: 145 below it. 68 left
     the section 77 short once the all-line moved up to its measured y. */
  .proj__inner { position: relative; z-index: 1; padding-block: 142px 145px; }
  .proj__head { margin-left: var(--rail-width); }
  .proj__count { margin-top: var(--sp-4); font-size: 40px; font-weight: var(--fw-semi); letter-spacing: var(--ls-display); color: rgb(236, 234, 228); }
  .proj__count span { font-size: 22px; font-weight: var(--fw-medium); }
  /* Label at 732, a 16px white rule at 974. Measured off the export. */
  .proj__legend {
