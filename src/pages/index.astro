---
/**
 * Homepage. Nine sections, spec in design/specs/Main.md.
 *
 * All copy here is verbatim from that spec, including its own punctuation.
 * Nothing is paraphrased and nothing is invented.
 *
 * MISSING IMAGERY. The spec sources every photograph from
 * roarsinc.com/wp-content/uploads/*. Those files are not in this repo yet:
 * they arrive with the uploads import in Phase 5, and CLAUDE.md forbids
 * hot-linking the live WordPress site. So every photo slot renders the
 * design's own placeholder ground, rgb(30,30,30), at the right dimensions,
 * which keeps the layout and the CLS budget honest. Each one is listed in the
 * build report. Nothing here is a stock stand-in.
 */
import BaseLayout from '../layouts/BaseLayout.astro'
import Section from '../components/Section.astro'
import TopBar from '../components/TopBar.astro'
import NavOverlay from '../components/NavOverlay.astro'
import SiteFooter from '../components/SiteFooter.astro'
import Button from '../components/Button.astro'
import Accordion from '../components/Accordion.astro'
import { getCollection } from 'astro:content'
import { site } from '../lib/site'
import { PORTRAIT, CLIENT_LOGOS, workHeroFor, JOURNAL_IMG } from '../lib/media'
import { JOURNAL } from '../lib/journal'
import GrainField from '../components/GrainField.astro'
import RingField from '../components/RingField.astro'
/* Decorative furniture still used by About and Insights. The hero's own
   set — planet, starbelt, slash mark — went with the export 2 redesign. */
import star3 from '../assets/star-3.svg'
import star5 from '../assets/star-5.svg'

/* ------------------------------------------------------------ content */

/**
 * ALL TWELVE, IN THE ORDER /s/ PUTS THEM.
 *
 * This band showed four of the twelve and hid the rest behind an accordion
 * nobody was going to open twelve times. It is now a straight list: every
 * service, one row each, and the circle on the right is a link to the page
 * rather than a toggle.
 *
 * The lines are the ones /s/index.astro already writes for each service, not
 * a second set — one description per service, in one place.
 *
 * NO "N PROJECTS" FIGURE. The old rows carried 40, 35 and 17, which are
 * export numbers with nothing behind them in the content: no service record
 * has a project count, and nine of the twelve would have had no number at all.
 * Same call as the "[ NEEDS THE REAL FIGURE ]" placeholders.
 */
/**
 * FIVE FEATURED, SEVEN ON A LINE BELOW.
 *
 * The band used to show four of twelve behind an accordion, then twelve full
 * rows. Twelve rows is a lot of page for a homepage band and the tail of the
 * list was doing none of the work, so this is the Claude Design layout: the
 * five that carry the enquiries get a row each with a figure, and the other
 * seven sit on one "ALSO" line, one click away. Nothing is unreachable.
 *
 * THE FIGURES COME FROM THE DESIGN, NOT FROM THE CONTENT. No service record
 * carries a project count and there is no source in the repo for 40, 35, 17 or
 * 12 weeks; 4,000+ is the company-wide total from site.stats, shown here against
 * Product Development. Raised with the owner, who asked for the design's
 * numbers as drawn. Recorded in docs/OPEN-DECISIONS.md so the next person does
 * not have to rediscover it.
 */
const services = [
  {
    n: '/01',
    name: 'Product Development',
    body: 'Idea to launch: strategy, design and engineering in one team.',
    stat: '4,000', unit: 'shipped',
    href: '/s/product-development-company/',
  },
  {
    n: '/02',
    name: 'User Experience Design',
    body: 'Human-centered design that turns complex ideas into easy, elegant experiences.',
    stat: '40', unit: 'projects',
    href: '/s/user-experience-design-agency/',
  },
  {
    n: '/03',
    name: 'Mobile App Development',
    body: 'Native and cross-platform apps built to scale with your user base.',
    stat: '35', unit: 'projects',
    href: '/s/mobile-app-development/',
  },
  {
    n: '/04',
    name: 'MVP Development',
    body: 'A focused first release that proves the model and returns real user data.',
    stat: '12', unit: 'weeks',
    href: '/s/mvp-development/',
  },
  {
    n: '/05',
    name: 'AI Automation',
    body: 'Workflow automation and AI features wired into your product and operations.',
    stat: '17', unit: 'projects',
    href: '/s/ai-automation-services/',
  },
]

/** The other seven. Same twelve as the menu panel, minus the five above. */
const servicesAlso = [
  { name: 'Innovation Design', href: '/s/innovation-design-company/' },
  { name: 'Web App Development', href: '/s/web-app-development/' },
  { name: 'eCommerce Development', href: '/s/ecommerce-development-company/' },
  { name: 'DevOps', href: '/s/result-oriented-devops-services/' },
  { name: 'Growth Hacking', href: '/s/growth-hacking-agency/' },
  { name: 'Digital Transformation', href: '/s/digital-business-transformation-services/' },
  { name: 'Hire Dedicated Developers', href: '/s/hire-dedicated-developers/' },
]

/**
 * Two featured case studies. Slugs from docs/URL-INVENTORY.csv.
 *
 * The shot comes from workHeroFor, the same resolver /work/ and /work/<slug>/
 * use, so a project shows the same photograph everywhere it is named and there
 * is one place to change it. It is built at 2:1 by scripts/build-work-headers,
 * which is why .proj__ph is 2:1 below rather than the export's 1129x579.
 *
 * NOTHING ABOUT THE PROJECT IS WRITTEN HERE ANY MORE — only which two, and
 * whose faces. The name, the sector, the date and the year all come out of the
 * project's own front matter, read exactly the way /work/ reads them, because
 * the hard-coded versions had already drifted: this band said "02 Jul 2025"
 * and "15 Oct 2026" where the content says 28 Jul 2025 and 18 Feb 2026, and
 * called the clients "Parqly." and "Snowman Logistics." with a full stop that
 * appears nowhere else on the site. A card that names a project cannot be the
 * one surface that gets to disagree about its name.
 */
/* UTC getters throughout, and this table rather than toLocaleDateString: the
   dates are parsed as UTC midnight, so a local getter moves 28 Jul to 27 Jul
   on any build machine west of Greenwich, and a locale format would render
   differently depending on where the build ran. */
const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec']

const projectEntries = await getCollection('projects')
const industryEntries = await getCollection('industries')
/* The sector label is the industry PAGE's own title, so a card and the sector
   page can never disagree about what a sector is called. Same rule as /work/. */
const industryTitle = new Map(industryEntries.map((e) => [e.id, e.data.title as string]))
const projectBySlug = new Map(projectEntries.map((e) => [e.id, e.data]))

const featured = [
  { href: '/work/parqly-parking-solution/', faces: [PORTRAIT.chetna, PORTRAIT.atul] },
  { href: '/work/warehouse-compliance-checklist-app/', faces: [PORTRAIT.abhishek, PORTRAIT.suzanne] },
].map((f) => {
  const d = projectBySlug.get(f.href.split('/').filter(Boolean)[1])
  const at = d?.publishedAt as Date | undefined
  const sectorKey = (d?.industry as string[] | undefined)?.[0]
  return {
    ...f,
    img: workHeroFor(f.href),
    name: (d?.client as string | undefined) ?? '',
    sector: sectorKey
      ? industryTitle.get(sectorKey) ?? sectorKey.charAt(0).toUpperCase() + sectorKey.slice(1)
      : undefined,
    /* Day and month in the rail, year on the card — /work/ split them that way
       because printing the year in both places on one card reads as a mistake,
       and this band had been doing exactly that. */
    day: at ? `${at.getUTCDate()} ${MONTHS[at.getUTCMonth()]}` : '',
    year: at?.getUTCFullYear(),
  }
})

/**
 * The cascade. Four testimonials at four sizes and four vertical offsets,
 * measured off the rendered prototype. The irregularity IS the design, so the
 * per-item geometry lives here as data rather than as four hand-tuned CSS
 * blocks: `col` places it in the 7-track grid, the rest drive one shared rule
 * set through custom properties.
 */
/**
 * THE CASCADE'S FOUR SLOTS. Geometry belongs to the SLOT, not the person:
 * `col` places it in the 7-track grid, the rest drive one shared rule set
 * through custom properties. Slot 0 is the largest and slot 3 the smallest,
 * so each page puts its longest quote first and its shortest last.
 */
const saySlots = [
  { col: 5, top: 0, avatar: 80, label: 14, qs: 24, lead: 32, star: 14 },
  { col: 3, top: 264, avatar: 65, label: 13, qs: 18, lead: 25, star: 12 },
  { col: 1, top: 108, avatar: 57, label: 12, qs: 15, lead: 21, star: 11 },
  { col: 7, top: 230, avatar: 40, label: 10, qs: 12, lead: 17, star: 9 },
]

/**
 * Twelve real testimonials, three pages of four, from the owner's SocialJuice
 * export. Quotes are verbatim contiguous sentences, trimmed to fit the slot
 * they sit in but not reworded.
 *
 * INITIALS, NOT PHOTOGRAPHS. These are real, named clients and there is no
 * portrait of any of them. What used to sit here were four Roars staff
 * photographs standing in for invented client names.
 */
const sayPages = [
  [
    { initials: 'BP', name: 'Bhushan Paralkar', role: 'VP IT & Business Excellence, Snowman Logistics',
      quote: 'You showed a strong understanding of our business needs and prepared well-structured documentation. The user-friendly UI/UX design you created makes the system easy to use, and your guidance in improving business processes has been very valuable.' },
    { initials: 'DS', name: 'Dipali Sikand', role: 'CEO, Club Concierge',
      quote: 'If there is anyone who can truly understand and translate my unique business requirements into a technical reality, it is Roars.' },
    { initials: 'NS', name: 'Nillaesh Sonill', role: 'Medical Director, Pimlico Health Centre',
      quote: 'They have helped with website development and social media engagement alongside quick turn-around time for delivering project work.' },
    { initials: 'SO', name: 'Sandro Ore', role: 'Head of Marketing, Ventura Law',
      quote: 'We love working with Roars! They provide great service and are fast with development.' },
  ],
  [
    { initials: 'NM', name: 'Nirmal Mistry', role: 'Director, Okeva',
      quote: 'Rinkesh and his team at Roars have a unique approach to their work and truly tailor their services to the end client. Bespoke service and dedicated support. They really know their stuff and the quality of their output versus price point is exceptional.' },
    { initials: 'YG', name: 'Yves Goris', role: 'Business Owner, Rubberduck',
      quote: 'I have been a client for about 17 years, and in this time I have always had a good relationship with them. They are always on time, very friendly, and hands-on.' },
    { initials: 'KH', name: 'Kamran Hussain', role: 'Director, gymBAIT',
      quote: 'They executed everything me and my business partner asked for during the process of building our business app. I would recommend their services to anyone I come across.' },
    { initials: 'EE', name: 'Elena Elraie', role: 'Digital Consultant, Lametus',
      quote: 'Their service is professional, flexible, and friendly. I am very happy with the service and the results.' },
  ],
  [
    { initials: 'DS', name: 'Deepika Sharma', role: 'Director, Itax Office',
      quote: 'They took the time to understand our business needs and goals, and translated them into a visually appealing and user-friendly website. The design perfectly aligns with our brand identity, and the layout and navigation are intuitive for our visitors.' },
    { initials: 'SM', name: 'Sadala Musoke', role: 'RightQode',
      quote: 'This is the most dedicated team I have ever met. With the limited budget we had, they have always been on our side and worked hard to see that we launch our product.' },
    { initials: 'NV', name: 'Nisha Verma', role: 'Chief Program Officer, Club Concierges',
      quote: 'They were quite responsive and consistently honored the timelines they set. The quick turnaround times were particularly impressive.' },
    { initials: 'SA', name: 'Sanjeev', role: 'CEO, Broad Wings Family Office',
      quote: 'They approach every project with wholehearted dedication, ensuring it is completed on schedule.' },
  ],
]

/**
 * The eight sectors, in the export's order. `body` is one line on what we
 * actually build in each, which is what the sector's own page opens with.
 */
const industries = [
  { n: '01', letter: 'R', name: 'Restaurant', body: 'Ordering, delivery and POS-linked apps.', href: '/industries/food-restaurant-app-development/' },
  { n: '02', letter: 'F', name: 'Fitness', body: 'On-demand classes, coaching and wearables.', href: '/industries/on-demand-fitness-app-development/' },
  { n: '03', letter: 'e', name: 'eCommerce', body: 'Storefronts, checkout and fulfilment.', href: '/industries/retail-ecommerce-development/' },
  { n: '04', letter: 'C', name: 'Concierge', body: 'Booking and service-request platforms.', href: '/industries/concierge-app-development/' },
  { n: '05', letter: 'T', name: 'Travel', body: 'Booking, itineraries and hospitality ops.', href: '/industries/travel-and-hospitality-app-development/' },
  { n: '06', letter: 'L', name: 'Logistics', body: 'Fleet, dispatch and last-mile tracking.', href: '/industries/logistics-transportation-app-development/' },
  { n: '07', letter: 'S', name: 'SaaS', body: 'Multi-tenant products, roles and billing.', href: '/industries/saas-application-development-services/' },
  { n: '08', letter: 'H', name: 'Healthcare', body: 'Patient apps, records and compliance.', href: '/industries/healthcare-app-development-company/' },
]

/** Slugs resolved against docs/URL-INVENTORY.csv, not invented. */
/**
 * The three newest posts, FROM THE JOURNAL ITSELF.
 *
 * This was three hardcoded entries with hand-picked images, and two of the
 * three were pointing at the wrong photograph — "AI App Development vs
 * Traditional" carried the AI-fitness hero and the meal-planning piece
 * carried the concierge one. It also went stale the moment anything was
 * published, which is why it was still leading on a post from May.
 *
 * `JOURNAL` is already sorted newest first and already carries the day, the
 * month, the title and the post's own hero, so the homepage takes the top
 * three and nothing here has to be kept in step by hand. The JOURNAL_IMG
 * fallback is the same one /our-journal/ uses for the posts whose migrated
 * hero is missing.
 */
const insights = JOURNAL.slice(0, 3).map((p) => ({
  day: p.day,
  month: p.month,
  title: p.name,
  img: p.hero ?? JOURNAL_IMG[p.slug],
  href: p.href,
}))

const faq = [
  {
    question: 'How long does it take to build a product?',
    answer:
      'The timeline depends on complexity and specific requirements. An MVP typically runs eight to sixteen weeks. We provide a detailed timeline during the initial consultation to ensure clear expectations.',
  },
  {
    question: 'What’s included in your product strategy?',
    answer:
      'Discovery workshops, market and competitor review, product definition, technical feasibility and a costed delivery roadmap.',
  },
  {
    question: 'How does the monthly engagement model work?',
    answer:
      'A dedicated team bills monthly and works to your cadence. You can scale up or down at the end of any month, with a named project manager throughout.',
  },
  {
    question: 'Can you take over an existing product?',
    answer:
      'Yes. We start with a technical and design audit, then agree a plan to stabilise what exists before extending it.',
  },
  {
    question: 'Do you work with pre-seed startups?',
    answer:
      'Regularly. Much of our work is with founders building a first version, and we scope to the funding available.',
  },
]

/* ------------------------------------------------------------- schema */

/**
 * Organization + WebSite, homepage only, per docs/SEO-SPEC.md 7.1.
 * FAQPage is included because the accordion below renders the real Q&A in the
 * DOM and the answers match word for word, which is the condition for it.
 * No aggregateRating: there are no verifiable on-page reviews.
 */
const schema = [
  {
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': ['Organization', 'ProfessionalService'],
        '@id': `${site.url}/#organization`,
        name: site.name,
        legalName: site.legalName,
        alternateName: site.shortName,
        url: `${site.url}/`,
        foundingDate: site.founded,
        founder: { '@type': 'Person', name: 'Rinkesh A Shah', jobTitle: 'Founder and CEO' },
        sameAs: site.sameAs,
        email: site.email.sales,
        contactPoint: [
          {
            '@type': 'ContactPoint',
            telephone: site.phones.US.tel,
            contactType: 'sales',
            areaServed: ['US', 'CA'],
            availableLanguage: ['en'],
          },
          {
            '@type': 'ContactPoint',
            telephone: site.phones.UK.tel,
            contactType: 'sales',
            areaServed: ['GB', 'EU'],
            availableLanguage: ['en'],
          },
        ],
        address: site.offices.map((o) => ({
          '@type': 'PostalAddress',
          addressLocality: o.city,
          ...(o.region ? { addressRegion: o.region } : {}),
          addressCountry: o.country,
        })),
        knowsAbout: [
          'Product Development',
          'User Experience Design',
          'Mobile App Development',
          'MVP Development',
          'AI Automation',
          'Digital Transformation',
        ],
        numberOfEmployees: { '@type': 'QuantitativeValue', minValue: 11, maxValue: 50 },
      },
      {
        '@type': 'WebSite',
        '@id': `${site.url}/#website`,
        url: `${site.url}/`,
        name: site.name,
        publisher: { '@id': `${site.url}/#organization` },
        inLanguage: 'en-US',
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: { '@type': 'Answer', text: f.answer },
    })),
  },
]
---

<BaseLayout
  title="Product Development for Startups & SMEs | Roars"
  description="Roars is a product development and design agency. 4,000+ products shipped since 2005, across product strategy, UI/UX, mobile apps and AI automation."
  path="/"
  ogType="website"
  schema={schema}
>
  <TopBar slot="topbar" />
  <NavOverlay />

  {/* ── 1. Header ───────────────────────────────────────────── */}
  <Section ground="accent" bleed>
    {/* Export 2 replaces the space photograph with a full-bleed yellow
        ground. CLAUDE.md's "yellow is never a ground" rule was updated to
        allow exactly this, and only where the prototype does it. The old
        hero — panel, planet, starbelt, slash mark, wordmark, badge and the
        services rail — is gone with it, and space.jpg with that. */}
    <div class="hero">
      <GrainField tone="yellow" second />

      <div class="wrap hero__inner">
        <h1 class="hero__h1">
          Ship product<br />that{' '}
          <span class="hero__rotate" data-rotate data-words="scales|lasts|earns|works">scales</span>
        </h1>
        <p class="hero__lede">
          Roars is a product studio working out of the USA, UK and India.
          4,000+ products shipped for startups and SMEs since 2005.
        </p>
        <a class="hero__cta" href="/contact-us/">
          Start a project<span class="hero__dot" aria-hidden="true"></span>
        </a>
        <div class="hero__rule" aria-hidden="true"></div>
        <ul class="hero__labels">
          <li>Product development</li>
          <li>UI/UX &amp; product design</li>
          <li>Mobile apps</li>
          <li>MVP in 12 weeks</li>
          <li>AI automation</li>
        </ul>
      </div>
    </div>
  </Section>

  {/* ── 2. About ────────────────────────────────────────────── */}
  <Section ground="light">
    <div class="about">
      {/* The paired star marks in the left rail. Decoration, so aria-hidden. */}
      <span class="about__stars" aria-hidden="true">
        <span class="starmark" style={`--m:url(${star3.src});width:20px;height:20px`}></span>
        <span class="starmark" style={`--m:url(${star5.src});width:20px;height:20px`}></span>
      </span>
      {/* All THREE stats live in one 1362x362 block in the export, and the
          third is nested inside it at an offset of 698,187 — it is not a
          second row under the first two, which is how it was built and why it
          sat 15px low with 2005 18px adrift. The two placements overlap in
          the same grid area, which is what grid overlap is for; nothing here
          is absolutely positioned. Columns 463/235/664 sum to the 1362
          content box, so they hold at any width. */}
      <div data-reveal class="about__stats">
        <div class="about__stat-pair">
          <div class="about__stat">
            <p class="about__stat-name">Projects Delivered</p>
            <div class="rule about__stat-rule"></div>
            <div class="about__stat-row">
              <span class="about__stat-num">4,000<span class="about__plus">+</span></span>
              <span class="about__stat-note">Products launched successfully since 2005</span>
            </div>
          </div>
          <div class="about__stat">
            <p class="about__stat-name">AI-Driven Solutions</p>
            <div class="rule about__stat-rule"></div>
            <div class="about__stat-row">
              <span class="about__stat-num">63<span class="about__pct">%</span></span>
              <span class="about__stat-note">Products now shipping with AI in the build</span>
            </div>
          </div>
        </div>

        <div class="about__est">
          <p class="about__est-name">Year of Establishment</p>
          <div class="rule about__est-rule"></div>
          <div class="about__est-row">
            <span class="about__est-note">
              The year Rinkesh A Shah founded Roars, a first product for an
              early-stage startup.
            </span>
            <span class="about__est-side">
              <span class="about__stat-num about__est-num">2005</span>
              {/* Two 28px portraits under the year. Files arrive with the
                  Phase 5 uploads import; the discs hold their places. */}
              <span class="about__est-faces" aria-hidden="true">
                <img src={PORTRAIT.suzanne} alt="" width="28" height="28" loading="lazy" />
                <img src={PORTRAIT.nitin} alt="" width="28" height="28" loading="lazy" />
              </span>
            </span>
          </div>
        </div>
      </div>

      <div data-reveal class="about__team" style="transition-delay:120ms">
        <p class="about__team-name">Team of Roars</p>
        <div class="rule rule--short"></div>
        {/* Scattered cluster, not a row: the prototype offsets the four
            portraits on a 2x3 lattice with one cell left empty, and the count
            sits in that gap. Portraits arrive with the Phase 5 uploads
            import; the discs hold their places until then. */}
        <div class="about__cluster">
          <img class="about__face about__face--a" src={PORTRAIT.suzanne} alt="" width="42" height="42" loading="lazy" />
          <img class="about__face about__face--b" src={PORTRAIT.chetna} alt="" width="42" height="42" loading="lazy" />
          <img class="about__face about__face--c" src={PORTRAIT.nitin} alt="" width="42" height="42" loading="lazy" />
          <img class="about__face about__face--d" src={PORTRAIT.atul} alt="" width="42" height="42" loading="lazy" />
          <p class="about__team-count"><span>25</span></p>
        </div>
      </div>

      <div data-reveal class="about__who" style="transition-delay:160ms">
        <p class="about__who-name">Roars</p>
        <p class="about__who-sub">Product Company</p>
        <img class="about__who-face" src={PORTRAIT.founder} alt="" width="60" height="60" loading="lazy" />
        <p class="about__who-person">Rinkesh A Shah</p>
        <p class="about__who-role">CEO / Founder</p>
      </div>

      {/* The pitch and the logo strip share one column in the export — both
          sit in the block that opens at 584, at 79 and 296 into it. Given
          their own grid rows they were separated by the row gap and the strip
          landed 45px low. */}
      <div class="about__right">
        <div data-reveal class="about__pitch" style="transition-delay:200ms">
          <p>
            We work with you as thinkers, creators, consultants, designers and
            implementers{' '}
            <span class="about__pitch-mid">to turn your product into a high quality marketable offering.</span>{' '}
            <span class="about__pitch-low">Our approach is simple. We bring clarity to complex situations.</span>
          </p>
        </div>

        {/* Client logos.

            DELIBERATE CHANGE FROM THE EXPORT, asked for directly. The export
            draws a static flex row inside a 629px overflow:hidden box, so
            with the real files at their drawn heights only Samsung, TATA and
            GISAID ever appear and Forbes, Reliance and DDB are clipped off
            the right edge — six marks paid for, three seen. It rotates now,
            and the marks are smaller so more of the strip reads at once.

            The row is duplicated and the track travels -50%, which is what
            makes the loop seamless; the export's own edge fades cover both
            entry and exit. The clone is aria-hidden with empty alts so the
            the brands are announced once. */}
        <div class="about__logos" data-reveal>
          <div class="about__logo-track">
            {[false, true].map((clone) => (
              <div class="about__logo-row" aria-hidden={clone ? 'true' : undefined}>
                {CLIENT_LOGOS.map((l, i) => (
                  <img
                    src={l.src}
                    alt={clone ? '' : l.alt}
                    style={`--i:${i}`}
                    loading="lazy"
                    decoding="async"
                  />
                ))}
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </Section>

  {/* ── 3. Services ─────────────────────────────────────────── */}
  <Section ground="surface">
    <div class="svc">
      <div class="svc__head" data-reveal>
        <h2 class="display">Services</h2>
        <p class="svc__intro">
          Five services carry most of the work. The other seven sit one line
          below, one click away.
        </p>
      </div>

      {/* FIVE ROWS, THEN A LINE.

          It was an accordion over four of twelve, then twelve full rows. The
          five that carry the enquiries get a row each; the other seven sit on
          the ALSO line under them. Nothing is unreachable and the band is a
          third of the page it was.

          The whole row is the link target, not just the arrow: a 36px hit area
          at the end of a 1362px row is a bad thing to ask for. The arrow is
          the affordance; the <a> is the row. It sits FIRST in the row so the
          hover styles can reach the name and the arrow with `~`, which only
          looks forwards. */}
      <ul class="svc__list">
        {services.map((s, i) => (
          <li class="svc__row" data-reveal style={`transition-delay:${i * 70}ms`}>
            {/* A rule is an ELEMENT, not a border-top. A border spans the
                row's whole box, and the box is the full 1362 even where the
                tracks stop short of it. */}
            <span class="svc__rule" aria-hidden="true"></span>
            <a class="svc__link" href={s.href}>{s.name}</a>
            <span class="svc__n">{s.n}</span>
            <h3 class="svc__name">{s.name}</h3>
            <p class="svc__body">{s.body}</p>
            <p class="svc__stat"><b>{s.stat}</b><i>{s.unit}</i></p>
            <span class="svc__icon" aria-hidden="true"></span>
          </li>
        ))}
      </ul>

      <div class="svc__also" data-reveal>
        <span class="svc__also-label">ALSO</span>
        <ul class="svc__also-list">
          {servicesAlso.map((s) => (
            <li><a href={s.href}>{s.name}</a></li>
          ))}
        </ul>
      </div>

      <div class="svc__foot" data-reveal>
        <p class="intro">
          Roars helps founders stand out with bold product design and smart
          digital solutions. We mix strategy, creativity and technology.
        </p>
        <Button href="/contact-us/" label="Start a Project" />
      </div>
    </div>
  </Section>

  {/* ── 4. Projects ─────────────────────────────────────────── */}
  <Section ground="dark" bleed pin>
    <div class="proj">
    <GrainField tone="dark" />
    {/* Turn 8a, on the band the export drew it on. AFTER GrainField, not
        before: both fill the band at z-index 0, and at equal z-index the later
        sibling paints on top — put the ring first and the grain gradient
        covers it outright. */}
    <RingField />

    <div class="wrap proj__inner">
      <div class="proj__head" data-reveal>
        <h2 class="display display--on-dark">Projects</h2>
        <p class="proj__count">4,000<span>+</span></p>
        <ul class="proj__legend">
          {['Recent Projects', 'Product Development', 'UI/UX and Product Design', 'Mobile and AI'].map((l) => (
            <li><span>{l}</span><i aria-hidden="true"></i></li>
          ))}
        </ul>
      </div>

      {/* No inline visibility on the slides: each card has to stay paintable
          so the incoming image can ride up OVER the outgoing one, which is
          the whole device. Only the text hides, and it hides discretely — see
          .proj__slide[aria-hidden] below and scripts/crossfade.ts. */}
      {/* THE STAGE IS PINNED. The track below it is the stage's own height
          plus one screenful of scroll per handover; the stage sticks inside
          it, so the first project comes to rest in the middle of the viewport
          and STAYS there while the page keeps scrolling. Those scrolled pixels
          are what drive the handover to the second project, after which the
          track runs out and the section carries on up.
          --steps is the number of handovers, not the number of projects, and
          it is written from the data so adding a third project lengthens the
          track without anyone editing the CSS. */}
      <div class="proj__track" data-crossfade-track style={`--steps:${featured.length - 1}`}>
      <div class="proj__stage" data-crossfade>
        {featured.map((f, i) => (
          <article
            class="proj__slide"
            data-slide
            style={`opacity:${i === 0 ? 1 : 0}`}
            aria-hidden={i === 0 ? undefined : 'true'}
          >
            {/* Day and month only. The year is on the card beside the star,
                the way /work/ sets it — see the note on `featured` above. */}
            <div class="proj__date">
              <span class="proj__day">{f.day}</span>
              <div class="rule rule--thin"></div>
            </div>
            <a class="proj__card" href={f.href}>
              <img class="proj__ph" src={f.img} alt="" width="2400" height="1200" loading="lazy" decoding="async" />
              <span class="proj__faces" aria-hidden="true">
                {f.faces.map((src) => <img src={src} alt="" width="42" height="42" loading="lazy" />)}
              </span>
              {/* Sector, name, year — stacked and left-aligned on the flat-ink
                  side, which is the same caption /work/ sets on its cards. */}
              <span class="proj__cap">
                {f.sector && <span class="proj__sector">{f.sector}</span>}
                <span class="proj__name">{f.name}</span>
                {f.year && (
                  <span class="proj__meta">
                    <span class="proj__star" style={`--m:url(${star5.src})`} aria-hidden="true"></span>
                    <span>{f.year}</span>
                  </span>
                )}
              </span>
            </a>
          </article>
        ))}
      </div>
      </div>

      <div class="proj__foot" data-reveal>
        <span class="proj__stars" aria-hidden="true">
          <span class="starmark" style={`--m:url(${star3.src});width:17px;height:17px`}></span>
          <span class="starmark" style={`--m:url(${star5.src});width:17px;height:17px`}></span>
        </span>
        <Button href="/work/" label="All Projects" variant="light" />
      </div>
    </div>
    </div>
  </Section>

  {/* ── 5. People say ───────────────────────────────────────── */}
  <Section ground="light">
    <div class="say">
      <h2 class="display">People say</h2>
      <p class="say__score">4.9/5</p>

      {/* A cascade, not a row of four equal cards. The four columns do not
          overlap horizontally, so this is one grid with uneven tracks plus a
          per-item top offset — flow layout, no absolute positioning. */}
      {/* THREE PAGES, ONE SET OF SLOTS.

          The cascade's geometry belongs to the slot, so each page renders the
          same four boxes with different people in them and Prev/Next swaps
          which page is shown. All three ship in the DOM: twelve short quotes
          is less markup than the script it would take to fetch them, and it
          means the other eight are in the page for a crawler even though only
          four are on screen. */}
      <div class="say__deck" data-say>
        {sayPages.map((page, p) => (
          <ul class="say__list" data-say-page hidden={p !== 0}>
            {page.map((t, i) => (
              <li
                class="say__item"
                data-reveal
                style={`--col:${saySlots[i].col};--top:${saySlots[i].top}px;--av:${saySlots[i].avatar}px;--lb:${saySlots[i].label}px;--qt:${saySlots[i].qs}px;--ld:${saySlots[i].lead}px;--st:${saySlots[i].star}px;transition-delay:${i * 70}ms`}
              >
                <span class="say__avatar" aria-hidden="true">{t.initials}</span>
                <p class="say__name">{t.name}</p>
                <p class="say__role">{t.role}</p>
                <div class="say__rule"></div>
                <div class="say__stars" aria-label="Rated 5 out of 5">
                  {[0, 1, 2, 3, 4].map(() => (
                    <span class="starmark" style={`--m:url(${star5.src});width:var(--st);height:var(--st)`} aria-hidden="true"></span>
                  ))}
                </div>
                <blockquote class="say__quote">{t.quote}</blockquote>
              </li>
            ))}
          </ul>
        ))}
      </div>

      <div class="say__foot">
        {/* Buttons, not spans. They were decorative marks that looked like
            controls; now they page the deck, so they have to be reachable by
            keyboard and announce themselves. */}
        <div class="say__nav">
          <span class="say__dot"></span>
          <button class="say__prev" type="button" data-say-prev>Prev.</button>
          <button class="say__next" type="button" data-say-next>Next</button>
          <span class="say__dot say__dot--on"></span>
        </div>
        {/* Reviewer portraits arrive with the Phase 5 uploads import; the
            count disc closes the stack, as in the prototype. */}
        <div class="say__stack">
          <span aria-hidden="true"></span>
          <span aria-hidden="true"></span>
          <span aria-hidden="true"></span>
          <span class="say__count">37</span>
        </div>
        <p class="say__meta">reviews<br />4.9 average</p>
        <Button href="https://rateus.roarsinc.com/" label="Leave a Review" />
      </div>
    </div>
  </Section>

  {/* ── 6. Industries ───────────────────────────────────────── */}
  <Section ground="surface">
    <div class="ind">
      <h2 class="display">Industries</h2>
      <p class="intro ind__intro">
        We build in sectors we already understand, so the discovery work starts
        from domain knowledge rather than from scratch.
      </p>

      {/* EIGHT CARDS, FOUR ACROSS, EACH WITH A RULE AND A NUMBER.
          The rail's "Eight sectors / Where we work" pair is gone with the
          redesign: the count is the numbering now, and it was sitting alone in
          the far-left gutter 200px above anything it labelled. */}
      <ul class="ind__grid">
        {industries.map((sector, i) => (
          <li data-reveal style={`transition-delay:${i * 50}ms`}>
            <a class="ind__card" href={sector.href}>
              <span class="ind__rule" aria-hidden="true"></span>
              <span class="ind__n" aria-hidden="true">{sector.n}</span>
              <span class="ind__letter" aria-hidden="true">{sector.letter}</span>
              <span class="ind__text">
                <span class="ind__name">{sector.name}</span>
                <span class="ind__cta">View sector</span>
              </span>
              <span class="ind__body">{sector.body}</span>
            </a>
          </li>
        ))}
      </ul>

      <div class="ind__foot">
        <p class="ind__note">Not listed? Most of our work starts in a new sector.</p>
        <span class="ind__stars" aria-hidden="true">
          <span class="starmark" style={`--m:url(${star3.src});width:17px;height:17px`}></span>
          <span class="starmark" style={`--m:url(${star5.src});width:17px;height:17px`}></span>
        </span>
        <Button href="/work/" label="See the work" />
      </div>
    </div>
  </Section>

  {/* ── 7. Insights ─────────────────────────────────────────── */}
  <Section ground="light">
    <div class="ins">
      <h2 class="display">Insights</h2>
      <div class="ins__head">
        <div class="ins__who">
          <img class="ins__avatar" src={PORTRAIT.founder} alt="" width="42" height="42" loading="lazy" />
          <p class="ins__name">Rinkesh A Shah</p>
          <p class="ins__role">Founder</p>
        </div>
        <p class="intro ins__intro">
          We have a lot to say about product work: how we approach the process,
          what the AI shift actually changes, and the nuances of building for
          founders.
        </p>
      </div>

      <ul class="ins__grid">
        {insights.map((post, i) => (
          <li data-reveal style={`transition-delay:${i * 70}ms`}>
            <a class="ins__card" href={post.href}>
              <img class="ins__ph" src={post.img} alt="" width="138" height="138" loading="lazy" decoding="async" />
              <span class="ins__rule"></span>
              <span class="ins__day">{post.day}</span>
              <span class="ins__month">{post.month}</span>
              <span class="ins__title">{post.title}</span>
