      </ul>

      <div class="ins__foot">
        <span class="ins__stars" aria-hidden="true">
          <span class="starmark" style={`--m:url(${star3.src});width:17px;height:17px`}></span>
          <span class="starmark" style={`--m:url(${star5.src});width:17px;height:17px`}></span>
        </span>
        <Button href="/our-journal/" label="All Insights" />
      </div>
    </div>
  </Section>

  {/* ── 8. FAQ ──────────────────────────────────────────────── */}
  <Section ground="surface">
    <div class="faq">
      <h2 class="display">FAQ</h2>
      {/* Founder block sits in the left rail, as in the prototype. */}
      <div class="faq__rail" data-reveal>
        <img class="faq__avatar" src={PORTRAIT.founder} alt="" width="42" height="42" loading="lazy" />
        <p class="faq__who">Rinkesh A Shah</p>
        <p class="faq__role">CEO / Founder</p>
        <p class="faq__intro">
          Behind every project: the thinking that fuels how Roars builds.
        </p>
      </div>

      <Accordion items={faq} name="home-faq" />

      <div class="faq__foot" data-reveal style="transition-delay:80ms">
        <p class="faq__ask">Didn’t find the answer? Ask us about our services!</p>
        <Button href="/contact-us/" label="Ask your Question" />
      </div>
    </div>
  </Section>

  {/* ── 9. Footer ───────────────────────────────────────────── */}
  <SiteFooter slot="footer" />
</BaseLayout>

<style>
  /* shared ------------------------------------------------------------- */
  .rule { height: 1.5px; background: var(--c-rule-strong); }
  .rule--short { width: 16px; }
  .rule--thin { height: 1.25px; }
  /* A clamp's vw term has to REACH its cap at the 1440 design width, or the
     cap never applies and the step lands fractionally small. 8.6vw is 123.84
     at 1440, not 124 — and since letter-spacing and any em-sized glyph
     children are relative, one missing 0.16px reappears as a row per
     descendant in the diff table. 124/1440 = 8.611vw, so 8.62vw overshoots by
     a hair and the cap decides. Same rule at every clamp here: the vw term
     must exceed cap/14.4. */
  .display {
    margin: 0;
    font-size: clamp(var(--fs-heading-m), 8.62vw, var(--fs-heading));
    font-weight: var(--fw-semi);
    line-height: var(--lh-tight);
    letter-spacing: var(--ls-display);
    color: var(--c-ink-heading);
  }
  .display--on-dark { color: var(--c-off, #fbfbfb); }
  .intro {
    font-size: var(--fs-intro);
    font-weight: var(--fw-medium);
    line-height: var(--lh-intro);
    letter-spacing: var(--ls-item);
    /* The prototype sets section intros in near-black, not the heading ink. */
    color: var(--c-black);
  }

  /* 1. hero ------------------------------------------------------------ */
  .hero { position: relative; min-height: 900px; display: flex; align-items: stretch; }

  .hero__inner {
    position: relative; z-index: 1; width: 100%;
    display: flex; flex-direction: column; align-items: flex-start;
    padding-block: 200px 0;
  }
  .hero__h1 {
    max-width: 1180px; margin: 0;
    font-size: clamp(56px, 10vw, 144px);
    font-weight: var(--fw-semi);
    line-height: 130px;
    letter-spacing: -0.055em;
    color: var(--c-footer);
  }
  .hero__rotate { display: inline-block; min-width: 360px; transition: opacity 260ms var(--ease-out); }
  .hero__lede {
    max-width: 600px; margin: 60px 0 0;
    font-size: var(--fs-item); line-height: 34px;
    font-weight: var(--fw-medium); letter-spacing: var(--ls-item);
    color: rgba(11, 11, 11, 0.78);
  }
  .hero__cta {
    display: inline-flex; align-items: center; gap: 11px;
    height: 52px; margin-top: 26px; padding-inline: 30px;
    border-radius: var(--r-pill);
    background: var(--c-footer); color: var(--c-white);
    font-size: 15px; font-weight: var(--fw-semi); letter-spacing: var(--ls-button);
  }
  .hero__dot { width: 7px; height: 7px; border-radius: 50%; background: var(--c-accent); }
  .hero__rule { width: 100%; height: 1px; margin-top: 74px; background: rgba(11, 11, 11, 0.22); }
  .hero__labels {
    display: flex; justify-content: space-between;
    width: 100%; margin: 23px 0 0; padding: 0;
    list-style: none;
    font-size: 13px; font-weight: var(--fw-semi);
    letter-spacing: 0.14em; text-transform: uppercase;
    /* The export sets no line-height here and inks at 72%, not solid. */
    line-height: normal;
    color: rgba(11, 11, 11, 0.72);
  }

  /* 2. about ----------------------------------------------------------- */
  .about__stars { position: absolute; left: 3px; top: 139px; display: flex; gap: 6px; }
  .about {
    position: relative;
    display: grid;
    grid-template-columns: 464fr 234fr 234fr 430fr;
    /* 83, not --sp-6: the export's stats block ends at 501 and the team row
       opens at 584. */
    row-gap: 83px;
    column-gap: 0;
    /* 155, not 123: the export's last block ends at 924 in a 1079 section. */
    padding-block: 139px 155px;
  }
  /* The export's one stats block: 1362x362 at 39,139. Two placements share
     it — the pair from column 463, the Year block from 698,187. Tracks are
     fr so they resolve to 463/235/664 on the 1362 content box and stay
     proportional below it. */
  .about__stats {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: 463fr 235fr 664fr;
    grid-template-rows: 187px minmax(0, 1fr);
    min-height: 362px;
  }
  .about__stat-pair {
    grid-column: 2 / -1; grid-row: 1 / -1;
    display: grid; grid-template-columns: 435fr 29fr 435fr;
  }
  .about__stat-pair > :last-child { grid-column: 3; }
  .about__est { grid-column: 3 / -1; grid-row: 2 / -1; }

  /* Inside a stat box: name 0, rule 43, number 54, note 73. The name and the
     rule carry the export's 2px inset; the number does not. */
  .about__stat-name, .about__est-name {
    font-size: var(--fs-intro); line-height: 19px; font-weight: var(--fw-semi);
    letter-spacing: var(--ls-body); color: var(--c-black);
  }
  .about__stat-name { margin-left: 2px; }
  .about__stat-rule { margin: 24px 0 0 2px; }
  /* Both tracks are fr and they SUM to the box. Pairing a large fr with 1fr
     does not mean "235 then the rest" — fr distributes proportionally, so
     235fr 1fr gives the second track 1/236th of the row and the note
     collapsed to 2px. */
  /* 268fr, up from the export's 235fr. The export drew this column around a
     three-character figure; the real one is "4,000" at 222px, and with the
     plus and its gap the number needs about 250. At 235 the sign had nowhere
     to go but on top of the note. The note's own column is unchanged — it
     caps at 170px of text, so the 33fr comes out of slack rather than off
     the copy. */
  .about__stat-row {
    display: grid;
    grid-template-columns: 268fr 200fr;
    /* A real gap, not just a wider column. Widening alone left the plus
       ending on the exact pixel the note began — measured at 0px clearance,
       which is touching rather than colliding and reads as a typo. The gap
       holds whatever the figure grows to. */
    column-gap: 24px;
    align-items: start;
    margin-top: 9.5px;
  }
  /* Year block: name 0, rule 38, row 60. The row holds the note at 0 and a
     right column whose year overhangs it by 11px, exactly as drawn. */
  .about__est-rule { margin-top: 19px; }
  /* The drawn row is 448 of the block's 664; the trailing track is the
     remainder so the first two land at 228 and 220. */
  .about__est-row {
    display: grid; grid-template-columns: 228fr 220fr 216fr;
    align-items: start; margin-top: 20.5px;
  }
  .about__est-num { line-height: 84px; }
  /* Flex, not block: as a block the 84px inline span sits in a line box with
     the 22px strut and the two align on the baseline, which put the year 9px
     high. A flex column makes the span its own item. */
  .about__est-side { display: flex; flex-direction: column; align-items: flex-start; margin-top: -11px; }
  .about__est-faces { display: flex; gap: 6px; margin-top: 9px; margin-left: 2px; }
  .about__est-faces img {
    width: 28px; height: 28px; border-radius: var(--r-circle);
    object-fit: cover; background: rgb(173, 173, 173);
  }
  .about__stat-num {
    /* 5.8vw is 83.52 at 1440, so the 84px cap never applied. See .display. */
    font-size: clamp(var(--fs-stat-m), 5.84vw, var(--fs-display));
    /* 84/84 in the export. 43 was a mispairing — it is the /Projects count
       in the Services rows that leads at 43 — and the 41px it cost is
       exactly what left the About section short and shifted every section
       below it. */
    font-weight: var(--fw-semi); line-height: 84px;
    letter-spacing: var(--ls-display); color: var(--c-black);
    /* inline-block, not block: the box has to shrink to the digits so the
       suffix's `left: 100%` lands at the end of the number rather than at the
       far edge of the grid cell. See .about__plus. */
    position: relative; display: inline-block; white-space: nowrap;
  }
  /* The export PLACES these — + at 152,71 and % at 110,73 against a number
     that starts at 0,54 — it does not run them on after the digits. Set
     inline they closed up tight against the figure and sat low on its
     baseline. No table of text positions would have caught it: visual-diff
     skips inline boxes, whose rect is a union of line boxes. It took looking
     at the two renders side by side.
     letter-spacing is re-declared because it INHERITS AS A COMPUTED PX value,
     so both were carrying the number's -4.2px rather than their own. */
  /* THE SUFFIX IS PINNED TO THE END OF THE DIGITS, not to a pixel.
     It used to be `left: 152px` for the plus and `left: 110px` for the per
     cent — offsets measured off whatever figures were there at the time. The
     per cent still worked because "63" is still two digits. The plus did not:
     the figure is "4,000" now, 222px of digits, so a plus pinned at 152px sat
     70px INSIDE the number and printed over the final nought. It was never
     missing, it was underneath.
     `left: 100%` against a number box that shrinks to its own digits puts the
     sign immediately after them whatever they say, which is what 152px was
     trying to approximate. That is why .about__stat-num is inline-block: as a
     block it filled the grid cell and 100% would have meant the far edge of
     the column.
     AND IT FLOWS, which took three goes to get right. Absolute at a fixed
     pixel printed it over the digits. Absolute at `left: 100%` cleared the
     digits but landed on the note in the next column, because out of flow it
     reserves nothing. In flow it can only fit or wrap, and wrapping is ruled
     out by nowrap on the number and a column wide enough to hold it — so the
     one remaining outcome is the right one. */
  .about__plus, .about__pct {
    position: relative;
    display: inline-block;
    vertical-align: top;
    margin-left: 5px;
    line-height: 31px;
    letter-spacing: var(--ls-display);
  }
  .about__plus { top: 17px; font-size: 36px; font-weight: var(--fw-medium); }
  .about__pct  { top: 19px; font-size: 26px; font-weight: 700; }
  .about__stat-note, .about__est-note {
    max-width: 170px; margin-top: 19px;
    font-size: var(--fs-body); line-height: 22px;
    letter-spacing: var(--ls-body); color: rgb(71, 71, 71); opacity: 0.78;
  }
  /* The 19px drop belongs to the two stat notes, which sit that far under
     their number. The Year note opens its own row and starts at its top. */
  .about__est-note { margin-top: 0; line-height: 23px; }
  .about__est-name { font-size: 18px; color: rgb(54, 53, 53); }
  /* The export sets these three at 24px on a 19px leading — tighter than the
     glyphs, which is what keeps "Roars / Product Company" reading as one
     stacked lockup rather than two lines of copy. --lh-item (32px) is the
     body pairing and is wrong here; it cost 4px on "Roars" and 6px on the
     line under it. */
  .about__team-name, .about__who-name, .about__who-sub {
    font-size: var(--fs-item); line-height: 19px; font-weight: var(--fw-semi);
    letter-spacing: var(--ls-item); color: var(--c-black);
  }
  /* Offsets inside the block, from the export: name 0, sub 30, portrait 85,
     name 157, role 178. They are not a rhythm, so each carries its own gap. */
  .about__who { grid-column: 2 / 3; }
  .about__who-sub { margin-top: 11px; color: rgb(71, 71, 71); opacity: 0.7; }
  .about__who-person { margin-top: 12px; font-size: var(--fs-label); line-height: var(--lh-label); font-weight: var(--fw-semi); letter-spacing: var(--ls-body); color: rgb(22, 22, 22); }
  .about__who-role { margin-top: 2px; font-size: var(--fs-label); line-height: var(--lh-label); font-weight: var(--fw-medium); letter-spacing: var(--ls-body); color: rgb(145, 144, 142); }
  /* Team block: name 0, rule 43, cluster 85. */
  .about__team .rule--short { margin-top: 24px; background: rgb(180, 174, 174); }
  .about__cluster { position: relative; width: 145px; height: 143px; margin-top: 40.5px; }
  .about__face {
    position: absolute; width: var(--avatar); height: var(--avatar);
    border-radius: var(--r-circle); object-fit: cover; background: rgb(173, 173, 173);
  }
  .about__face--a { left: 103px; top: 0; }
  .about__face--b { left: 52px;  top: 50px; }
  .about__face--c { left: 0;     top: 101px; }
  .about__face--d { left: 103px; top: 101px; }
  /* One rule, not two. There was a second .about__team-count above the
     cluster block that set 18px on a grey chip; this one overrode it and
     shipped the counter at 14px/19. The export is 18px on a 43px leading. */
  .about__team-count {
    position: absolute; left: 0; top: 0;
    width: var(--avatar); height: var(--avatar);
    margin: 0; border-radius: var(--r-circle);
    background: rgba(153, 152, 149, 0.18);
    display: grid; place-items: center;
  }
  /* CENTRED. It used to sit at 10,8 on a 43px leading, which is what the
     export draws and which reads high and left in a 42px disc. The note that
     kept it there said centring "lost the relationship to the star mark
     beside it" — there is no star mark in this cluster, only four faces and
     this count, so that reason had stopped applying. Asked for and changed.
     line-height 1 rather than 43px: a 43px line box inside a 42px disc cannot
     be centred in it, and the leading was half of why the figure sat low. */
  .about__team-count > span {
    font-size: 18px; line-height: 1; font-weight: var(--fw-semi);
    letter-spacing: var(--ls-item); color: var(--c-black);
  }

  /* Edge fades so the row reads as a strip that continues past its box. */
  .about__logos { position: relative; width: 94.73%; margin: 81px 0 0 -1.81%; overflow: hidden; }
  .about__logos::before, .about__logos::after {
    content: ''; position: absolute; top: 0; bottom: 0; width: 54px; z-index: 1;
  }
  .about__logos::before { left: 0; background: linear-gradient(270deg, rgba(255,255,255,0) 0%, var(--c-white) 100%); }
  .about__logos::after { right: 0; background: linear-gradient(90deg, rgba(255,255,255,0) 0%, var(--c-white) 100%); }
  /* One treatment for every mark, which is the point of the row: grayscale at
     62%, full colour under the cursor. The heights keep the export's relative
     proportions (22/27/24/22/27/22 — not one number, because forcing one
     makes TATA and Reliance look small) scaled to 0.73, which is the "make
     them smaller" half of the request.

     THE ROTATION IS A DELIBERATE CHANGE, not fidelity. See the markup. The
     track is two identical rows and travels exactly -50%, so the moment it
     wraps, row two is where row one began and the loop is invisible. Duration
     scales with the content, not the clock: 6 marks at ~5s each. */
  .about__logo-track {
    display: flex;
    width: max-content;
    animation: logoMarquee 30s linear infinite;
  }
  .about__logos:hover .about__logo-track,
  .about__logos:focus-within .about__logo-track { animation-play-state: paused; }
  @keyframes logoMarquee {
    from { transform: translate3d(0, 0, 0); }
    to   { transform: translate3d(-50%, 0, 0); }
  }
  .about__logo-row {
    display: flex; align-items: center; gap: 36px;
    height: 44px; padding-inline: 18px;
  }
  /* The entrance stagger is KEPT alongside the rotation. The two do not fight:
     the stagger is a Y lift and a fade on each mark, the marquee an X
     translate on the track above them, so they compose. The row still arrives
     as one thing moving rather than six things appearing, and then it turns. */
  /* ONE HEIGHT FOR ALL FIFTEEN, not a per-logo number.
     The old six each carried their own --logo-h because they were raw files
     at whatever size they happened to be. The set is levelled at build time
     now (scripts/build-client-logos.mjs fits each mark's longest axis to the
     same box), so a per-mark override would undo the levelling it is meant to
     preserve. max-width stops a wide wordmark like bollywoodhungama.com from
     running the row long. */
  .about__logo-row img {
    flex: 0 0 auto;
    width: auto; height: 26px; max-width: 132px;
    object-fit: contain;
    opacity: 0.55;
    translate: 0 6px;
    transition:
      filter var(--dur-fast) ease,
      opacity var(--dur-mid) ease calc(var(--i) * 70ms),
      translate var(--dur-mid) cubic-bezier(0.16, 1, 0.3, 1) calc(var(--i) * 70ms);
  }
  /* Visible by default. Gating opacity on .is-in meant that if the observer
     never fired the row simply was not there. The reveal supplies the lift. */
  .about__logos.is-in .about__logo-row img { translate: 0 0; }
  .about__logo-row img:hover { filter: grayscale(0); opacity: 1; }

  /* A strip that moves on its own is exactly what this switches off. It still
     clips at 629, so the export's own three-and-a-bit is what shows. */
  @media (prefers-reduced-motion: reduce) {
    .about__logo-track { animation: none; }
    .about__logo-row img { translate: 0 0; transition: filter var(--dur-fast) ease; }
    /* NO PIN. crossfade.ts already parks on the first slide under reduced
       motion and stops sampling, so a pinned stage would hold a card still
       while 620px of reserved, empty scroll went past — motion sickness is not
       the only reason someone turns this on, but a dead gap is nobody's idea
       of an accommodation. The track collapses and the stage flows. */
    .proj__track::after { display: none; }
    .proj__stage { position: relative; top: auto; }
  }

  /* Explicit box, not the attributes: tokens.css sets img{height:auto}, so a
     portrait whose file is still missing collapses and takes the two names
     under it up with it. The export puts this at 85 in the block, which is
     36 under the line above. */
  .about__who-face { display: block; width: 60px; height: 60px; margin-top: 36px; border-radius: var(--r-circle); object-fit: cover; background: rgb(217, 217, 217); }
  .about__who-person { margin-top: 12px; }
  /* Prototype: "Roars" at 610, the pitch at 689 — 79px lower, not level. */
  /* The who block opens level with "Team of Roars" at 584, not 8px under it. */
  /* 79 and 296 into the block that opens at 584, so the strip clears the
     pitch by 81 rather than by the grid's row gap. */
  .about__right { grid-column: 3 / 5; }
  .about__pitch { margin-top: 79px; }
  .about__pitch p { max-width: 617px; }
  .about__pitch p {
    font-size: var(--fs-item); font-weight: var(--fw-medium);
    line-height: 34px; letter-spacing: var(--ls-item); color: var(--c-black);
  }
  .about__pitch-mid { color: rgb(71, 71, 71); }
  .about__pitch-low { color: rgb(145, 144, 142); }

  /* 3. services -------------------------------------------------------- */
    /* Matches .ind and .ins: the band was 121/96 with only 40px between the
     title and the first row, so it read tighter than every section around
     it even though its own padding was the same. */
  .svc { padding-block: 120px 104px; }
  /* THE TITLE STAYS AT THE RAIL, like every other section title on this page.
     The mockup runs it flush to the container edge with the intro beside it;
     that reads fine in isolation and wrong in a column of six sections that
     all start at 464. The intro keeps its place on the right. */
  .svc__head {
    display: grid; grid-template-columns: minmax(0, 1fr) 348px;
    align-items: end; column-gap: 40px;
    margin-left: var(--rail-width);
  }
  .svc__intro {
    margin: 0 0 14px;
    font-size: var(--fs-body); line-height: 23px;
    font-weight: var(--fw-medium); letter-spacing: -0.045em;
    color: rgb(71, 71, 71);
  }

  .svc__list { list-style: none; margin: 64px 0 0; padding: 0; }

  /* /NN  name  description  figure  arrow, across the full 1362.
     One shape for all five rows: the zigzag belonged to a four-row band and
     with a figure column to line up it just made two of every measurement. */
  .svc__row {
    position: relative;
    display: grid;
    grid-template-columns: 68fr 398fr 500fr 210fr 36fr;
    /* The rule is a hairline ON the row's top edge and takes no space; given a
       real auto track it adds 1-2px to every row and the band drifts. */
    grid-template-rows: 0 auto;
    align-items: center;
    /* MORE ABOVE THAN BELOW. The rule is drawn on the row's top edge, so a
       symmetric 22 put the name hard against the line above it while the
       gap to the next rule looked fine. The row hangs off its rule now. */
    padding-block: 34px 28px;
  }
  /* ABSOLUTE, NOT A GRID TRACK. As a zero-height row-1 track the rule sat
     AFTER the row's padding-top, so padding pushed the rule and the content
     down together and the gap between them never opened — 34px of padding
     still left the name 3px under the line. Anchored to the row's top edge it
     stays put and the padding does what it says. */
  .svc__rule {
    position: absolute; left: 0; right: 0; top: 0;
    height: 1px; background: var(--c-rule-strong);
  }
  /* THE RULE DRAWS ITSELF. Each row already fades and lifts with the shared
     [data-reveal]; the hairline above it sweeps out from the left over the
     same beat, so the list reads as being ruled off a line at a time rather
     than five identical blocks arriving.
     A scaleX on a 1px line costs nothing to composite and cannot shift
     layout.
     `transition-delay: inherit` is doing real work: the per-row stagger is an
     inline style on the <li>, and transition-delay does NOT inherit on its
     own, so without this the five rules would all draw at once under five
     rows arriving 70ms apart. Asking for it explicitly keeps the stagger
     written in one place. */
  .svc__row .svc__rule {
    transform: scaleX(0); transform-origin: left center;
    transition: transform var(--dur-reveal) var(--ease-out);
    transition-delay: inherit;
  }
  .svc__row.is-in .svc__rule { transform: scaleX(1); }
  @media (prefers-reduced-motion: reduce) {
    .svc__row .svc__rule { transform: none; transition: none; }
  }
  /* The last row closes the list, so it gets a rule under it as well as over.
     Without it the ALSO line below reads as part of the fifth service. */
  .svc__row:last-child { border-bottom: 1px solid var(--c-rule-strong); }

  .svc__n {
    grid-row: 2; grid-column: 1;
    font-size: var(--fs-label); line-height: 19px;
    font-weight: var(--fw-medium); letter-spacing: var(--ls-item);
    color: rgb(145, 144, 142);
  }
  .svc__name {
    grid-row: 2; grid-column: 2;
    margin: 0;
    font-size: 26px; line-height: 32px;
    font-weight: var(--fw-semi);
    letter-spacing: var(--ls-item); color: var(--c-black);
    transition: color var(--dur-fast) ease;
  }
  .svc__body {
    grid-row: 2; grid-column: 3;
    margin: 0;
    font-size: var(--fs-body); line-height: 23px;
    font-weight: var(--fw-medium); letter-spacing: -0.06em;
    color: rgb(71, 71, 71);
  }
  /* Figure and unit on one baseline, the unit sitting on the figure's optical
     middle rather than under it. */
  .svc__stat {
    grid-row: 2; grid-column: 4;
    margin: 0; display: flex; align-items: baseline; gap: 7px;
    justify-self: end;
    color: var(--c-black); white-space: nowrap;
  }
  .svc__stat b { font-size: 30px; line-height: 32px; font-weight: var(--fw-semi); letter-spacing: var(--ls-display); }
  .svc__stat i {
    font-style: normal;
    font-size: var(--fs-label); line-height: 19px;
    font-weight: var(--fw-medium); letter-spacing: var(--ls-item);
    color: rgb(90, 90, 88);
  }

  /* The arrow the design puts at the row's right edge. It is the affordance
     for the row's link and takes no events of its own. */
  .svc__icon {
    grid-row: 2; grid-column: 5;
    position: relative;
    justify-self: end;
    width: var(--icon-circle); height: var(--icon-circle);
    border-radius: var(--r-pill); background: var(--c-white);
    /* A ring, because this band's ground is --c-surface and a white disc on it
       is invisible until you already know it is there. */
    border: 1px solid rgba(20, 20, 20, 0.14);
    transition: background var(--dur-fast) ease, border-color var(--dur-fast) ease;
  }
  .svc__icon::before, .svc__icon::after {
    content: ''; position: absolute; background: var(--c-black);
  }
  /* A shaft, and a chevron at the SHAFT'S RIGHT END. Both were centred on the
     disc, so the head sat on the middle of the line and the pair read as a
     dart rather than an arrow. */
  .svc__icon::before {
    inset: 50% auto auto 50%; translate: -50% -50%;
    width: 13px; height: 1.25px;
  }
  .svc__icon::after {
    inset: 50% auto auto 50%; translate: calc(-50% + 3.5px) -50%;
    width: 6px; height: 6px;
    border-top: 1.25px solid var(--c-black); border-right: 1.25px solid var(--c-black);
    background: none; rotate: 45deg;
  }

  .svc__link {
    position: absolute; inset: 0; z-index: 1;
    font-size: 0; color: transparent; border-radius: 6px;
  }
  .svc__link:hover ~ .svc__icon,
  .svc__link:focus-visible ~ .svc__icon { background: var(--c-accent); border-color: var(--c-accent); }
  .svc__link:hover ~ .svc__name { color: rgb(90, 90, 88); }

  /* The other seven, on one line. */
  .svc__also {
    display: grid; grid-template-columns: 68px minmax(0, 1fr);
    align-items: baseline;
    padding-block: 34px 30px;
    border-bottom: 1px solid var(--c-rule-strong);
  }
  .svc__also-label {
    font-size: var(--fs-label); line-height: 19px;
    font-weight: var(--fw-medium); letter-spacing: var(--ls-item);
    color: rgb(145, 144, 142);
  }
  .svc__also-list {
    list-style: none; margin: 0; padding: 0;
    display: flex; flex-wrap: wrap; column-gap: 28px; row-gap: 10px;
  }
  .svc__also-list :global(a) {
    font-size: var(--fs-body); line-height: 23px;
    font-weight: var(--fw-semi); letter-spacing: var(--ls-item);
    color: var(--c-black); text-decoration: none;
    transition: color var(--dur-fast) ease;
  }
  .svc__also-list :global(a:hover) { color: rgb(145, 144, 142); }

  .svc__foot {
    /* The pill sits at 967, one rail width from the paragraph's 503 — so the
       first track is 464 with no gap, not 356 plus a gap. */
    display: grid; grid-template-columns: 464px 1fr; gap: 0;
    margin-top: 56px; margin-left: var(--rail-width);
    align-items: start;
  }
  .svc__foot .intro { max-width: 356px; }
  .svc__foot :global(a) { justify-self: start; }

  /* 4. projects -------------------------------------------------------- */
  .proj { position: relative; background: var(--c-black); }
  /* Section 1340 tall, the all-line ending at 1195: 145 below it. 68 left
     the section 77 short once the all-line moved up to its measured y. */
  .proj__inner { position: relative; z-index: 1; padding-block: 142px 145px; }
  .proj__head { margin-left: var(--rail-width); }
  /* margin-top was --sp-4 against "250+". "4,000+" is a third wider and the
     display heading above it has a tight line-height, so the two boxes met. */
  /* 48, where --sp-4 was enough for "250+". The display heading's line box
     runs well below its baseline and the count always sat inside it; at
     three characters the two rects never met horizontally, and at six they
     do. Clearing the box is the fix, not narrowing the figure. */
  .proj__count { margin-top: 48px; font-size: 40px; font-weight: var(--fw-semi); letter-spacing: var(--ls-display); color: rgb(236, 234, 228); }
  .proj__count span { font-size: 22px; font-weight: var(--fw-medium); }
  /* Label at 732, a 16px white rule at 974. Measured off the export. */
  .proj__legend {
    list-style: none; margin: var(--sp-4) 0 0 229px; padding: 0;
    font-size: var(--fs-body); line-height: 28px;
    letter-spacing: var(--ls-display); color: var(--c-white);
  }
  .proj__legend li { display: grid; grid-template-columns: 242px 16px; align-items: center; }
  .proj__legend i { display: block; height: 1px; background: var(--c-white); }

  /* The pinned track: the stage's own height plus the scroll the handovers
     need. 620px per handover is the export's RANGE, which crossfade.ts already
     used as the distance a handover takes; the only change is that those
     pixels are now scrolled against a stationary card instead of a moving one.
     A SPACER, NOT padding-bottom. A sticky child is confined to its containing
     block's CONTENT box, and padding is outside it — with the reserved scroll
     as padding the track's content box was exactly the stage's height, the
     stage had nought pixels of room to travel, and it scrolled away like any
     static element while reporting position:sticky the whole time. The spacer
     is in flow, so it grows the content box and the stage gets its range.
     The pseudo-element also means the height is never written against a fixed
     stage height: if the card grows, the sum follows it. */
  .proj__track { position: relative; }
  .proj__track::after { content: ''; display: block; height: calc(var(--steps, 1) * 620px); }
  /* Stuck roughly centred: half the leftover viewport, floored at 88px so the
     card never rides up under the top bar on a short window. crossfade.ts
     reads this computed value rather than assuming a number. */
  .proj__stage {
    position: sticky; top: max(88px, calc((100svh - 580px) / 2));
    margin-top: 77px; min-height: 580px;
  }
  .proj__slide {
    position: absolute; inset: 0;
    display: grid; grid-template-columns: 120px minmax(0, 1fr);
    gap: var(--sp-4);
    transform-origin: 50% 100%;
    will-change: opacity, transform;
    /* NO transition. The opacity and transform are sampled from the scroll
       position every frame; a transition on top of that lags behind the
       pointer and makes the handover feel elastic instead of tied to the
       wheel. */
  }
  /* The card overlaps. The TEXT does not: the outgoing date and title leave
     the paint and the accessibility tree outright, so two dates are never on
     screen together at any opacity. That collision is why this motion was
     removed once already. */
  .proj__slide[aria-hidden='true'] .proj__date,
  .proj__slide[aria-hidden='true'] .proj__cap { visibility: hidden; }
  .proj__slide:first-child { position: relative; }
  .proj__day { font-size: var(--fs-item); line-height: var(--lh-item); font-weight: var(--fw-medium); letter-spacing: var(--ls-body); color: #fbfbfb; }
  .proj__date .rule { margin-block: var(--sp-3); width: 85px; }
  .proj__card { position: relative; display: block; border-radius: var(--r-card, 12px); overflow: hidden; }
  .proj__ph { display: block; width: 100%; height: 100%; object-fit: cover; background: rgb(30, 30, 30); }
  /* Two ringed faces at the card's top right, as the export draws them. */
  .proj__faces { position: absolute; right: var(--sp-4); top: var(--sp-4); z-index: 3; display: flex; flex-direction: column; gap: 6px; }
  .proj__faces img { width: var(--avatar); height: var(--avatar); border-radius: var(--r-circle); object-fit: cover; box-shadow: var(--shadow-ring); }
  /* rgb(30,30,30) behind the photograph so the layout and the CLS budget hold
     while it loads. 2:1 because that is what build-work-headers writes and
     what both /work/ surfaces show — the export's 1129x579 would have cropped
     a second time in the browser on top of the crop already baked into the
     file. */
  .proj__ph { aspect-ratio: 2 / 1; background: rgb(30, 30, 30); border-radius: 12px; }
  /* Amber dusk. Amber under ink, same order as /work/ — see tokens.css.
     The card exposure, not the hero one, and the HORIZONTAL ink: the caption
     is now a three-line stack down the left of the picture rather than a name
     along the bottom, which is the case --dusk-ink was written for. The
     bottom-up ramp it used to take put the contrast under a name that is no
     longer there and left the sector label sitting on bare photograph. */
  .proj__ph { filter: brightness(var(--dusk-exposure-card)); }
  .proj__card::before,
  .proj__card::after {
    content: ''; position: absolute; inset: 0; pointer-events: none;
  }
  .proj__card::before { z-index: 1; background: var(--dusk-amber); }
  .proj__card::after { z-index: 2; background: var(--dusk-ink); }
  /* THE CAPTION IS /work/'s. Same order, same type, same alignment, so a
     project introduced on the homepage and the same project in the index read
     as one component. The only number that differs is the left inset: the
     /work/ card carries its date rail INSIDE the frame and starts the caption
     at 176px to clear it, where this band puts the date outside the card and
     has the full width. */
  .proj__cap {
    position: absolute; left: var(--sp-5); top: 33%; right: 46%; z-index: 3;
    display: flex; flex-direction: column; align-items: flex-start;
  }
  .proj__sector {
    font-size: var(--fs-micro); line-height: 19px; font-weight: var(--fw-semi);
    letter-spacing: 0.18em; text-transform: uppercase; color: rgba(255, 255, 255, 0.66);
  }
  .proj__name {
    margin-top: 16px;
    font-size: 56px; line-height: 1.07; font-weight: var(--fw-semi);
    letter-spacing: var(--ls-display); color: var(--c-white);
    text-wrap: pretty;
  }
  .proj__meta {
    display: flex; align-items: center; gap: 12px; margin-top: 22px;
    font-size: var(--fs-body); line-height: 20px; font-weight: var(--fw-medium);
    letter-spacing: var(--ls-item); color: rgba(255, 255, 255, 0.78);
  }
  /* Masked, not an <img>: the star takes the accent token. Same as /work/. */
  .proj__star {
    width: 13px; height: 13px; background: var(--c-accent);
    mask: var(--m) center / contain no-repeat;
    -webkit-mask: var(--m) center / contain no-repeat;
  }
  /* The "all line" is a 430x47 block at 503,1148: two star marks at 0 and 23,
     then the pill at 226. The marks belong beside the pill, not adrift in the
     rail — they were 226px too far left and sitting below it. */
  .proj__foot { display: grid; grid-template-columns: 226px auto; margin-top: 30px; margin-left: var(--rail-width); }
  .proj__foot :global(a) { grid-column: 2; justify-self: start; }
  .proj__stars, .ind__stars { display: flex; gap: 6px; align-self: start; margin-top: 16px; }

  /* 5. people say ------------------------------------------------------ */
  /* 104px below, up from 95, so the band closes with about as much air under
     the controls as the gap that now sits above them. --sp-7 rather than a
     new number: the spacing scale already had the step. */
  .say { padding-block: 147px var(--sp-7); }
  .say .display, .say__score { margin-left: var(--rail-width); }
  .say__score { margin-top: var(--sp-4); font-size: var(--fs-stat); line-height: var(--lh-stat); font-weight: var(--fw-semi); letter-spacing: var(--ls-display); color: var(--c-ink-heading); }

  /* The cascade. Seven tracks so the four items land on the prototype's
     uneven column rhythm (292 / 57 / 339 / 7 / 435 / 29 / 206 of 1365); each
     item then drops by its own offset. Proportional, so it holds off 1440. */
  /* The cascade is an authored 525px band (container 39,329 to 854 in the
     export), not a content-driven one — the four cards carry deliberate
     vertical offsets, so letting the tallest set the height put the review
     bar below it 37px low. min-height, not height: the export's container
     clips at 525 and its mock quotes fit; the real testimonials are longer,
     and cutting a client's words off mid-sentence to save 37px is not a
     trade worth making. Where the band has to grow, it grows. */
  .say__list {
    list-style: none; margin: 27px 0 0; padding: 0;
    display: grid;
    grid-template-columns: 292fr 57fr 339fr 7fr 435fr 29fr 206fr;
    align-items: start;
    min-height: 525px;
  }
  .say__item {
    grid-row: 1;
    grid-column: var(--col);
    margin-top: var(--top);
  }
  /* A monogram, sized off the same --av the photograph used, so the cascade's
     four scales still hold. Font size follows the disc rather than being set
     four times. */
  .say__avatar {
    display: grid; place-items: center;
    width: var(--av); height: var(--av);
    border-radius: var(--r-circle);
    background: rgb(226, 224, 218);
    font-size: calc(var(--av) * 0.34); line-height: 1;
    font-weight: var(--fw-semi); letter-spacing: var(--ls-item);
    color: rgb(64, 63, 60);
  }
  .say__name { margin: 15px 0 0; font-size: var(--lb); font-weight: var(--fw-semi); line-height: 19px; letter-spacing: var(--ls-body); color: rgb(31, 31, 31); }
  .say__role { margin: 0; font-size: var(--lb); font-weight: var(--fw-medium); line-height: 19px; letter-spacing: var(--ls-body); color: var(--c-ink-label); }
  .say__rule { height: 1.5px; margin-top: 19px; background: var(--c-rule-strong); }
  .say__stars { display: flex; gap: 4px; margin-top: 22px; }
  .say__stars img { width: var(--st); height: var(--st); }
  .say__quote {
    margin: 28px 0 0;
    font-size: var(--qt); font-weight: var(--fw-medium);
    line-height: var(--ld); letter-spacing: var(--ls-item); color: var(--c-black);
  }

  /* 386 / 737 / 966 in the prototype, which is its own rhythm rather than
     the inner column. */
  /* Measured: the nav block at 386,880 and the stack block at 737,866, so
     they are 351 apart and NOT baseline-aligned — the nav sits 14 lower.
     Within the stack block: avatars 0-138, meta at 150, pill label at 991
     page-absolute, so the pill starts 229 in and the meta track is 79.
     (I briefly set that track to 314 off a `left:464px` found in the MENU
     overlay's contact panel, not this section, and it threw the pill 235px
     right. Grep the right block.) */
  /* 64px above, not 12. The cascade's lowest quote ended eleven pixels before
     the Prev/Next row started — measured on all three pages of the deck, and
     the list is not overrunning, so twelve is simply what the gap always was.
     Under a paragraph that reads as the controls being part of the quote. */
  .say__foot { display: grid; grid-template-columns: 351px 150px 79px auto; align-items: start; margin-top: var(--sp-6); margin-left: 347px; }
  .say__foot :global(a) { justify-self: start; }
  /* 190px band: dot at 0, "Prev." at 18, "Next" at 128, dot at 182. */
  .say__nav { display: grid; grid-template-columns: 8px 102px 42px 8px; gap: 0 10px; width: 190px; align-items: center; margin-top: 14px; font-size: var(--fs-body); line-height: var(--lh-body); font-weight: var(--fw-medium); letter-spacing: var(--ls-display); }
  /* These are <button>s now, so the UA's own chrome has to come off before
     they look like the marks the prototype draws. */
  .say__prev, .say__next {
    border: 0; padding: 0; background: none; cursor: pointer;
    font: inherit; letter-spacing: inherit;
  }
  .say__prev { color: rgba(0, 0, 0, 0.4); }
  .say__next { color: rgb(8, 8, 8); }
  .say__prev:hover, .say__next:hover { color: var(--c-black); }
  /* All three pages occupy the same cell, so the band does not jump to the
     tallest page's height when you click through. */
  .say__deck { display: grid; }
  .say__deck > * { grid-area: 1 / 1; }
  /* .say__list sets its own display, which beats the UA's [hidden] rule, so
     the two hidden pages were still laid out and every name sat on top of
     the name behind it. */
  .say__list[hidden] { display: none; }
  .say__dot { width: 8px; height: 8px; border-radius: var(--r-circle); background: rgba(0, 0, 0, 0.4); }
  .say__dot--on { background: rgb(8, 8, 8); }
  /* Overlapping stack: 42px discs at a 32px pitch, each ringed in the ground
     colour so the overlap reads as depth rather than a smudge. */
  .say__stack { display: flex; }
  .say__stack > * {
    width: var(--avatar); height: var(--avatar);
    border-radius: var(--r-circle);
    background: rgb(217, 217, 217);
    box-shadow: var(--shadow-ring);
  }
  .say__stack > * + * { margin-left: var(--avatar-overlap); }
  .say__count {
    display: flex; align-items: center; justify-content: center;
    background: rgb(20, 20, 20);
    font-size: 15px; font-weight: var(--fw-semi);
    letter-spacing: var(--ls-item); color: var(--c-white);
  }
  .say__meta { margin: 0; font-size: 13px; font-weight: var(--fw-medium); line-height: 18px; letter-spacing: var(--ls-display); color: rgb(71, 71, 71); }

  /* 6. industries ------------------------------------------------------ */
  .ind { padding-block: 120px 96px; position: relative; }
  /* Title and intro stay at the rail, where every other section title on this
     page sits. The grid and the foot run the full width: eight cards four
     across inside the inner column would be 224px each. */
  .ind .display, .ind__intro { margin-left: var(--rail-width); }
  .ind__intro { margin-top: var(--sp-4); max-width: 756px; }
  /* Was 202px of margin under the intro, against a rail pair that no longer
     exists. That void was the first thing you saw in the section. */
  .ind__grid {
    list-style: none; margin: 64px 0 0; padding: 0;
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 44px 32px;
  }

  /* Ring circle, name and cta beside it, a rule and a number above, and the
     sector's line underneath. */
  .ind__card {
    position: relative;
    display: grid;
    grid-template-columns: 52px minmax(0, 1fr);
    align-items: center;
    column-gap: var(--sp-3); row-gap: 14px;
    padding-top: 26px;
  }
  .ind__rule {
    position: absolute; left: 0; right: 0; top: 0;
    height: 1px; background: var(--c-rule-strong);
  }
  /* The counter sits ON the rule's right end, which is where the design puts
     it and why the rule is an element rather than a border-top. */
  .ind__n {
    position: absolute; right: 0; top: 9px;
    font-size: var(--fs-micro); line-height: 1;
    font-weight: var(--fw-medium); letter-spacing: 2px;
    color: rgb(168, 166, 161);
  }
  .ind__letter {
    grid-column: 1;
    display: flex; align-items: center; justify-content: center;
    width: 52px; height: 52px;
    border-radius: var(--r-circle);
    box-shadow: inset 0 0 0 1.5px rgba(20, 20, 20, 0.35);
    font-size: var(--fs-item); font-weight: var(--fw-semi); line-height: 1;
    letter-spacing: var(--ls-display); color: var(--c-ink-heading);
    transition: box-shadow var(--dur-fast) ease, background var(--dur-fast) ease;
  }
  /* THE WHOLE CARD ANSWERS, not just the disc.
     The card is 250px wide and an <a> for all of it, but only the 52px circle
     used to react — hover anywhere else and nothing happened, which is why it
     read as inert. Now the rule above it takes the accent, the name and its
     cta step 4px right, the number and the cta come up to full ink, and the
     disc keeps the ring it already had.

     THE ACCENT STAYS A LINE, NOT A FILL. tokens.css is explicit that the
     accent is "never a background, max two moments per viewport", and a solid
     yellow 52px disc under the cursor would break both halves of that on a
     grid of eight. The 1px rule going yellow is the accent doing what it is
     for, and it is the same device the service rows use one section up, so
     the two lists behave like one system. */
  .ind__rule, .ind__n { transition: background var(--dur-fast) ease, color var(--dur-fast) ease; }
  .ind__name, .ind__cta { transition: color var(--dur-fast) ease, translate var(--dur-fast) var(--ease-out); }
  .ind__card:hover .ind__rule { background: var(--c-accent); }
  .ind__card:hover .ind__n { color: var(--c-ink-heading); }
  .ind__card:hover .ind__name { translate: 4px 0; }
  .ind__card:hover .ind__cta { translate: 4px 0; color: var(--c-ink-heading); }
  .ind__card:hover .ind__letter { box-shadow: inset 0 0 0 1.5px var(--c-accent); background: rgba(255, 212, 0, 0.14); }

  @media (prefers-reduced-motion: reduce) {
    .ind__name, .ind__cta { transition: color var(--dur-fast) ease; }
    .ind__card:hover .ind__name, .ind__card:hover .ind__cta { translate: none; }
  }
  .ind__text { grid-column: 2; display: flex; flex-direction: column; gap: 2px; }
  .ind__name { font-size: var(--fs-intro); font-weight: var(--fw-semi); line-height: 26px; letter-spacing: var(--ls-display); color: var(--c-ink-heading); }
  .ind__cta { font-size: var(--fs-micro); font-weight: var(--fw-medium); line-height: 18px; letter-spacing: var(--ls-item); color: var(--c-rule); }
  /* Under the whole card, not beside the disc: it is the sector's line, not
     the circle's caption. */
  .ind__body {
    grid-column: 1 / -1;
    font-size: var(--fs-body); line-height: 22px;
    font-weight: var(--fw-medium); letter-spacing: -0.045em;
    color: rgb(90, 90, 88);
  }

  .ind__foot {
    display: grid; grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: center; column-gap: 20px;
    margin-top: 56px; padding-top: 30px;
    border-top: 1px solid var(--c-rule-strong);
  }
  .ind__note {
    margin: 0;
    font-size: var(--fs-body); line-height: 22px;
    font-weight: var(--fw-medium); letter-spacing: -0.045em;
    color: rgb(90, 90, 88);
  }
  .ind__foot :global(a) { justify-self: end; }

  /* 7. insights -------------------------------------------------------- */
  .ins { padding-block: 120px 79px; }
  .ins .display, .ins__head, .ins__foot { margin-left: var(--rail-width); }
  .ins__head { display: grid; grid-template-columns: 232px minmax(0, 524px); gap: 0; margin-top: 92px; align-items: start; }
  .ins__avatar { display: block; width: var(--avatar); height: var(--avatar); border-radius: var(--r-circle); object-fit: cover; background: rgb(217, 217, 217); }
  .ins__name { margin: 18px 0 0; font-size: var(--fs-label); font-weight: var(--fw-semi); line-height: 20px; letter-spacing: var(--ls-display); color: rgb(22, 22, 22); }
  .ins__role { margin: 0; font-size: var(--fs-label); font-weight: var(--fw-medium); line-height: 20px; letter-spacing: var(--ls-display); color: rgb(145, 144, 142); }
  .ins__intro { margin: 0; }

  /* Three cards across the FULL width, gutter to gutter, not inside the
     inner column: the first card's month sits at x=94 in the prototype. */
  .ins__grid { list-style: none; margin: 126px 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 29px; }
  .ins__card {
    display: grid;
    grid-template-columns: 232px minmax(0, 1fr);
    align-items: start;
    row-gap: 0;
  }
  /* A 138px disc, offset into the second column, matching the services row. */
  .ins__ph { grid-column: 2; width: 138px; height: 138px; border-radius: var(--r-circle); object-fit: cover; background: rgb(217, 217, 217); }
  .ins__rule { grid-column: 1 / -1; height: 1px; margin-top: 36px; background: var(--c-rule-strong); }
  .ins__day { grid-column: 1; grid-row: 3; justify-self: start; margin-top: 13px; font-size: var(--fs-stat); font-weight: var(--fw-semi); line-height: 43px; letter-spacing: var(--ls-display); color: var(--c-ink-heading); }
  .ins__month { grid-column: 1; grid-row: 3; justify-self: start; margin: 13px 0 0 55px; font-size: var(--fs-body); font-weight: var(--fw-medium); line-height: 43px; letter-spacing: var(--ls-display); color: var(--c-ink-heading); }
  .ins__title { grid-column: 2; grid-row: 3; max-width: 195px; margin-top: 25px; font-size: var(--fs-body); font-weight: var(--fw-medium); line-height: 22px; letter-spacing: var(--ls-body); color: rgb(20, 20, 20); }
  .ins__card:hover .ins__title { color: rgb(90, 90, 90); }
  .ins__foot { display: grid; grid-template-columns: 232px auto; align-items: center; margin-top: 115px; }
  .ins__foot :global(a) { justify-self: start; }
  .ins__stars { display: flex; gap: 5px; }

  /* 8. faq ------------------------------------------------------------- */
  .faq { padding-block: 120px 135px; position: relative; }
  .faq .display, .faq__foot { margin-left: var(--rail-width); }
  .faq :global(.acc) { margin-top: var(--sp-7); margin-left: var(--rail-width); }
  /* Founder block in the left rail. */
  .faq__rail { position: absolute; left: 3px; top: 308px; width: 195px; }
  .faq__avatar { display: block; width: var(--avatar); height: var(--avatar); border-radius: var(--r-circle); object-fit: cover; background: rgb(217, 217, 217); }
  .faq__who { margin: 10px 0 0; font-size: var(--fs-micro); font-weight: var(--fw-medium); line-height: 19px; letter-spacing: var(--ls-body); color: var(--c-black); }
  .faq__role { margin: 0; font-size: var(--fs-micro); font-weight: var(--fw-regular); line-height: 19px; letter-spacing: var(--ls-body); color: var(--c-rule); }
  .faq__intro { margin: var(--sp-4) 0 0; font-size: var(--fs-body); font-weight: var(--fw-medium); line-height: 22px; letter-spacing: var(--ls-body); color: rgb(20, 20, 20); }
  .faq__foot { margin-top: var(--sp-6); display: grid; grid-template-columns: 232px auto; align-items: center; }
  .faq__foot :global(a) { justify-self: start; }
  .faq__ask { max-width: 200px; margin: 0; font-size: var(--fs-body); font-weight: var(--fw-medium); line-height: 22px; letter-spacing: var(--ls-body); color: rgb(20, 20, 20); }

  /* responsive --------------------------------------------------------- */
  @media (max-width: 1040px) {
    .hero__inner { grid-template-columns: 1fr; padding-block: 180px 80px; row-gap: var(--sp-6); }
    /* minmax(0, 1fr): see the ≤760 block. `1fr` floors at the widest child's
       min-content, which the logo marquee sets to 914px. */
    .about { grid-template-columns: minmax(0, 1fr); }
    .about > * { min-width: 0; }
    .about__stats, .about__est, .about__who, .about__right { grid-column: 1 / -1; }
    /* Every 464px rail indent, from the declarations that actually set one.
       The earlier list was written from memory and named .ins__who and
       .faq__who, which never had a margin, while missing .ins__head — which
       did, and which therefore kept a 464px indent inside a 350px page and
       collapsed to zero width. */
    .svc__head, .svc__foot,
    .proj__head, .proj__foot,
    .say .display, .say__score, .say__foot,
    .ind .display, .ind__intro,
    .ins .display, .ins__head, .ins__foot,
    .faq .display, .faq__foot { margin-left: 0; }
    .faq :global(.acc) { margin-left: 0; }
    .svc__grid { grid-template-columns: 1fr 1fr; }
    .svc__foot { grid-template-columns: 1fr; }
    .say__list { grid-template-columns: 1fr 1fr; min-height: 0; gap: 40px 24px; }
    /* Each card names its own column and its own top offset, which is how the
       prototype staggers them across a seven-track row. Narrowing the track
       list does not clear those: an item still asking for column 5 makes the
       grid grow an implicit column to hold it. They flow in order instead. */
    .say__item { grid-column: auto; grid-row: auto; margin-top: 0; }
    .ind__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .ins__grid { grid-template-columns: 1fr; }

    /*
     * Unstacking the fixed tracks starts HERE, not at 760.
     *
     * The desktop layout is a 1362 canvas, so the section feet and heads are
     * two-column grids with a 232px rail and an absolute-positioned side rail
     * at a fixed top offset. Those do not fit a tablet either. Leaving them
     * until 760 left an 800px-wide phone in landscape, and every tablet,
     * rendering the desktop geometry into a box too small for it — which is
     * the same clipping bug one breakpoint up.
     *
     * The ≤760 block below is then only what is genuinely phone-specific:
     * type scale, single columns, and the two blocks whose absolute
     * placements are tied to an 84px numeral.
     */
    .proj__head, .proj__foot,
    .say__foot, .ind__foot, .ins__head, .ins__foot, .faq__foot {
      display: flex; flex-direction: column; align-items: stretch;
      grid-template-columns: none;
    }
    /* stretch, not flex-start: a flex item aligned to the start shrinks to
       max-content, which left the project legend and the section intros
       sized to their longest line and hanging off the page. The pills are
       the exception — they are a fixed 204 and should not run the width. */
    .proj__head > a, .proj__foot > a, .say__foot > a,
    .ind__foot > a, .ins__foot > a, .faq__foot > a,
    .proj__head :global(.btn), .proj__foot :global(.btn), .say__foot :global(.btn),
    .ind__foot :global(.btn), .ins__foot :global(.btn), .faq__foot :global(.btn) {
      align-self: flex-start;
    }
    .proj__head, .ins__head { gap: 20px; }
    .proj__foot, .say__foot, .ind__foot, .ins__foot, .faq__foot { gap: 18px; }
    /* Side rails placed at a fixed top offset against a fixed section height. */
    .faq__rail { position: static; width: auto; margin-top: var(--sp-4); }
    /* Widths measured off the 1362 box.
       100%, not none: these sit in flex columns aligned to the start, so
       `none` lets them size to max-content and run past the page edge. */
    .ind__intro, .ins__intro, .faq__intro, .ins__title, .faq__ask, .say__meta,
    .svc__foot .intro { max-width: 100%; }
    /* The service rows are four and five fr tracks on the 1362 canvas. fr does
       not wrap, so at tablet width the rule and the circle were painting past
       the section edge. */
    /* The five tracks are fr on the 1362 canvas and fr does not wrap, so at
       tablet width the figure and the arrow painted past the section edge.
       Two columns instead: the number and name on one line, the figure and
       the arrow opposite, description under both. */
    .svc__row {
      grid-template-columns: 34px minmax(0, 1fr) auto 36px;
      grid-template-rows: 0 auto auto;
      column-gap: 12px; row-gap: 8px;
      align-items: center;
    }
    .svc__n { grid-column: 1; }
    .svc__name { grid-column: 2 / -1; font-size: 21px; line-height: 27px; }
    /* The figure drops to its own line beside the arrow. On one line with the
       name it was fine at "250" and ran into it at "4,000". */
    .svc__stat { grid-row: 3; grid-column: 2; justify-self: start; }
    .svc__icon { grid-row: 3; grid-column: 4; }
    .svc__body { grid-row: 4; grid-column: 2 / -1; }
    .svc__row { grid-template-rows: 0 auto auto auto; }
    .svc__head { grid-template-columns: minmax(0, 1fr); row-gap: 12px; }
    /* 68px of label column leaves 282 for seven links, which wrapped into a
       ragged block with one stranded on a line of its own. Label above,
       list under it at the full width. */
    .svc__also { grid-template-columns: minmax(0, 1fr); row-gap: 12px; }
    .svc__also-list { column-gap: 18px; row-gap: 8px; }
    .svc__intro { margin-bottom: 0; }
    /* 229px of left margin measured off the 1362 canvas. */
    .proj__legend { margin-left: 0; }
    .proj__legend li { grid-template-columns: minmax(0, 1fr) 16px; }
    .say__nav { width: auto; }
    /* Both signs flow after the digits on desktop now, raised to the top of
       the line. Down here the numeral clamps smaller and the line box with
       it, so the raise is dropped and they sit on the baseline as ordinary
       next characters — position:static also makes the desktop `top` inert,
       which is why there is no `top: 0` to write. */
    .about__stat-num { position: static; }
    .about__plus, .about__pct {
      position: static; margin-left: 6px; line-height: normal;
      vertical-align: baseline;
    }

    /* Section rhythm. Every vertical gap on this page was measured off the
       1440 canvas, where a section is a tenth of the page. Kept as-is they
       are a fifth of a small screen each, and the page reads as a run of
       empty panels with a paragraph in the middle of each. The spec's mobile
       sections are 56-64px of padding and 32-40px between blocks. */
    .about { padding-block: 56px; }
    .svc { padding-block: 56px 72px; }
    .svc__list { margin-top: 40px; }
    .svc__foot { margin-top: 48px; }
    .proj__inner { padding-block: 56px 64px; }
    /* NO PIN below 1040. The stage is most of a narrow viewport by itself, so
       pinning it leaves nothing else on screen to show that the page is still
       moving, and the track's reserved scroll reads as a dead gap. The stage
       goes back to flowing and crossfade.ts sees position != sticky and
       returns to sampling the stage's own rect. */
    .proj__track::after { display: none; }
    .proj__stage { position: relative; top: auto; margin-top: 40px; }
    .proj__foot { margin-top: 40px; }
    .say { padding-block: 56px 64px; }
    .say__list { margin-top: 32px; }
    .ind { padding-block: 56px 64px; }
    .ind__grid { margin-top: 44px; gap: 36px 20px; }
    .ins { padding-block: 56px 64px; }
    .faq { padding-block: 56px 72px; }
    .faq :global(.acc) { margin-top: 36px; }
    .about__pitch { margin-top: 40px; }
  }

  /*
   * ≤760: the documented mobile stack.
   *
   * One DOM, reflowed. The prototype ships a second markup tree and toggles
   * the two with display:none; that doubles the document and lets the two
   * versions drift apart, which is how a fix lands on desktop and not on a
   * phone. Everything below re-flows the same elements.
   *
   * Type sizes and stacking come from design/specs/Main.md, "Mobile layout
   * (≤760px)", sections M1-M9. Where the shipped page has moved past the
   * prototype — the hero is the yellow "Ship product that scales" lockup, not
   * the prototype's dark wordmark — the shipped content wins and only the
   * scale comes from the spec.
   *
   * THE RECURRING BUG this fixes: the desktop layout is a 1362 canvas, so
   * almost every block carries a fixed or fr-based grid. `fr` tracks do not
   * collapse — 435fr 29fr 435fr stays 3 columns at 390px and simply overflows
   * — and the sections clip with overflow:hidden, so the content did not
   * scroll sideways, it vanished. 105 elements were painting off-screen.
   */
  @media (max-width: 760px) {
    .display { font-size: 56px; line-height: 56px; }
    .intro { font-size: 19px; line-height: 28px; }


    /* hero ------------------------------------------------------------- */
    .hero { min-height: 0; }
    .hero__inner { padding-block: 128px 56px; }
    /* The 130px line-height was fixed while the size clamped down to 56,
       which left two thirds of a line of air between every line. */
    .hero__h1 { font-size: clamp(44px, 13vw, 72px); line-height: 1.06; letter-spacing: -0.045em; }
    /* 360px of reserved width does not fit a 350px content box. The word
       swap shifts the line on a phone; that is better than a scrollbar. */
    .hero__rotate { min-width: 0; }
    .hero__lede { margin-top: 32px; font-size: 17px; line-height: 26px; }
    .hero__cta { margin-top: 24px; }
    .hero__rule { margin-top: 44px; }
    /* Four labels across 350px is four stacked characters per column. */
    .hero__labels {
      display: grid; grid-template-columns: 1fr 1fr; gap: 14px 18px;
      margin-top: 20px; font-size: 11px;
    }

    /* about ------------------------------------------------------------ */
    /* minmax(0, 1fr), not 1fr. A bare `1fr` is minmax(auto, 1fr), so the
       track cannot shrink below its widest child's min-content — and the
       logo marquee is `width: max-content`, which made that 914px. The whole
       About column was sized by the marquee and clipped at the section edge.
       min-width on the children is the same guard one level down. */
    .about { grid-template-columns: minmax(0, 1fr); row-gap: 48px; padding-block: 56px; }
    .about > * { min-width: 0; }
    .about__stars { position: static; margin-bottom: 8px; }
