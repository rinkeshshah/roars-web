  .svc__row--inner .svc__count { grid-column: 4; }
  .svc__count span { margin-right: var(--sp-3); font-size: 32px; line-height: 32px; font-weight: var(--fw-semi); letter-spacing: var(--ls-display); }

  .svc__icon {
