---
/**
 * Homepage. Nine sections, spec in design/specs/Main.md.
 *
 * All copy here is verbatim from that spec, including its own punctuation.
 * Nothing is paraphrased and nothing is invented.
 *
 * MISSING IMAGERY. The spec sources every photograph from
 * roarsinc.com/wp-content/uploads/*. Those files are not in this repo yet:
 * they arrive with the uploads import in Phase 5, and CLAUDE.md forbids
 * hot-linking the live WordPress site. So every photo slot renders the
 * design's own placeholder ground, rgb(30,30,30), at the right dimensions,
 * which keeps the layout and the CLS budget honest. Each one is listed in the
 * build report. Nothing here is a stock stand-in.
 */
import BaseLayout from '../layouts/BaseLayout.astro'
import Section from '../components/Section.astro'
import TopBar from '../components/TopBar.astro'
import NavOverlay from '../components/NavOverlay.astro'
import SiteFooter from '../components/SiteFooter.astro'
import Button from '../components/Button.astro'
import Accordion from '../components/Accordion.astro'
import { Picture } from 'astro:assets'
import { site } from '../lib/site'
import space2000 from '../assets/space-2000.jpg'
/* Decorative furniture. These carry the hero's art direction, so they are
   part of the design rather than ornament, and they are aria-hidden because
   they say nothing a screen reader needs. */
import asteroids from '../assets/asteroids.svg'
import asteroids2 from '../assets/asteroids-2.svg'
import union from '../assets/union.svg'
import star3 from '../assets/star-3.svg'
import star5 from '../assets/star-5.svg'

/* ------------------------------------------------------------ content */

const services = [
  {
    n: '/01',
    name: 'Product Development',
    body: 'We take products from idea to launch — strategy, design and engineering in one team',
    stages: 'Discovery, Architecture, Engineering, Launch',
    clients: ['Snowman Logistics', 'Parqly'],
    more: '+ 11',
    href: '/s/product-development-company/',
  },
  {
    n: '/02',
    name: 'UI/UX and Product Design',
    body: 'Human-centered design that turns complex ideas into easy, elegant user experiences',
    count: '40',
    href: '/s/user-experience-design-agency/',
  },
  {
    n: '/03',
    name: 'Mobile App Development',
    body: 'Native and cross-platform apps built to scale with your user base',
    count: '35',
    href: '/s/mobile-app-development/',
  },
  {
    n: '/04',
    name: 'AI Automation',
    body: 'Workflow automation and AI features wired into your product and operations.',
    count: '17',
    href: '/s/ai-automation-services/',
  },
]

/** Two featured case studies. Slugs from docs/URL-INVENTORY.csv. */
const featured = [
  {
    day: '02 Jul',
    year: '2025',
    name: 'Parqly.',
    href: '/work/parqly-parking-solution/',
  },
  {
    day: '15 Oct',
    year: '2026',
    name: 'Snowman Logistics.',
    href: '/work/warehouse-compliance-checklist-app/',
  },
]

/**
 * The cascade. Four testimonials at four sizes and four vertical offsets,
 * measured off the rendered prototype. The irregularity IS the design, so the
 * per-item geometry lives here as data rather than as four hand-tuned CSS
 * blocks: `col` places it in the 7-track grid, the rest drive one shared rule
 * set through custom properties.
 */
const testimonials = [
  {
    col: 5, top: 0, avatar: 80, label: 14, quote: 24, lead: 32, star: 14,
    name: 'Jayeis Sonill',
    role: 'CEO, Aum Investment',
    quote:
      'Roars has consistently positioned themselves at the forefront of innovation and technology. They understand business needs and craft technologies to address them.',
  },
  {
    col: 3, top: 264, avatar: 65, label: 13, quote: 18, lead: 25, star: 12,
    name: 'James Hadley',
    role: 'CEO, Simthing New, LLC',
    quote:
      'I was pleased with the deliverables. I was able to see and understand the efforts required to scale the solution in development.',
  },
  {
    col: 1, top: 108, avatar: 57, label: 12, quote: 15, lead: 21, star: 11,
    name: 'Avinash Kumar',
    role: 'Project Manager, Roars',
    quote:
      'From discovery to launch, the team brought our platform to life with precision. A genuine product partner.',
  },
  {
    col: 7, top: 230, avatar: 40, label: 10, quote: 12, lead: 17, star: 9,
    name: 'Khusboo Panchal',
    role: 'Digital Marketing',
    quote: 'Fast, smart and beautiful. We will be back for round two soon.',
  },
]

const industries = [
  { letter: 'R', name: 'Restaurant', href: '/industries/food-restaurant-app-development/' },
  { letter: 'F', name: 'Fitness', href: '/industries/on-demand-fitness-app-development/' },
  { letter: 'e', name: 'eCommerce', href: '/industries/retail-ecommerce-development/' },
  { letter: 'C', name: 'Concierge', href: '/industries/concierge-app-development/' },
  { letter: 'T', name: 'Travel', href: '/industries/travel-and-hospitality-app-development/' },
  { letter: 'L', name: 'Logistics', href: '/industries/logistics-transportation-app-development/' },
  { letter: 'S', name: 'SaaS', href: '/industries/saas-application-development-services/' },
  { letter: 'H', name: 'Healthcare', href: '/industries/healthcare-app-development-company/' },
]

/** Slugs resolved against docs/URL-INVENTORY.csv, not invented. */
const insights = [
  {
    day: '15',
    month: 'May',
    title: 'AI App Development vs Traditional App Development',
    href: '/our-journal/ai-app-development-vs-traditional-app-development-which-is-better-for-customer-engagement/',
  },
  {
    day: '04',
    month: 'May',
    title: '20 Years of Roars: Built on Purpose, Driven by Impact',
    href: '/our-journal/20-years-of-roars-built-on-purpose-driven-by-impact/',
  },
  {
    day: '11',
    month: 'Dec',
    title: 'The Unexpected Insight — We built a meal planning app',
    href: '/our-journal/the-unexpected-insight-we-built-a-meal-planning-app/',
  },
]

const faq = [
  {
    question: 'How long does it take to build a product?',
    answer:
      'The timeline depends on complexity and specific requirements. An MVP typically runs eight to sixteen weeks. We provide a detailed timeline during the initial consultation to ensure clear expectations.',
  },
  {
    question: 'What’s included in your product strategy?',
    answer:
      'Discovery workshops, market and competitor review, product definition, technical feasibility and a costed delivery roadmap.',
  },
  {
    question: 'How does the monthly engagement model work?',
    answer:
      'A dedicated team bills monthly and works to your cadence. You can scale up or down at the end of any month, with a named project manager throughout.',
  },
  {
    question: 'Can you take over an existing product?',
    answer:
      'Yes. We start with a technical and design audit, then agree a plan to stabilise what exists before extending it.',
  },
  {
    question: 'Do you work with pre-seed startups?',
    answer:
      'Regularly. Much of our work is with founders building a first version, and we scope to the funding available.',
  },
]

/* ------------------------------------------------------------- schema */

/**
 * Organization + WebSite, homepage only, per docs/SEO-SPEC.md 7.1.
 * FAQPage is included because the accordion below renders the real Q&A in the
 * DOM and the answers match word for word, which is the condition for it.
 * No aggregateRating: there are no verifiable on-page reviews.
 */
const schema = [
  {
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': ['Organization', 'ProfessionalService'],
        '@id': `${site.url}/#organization`,
        name: site.name,
        legalName: site.legalName,
        alternateName: site.shortName,
        url: `${site.url}/`,
        foundingDate: site.founded,
        founder: { '@type': 'Person', name: 'Rinkesh A Shah', jobTitle: 'Founder and CEO' },
        sameAs: site.sameAs,
        email: site.email.sales,
        contactPoint: [
          {
            '@type': 'ContactPoint',
            telephone: site.phones.US.tel,
            contactType: 'sales',
            areaServed: ['US', 'CA'],
            availableLanguage: ['en'],
          },
          {
            '@type': 'ContactPoint',
            telephone: site.phones.UK.tel,
            contactType: 'sales',
            areaServed: ['GB', 'EU'],
            availableLanguage: ['en'],
          },
        ],
        address: site.offices.map((o) => ({
          '@type': 'PostalAddress',
          addressLocality: o.city,
          ...(o.region ? { addressRegion: o.region } : {}),
          addressCountry: o.country,
        })),
        knowsAbout: [
          'Product Development',
          'User Experience Design',
          'Mobile App Development',
          'MVP Development',
          'AI Automation',
          'Digital Transformation',
        ],
        numberOfEmployees: { '@type': 'QuantitativeValue', minValue: 11, maxValue: 50 },
      },
      {
        '@type': 'WebSite',
        '@id': `${site.url}/#website`,
        url: `${site.url}/`,
        name: site.name,
        publisher: { '@id': `${site.url}/#organization` },
        inLanguage: 'en-US',
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: { '@type': 'Answer', text: f.answer },
    })),
  },
]
---

<BaseLayout
  title="Product Development for Startups & SMEs | Roars"
  description="Roars is a product development and design agency. 250+ products shipped since 2005, across product strategy, UI/UX, mobile apps and AI automation."
  path="/"
  ogType="website"
  schema={schema}
>
  <TopBar slot="topbar" />
  <NavOverlay />

  {/* ── 1. Header ───────────────────────────────────────────── */}
  <Section ground="light" bleed>
    <div class="hero" data-topbar-ink="light">
    {/* The photograph is a PANEL on the right, not a full bleed: it starts at
        30% of the width and the left third stays white, which is what lets the
        services rail read as dark type on paper. The LCP element. AVIF first,
        eager and high priority. A raw <img> here shipped the untouched 276KB
        JPEG and pushed LCP past budget. */}
    <div class="hero__panel">
      <Picture
        class="hero__bg"
        src={space2000}
        formats={['avif', 'webp']}
        widths={[900, 1440, 2000]}
        sizes="70vw"
        quality={62}
        alt=""
        loading="eager"
        fetchpriority="high"
        decoding="sync"
      />
    </div>
    {/* Wash across the seam, so the panel's left edge feathers into the paper
        instead of cutting it. */}
    <div class="hero__veil"></div>

    {/* Art direction. Absolutely positioned because it is decoration floating
        over the composition, not layout: nothing below depends on it, and it
        is removed from the accessibility tree entirely. */}
    <div class="hero__deco" aria-hidden="true">
      <div class="hero__belt">
        <i class="hero__belt-a"></i>
        <i class="hero__belt-b"></i>
        <img class="hero__belt-1" src={asteroids.src} alt="" width="48" height="7" />
        <img class="hero__belt-2" src={asteroids2.src} alt="" width="107" height="10" />
      </div>
      <div class="hero__planet">
        <span class="hero__planet-body"></span>
        <img class="hero__planet-dust" src={asteroids2.src} alt="" width="29" height="5" />
        <span class="hero__planet-moon"></span>
      </div>
    </div>

    <div class="wrap hero__inner">
      <div class="hero__rail">
        <ul class="hero__services">
          <li>Product Development</li>
          <li>UI/UX and Product Design</li>
          <li>Mobile App Development</li>
          <li>AI Automation</li>
        </ul>
        <div class="hero__ticks" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
      </div>

      <div class="hero__col">
        <p class="hero__kicker">Space of Product<br />Solutions</p>
        <h1 class="hero__wordmark">
          <img class="hero__mark" src={union.src} alt="" width="73" height="9" aria-hidden="true" />
          roars<span class="hero__badge" aria-hidden="true">&reg;</span>
        </h1>
        <p class="hero__sub">Product Development<br />for Startups &amp; SMEs</p>
      </div>
    </div>
    </div>
  </Section>

  {/* ── 2. About ────────────────────────────────────────────── */}
  <Section ground="light">
    <div class="about">
      {/* The paired star marks in the left rail. Decoration, so aria-hidden. */}
      <span class="about__stars" aria-hidden="true">
        <img src={star3.src} alt="" width="20" height="20" />
        <img src={star5.src} alt="" width="20" height="20" />
      </span>
      <div data-reveal class="about__stats">
        <div class="about__stat">
          <p class="about__stat-name">Projects Delivered</p>
          <div class="rule"></div>
          <div class="about__stat-row">
            <span class="about__stat-num">250<span class="about__plus">+</span></span>
            <span class="about__stat-note">Products launched successfully since 2005</span>
          </div>
        </div>
        <div class="about__stat">
          <p class="about__stat-name">Returning Customers</p>
          <div class="rule"></div>
          <div class="about__stat-row">
            <span class="about__stat-num">96<span class="about__pct">%</span></span>
            <span class="about__stat-note">Clients who return for their next product</span>
          </div>
        </div>
      </div>

      <div data-reveal class="about__est" style="transition-delay:80ms">
        <p class="about__est-name">Year of Establishment</p>
        <div class="rule"></div>
        <div class="about__est-row">
          <span class="about__est-note">
            The year Rinkesh A Shah founded Roars — a first product for an
            early-stage startup.
          </span>
          <span class="about__stat-num">2005</span>
        </div>
      </div>

      <div data-reveal class="about__team" style="transition-delay:120ms">
        <p class="about__team-name">Team of Roars</p>
        <div class="rule rule--short"></div>
        {/* Scattered cluster, not a row: the prototype offsets the four
            portraits on a 2x3 lattice with one cell left empty, and the count
            sits in that gap. Portraits arrive with the Phase 5 uploads
            import; the discs hold their places until then. */}
        <div class="about__cluster" aria-hidden="true">
          <span class="about__face about__face--a"></span>
          <span class="about__face about__face--b"></span>
          <span class="about__face about__face--c"></span>
          <span class="about__face about__face--d"></span>
          <p class="about__team-count"><span>59</span></p>
        </div>
      </div>

      <div data-reveal class="about__who" style="transition-delay:160ms">
        <p class="about__who-name">Roars</p>
        <p class="about__who-sub">Product Company</p>
        <p class="about__who-person">Rinkesh A Shah</p>
        <p class="about__who-role">CEO / Founder</p>
      </div>

      <div data-reveal class="about__pitch" style="transition-delay:200ms">
        <p>
          We work with you as thinkers, creators, consultants, designers and
          implementers{' '}
          <span class="about__pitch-mid">to turn your product into a high quality marketable offering.</span>{' '}
          <span class="about__pitch-low">Our approach is simple — we bring clarity to complex situations.</span>
        </p>
      </div>

      {/* Client logos. The files live on the WordPress install and arrive with
          the Phase 5 uploads import; CLAUDE.md forbids hot-linking the live
          site, so the row holds its 44px height and its edge fades until then
          and is listed in the build report. */}
      <div class="about__logos" aria-hidden="true">
        <div class="about__logo-row">
          <span></span><span></span><span></span>
          <span></span><span></span><span></span>
        </div>
      </div>
    </div>
  </Section>

  {/* ── 3. Services ─────────────────────────────────────────── */}
  <Section ground="surface">
    <div class="svc">
      <h2 class="display">Services</h2>

      {/* Accordion, not the static grid this used to be: the prototype opens
          /01 with its imagery and tags and collapses the rest to a count and
          a toggle. Approved island 2 of 4, shared with the FAQ below.

          The mock is internally inconsistent about where a row's name sits —
          two collapsed rows put it in the left rail at x=39, the other and the
          open row put it in the inner column at x=503 — so it is placed in the
          rail for every row, which is also where Industries and the FAQ put
          their section labels. docs/DESIGN-SYSTEM.md records the call. */}
      <ul class="svc__list" data-accordion>
        {services.map((s, i) => (
          <li class="svc__row">
            <h3 class="svc__h">
              <button
                class="svc__trigger"
                type="button"
                aria-expanded={i === 0 ? 'true' : 'false'}
                aria-controls={`svc-panel-${i}`}
                id={`svc-trigger-${i}`}
              >
                <span class="svc__rail">
                  <span class="svc__n">{s.n}</span>
                  <span class="svc__name">{s.name}</span>
                </span>
                <span class="svc__body">{s.body}</span>
                {/* /01 carries a client list instead of a count in the
                    spec's own data. Empty rather than a fabricated number. */}
                <span class="svc__count">
                  {s.count && <><span>{s.count}</span> Projects</>}
                </span>
                <span class="svc__icon" aria-hidden="true"></span>
              </button>
            </h3>
            <div
              class="svc__panel"
              id={`svc-panel-${i}`}
              role="region"
              aria-labelledby={`svc-trigger-${i}`}
              hidden={i !== 0}
            >
              <div class="svc__inner">
                {/* Imagery arrives with the Phase 5 uploads import. The
                    placeholder holds the prototype's 138px and 37px discs so
                    the row keeps its height and CLS stays honest. */}
                <div class="svc__media" aria-hidden="true">
                  <span class="svc__disc"></span>
                  <span class="svc__disc svc__disc--sm"></span>
                </div>
                <div class="svc__detail">
                  {s.stages && <p class="svc__stages">{s.stages}</p>}
                  {s.clients && (
                    <ul class="svc__clients">
                      {s.clients.map((c) => <li>{c}</li>)}
                      <li class="svc__more">{s.more}</li>
                    </ul>
                  )}
                  <a class="svc__link" href={s.href}>Read about {s.name}</a>
                </div>
              </div>
            </div>
          </li>
        ))}
      </ul>

      <div class="svc__foot">
        <p class="intro">
          Roars helps founders stand out with bold product design and smart
          digital solutions. We mix strategy, creativity and technology.
        </p>
        <Button href="/contact-us/" label="Start a Project" />
      </div>
    </div>
  </Section>

  {/* ── 4. Projects ─────────────────────────────────────────── */}
  <Section ground="dark" bleed>
    <div class="proj">
    <Picture
      class="proj__bg"
      src={space2000}
      formats={['avif', 'webp']}
      widths={[900, 1440, 2000]}
      sizes="100vw"
      quality={58}
      alt=""
      loading="lazy"
      decoding="async"
    />
    <div class="proj__veil"></div>

    <div class="wrap proj__inner">
      <div class="proj__head">
        <h2 class="display display--on-dark">Projects</h2>
        <p class="proj__count">250<span>+</span></p>
        <ul class="proj__legend">
          <li>Recent Projects</li>
          <li>Product Development</li>
          <li>UI/UX and Product Design</li>
          <li>Mobile and AI</li>
        </ul>
      </div>

      <div class="proj__stage" data-crossfade>
        {featured.map((f, i) => (
          <article class="proj__slide" data-slide style={`opacity:${i === 0 ? 1 : 0}`}>
            <div class="proj__date">
              <span class="proj__day">{f.day}</span>
              <div class="rule rule--thin"></div>
              <span class="proj__year">{f.year}</span>
            </div>
            <a class="proj__card" href={f.href}>
              {/* Hero image arrives with the Phase 5 uploads import. */}
              <div class="proj__ph" role="img" aria-label={f.name}></div>
              <span class="proj__name">{f.name}</span>
            </a>
          </article>
        ))}
      </div>

      <div class="proj__foot">
        <Button href="/work/" label="All Projects" variant="light" />
      </div>
    </div>
    </div>
  </Section>

  {/* ── 5. People say ───────────────────────────────────────── */}
  <Section ground="light">
    <div class="say">
      <h2 class="display">People say</h2>
      <p class="say__score">4.9/5</p>

      {/* A cascade, not a row of four equal cards. The four columns do not
          overlap horizontally, so this is one grid with uneven tracks plus a
          per-item top offset — flow layout, no absolute positioning. */}
      <ul class="say__list">
        {testimonials.map((t, i) => (
          <li
            class="say__item"
            data-reveal
            style={`--col:${t.col};--top:${t.top}px;--av:${t.avatar}px;--lb:${t.label}px;--qt:${t.quote}px;--ld:${t.lead}px;--st:${t.star}px;transition-delay:${i * 70}ms`}
          >
            {/* Portraits arrive with the Phase 5 uploads import. */}
            <span class="say__avatar" aria-hidden="true"></span>
            <p class="say__name">{t.name}</p>
            <p class="say__role">{t.role}</p>
            <div class="say__rule"></div>
            <div class="say__stars" aria-label="Rated 5 out of 5">
              {[0, 1, 2, 3, 4].map(() => (
                <img src={star5.src} alt="" width="14" height="14" aria-hidden="true" />
              ))}
            </div>
            <blockquote class="say__quote">{t.quote}</blockquote>
          </li>
        ))}
      </ul>

      <div class="say__foot">
        <div class="say__nav">
          <span class="say__dot"></span>
          <span class="say__prev">Prev.</span>
          <span class="say__next">Next</span>
          <span class="say__dot say__dot--on"></span>
        </div>
        {/* Reviewer portraits arrive with the Phase 5 uploads import; the
            count disc closes the stack, as in the prototype. */}
        <div class="say__stack">
          <span aria-hidden="true"></span>
          <span aria-hidden="true"></span>
          <span aria-hidden="true"></span>
          <span class="say__count">37</span>
        </div>
        <p class="say__meta">reviews<br />4.9 average</p>
        <Button href="/contact-us/" label="Leave a Review" />
      </div>
    </div>
  </Section>

  {/* ── 6. Industries ───────────────────────────────────────── */}
  <Section ground="surface">
    <div class="ind">
      <h2 class="display">Industries</h2>
      {/* Label pair lives in the left rail, not the inner column. */}
      <div class="ind__rail">
        <p class="ind__label">Eight sectors</p>
        <p class="ind__sub">Where we work</p>
      </div>
      <p class="intro ind__intro">
        We build in sectors we already understand, so the discovery work starts
        from domain knowledge rather than from scratch.
      </p>

      <ul class="ind__grid">
        {industries.map((sector, i) => (
          <li data-reveal style={`transition-delay:${i * 50}ms`}>
            <a class="ind__card" href={sector.href}>
              <span class="ind__letter" aria-hidden="true">{sector.letter}</span>
              <span class="ind__text">
                <span class="ind__name">{sector.name}</span>
                <span class="ind__cta">View sector</span>
              </span>
            </a>
          </li>
        ))}
      </ul>

      <div class="ind__foot">
        <Button href="/work/" label="See the work" />
      </div>
    </div>
  </Section>

  {/* ── 7. Insights ─────────────────────────────────────────── */}
  <Section ground="light">
    <div class="ins">
      <h2 class="display">Insights</h2>
      <div class="ins__head">
        <div class="ins__who">
          {/* Portrait arrives with the Phase 5 uploads import. */}
          <span class="ins__avatar" aria-hidden="true"></span>
          <p class="ins__name">Rinkesh A Shah</p>
          <p class="ins__role">Founder</p>
        </div>
        <p class="intro ins__intro">
          We have a lot to say about product work — how we approach the process,
          what the AI shift actually changes, and the nuances of building for
          founders.
        </p>
      </div>

      <ul class="ins__grid">
        {insights.map((post, i) => (
          <li data-reveal style={`transition-delay:${i * 70}ms`}>
            <a class="ins__card" href={post.href}>
              {/* Featured image arrives with the Phase 5 uploads import.
                  A 138px disc, matching the services row. */}
              <span class="ins__ph" aria-hidden="true"></span>
              <span class="ins__rule"></span>
              <span class="ins__day">{post.day}</span>
