---
/**
 * /industries/ — the sectors hub.
 *
 * ORDERED BY DEPTH OF EVIDENCE, strongest first, not alphabetically and not
 * into a tidy three by three. The brief is explicit about resisting symmetry,
 * and the order is itself a claim: these are the sectors we can show work in,
 * in the order we can show it.
 *
 * The two at the end have no case study in their sector yet. They are listed,
 * because the pages exist and the URLs are live, but they are visibly last
 * and they say why rather than pretending to be peers.
 */
import BaseLayout from '../../layouts/BaseLayout.astro'
import Section from '../../components/Section.astro'
import TopBar from '../../components/TopBar.astro'
import NavOverlay from '../../components/NavOverlay.astro'
import SiteFooter from '../../components/SiteFooter.astro'
import GrainField from '../../components/GrainField.astro'
import { site } from '../../lib/site'

const path = '/industries/'

/** Depth of evidence: cases we can show in that sector, strongest first. */
const SECTORS = [
  { n: '01', name: 'Logistics', href: '/industries/logistics-transportation-app-development/', line: 'Cold chain apps fail on connectivity, not on UI. Every flow has to survive a driver in a basement.', proof: 'Snowman Logistics' },
  { n: '02', name: 'Healthcare', href: '/industries/healthcare-app-development-company/', line: 'The people using it are stressed, rushed or unwell, and the rules do not bend.', proof: 'GISAID, Friendo' },
  { n: '03', name: 'Fitness', href: '/industries/on-demand-fitness-app-development/', line: 'Signups are not the problem. Week three is.', proof: 'GymBait.AI, FlowRow' },
  { n: '04', name: 'Concierge', href: '/industries/concierge-app-development/', line: 'The service is the product, and software usually gets in its way.', proof: 'Concierge Loyalty, Les Concierges' },
  { n: '05', name: 'Restaurant', href: '/industries/food-restaurant-app-development/', line: 'Six moments, four screens, and a kitchen that cannot wait for a sync.', proof: 'The Club Social' },
  { n: '06', name: 'SaaS', href: '/industries/saas-application-development-services/', line: 'You do not have an acquisition problem. You have a first-week problem.', proof: 'The Club Social' },
  { n: '07', name: 'Travel', href: '/industries/travel-and-hospitality-app-development/', line: 'The plan is fine until the day it changes, and then the product is the whole service.', proof: 'ONUS' },
  { n: '08', name: 'eCommerce', href: '/industries/retail-ecommerce-development/', line: 'Every visit is paid for twice before it reaches the basket.', proof: '' },
  { n: '09', name: 'Education', href: '/industries/education-mobile-app-development/', line: 'Attention is the scarce resource, and the buyer is never the learner.', proof: '' },
]

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    '@id': `${site.url}${path}#collection`,
    name: 'Industries',
    isPartOf: { '@id': `${site.url}/#website` },
  },
]
---

<BaseLayout
  title="Industries: Where We Have Already Made the Mistakes | Roars"
  description="Nine sectors, ordered by the work we can show in each. What is different about building software in logistics, healthcare, fitness, concierge, restaurant, SaaS and travel."
  path={path}
  schema={schema}
>
  <TopBar slot="topbar" cta="meeting" />
  <NavOverlay />

  <Section ground="dark" bleed>
    <div class="hb">
      <GrainField tone="dark" second />
      <div class="wrap hb__inner">
        <span class="hb__eyebrow">INDUSTRIES</span>
        <span class="hb__tick" aria-hidden="true"></span>
        <h1 class="hb__h">Sector knowledge is mostly a list of mistakes you no longer have to make.</h1>
        <p class="hb__sub">
          A design partner who has never worked in your sector will learn its constraints
          on your budget. The value of having been there is not vocabulary, it is that the
          expensive assumptions get caught in week one rather than at launch.
        </p>
      </div>
    </div>
  </Section>

  <Section ground="light">
    <div class="hs">
      <p class="hs__note" data-reveal>
        Ordered by the work we can show in each, strongest first. The last two are
        sectors we build in without a case study to point at yet, and they are at the
        bottom for that reason rather than for alphabetical ones.
      </p>
      <ul class="hs__list">
        {SECTORS.map((s, i) => (
          <li data-reveal style={`transition-delay:${(i % 3) * 60}ms`}>
            <a href={s.href}>
              <span class="hs__n">{s.n}</span>
              <b class="hs__name">{s.name}</b>
              <span class="hs__line">{s.line}</span>
              {s.proof
                ? <span class="hs__proof">{s.proof}</span>
                : <span class="hs__proof hs__proof--none">no case study here yet</span>}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </Section>

  <SiteFooter
    slot="footer"
    blurbTitle="Your sector not on the list?"
    blurb="Tell us the constraint that defines it. If we have not worked there we will say so, and we will tell you whether that matters for what you are building."
    tagline="where we have already been"
    ctaLabel="Shall we chat?"
    ctaHref="https://meet.roarsinc.com/sales"
  />
</BaseLayout>

<style>
  .hb { position: relative; }
  .hb__inner { position: relative; z-index: 1; padding-block: 170px 96px; }
  .hb__eyebrow {
    display: block;
    font-size: var(--fs-micro); font-weight: var(--fw-medium);
    letter-spacing: 0.18em; color: rgba(255, 255, 255, 0.55);
  }
  .hb__tick { display: block; width: 16px; height: 1.5px; margin-top: 19px; background: var(--c-accent); }
  .hb__h {
    margin: 30px 0 0 -4px; max-width: 980px;
    font-size: clamp(34px, 4.4vw, 62px); line-height: 1.1; font-weight: var(--fw-semi);
    letter-spacing: var(--ls-display); color: rgb(251, 251, 251);
  }
  .hb__sub {
    margin: 26px 0 0; max-width: 620px;
    font-size: 18px; line-height: 28px; font-weight: var(--fw-medium);
    letter-spacing: var(--ls-item); color: rgba(255, 255, 255, 0.62);
  }

  .hs { padding-block: 96px; }
  .hs__note {
    margin: 0 0 48px; max-width: 620px;
    font-size: var(--fs-body); line-height: 25px; font-weight: var(--fw-medium);
    letter-spacing: var(--ls-item); color: rgba(20, 20, 20, 0.66);
  }
  .hs__list { list-style: none; margin: 0; padding: 0; }
  .hs__list li { border-top: 1px solid rgba(153, 152, 149, 0.32); }
  .hs__list li:first-child { border-top: 2px solid var(--c-accent); }
  .hs__list li:last-child { border-bottom: 1px solid rgba(153, 152, 149, 0.32); }
  .hs__list a {
    display: grid; grid-template-columns: 56px minmax(140px, 18%) minmax(0, 1fr) minmax(0, 22%);
    align-items: baseline; gap: 20px; padding: 26px 0;
  }
  .hs__n {
    font-size: var(--fs-micro); font-weight: var(--fw-semi);
    letter-spacing: 0.16em; color: var(--c-ink-label);
  }
  .hs__name {
    font-size: clamp(22px, 2.2vw, 30px); line-height: 1.15; font-weight: var(--fw-semi);
    letter-spacing: var(--ls-display); color: var(--c-ink-heading);
    transition: color var(--dur-fast) ease;
  }
  .hs__line {
    font-size: var(--fs-body); line-height: 24px; font-weight: var(--fw-medium);
    letter-spacing: -0.045em; color: rgba(20, 20, 20, 0.72);
  }
  .hs__proof {
    font-size: var(--fs-micro); line-height: 18px; font-weight: var(--fw-semi);
    letter-spacing: 0.1em; text-transform: uppercase; color: rgba(20, 20, 20, 0.5);
  }
  .hs__proof--none { color: rgba(20, 20, 20, 0.28); text-transform: none; letter-spacing: var(--ls-item); font-weight: var(--fw-medium); }
  .hs__list a:hover .hs__name { color: rgb(90, 90, 90); }

  @media (max-width: 1040px) {
    .hb__inner { padding-block: 130px 72px; }
    .hs { padding-block: 64px; }
    .hs__list a { grid-template-columns: 44px minmax(0, 1fr); gap: 8px 16px; }
    .hs__line, .hs__proof { grid-column: 2; }
  }
</style>
