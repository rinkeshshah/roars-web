---
/**
 * Industry pages. Nine live URLs at /industries/[slug]/.
 *
 * Routes come from docs/URL-INVENTORY.csv, not from the collection, so every
 * ranking URL resolves even before its body is migrated.
 *
 * TWO RENDERINGS, ONE ROUTE — the same arrangement as /s/[slug]/:
 *   - An entry carrying `hero` gets the full designed page, built against
 *     design/prototypes/Roars v2 - Industries v2.dc.html, shown as food &
 *     restaurant. Canvas 1440x6020: Hero 820, The order 2160, Surfaces 720,
 *     Proof 1000, All industries 980.
 *   - Anything else falls back to MarketingPage. Eight of the nine are there.
 *
 * NO CLOSING GREY BAND. The export draws one at 5680 repeating the offer, and
 * the footer under it now carries the page's own CTA — the same duplication
 * that was removed from the service template. Its copy lives in `cta`.
 *
 * Coordinates in the comments are SECTION-relative as the export authors
 * them; the content box starts at the 39px gutter.
 */
import { getCollection, render } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import MarketingPage from '../../components/MarketingPage.astro'
import Section from '../../components/Section.astro'
import TopBar from '../../components/TopBar.astro'
import NavOverlay from '../../components/NavOverlay.astro'
import SiteFooter from '../../components/SiteFooter.astro'
import GrainField from '../../components/GrainField.astro'
import RingField from '../../components/RingField.astro'
import { slugsOf, nameFromSlug } from '../../lib/inventory'
import { site } from '../../lib/site'
import { workHeroFor } from '../../lib/media'
import star5 from '../../assets/star-5.svg'

export async function getStaticPaths() {
  const entries = await getCollection('industries')
  const byId = new Map(entries.map((e) => [e.id, e]))
  return slugsOf('industries').map((slug) => ({
    params: { slug },
    props: { entry: byId.get(slug) },
  }))
}

const { slug } = Astro.params
const { entry } = Astro.props
const path = `/industries/${slug}/`
const name = entry?.data.title ?? nameFromSlug(slug)
const d = entry?.data

const schema = entry
  ? [
      {
        '@context': 'https://schema.org',
        '@type': 'Service',
        '@id': `${site.url}${path}#service`,
        name,
        description: entry.data.seo.description,
        serviceType: entry.data.serviceType,
        provider: { '@id': `${site.url}/#organization` },
        areaServed: [
          { '@type': 'Country', name: 'United States' },
          { '@type': 'Country', name: 'United Kingdom' },
          { '@type': 'Country', name: 'India' },
        ],
      },
      {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
          { '@type': 'ListItem', position: 2, name },
        ],
      },
    ]
  : []

const { Content } = entry ? await render(entry) : { Content: null }
const designed = Boolean(d?.hero)
/* The band credits a project, so it takes that project's own header photo.
   Derived from the link rather than named again in the entry, so the picture
   and the thing it links to cannot drift apart. */
const featuredShot = d?.proof?.featured ? workHeroFor(d.proof.featured.href) : undefined
---

{designed && d ? (
  <BaseLayout
    title={d.seo.title}
    description={d.seo.description}
    path={path}
    schema={schema}
    noindex={d.needsReview}
  >
    <TopBar slot="topbar" cta="meeting" />
    <NavOverlay />

    {/* ── Hero, 1440x820 ───────────────────────────────────── */}
    <Section ground="dark" bleed>
      <div class="ih">
        <GrainField tone="dark" second />
        <div class="wrap ih__inner">
          <div class="ih__rail" data-reveal>
            {d.eyebrow && <span class="i-eyebrow i-eyebrow--dark">{d.eyebrow}</span>}
            <span class="ih__tick" aria-hidden="true"></span>
            {/* I1. The constraint that defines the sector, not the sector's
                name. An insider should nod at it.
                ART DIRECTION, the compression device: the rail stacks tight
                and the h1 is the one line that refuses to thin out, so the
                density resolves into it rather than surrounding it. */}
            {/* All nine sectors carry a frame now, so the migrated hero
                statement no longer renders. It stays in the content as the
                source the I1 line was written from. */}
            {d.frame && (
              <Fragment>
                <h1 class="if__h">{d.frame.h1}</h1>
                <p class="if__does">{d.frame.does}</p>
              </Fragment>
            )}
            {d.hero!.ctaLabel && d.hero!.ctaHref && (
              <a class="i-ghost" href={d.hero!.ctaHref} target="_blank" rel="noopener">
                <span>{d.hero!.ctaLabel}</span>
                <span class="i-ghost__dots" data-dots aria-hidden="true"><i></i><i></i></span>
              </a>
            )}
          </div>

          {d.headline && (
            <div class="ih__mast" data-reveal>
              {/* "roars" with the star mark hung off its shoulder, as the
                  export draws it. NO union.svg swoosh under the small line —
                  that scribble was asked about and removed twice, and this is
                  an inner page. See docs/HANDOFF.md. */}
              <span class="i-chip">
                <span>roars</span>
                <span
                  class="starmark i-chip__star"
                  style={`--m:url(${star5.src})`}
                  aria-hidden="true"
                ></span>
              </span>
              <span class="ih__small">{d.headline.small}</span>
              <h1 class="ih__large">{d.headline.large}</h1>
              {d.standfirst && <p class="ih__standfirst">{d.standfirst}</p>}
            </div>
          )}

          {/* The printed order. Real copy from the entry, so it is content;
              the torn edges are two repeating gradients rather than images. */}
          {d.hero!.receipt && (
            <aside
              class="rcpt"
              data-reveal
              data-ticket={JSON.stringify(d.hero!.receipt.statuses)}
              data-ticket-index={d.hero!.receipt.statusIndex}
            >
              <span class="rcpt__tear rcpt__tear--top" aria-hidden="true"></span>
              <div class="rcpt__body">
                <div class="rcpt__head">
                  <span>{d.hero!.receipt.title}</span>
                  {d.hero!.receipt.time && (
                    <span class="rcpt__time" data-ticket-clock>{d.hero!.receipt.time}</span>
                  )}
                </div>
                <span class="rcpt__hair" aria-hidden="true"></span>
                {d.hero!.receipt.meta.map((m, i) => (
                  <p class:list={['rcpt__meta', i > 0 && 'rcpt__meta--dim']}>{m}</p>
                ))}
                <span class="rcpt__hair" aria-hidden="true"></span>
                <ul class="rcpt__lines">
                  {d.hero!.receipt.lines.map((l) => (
                    <li><span>{l.k}</span><span class="rcpt__v">{l.v}</span></li>
                  ))}
                  {d.hero!.receipt.note && <li class="rcpt__note">{d.hero!.receipt.note}</li>}
                </ul>
                <span class="rcpt__hair" aria-hidden="true"></span>
                <p class="rcpt__total">
                  <span>{d.hero!.receipt.totalLabel}</span><span>{d.hero!.receipt.total}</span>
                </p>
                {d.hero!.receipt.paid && <p class="rcpt__paid">{d.hero!.receipt.paid}</p>}
                <span class="rcpt__hair" aria-hidden="true"></span>
                <p class="rcpt__label">{d.hero!.receipt.statusLabel}</p>
                <p class="rcpt__status">
                  <span class="rcpt__led" aria-hidden="true"></span>
                  <span data-ticket-status>
                    {d.hero!.receipt.statuses[d.hero!.receipt.statusIndex]}
                  </span>
                </p>
                <div class="rcpt__ticks" aria-hidden="true">
                  {d.hero!.receipt.statuses.map((_, i) => (
                    <span
                      data-ticket-step
                      class:list={[i <= d.hero!.receipt!.statusIndex && 'is-on']}
                    ></span>
                  ))}
                </div>
                <span class="rcpt__hair" aria-hidden="true"></span>
                {d.hero!.receipt.footnote && <p class="rcpt__foot">{d.hero!.receipt.footnote}</p>}
              </div>
              <span class="rcpt__tear rcpt__tear--bottom" aria-hidden="true"></span>
            </aside>
          )}
        </div>
      </div>
    </Section>

    {/* ── The journey, 1440x2160 ───────────────────────────── */}
    {/* I2. The section the page exists for. Four constraints an insider would
        nod at, not four ways of saying the sector moves fast. */}
    {d.constraints && (
      <Section ground="light">
        <div class="ic">
          <span class="i-eyebrow">{d.constraints.label}</span>
          <h2 class="ic__h" data-reveal>{d.constraints.heading}</h2>
          <ol class="ic__list">
            {d.constraints.items.map((it, i) => (
              <li class="ic__item" data-reveal style={`transition-delay:${(i % 4) * 70}ms`}>
                <span class="ic__n">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="ic__name">{it.name}</h3>
                <p class="ic__body">{it.body}</p>
              </li>
            ))}
          </ol>
        </div>
      </Section>
    )}

    {/* I3. Failure patterns. Naming other people's mistakes accurately is the
        fastest way to show you have worked here. */}
    {d.failures && (
      <Section ground="surface">
        <div class="ifl">
          <span class="i-eyebrow">{d.failures.label}</span>
          <h2 class="ifl__h" data-reveal>{d.failures.heading}</h2>
          <ul class="ifl__list">
            {d.failures.items.map((it, i) => (
              <li class="ifl__item" data-reveal style={`transition-delay:${(i % 3) * 70}ms`}>
                <span class="ifl__rule" aria-hidden="true"></span>
                <h3 class="ifl__name">{it.name}</h3>
                <p class="ifl__body">{it.body}</p>
              </li>
            ))}
          </ul>
        </div>
      </Section>
    )}

    {/* I4. One or two cases, both from this sector.
        ART DIRECTION: the yellow stroke cuts across the case rather than
        framing it, which is the V1 habit worth keeping. */}
    {d.cases && (
      <Section ground="dark">
        <div class="icz">
          {/* THE BAND'S GROUND IS THE PHOTOGRAPHY. Full bleed, edge to edge and
              top to bottom — there is no black left behind this section.

              Split when there are two cases. Three of the seven industries run
              two side by side, and one photograph across the whole band would
              put one client's premises behind another client's name, so the
              ground is halved and each case sits over its own. With one case
              it is a single image across the full width. */}
          {/* THE SWEEP ONLY WHEN THERE IS ONE. Turn 7b puts the ring ON a
              photograph where that photograph is the full-width ground of a
              band, which is this band with a single case and nothing else on
              the site. With two, the ground is halved: each picture is a
              half-width card carrying a client name, a lead and a button, and
              the arcs cross every line of it. Those halves keep the card
              treatment — amber dusk under ink — which is the same rule the
              /work/ grid follows. */}
          <span class="icz__ground" aria-hidden="true">
            {d.cases.items.map((c) => (
              <span class:list={['icz__shot', d.cases.items.length === 1 && 'icz__shot--sweep']}>
                {workHeroFor(c.href) && (
                  <Fragment>
                    <img src={workHeroFor(c.href)} alt="" width="2400" height="1200" loading="lazy" decoding="async" />
                    {d.cases.items.length === 1 && <RingField variant="sweep" />}
                  </Fragment>
                )}
              </span>
            ))}
          </span>
          <span class="i-eyebrow i-eyebrow--dark">{d.cases.label}</span>
          <div class:list={['icz__grid', d.cases.items.length === 1 && 'icz__grid--one']}>
            {d.cases.items.map((c, i) => (
              <article class="icz__case" data-reveal style={`transition-delay:${i * 90}ms`}>
                <span class="icz__cut" aria-hidden="true"></span>
                <h3 class="icz__client">{c.client}</h3>
                <p class="icz__sit">{c.situation}</p>
                <p class="icz__did">{c.did}</p>
                {c.outcome && <p class="icz__out">{c.outcome}</p>}
                <a class="i-ghost icz__cta" href={c.href}>
                  <span>Read the case study</span>
                  <span class="i-ghost__dots" data-dots aria-hidden="true"><i></i><i></i></span>
                </a>
              </article>
            ))}
          </div>
        </div>
      </Section>
    )}

    {/* I5. Services with a line on how each one applies HERE. This block and
        the service pages' S8 are the whole internal link structure. */}
    {d.applies && (
      <Section ground="light">
        <div class="iap">
          <span class="i-eyebrow">{d.applies.label}</span>
          <h2 class="iap__h" data-reveal>{d.applies.heading}</h2>
          <ul class="iap__list">
            {d.applies.items.map((it, i) => (
              <li data-reveal style={`transition-delay:${(i % 3) * 60}ms`}>
                <a href={it.href}>
                  <b>{it.name}</b>
                  <span>{it.why}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </Section>
    )}

    {/* I6. The block that survives a procurement review. Named things only. */}
    {d.domain && (
      <Section ground="surface">
        <div class="idm">
          <span class="i-eyebrow">{d.domain.label}</span>
          <h2 class="idm__h" data-reveal>{d.domain.heading}</h2>
          {d.domain.note && <p class="idm__note" data-reveal>{d.domain.note}</p>}
          <dl class="idm__grid">
            {d.domain.groups.map((g, i) => (
              <div data-reveal style={`transition-delay:${(i % 4) * 60}ms`}>
                <dt>{g.k}</dt>
                <dd>
                  <ul>{g.items.map((x) => <li>{x}</li>)}</ul>
                </dd>
              </div>
            ))}
          </dl>
        </div>
      </Section>
    )}

    {d.journey && (
      <Section ground="light">
        <div class="ij">
          <span class="i-rule" aria-hidden="true"></span>
          <span class="i-eyebrow">{d.journey.label}</span>
          <h2 class="ij__h">{d.journey.heading}</h2>
          <div class="ij__intro" data-reveal>
            {d.journey.intro && <p class="ij__intro-a">{d.journey.intro}</p>}
            {d.journey.note && <p class="ij__intro-b">{d.journey.note}</p>}
          </div>

          {/* Same spine as /approach/, driven by src/scripts/spine.ts. */}
          <div class="ij__spine" data-spine aria-hidden="true">
            <span class="ij__spine-line"></span>
            <span class="ij__spine-fill" data-spine-fill></span>
            {d.journey.moments.map((_, i) => (
              <span
                class:list={['ij__node', i === 0 && 'is-on']}
                data-spine-node
                style={`top:${i * 270}px`}
              ></span>
            ))}
          </div>

          <ol class="ij__moments">
            {d.journey.moments.map((m) => (
              <li class="ij__moment" data-reveal>
                <span class="ij__n">{m.n}</span>
                <h3 class:list={['ij__name', m.name.length > 12 && 'ij__name--long']}>{m.name}</h3>
                {m.lead && <p class="ij__lead">{m.lead}</p>}
                <div class="ij__detail"><p>{m.body}</p></div>
                {m.tags.length > 0 && (
                  <ul class="ij__tags">{m.tags.map((t) => <li>{t}</li>)}</ul>
                )}
              </li>
            ))}
          </ol>
        </div>
      </Section>
    )}

    {/* ── Surfaces, 1440x720 on #F5F5F5 ────────────────────── */}
    {d.surfaces && (
      <Section ground="surface">
        <div class="isf" data-tabs>
          <span class="isf__tick" aria-hidden="true"></span>
          <span class="i-eyebrow">{d.surfaces.label}</span>
          {/* The only band on this page with no motion in it. The heading and
              its line lift in; the tab strip and its panels do NOT, because
              the panels are switched by the tabs island and a reveal on a
              hidden panel never intersects, so it would stay at opacity 0
              until the panel was opened and then snap. */}
          <h2 class="isf__h" data-reveal>{d.surfaces.heading}</h2>
          {d.surfaces.sub && <p class="isf__sub" data-reveal style="transition-delay:70ms">{d.surfaces.sub}</p>}

          <div class="isf__tabs" role="tablist" aria-label={d.surfaces.heading}>
            {d.surfaces.tabs.map((t, i) => (
              <button
                type="button"
                role="tab"
                id={`surf-tab-${i}`}
                aria-controls={`surf-panel-${i}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                tabindex={i === 0 ? 0 : -1}
              >
                <span class="isf__tab-n">{t.n}</span>
                <span class="isf__tab-name">{t.name}</span>
                <span class="isf__tab-dot" aria-hidden="true"></span>
              </button>
            ))}
          </div>

          <div class="isf__panels">
            {d.surfaces.tabs.map((t, i) => (
              <div
                class="isf__panel"
                role="tabpanel"
                id={`surf-panel-${i}`}
                aria-labelledby={`surf-tab-${i}`}
                hidden={i !== 0}
              >
                <h3 class="isf__panel-h">{t.heading}</h3>
                <ul class="isf__points">{t.points.map((pt) => <li>{pt}</li>)}</ul>
                {t.note && <p class="isf__note">{t.note}</p>}
              </div>
            ))}
          </div>
        </div>
      </Section>
    )}

    {/* ── Proof, 1440x1000 on black ────────────────────────── */}
    {d.proof && (
      <Section ground="dark">
        <div class="ip">
          {/* The ground is the featured project's own header shot, resolved by
              the same workHeroFor the /work/ card and the case-study header
              use, so a project looks the same everywhere it is named. Under
              the export's dark wash, because the 84px numerals sit on top of
              it and need the contrast; the amber corner goes over the wash
              rather than under it, since at 0.66-0.9 black there would be
              nothing left of it to see.
              aria-hidden with an empty alt: it is a ground, and the credit
              beside it is the content. */}
          {featuredShot && (
            <div class="ip__bg" aria-hidden="true">
              <img src={featuredShot} alt="" width="1440" height="1000" loading="lazy" decoding="async" />
              <RingField variant="sweep" />
            </div>
          )}
          <span class="ip__tick" aria-hidden="true"></span>
          <span class="i-eyebrow i-eyebrow--dark">{d.proof.label}</span>
          <h2 class="ip__h">{d.proof.heading}</h2>
          <ul class="ip__stats">
            {d.proof.stats.map((s, i) => (
              <li data-reveal style={`transition-delay:${i * 60}ms`}>
                <span class="ip__n">{s.n}<i class:list={[s.pct && 'ip__pct']}>{s.suffix}</i></span>
                <span class="ip__label">{s.label}</span>
              </li>
            ))}
          </ul>

          {d.proof.featured && (
            <div class="ip__feat">
              <span class="ip__hair" aria-hidden="true"></span>
              <span class="i-eyebrow i-eyebrow--dark ip__feat-label">{d.proof.featured.label}</span>
              <h3 class="ip__feat-client" data-reveal>{d.proof.featured.client}</h3>
              <p class="ip__feat-body" data-reveal>{d.proof.featured.body}</p>
              <dl class="ip__feat-meta" data-reveal>
                {d.proof.featured.meta.map((m) => (
                  <div><dt>{m.k}</dt><dd>{m.v}</dd></div>
                ))}
              </dl>
              <a class="i-ghost ip__feat-cta" href={d.proof.featured.href}>
                <span>{d.proof.featured.ctaLabel}</span>
                <span class="i-ghost__dots" data-dots aria-hidden="true"><i></i><i></i></span>
              </a>
            </div>
          )}
        </div>
      </Section>
    )}

    {/* ── Other sectors, 1440x980 ──────────────────────────── */}
    {d.sectors && (
      <Section ground="light">
        <div class="isc">
          <span class="i-rule" aria-hidden="true"></span>
          <span class="i-eyebrow">{d.sectors.label}</span>
          <h2 class="isc__h">{d.sectors.heading}</h2>
          {d.sectors.intro && <p class="isc__intro" data-reveal>{d.sectors.intro}</p>}
          <ul class="isc__rows">
            {d.sectors.items.map((it, i) => (
              <li data-reveal style={`transition-delay:${i * 30}ms`}>
                <a href={it.href} aria-current={it.href === path ? 'page' : undefined}>
                  <span class="isc__hair" aria-hidden="true"></span>
                  <span class="isc__n">{it.n}</span>
                  <span class="isc__name">{it.name}</span>
                  {/* Revealed on hover, per the export's own instruction to
                      the reader. Always present for a crawler and for touch,
                      where there is no hover to do the revealing. */}
                  <span class="isc__blurb">{it.blurb}</span>
                  <span class="isc__arrow" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
            <li class="isc__end"><span class="isc__hair" aria-hidden="true"></span></li>
          </ul>
        </div>
      </Section>
    )}

    <SiteFooter
      slot="footer"
      blurbTitle={d.cta?.footerTitle}
      blurb={d.cta?.footerBlurb}
      tagline={d.cta?.footerTagline}
      ctaLabel={d.cta?.ctaLabel}
      ctaHref={d.cta?.ctaHref}
    />
  </BaseLayout>
) : (
  <MarketingPage
    title={entry?.data.seo.title ?? `${name} | ${site.name}`}
    description={entry?.data.seo.description}
    path={path}
    label="Industry"
    heading={name}
    schema={schema}
    pending={!entry}
    ctaCopy={entry?.data.cta}
  >
    {Content && <Content />}
  </MarketingPage>
)}

<style>
  /* ── shared ─────────────────────────────────────────────── */
  .i-eyebrow {
    display: block;
    font-size: var(--fs-micro); line-height: 19px; font-weight: var(--fw-medium);
    letter-spacing: 0.18em; color: var(--c-ink-label);
  }
  .i-eyebrow--dark { color: rgba(255, 255, 255, 0.55); }
  .i-rule { display: block; height: 1.5px; background: var(--c-rule-strong); }
  .i-chip { display: flex; align-items: flex-start; height: 24px; margin-left: 8px; }
  .i-chip { position: relative; }
  .i-chip > span:first-child { font-size: 20px; line-height: 20px; font-weight: var(--fw-semi); letter-spacing: var(--ls-item); color: #fbfbfb; padding-top: 4px; }
  .i-chip__star { position: absolute; left: 52px; top: 0; width: 10px; height: 10px; color: #fbfbfb; }

  .i-ghost {
    position: relative; display: inline-flex; align-items: center;
    width: 195px; height: 42px; padding-left: 21px; border-radius: var(--r-pill);
    box-shadow: inset 0 0 0 1.5px var(--c-ring-dark);
    font-size: var(--fs-micro); line-height: 20px; font-weight: var(--fw-medium);
    letter-spacing: normal; color: var(--c-white);
    transition: box-shadow var(--dur-fast) ease;
  }
  .i-ghost:hover { box-shadow: inset 0 0 0 1.5px var(--c-accent); color: var(--c-white); }
  /* THE DOTS, AS A PAIR, ON ALL THREE OF THESE BUTTONS.
     They were two separately-positioned spans pinned at left:158 and left:169,
     and the cases band's "Read the case study" shipped without them at all.
     .i-ghost is a fixed 195px and those two lefts reserve its last 40px for
     dots, so that button was a pill with a hole in the end of it — which is
     precisely what made it look unfinished beside every other button here.
     One flex pair anchored to the right edge instead of to two magic numbers,
     so it stays correct whatever the pill's width becomes. It carries
     data-dots as well, so these blink like every other pair on the site;
     they were the last ones left out. */
  .i-ghost__dots {
    position: absolute; right: 18px; top: 50%; translate: 0 -50%;
    display: flex; gap: 3px;
  }
  .i-ghost__dots i { width: 8px; height: 8px; border-radius: 50%; display: block; }
  .i-ghost__dots i:first-child { background: rgb(153, 152, 149); }
  .i-ghost__dots i:last-child { background: var(--c-accent); }

  /* ── hero ───────────────────────────────────────────────── */
  .ih { position: relative; }
  .ih__inner {
    position: relative; z-index: 1;
    display: grid; grid-template-columns: 401fr 734fr 227fr;
    align-content: start; padding-block: 168px 0; min-height: 820px;
  }
  /* Fixed offsets, not a margin chain: the export authors the rail as five
     children at 0 / 38 / 66 / 180 / 262, so a statement that wraps to two
     lines instead of three must not drag the button up with it. */
  .ih__rail { position: relative; grid-column: 1; grid-row: 1; width: 400px; height: 340px; }
  .ih__tick { position: absolute; top: 38px; display: block; width: 16px; height: 1.5px; background: var(--c-accent); }
  .ih__rail .i-ghost { position: absolute; top: 262px; }

  .ih__mast { grid-column: 2; grid-row: 1; margin-top: 212px; }
  .ih__small {
    display: block; margin: 20px 0 0 2px;
    font-size: 66px; line-height: 70px; font-weight: var(--fw-semi);
    letter-spacing: var(--ls-display); color: rgba(255, 255, 255, 0.62);
  }
  .ih__large {
    margin: 2px 0 0; white-space: nowrap;
    font-size: clamp(56px, 9.73vw, 140px); line-height: 150px; font-weight: var(--fw-semi);
    letter-spacing: -0.055em; color: rgb(251, 251, 251);
  }
  .ih__standfirst {
    margin: 16px 0 0 6px; max-width: 520px;
    font-size: var(--fs-item); line-height: 34px; font-weight: var(--fw-medium);
    letter-spacing: var(--ls-item); color: rgba(255, 255, 255, 0.72);
  }

  /* The printed order. Paper stock, dark ink — the one light object on the
     whole band, which is why it reads as an artefact rather than a card. */
  /* A ticket is set solid. base.css hands everything a flat 22px leading,
     which on 10 and 11px caps is nearly double-spaced and reads as a card,
     not a printout — so the whole receipt goes back to `normal` and the
     margins below place each row on the export's own offsets inside the
     188x500 inner box. */
  .rcpt {
    grid-column: 3; grid-row: 1; width: 228px; margin-top: 10px;
    color: rgb(20, 20, 20); line-height: normal;
  }
  .rcpt__tear {
    display: block; height: 8px;
    background: repeating-linear-gradient(90deg, rgb(251, 251, 249) 0 8px, transparent 8px 16px);
  }
  .rcpt__body { background: rgb(251, 251, 249); padding: 22px 20px 28px; }
  .rcpt__head {
    display: flex;
    font-size: 11px; font-weight: var(--fw-semi); letter-spacing: 0.24em;
  }
  .rcpt__head > :first-child { flex: 1; }
  .rcpt__time { width: 56px; font-weight: var(--fw-medium); letter-spacing: 0.04em; }
  .rcpt__hair { display: block; height: 1px; background: rgba(20, 20, 20, 0.14); }
  .rcpt__head + .rcpt__hair { margin-top: 12.7px; }
  .rcpt__meta { margin: 7px 0 0; font-size: var(--fs-micro); letter-spacing: 0.02em; }
  .rcpt__meta--dim { margin-top: 5.5px; color: rgba(20, 20, 20, 0.55); }
  .rcpt__meta + .rcpt__hair { margin-top: 17.5px; }
  .rcpt__lines {
    list-style: none; margin: 8px 0 0; padding: 0;
    font-size: var(--fs-micro); line-height: 26px; letter-spacing: 0.01em;
  }
  .rcpt__lines li { display: flex; justify-content: space-between; }
  .rcpt__v { color: rgba(20, 20, 20, 0.55); }
  .rcpt__note { display: block; color: rgba(20, 20, 20, 0.45); }
  .rcpt__lines + .rcpt__hair { margin-top: 27px; }
  .rcpt__total {
    display: flex; margin: 15px 0 0;
    font-size: var(--fs-label); font-weight: var(--fw-semi); letter-spacing: 0.02em;
  }
  .rcpt__total > :first-child { flex: 1; }
  .rcpt__total > :last-child { width: 68px; }
  .rcpt__paid { margin: 7px 0 0; font-size: 11px; letter-spacing: 0.02em; color: rgba(20, 20, 20, 0.5); }
  .rcpt__paid + .rcpt__hair { margin-top: 16.7px; }
  .rcpt__label { margin: 15px 0 0; font-size: 10px; font-weight: var(--fw-semi); letter-spacing: 0.22em; color: rgba(20, 20, 20, 0.5); }
  .rcpt__status {
    display: flex; align-items: center; gap: 9px; margin: 7.9px 0 0; height: 20px;
    font-size: 13px; font-weight: var(--fw-semi); letter-spacing: 0.03em;
  }
  .rcpt__led { width: 7px; height: 7px; background: var(--c-accent); }
  .rcpt__ticks { display: flex; align-items: flex-start; gap: 5px; height: 36px; margin-top: 20px; }
  .rcpt__ticks span { flex: 1; height: 3px; background: rgba(20, 20, 20, 0.15); }
  .rcpt__ticks span.is-on { background: var(--c-accent); }
  .rcpt__ticks span { transition: background var(--dur-fast) ease; }
  .rcpt__ticks + .rcpt__hair { margin-top: 14px; }
  .rcpt__foot { margin: 15px 0 0; font-size: 10px; font-weight: var(--fw-medium); letter-spacing: 0.14em; color: rgba(20, 20, 20, 0.5); }

  /* ── I1 frame ───────────────────────────────────────────── */
  /* The compression device. The rail stacks tight, the eyebrow and the tick
     sit close above, and the h1 is the line that refuses to thin out: it
     holds its weight while everything around it gets quieter. */
  .if__h {
    margin: 20px 0 0; max-width: 460px;
    font-size: 32px; line-height: 39px; font-weight: var(--fw-semi);
    letter-spacing: -0.035em; color: rgb(251, 251, 251);
  }
  .if__does {
    margin: 18px 0 0; max-width: 440px;
    font-size: var(--fs-body); line-height: 24px; font-weight: var(--fw-medium);
    letter-spacing: var(--ls-item); color: rgba(255, 255, 255, 0.6);
  }

  /* ── I2 constraints ─────────────────────────────────────── */
  .ic { padding-block: 96px; }
  .ic__h {
    margin: 26px 0 0 -4px; max-width: 62%;
    font-size: clamp(32px, 3.6vw, 48px); line-height: 1.16; font-weight: var(--fw-semi);
    letter-spacing: var(--ls-display); color: var(--c-ink-heading);
  }
  .ic__list {
    list-style: none; margin: 56px 0 0; padding: 0;
    display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 44px 30px;
  }
  .ic__item { min-width: 0; border-top: 2px solid rgba(153, 152, 149, 0.4); padding-top: 18px; }
  .ic__item:first-child { border-top-color: var(--c-accent); }
  .ic__n {
    font-size: var(--fs-micro); font-weight: var(--fw-semi);
    letter-spacing: 0.16em; color: var(--c-ink-label);
  }
  .ic__name {
    margin: 18px 0 0;
    font-size: 24px; line-height: 30px; font-weight: var(--fw-semi);
    letter-spacing: var(--ls-display); color: var(--c-ink-heading);
  }
  .ic__body {
    margin: 14px 0 0;
    font-size: var(--fs-body); line-height: 25px; font-weight: var(--fw-medium);
    letter-spacing: -0.045em; color: rgba(20, 20, 20, 0.75);
  }

  /* ── I3 failures ────────────────────────────────────────── */
  .ifl { padding-block: 96px; }
  .ifl__h {
    margin: 26px 0 0 -4px; max-width: 62%;
    font-size: clamp(32px, 3.6vw, 48px); line-height: 1.16; font-weight: var(--fw-semi);
    letter-spacing: var(--ls-display); color: var(--c-ink-heading);
  }
  .ifl__list {
    list-style: none; margin: 52px 0 0; padding: 0;
    display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 40px 30px;
  }
  .ifl__item { min-width: 0; }
  .ifl__rule { display: block; width: 28px; height: 2px; background: var(--c-accent); }
  .ifl__name {
    margin: 20px 0 0;
    font-size: 22px; line-height: 29px; font-weight: var(--fw-semi);
    letter-spacing: var(--ls-item); color: var(--c-ink-heading);
  }
  .ifl__body {
    margin: 12px 0 0;
    font-size: var(--fs-body); line-height: 25px; font-weight: var(--fw-medium);
    letter-spacing: -0.045em; color: rgba(20, 20, 20, 0.72);
  }

  /* ── I4 cases ───────────────────────────────────────────── */
  /* 204px, not 96px. The band is 40% taller than it was, and the height comes
     from padding rather than a min-height so the extra air lands evenly above
     and below the copy — the photograph gets room to be a photograph and the
     ring arcs get length to travel. 347px of content + 408px of padding = the
     755px this band now stands at, against 539px before. */
  .icz { position: relative; isolation: isolate; padding-block: 204px; }
  /* Full bleed. 100vw off the band's own centre, which is the viewport's
     centre because .wrap is a centred max-width box — the same move .ip__bg
     makes two sections down. z-index -1 under `isolation: isolate` puts it
     over the Section's dark ground and under every word in the band. */
  .icz__ground {
    position: absolute; left: 50%; top: 0; z-index: -1;
    display: flex; width: 100vw; height: 100%;
    transform: translateX(-50%); overflow: hidden;
  }
  /* One flex child per case, so two cases halve the band and one fills it.
     rgb(18,18,18) shows through for a case whose slug has no header file. */
  .icz__shot { position: relative; flex: 1 1 0; min-width: 0; background: rgb(18, 18, 18); }
  .icz__shot img {
    display: block; width: 100%; height: 100%; object-fit: cover;
    filter: brightness(var(--dusk-exposure-card));
  }
  /* Amber dusk, per half, so each case gets its own corner rather than one
     corner for a band that might hold two. Amber under ink, as everywhere. */
  .icz__shot::before,
  .icz__shot::after { content: ''; position: absolute; inset: 0; }
  .icz__shot::before { z-index: 1; background: var(--dusk-amber); }
  /* The ink is steeper than --dusk-ink. That token ramps out across a card the
     copy fills; here the copy sits in the left half of a 100vw band, so the
     standard ramp would be spent before it reached the text and would darken
     picture nobody is reading over. */
  .icz__shot::after {
    z-index: 2;
    background: linear-gradient(90deg,
      rgba(11, 11, 11, 0.9) 0%,
      rgba(11, 11, 11, 0.74) 42%,
      rgba(11, 11, 11, 0.3) 78%,
      rgba(11, 11, 11, 0.16) 100%);
  }
  /* The single-case band is one photograph across the full width, so it takes
     turn 7b instead: the grade, the ring drawn on it, no amber, and only the
     ink the copy in the left half actually needs. Same swap as .ip__bg. */
  .icz__shot--sweep img { filter: var(--sweep-grade); }
  .icz__shot--sweep::before { display: none; }
  .icz__shot--sweep::after {
    background: linear-gradient(90deg,
      rgba(11, 11, 11, 0.72) 0%,
      rgba(11, 11, 11, 0.42) 42%,
      rgba(11, 11, 11, 0.08) 78%,
      rgba(11, 11, 11, 0) 100%);
  }
  /* TWO EXPLICIT COLUMNS, NOT auto-fit. The ground behind this grid has to
     split at exactly the same width the grid does, and auto-fit resolves
     against the 1362 wrap while the ground resolves against 100vw — so the two
     disagreed for about forty pixels and the seam landed inside a case. Both
     now collapse at the 760px breakpoint below, together. */
  .icz__grid {
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 56px 60px; margin-top: 44px;
  }
  .icz__grid--one { grid-template-columns: minmax(0, 760px); }
  .icz__case { position: relative; min-width: 0; padding-top: 30px; }
  /* The stroke cuts ACROSS the case rather than boxing it in. Rounded cards
     stay out; this is a structural line, and it now has a photograph to cut
     across instead of a flat ground. */
  .icz__cut {
    position: absolute; left: -12px; top: 0; width: 120px; height: 3px;
    background: var(--c-accent);
  }
  .icz__client {
    margin: 0;
    font-size: clamp(30px, 3vw, 44px); line-height: 1.1; font-weight: var(--fw-semi);
    letter-spacing: var(--ls-display); color: rgb(251, 251, 251);
  }
  .icz__sit {
    margin: 20px 0 0;
    font-size: 18px; line-height: 27px; font-weight: var(--fw-medium);
    letter-spacing: var(--ls-item); color: rgba(255, 255, 255, 0.88);
  }
  .icz__did {
    margin: 14px 0 0;
    font-size: var(--fs-body); line-height: 25px; font-weight: var(--fw-medium);
    letter-spacing: var(--ls-item); color: rgba(255, 255, 255, 0.66);
  }
  /* .icz__out IS DELIBERATELY ABSENT. Every `outcome` in the industry content
     was a "[ NEEDS THE REAL FIGURE ]" placeholder and all of them were removed,
     so the rule matched nothing and assert-styles failed the build — which is
     the gate doing its job.
     THE MARKUP IS STILL WIRED: add a real outcome to a case in frontmatter and
     it renders again, unstyled, which is obvious enough to notice. Restore this
     rule with the first real figure:
       margin: 22px 0 0; padding-top: 18px;
       border-top: 1px solid rgba(255, 255, 255, 0.18);
       font-size: 19px; line-height: 28px; font-weight: var(--fw-semi);
       letter-spacing: var(--ls-item); color: var(--c-accent); */
  .icz__cta { margin-top: 26px; }

  /* ── I5 services applied ────────────────────────────────── */
  .iap { padding-block: 96px; }
  .iap__h {
    margin: 26px 0 0 -4px; max-width: 62%;
    font-size: clamp(32px, 3.6vw, 48px); line-height: 1.16; font-weight: var(--fw-semi);
    letter-spacing: var(--ls-display); color: var(--c-ink-heading);
  }
  .iap__list {
    list-style: none; margin: 48px 0 0; padding: 0;
    display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 0 60px;
  }
  .iap__list li { border-top: 1px solid rgba(153, 152, 149, 0.3); }
  .iap__list a { display: block; padding: 20px 0; }
  .iap__list b {
    display: block;
    font-size: 20px; line-height: 26px; font-weight: var(--fw-semi);
    letter-spacing: var(--ls-item); color: var(--c-ink-heading);
    transition: color var(--dur-fast) ease;
  }
  .iap__list span {
    display: block; margin-top: 5px;
    font-size: var(--fs-body); line-height: 22px; font-weight: var(--fw-medium);
    letter-spacing: var(--ls-item); color: rgba(20, 20, 20, 0.6);
  }
  .iap__list a:hover b { color: rgb(90, 90, 90); }

  /* ── I6 domain ──────────────────────────────────────────── */
  .idm { padding-block: 96px; }
  .idm__h {
    margin: 26px 0 0 -4px; max-width: 62%;
    font-size: clamp(32px, 3.6vw, 48px); line-height: 1.16; font-weight: var(--fw-semi);
    letter-spacing: var(--ls-display); color: var(--c-ink-heading);
  }
  .idm__note {
    margin: 20px 0 0; max-width: 620px;
    font-size: var(--fs-body); line-height: 25px; font-weight: var(--fw-medium);
    letter-spacing: var(--ls-item); color: rgba(20, 20, 20, 0.66);
  }
  .idm__grid {
    margin: 48px 0 0;
    display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 40px 30px;
  }
  .idm__grid dt {
    padding-bottom: 12px; border-bottom: 1px solid rgba(153, 152, 149, 0.4);
    font-size: var(--fs-micro); font-weight: var(--fw-semi);
    letter-spacing: 0.16em; text-transform: uppercase; color: var(--c-ink-label);
  }
  .idm__grid dd { margin: 16px 0 0; }
  .idm__grid ul { list-style: none; margin: 0; padding: 0; }
  .idm__grid li {
    padding: 7px 0;
    font-size: var(--fs-body); line-height: 22px; font-weight: var(--fw-medium);
    letter-spacing: var(--ls-item); color: rgba(20, 20, 20, 0.82);
  }

  /* ── the journey ────────────────────────────────────────── */
  .ij { position: relative; padding-block: 80px 270px; min-height: 2160px; }
  .ij__h {
    margin: 24px 0 0 -7px; max-width: 900px;
    font-size: clamp(48px, 7.78vw, 112px); line-height: 104px; font-weight: var(--fw-semi);
    letter-spacing: var(--ls-display); color: var(--c-ink-heading);
  }
  .ij .i-eyebrow { margin-top: 24px; }
  .ij__intro { position: absolute; left: 67.695%; top: 158px; width: 32.305%; }
  .ij__intro-a {
    font-size: var(--fs-intro); line-height: 32px; font-weight: var(--fw-medium);
    letter-spacing: var(--ls-item); color: rgb(20, 20, 20);
  }
  .ij__intro-b {
    position: absolute; left: 0; top: 150px; margin: 0; width: 100%;
    font-size: var(--fs-body); line-height: 23px; font-weight: var(--fw-medium);
    letter-spacing: var(--ls-item); color: rgba(20, 20, 20, 0.62);
  }
  /* 17px LEFT of where the export puts it. The export runs the rule at 120,
     which is inside the phase titles at 114 — the node lands on the P of
     "Pay" and the stroke crosses the F of "Fire". It is wrong there and it
     was worse here, because the node had grown to 19px. Node back to the
     export's 13px, rule moved to 104, so it clears the titles by 3px and
     still reads as the margin the phases hang off. */
  .ij__spine { position: absolute; left: 64px; top: 470px; width: 20px; height: 1420px; }
  .ij__spine-line { position: absolute; left: 0; top: 0; width: 1px; height: 100%; background: rgba(153, 152, 149, 0.45); }
  .ij__spine-fill { position: absolute; left: 0; top: 0; width: 2px; height: 0; background: var(--c-accent); }
  .ij__node {
    position: absolute; left: -6px; width: 13px; height: 13px; border-radius: 50%;
    background: var(--c-white); box-shadow: inset 0 0 0 1px rgba(153, 152, 149, 0.45);
  }
  .ij__node.is-on { background: var(--c-accent); box-shadow: none; }

  .ij__moments { list-style: none; margin: 0; padding: 0; }
  .ij__moment { position: absolute; left: 1px; right: 0; height: 230px; }
  .ij__moment:nth-child(1) { top: 440px; }
  .ij__moment:nth-child(2) { top: 710px; }
  .ij__moment:nth-child(3) { top: 980px; }
  .ij__moment:nth-child(4) { top: 1250px; }
  .ij__moment:nth-child(5) { top: 1520px; }
  .ij__moment:nth-child(6) { top: 1790px; }
  .ij__n {
    position: absolute; left: 104px; top: 0;
    font-size: var(--fs-micro); line-height: normal; font-weight: var(--fw-medium); letter-spacing: 0.14em;
    color: var(--c-ink-label);
  }
  /* The design's names are one word — Discover, Order, Pay — so the block
     never needed a width. Migrated pages name a capability instead ("HIPAA
     Compliant Apps"), which at 60px reached across into the body column at
     620. Capped to the rail it belongs to, and allowed to wrap. */
  /* The name, the lead and the body are each absolutely placed at a fixed
     top — 26, 104 and 152 — so the name has exactly 78px and cannot take a
     second line. The design's names are one word and never did. A migrated
     page names a capability instead, and "Custom eCommerce" at 60px wrapped
     straight down through the lead beneath it.
     Long names come down to 40px, which keeps any name the extractor can
     produce (18 characters) on one line inside the 470px rail. */
  .ij__name {
    position: absolute; left: 74px; top: 26px; margin: 0; max-width: 470px;
    font-size: 60px; line-height: 66px; font-weight: var(--fw-semi);
    letter-spacing: var(--ls-display); color: var(--c-ink-heading);
    white-space: nowrap;
  }
  .ij__name--long { font-size: 40px; line-height: 46px; }
  .ij__lead {
    position: absolute; left: 78px; top: 104px; width: 400px;
    font-size: 20px; line-height: 28px; font-weight: var(--fw-medium);
    letter-spacing: var(--ls-item); color: rgba(20, 20, 20, 0.78);
  }
  /* Three columns, not two. The export draws a hairline over each of the two
     right-hand ones at y=14 and starts their content at y=38; the tags are a
     column of their own at 1022, not a strip under the body copy. */
  .ij__detail { position: absolute; left: 580px; top: 38px; width: 400px; }
  .ij__detail::before,
  .ij__tags::before {
    content: ''; position: absolute; left: 0; top: -24px;
    width: 100%; height: 0.5px; background: rgba(153, 152, 149, 0.5);
  }
  .ij__detail p {
    font-size: var(--fs-body); line-height: 25px; font-weight: var(--fw-medium);
    letter-spacing: -0.045em; color: rgba(20, 20, 20, 0.8);
  }
  .ij__tags {
    position: absolute; left: 75.037%; top: 38px; width: 24.963%;
    list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px;
  }
  .ij__tags li {
    padding: 6px 13px; border-radius: var(--r-pill);
    box-shadow: inset 0 0 0 1px rgba(20, 20, 20, 0.16);
    font-size: 11px; line-height: normal; font-weight: var(--fw-medium);
    letter-spacing: 0.12em; color: rgb(20, 20, 20);
  }

  /* ── surfaces ───────────────────────────────────────────── */
  .isf { position: relative; padding-block: 80px 90px; min-height: 720px; }
  .isf__tick { display: block; width: 16px; height: 1.5px; background: var(--c-rule-strong); }
  .isf .i-eyebrow { margin-top: 20px; }
  .isf__h {
    margin: 17px 0 0 -6px;
    font-size: clamp(46px, 5.84vw, var(--fs-display)); line-height: 86px;
    font-weight: var(--fw-semi); letter-spacing: var(--ls-display); color: var(--c-ink-heading);
  }
  .isf__sub {
    margin: 16px 0 0 -1px;
    font-size: var(--fs-intro); line-height: 32px; font-weight: var(--fw-medium);
    letter-spacing: var(--ls-item); color: rgba(20, 20, 20, 0.62);
  }
  .isf__tabs { position: absolute; left: 1px; top: 330px; width: 520px; display: flex; flex-direction: column; }
  .isf__tabs button {
    position: relative; display: block; height: 74px;
    background: none; border: 0; text-align: left; cursor: pointer;
  }
  .isf__tabs button::before {
    content: ''; position: absolute; left: 0; top: 0;
    width: 100%; height: 0.5px; background: var(--c-rule-soft);
  }
  .isf__tabs button:last-child::after {
    content: ''; position: absolute; left: 0; bottom: 0;
    width: 100%; height: 0.5px; background: var(--c-rule-soft);
  }
  .isf__tab-n { position: absolute; left: 0; top: 28px; font-size: 11px; line-height: normal; font-weight: var(--fw-medium); letter-spacing: 0.14em; color: var(--c-ink-label); }
  .isf__tab-name {
    position: absolute; left: 54px; top: 18px;
    font-size: 38px; line-height: 46px; font-weight: var(--fw-semi);
